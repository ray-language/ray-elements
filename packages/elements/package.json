{
  "name": "@ray-ds/elements",
  "version": "0.3.0",
  "description": "Web components for any app, with raylang extras (shadcn/ui + Mantine inspired)",
  "license": "Apache-2.0",
  "keywords": ["web-components", "custom-elements", "design-system", "ui", "raylang"],
  "homepage": "https://github.com/ray-language/ray-ds#readme",
  "bugs": {
    "url": "https://github.com/ray-language/ray-ds/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ray-language/ray-ds.git",
    "directory": "packages/elements"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./ray-ds.d.ts",
  "exports": {
    ".": {
      "types": "./ray-ds.d.ts",
      "default": "./index.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./base.css": "./base.css",
    "./custom-elements.json": "./custom-elements.json",
    "./vscode.html-custom-data.json": "./vscode.html-custom-data.json",
    "./core/*": "./core/*",
    "./components/*": "./components/*"
  },
  "customElements": "custom-elements.json",
  "sideEffects": ["./index.js", "./components/**/*.js", "*.css"]
}
