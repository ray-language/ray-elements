// The shell every page of the documentation site shares: head, header
// (brand, site nav with the current page, primary color, theme), optional
// sidebar (ray-nav-links; the current section is highlighted by site.js),
// the mobile menu (a ray-drawer with the same navigation) and the footer.
//
// Pages live in docs/ and load ../dist, ../src and docs/site.{css,js}: they
// must be served from the ray-elements directory (head_guard explains it otherwise).

// The markup lives in site/layout.ray.html (a compiled template); this
// module turns a Page into its context: the site nav with the current entry,
// the document title, the palette colors of the primary picker.

from site/model import Page, NavItem, Group, Link;
import site/layout;
import site/brand;

// The ink of the mark's fourth tile follows the theme (site.css).
pub const INK: string = "var(--site-logo-ink, #0B1F33)";

// The site navigation: key, page, label.
const NAV: [(string, string, string)] = [
    ("start", "getting-started.html", "Get started"),
    ("foundations", "foundations.html", "Foundations"),
    ("components", "components.html", "Components"),
    ("extending", "extending.html", "Extending"),
    ("charts", "charts.html", "Charts"),
    ("raylang", "raylang.html", "raylang")
];

// The whole HTML document of a page. `colors`: palette colors for the primary picker.
pub fn render(p: Page, colors: [string]) -> string {
    let home = p.key == "home";
    let title = if (home) {
        "ray·ds — web components for any app, with raylang extras"
    } else {
        "${p.title} · ray·ds"
    };
    // A page in a subdirectory (components/button.html) reaches the rest
    // of the site through `base`.
    let depth = p.file.split("/").len() - 1;
    let base = "../".repeat(depth);
    // The sidebar link to this very page is the current one.
    let own = p.file.substring(p.file.last_index_of("/").map(fn(i: int) -> int { i + 1 }).unwrap_or(0), p.file.len());
    let groups: [Group] = [];
    for g in p.groups {
        let ls: [Link] = [];
        for l in g.links {
            ls.push(Link { label: l.label, href: l.href, current: l.href == own || l.href == p.file });
        }
        groups.push(Group { title: g.title, links: ls });
    }
    let nav: [NavItem] = [];
    for (k, href, label) in NAV {
        nav.push(NavItem { label: label, href: base + href, current: k == p.key });
    }
    layout.render(
        title,
        p.description,
        nav,
        home,
        colors,
        groups,
        p.main_class,
        p.body,
        head_guard(base),
        p.groups.len() > 0,
        brand.mark(INK, 28, false),
        brand.mark(INK, 16, true),
        base,
        p.key
    )
}

// <head> markup: the stored theme applied before the first paint (the
// runtime does it too, but as a module it runs after it: a dark flash on a
// light choice), the serve hint, then the tokens stylesheet that triggers it
// on error.
pub fn head_guard(base: string) -> string {
    `<script>
(function () {
  try {
    var root = document.documentElement;
    // A component's page shows its content once its components are defined
    // (no layout shift); modules.ray clears this, and 3 s is the fallback.
    root.setAttribute("data-ray-loading", "");
    setTimeout(function () { root.removeAttribute("data-ray-loading"); }, 3000);
    var theme = localStorage.getItem("ray-elements:theme");
    if (theme === "light" || theme === "dark") root.setAttribute("data-theme", theme);
    var primary = localStorage.getItem("ray-elements:primary");
    if (primary && primary !== "custom") root.setAttribute("data-primary", primary);
  } catch (e) {}
})();
</script>
<script>
window.__rayServeHint = function () {
  var show = function () {
    if (document.getElementById("ray-serve-hint")) return;
    var p = document.createElement("p");
    p.id = "ray-serve-hint";
    p.setAttribute("role", "alert");
    p.style.cssText = "margin:0;padding:12px 16px;font:14px/1.5 system-ui,sans-serif;background:#fff3bf;color:#5c3c00;border-bottom:1px solid #f08c00";
    p.innerHTML = "ray-elements could not load its tokens and components: this page must be served from the <b>ray-elements</b> directory. " +
      "Run <code>ray serve . --port 0</code> in <code>ray-elements/</code> (not in <code>docs/</code>) and open the printed URL + <code>/docs/</code>.";
    document.body.prepend(p);
  };
  if (document.body) show(); else document.addEventListener("DOMContentLoaded", show);
};
if (location.protocol === "file:") window.__rayServeHint();
</script>
<link rel="stylesheet" href="${base}../dist/tokens.css" onerror="window.__rayServeHint()">`
}

// ray-elements/index.html: the server root sends you to the docs.
pub fn root_index() -> string {
    redirect("docs/", "ray-elements")
}

fn redirect(to: string, title: string) -> string {
    `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>${title}</title>
<!-- Generated by ray-elements tools. Do not edit. -->
<meta http-equiv="refresh" content="0; url=${to}">
</head>
<body>
<p><a href="${to}">${title}</a></p>
</body>
</html>
`
}
