// docs/search-index.js: what the site's command palette (⌘K) searches — every
// component (name, category, summary, tags) and every page with its sections.

import std/json;
from components/meta import Component;
from site/model import Page;

pub fn index_js(cs: [Component], pages: [Page]) -> string {
    var items = json.arr();
    for c in cs {
        let tags: [string] = [c.dir] + c.aliases.map(fn(a: string) -> string { a.to_lower() });
        for el in c.elements {
            tags.push(el.tag);
        }
        let label = if (c.aliases.len() > 0) { "${c.name} (${join(c.aliases, ", ")})" } else { c.name };
        items = items.item(entry(label, "Components · ${c.category}", c.summary, "components.html#${c.dir}", tags, "layers"));
    }
    for p in pages {
        if (p.key == "home" || p.key == "components") {
            continue;
        }
        items = items.item(entry(p.title, "Pages", p.description, p.file, [p.key], "book"));
        for g in p.groups {
            for l in g.links {
                let href = if (l.href.starts_with("#")) { p.file + l.href } else { l.href };
                items = items.item(entry(l.label, p.title, "", href, [], "file"));
            }
        }
    }
    let lines = [
        "// Generated by ray-ds tools (tools/src/site/search.ray). Do not edit.",
        "export default ${json.render_arr_pretty(items, 2)};",
        ""
    ];
    join(lines, "\n")
}

fn entry(
    label: string,
    group: string,
    description: string,
    href: string,
    keywords: [string],
    icon: string
) -> json.Obj {
    json.obj()
        .field("label", label)
        .field("group", group)
        .field("description", description)
        .field("href", href)
        .field("keywords", json.list(keywords))
        .field("icon", icon)
}
