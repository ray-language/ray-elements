// dist/tokens.css
//
// Scheme-dependent tokens are written once as light-dark(light, dark): the
// theme is the element's `color-scheme` (the system's by default, forced with
// data-theme="light|dark" on any element, also a subtree).
//
// Custom properties substitute their var() references where they are declared,
// so a subtree with data-primary="violet" re-declares every token that points
// at the primary color, not only the primary-* aliases.

from tokens/model import Model, Token, depends_on_scheme, primary_aliases;
import tokens/refs;

pub fn render(m: Model) -> Result<string, string> {
    let out: [string] = [];
    out.push("/* Generated by ray-elements tools from tokens.toml. Do not edit. */");
    out.push("");
    out.push("@layer ray.tokens, ray.base;");
    out.push("");
    out.push("@layer ray.tokens {");
    out.push("  :root {");
    out.push("    color-scheme: light dark;");
    var group = "";
    for t in m.tokens {
        if (!t.css) {
            continue;
        }
        if (t.group != group) {
            group = t.group;
            out.push("");
            out.push("    /* ${group} */");
        }
        out.push("    ${decl(m, t)?}");
    }
    out.push("  }");
    out.push("");
    out.push("  [data-theme=\"light\"] { color-scheme: light; }");
    out.push("  [data-theme=\"dark\"] { color-scheme: dark; }");

    let dependents = primary_dependents(m)?;
    for c in m.colors {
        out.push("");
        out.push("  [data-primary=\"${c}\"] {");
        // A runtime color's shades come from variables set on this element
        // (definePrimary): redeclare its palette and variants here so they
        // resolve against them, not against the :root fallback.
        if (m.runtime.contains(c)) {
            for t in m.tokens {
                if ((t.group == "palette" || t.group == "variant") && t.name.starts_with("${c}-")) {
                    out.push("    ${decl(m, t)?}");
                }
            }
        }
        for t in primary_aliases(m, c) {
            out.push("    ${decl(m, t)?}");
        }
        for t in dependents {
            out.push("    ${decl(m, t)?}");
        }
        out.push("  }");
    }
    out.push("}");
    out.push("");
    Result.Ok(join(out, "\n"))
}

fn decl(m: Model, t: Token) -> Result<string, string> {
    let light = refs.to_css(t.light, m.prefix)?;
    let value = if (depends_on_scheme(t)) {
        "light-dark(${light}, ${refs.to_css(t.dark, m.prefix)?})"
    } else {
        light
    };
    Result.Ok("--${m.prefix}-${t.name}: ${value};")
}

// Non-alias tokens whose value refers to a primary-* token.
fn primary_dependents(m: Model) -> Result<[Token], string> {
    let out: [Token] = [];
    for t in m.tokens {
        if (t.group == "primary" || !t.css) {
            continue;
        }
        let names = refs.names(t.light)? + refs.names(t.dark)?;
        var hit = false;
        for n in names {
            if (n.starts_with("primary-")) {
                hit = true;
            }
        }
        if (hit) {
            out.push(t);
        }
    }
    Result.Ok(out)
}
