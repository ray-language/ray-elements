// WCAG 2.x contrast ratio between resolved token values.
//
// Understands `#rgb`, `#rrggbb` and two-color `color-mix(in srgb, A N%, B)`
// where B is a color (mixed) or `transparent` (the alpha form the generator
// emits, blended over the background before measuring).

import std/math;

pub struct Rgba {
    r: float,
    g: float,
    b: float,
    a: float,
}

pub fn parse(s: string) -> Option<Rgba> {
    let v = s.trim();
    if (v.starts_with("#")) {
        return parse_hex(v);
    }
    let pre = "color-mix(in srgb, ";
    if (v.starts_with(pre) && v.ends_with(")")) {
        let args = v.substring(pre.len(), v.len() - 1).split(", ");
        if (args.len() != 2) {
            return Option.None;
        }
        let first = args[0].trim();
        let sp = first.last_index_of(" ")?;
        let n = parse_float(first.substring(sp + 1, first.len()).strip_suffix("%")?)? / 100.0;
        let a = parse(first.substring(0, sp))?;
        let other = args[1].trim();
        if (other == "transparent") {
            return Option.Some(Rgba { r: a.r, g: a.g, b: a.b, a: a.a * n });
        }
        let b = parse(other)?;
        return Option.Some(
            Rgba {
                r: a.r * n + b.r * (1.0 - n),
                g: a.g * n + b.g * (1.0 - n),
                b: a.b * n + b.b * (1.0 - n),
                a: 1.0
            }
        );
    }
    Option.None
}

fn parse_hex(v: string) -> Option<Rgba> {
    let h = v.substring(1, v.len());
    if (h.len() == 3) {
        let r = hex_digit(h[0])?;
        let g = hex_digit(h[1])?;
        let b = hex_digit(h[2])?;
        return Option.Some(rgb((r * 17) as float, (g * 17) as float, (b * 17) as float));
    }
    if (h.len() == 6) {
        let r = hex_digit(h[0])? * 16 + hex_digit(h[1])?;
        let g = hex_digit(h[2])? * 16 + hex_digit(h[3])?;
        let b = hex_digit(h[4])? * 16 + hex_digit(h[5])?;
        return Option.Some(rgb(r as float, g as float, b as float));
    }
    Option.None
}

fn rgb(r: float, g: float, b: float) -> Rgba {
    Rgba { r: r / 255.0, g: g / 255.0, b: b / 255.0, a: 1.0 }
}

fn hex_digit(c: char) -> Option<int> {
    let n = char_code(c);
    if (n >= 48 && n <= 57) {
        return Option.Some(n - 48);
    }
    if (n >= 97 && n <= 102) {
        return Option.Some(n - 87);
    }
    if (n >= 65 && n <= 70) {
        return Option.Some(n - 55);
    }
    Option.None
}

// `fg` composited over an opaque `bg`.
pub fn over(fg: Rgba, bg: Rgba) -> Rgba {
    let a = fg.a;
    Rgba {
        r: fg.r * a + bg.r * (1.0 - a),
        g: fg.g * a + bg.g * (1.0 - a),
        b: fg.b * a + bg.b * (1.0 - a),
        a: 1.0
    }
}

fn channel(c: float) -> float {
    if (c <= 0.04045) { c / 12.92 } else { math.pow((c + 0.055) / 1.055, 2.4) }
}

pub fn luminance(c: Rgba) -> float {
    0.2126 * channel(c.r) + 0.7152 * channel(c.g) + 0.0722 * channel(c.b)
}

// Contrast ratio (1.0 … 21.0) of a foreground over a background.
pub fn ratio(fg: Rgba, bg: Rgba) -> float {
    let l1 = luminance(over(fg, bg));
    let l2 = luminance(bg);
    if (l1 > l2) { (l1 + 0.05) / (l2 + 0.05) } else { (l2 + 0.05) / (l1 + 0.05) }
}

// `#rrggbb`, or `#rrggbb NN%` when translucent.
pub fn to_hex(c: Rgba) -> string {
    let h = "#${byte_hex(c.r)}${byte_hex(c.g)}${byte_hex(c.b)}";
    if (c.a >= 1.0) { h } else { "${h} ${math.round(c.a * 100.0) as int}%" }
}

fn byte_hex(v: float) -> string {
    let n = math.round(v * 255.0) as int;
    let digits = "0123456789abcdef";
    "${digits[n / 16]}${digits[n % 16]}"
}

// --- perceptual distance and color vision deficiency --------------------------

// OKLab (Björn Ottosson): L, a, b.
pub struct Lab {
    l: float,
    a: float,
    b: float,
}

fn to_linear(c: float) -> float {
    if (c <= 0.04045) { c / 12.92 } else { math.pow((c + 0.055) / 1.055, 2.4) }
}

fn from_linear(c: float) -> float {
    let x = if (c < 0.0) { 0.0 } else if (c > 1.0) { 1.0 } else { c };
    if (x <= 0.0031308) { 12.92 * x } else { 1.055 * math.pow(x, 1.0 / 2.4) - 0.055 }
}

fn cbrt(x: float) -> float {
    if (x < 0.0) { 0.0 - math.pow(0.0 - x, 1.0 / 3.0) } else { math.pow(x, 1.0 / 3.0) }
}

pub fn oklab(c: Rgba) -> Lab {
    let r = to_linear(c.r);
    let g = to_linear(c.g);
    let b = to_linear(c.b);
    let l = cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
    let m = cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
    let s = cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
    Lab {
        l: 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,
        a: 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,
        b: 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s
    }
}

// Euclidean OKLab distance x100 (about 2 is a just-noticeable difference).
pub fn distance(x: Rgba, y: Rgba) -> float {
    let p = oklab(x);
    let q = oklab(y);
    let dl = p.l - q.l;
    let da = p.a - q.a;
    let db = p.b - q.b;
    math.sqrt(dl * dl + da * da + db * db) * 100.0
}

// How a color looks with full protanopia, deuteranopia or tritanopia
// (Machado, Oliveira & Fernandes 2009, severity 1.0), applied in linear RGB.
pub fn simulate(c: Rgba, kind: string) -> Rgba {
    let m = match (kind) {
        "protanopia" => [
            0.152286,
            1.052583,
            -0.204868,
            0.114503,
            0.786281,
            0.099216,
            -0.003882,
            -0.048116,
            1.051998
        ],
        "deuteranopia" => [0.367322, 0.860646, -0.227968, 0.280085, 0.672501, 0.047413, -0.01182, 0.04294, 0.968881],
        _ => [1.255528, -0.076749, -0.178779, -0.078411, 0.930809, 0.147602, 0.004733, 0.691367, 0.3039],
    };
    let r = to_linear(c.r);
    let g = to_linear(c.g);
    let b = to_linear(c.b);
    Rgba {
        r: from_linear(m[0] * r + m[1] * g + m[2] * b),
        g: from_linear(m[3] * r + m[4] * g + m[5] * b),
        b: from_linear(m[6] * r + m[7] * g + m[8] * b),
        a: c.a
    }
}

// One decimal place, for reports.
pub fn show(r: float) -> string {
    let tenths = math.round(r * 10.0) as int;
    "${tenths / 10}.${tenths % 10}"
}

@test
fn black_on_white_is_21() {
    let r = ratio(parse("#000").unwrap(), parse("#ffffff").unwrap());
    assert_eq(show(r), "21.0");
}

@test
fn mantine_blue_on_white() {
    let r = ratio(parse("#ffffff").unwrap(), parse("#228be6").unwrap());
    assert_eq(show(r), "3.6");
}

@test
fn oklab_distances() {
    let white = parse("#ffffff").unwrap();
    let black = parse("#000000").unwrap();
    assert(distance(white, black) > 99.0 && distance(white, black) < 101.0);
    assert(distance(white, white) < 0.001);
    let red = parse("#ff0000").unwrap();
    let green = parse("#00ff00").unwrap();
    // Red and green collapse for a deuteranope, not for normal vision.
    assert(distance(red, green) > 40.0);
    assert(
        distance(simulate(red, "deuteranopia"), simulate(green, "deuteranopia")) < distance(red, green) / 2.0
    );
}

@test
fn hex_round_trip() {
    assert_eq(to_hex(parse("#228be6").unwrap()), "#228be6");
    assert_eq(
        to_hex(parse("color-mix(in srgb, #000000 45%, transparent)").unwrap()),
        "#000000 45%"
    );
}

@test
fn mix_with_black_darkens() {
    let c = parse("color-mix(in srgb, #ffffff 50%, #000000)").unwrap();
    assert(c.r > 0.49 && c.r < 0.51 && c.a == 1.0);
}

@test
fn alpha_is_blended_over_the_background() {
    let half = parse("color-mix(in srgb, #000000 50%, transparent)").unwrap();
    let r = ratio(half, parse("#ffffff").unwrap());
    assert(r > 3.0 && r < 5.0);
}
