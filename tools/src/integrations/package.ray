// `package`: writes the npm packages under packages/ (generated, replaced
// wholesale on every run):
//
//   packages/elements  @raylang/elements  the web components + tokens + types + manifests + llms.txt
//   packages/react     @raylang/react     React wrappers (React 18/19)
//   packages/vue       @raylang/vue       Vue 3 wrappers with v-model + plugin
//
// Consume them from a Vite app with file: dependencies (see examples/).

import std/fs;
import std/toml;
from std/toml import TomlValue;
from components/meta import Component;
import integrations/elements;
import integrations/manifest;
import integrations/wrappers;

pub struct Info {
    scope: string,
    version: string,
    description: string,
    license: string,
    repository: string,
    homepage: string,
}

pub fn info(root: string) -> Result<Info, string> {
    let entries = toml.parse_toml(fs.read_file("${root}/ray-elements.toml")?)?;
    let i = Info { scope: "@raylang", version: "0.0.0", description: "", license: "Apache-2.0", repository: "", homepage: "" };
    for e in entries {
        let v = match (e.value) {
            TomlValue.TStr(s) => s,
            _ => return Result.Err("ray-elements.toml: ${e.key} must be a string"),
        };
        if (e.key == "package.scope") {
            i.scope = v;
        } else if (e.key == "package.version") {
            i.version = v;
        } else if (e.key == "package.description") {
            i.description = v;
        } else if (e.key == "package.license") {
            i.license = v;
        } else if (e.key == "package.repository") {
            i.repository = v;
        } else if (e.key == "package.homepage") {
            i.homepage = v;
        } else {
            return Result.Err("ray-elements.toml: unknown key '${e.key}'");
        }
    }
    if (!i.repository.starts_with("https://")) {
        return Result.Err("ray-elements.toml: package.repository must be an https:// URL");
    }
    if (i.homepage == "") {
        i.homepage = i.repository;
    }
    Result.Ok(i)
}

pub fn run(root: string, cs: [Component]) -> Result<[string], string> {
    let i = info(root)?;
    let written: [string] = [];
    let base = "${root}/packages";

    // --- elements
    let el = "${base}/elements";
    fresh(el)?;
    copy_tree(root, "src/core", "${el}/core", ".js")?;
    for c in cs {
        for f in c.files {
            put(
                written,
                "${el}/components/${c.dir}/${f}",
                fs.read_file("${root}/src/components/${c.dir}/${f}")?
            )?;
        }
    }
    put(written, "${el}/tokens.css", fs.read_file("${root}/dist/tokens.css")?)?;
    put(written, "${el}/tokens.json", fs.read_file("${root}/dist/tokens.json")?)?;
    put(written, "${el}/base.css", fs.read_file("${root}/src/core/base.css")?)?;
    put(written, "${el}/index.js", elements.index_js(cs))?;
    put(written, "${el}/core.js", elements.core_js())?;
    put(
        written,
        "${el}/ray-elements.d.ts",
        elements.dts(fs.read_file("${root}/src/core/core.d.ts")?, cs)
    )?;
    put(written, "${el}/custom-elements.json", manifest.custom_elements(cs, "components/")?)?;
    put(written, "${el}/vscode.html-custom-data.json", manifest.vscode_data(cs)?)?;
    // The docs for AI agents, for this version (docs writes them first).
    for name in ["llms.txt", "llms-full.txt"] {
        put(written, "${el}/${name}", fs.read_file("${root}/docs/${name}")?)?;
    }
    put(written, "${el}/package.json", elements_package(i, cs))?;
    put(written, "${el}/README.md", readme(i, "elements"))?;
    put(written, "${el}/LICENSE", fs.read_file("${root}/LICENSE")?)?;
    put(written, "${el}/NOTICE", fs.read_file("${root}/NOTICE")?)?;

    // --- react (and vue): the package target; no components beyond ray-elements's own
    let t = wrappers.package_target();
    let none: [Component] = [];
    let r = "${base}/react";
    fresh(r)?;
    put(written, "${r}/create.js", fs.read_file("${root}/src/integrations/react/create.js")?)?;
    for (rel, content) in wrappers.react_modules(cs) {
        put(written, "${r}/${rel}", content)?;
    }
    put(written, "${r}/index.d.ts", wrappers.react_dts(cs, none, t))?;
    put(
        written,
        "${r}/package.json",
        wrapper_package(
            i,
            "react",
            "React wrappers of the ray-elements web components",
            "\"react\": \">=18\""
        )
    )?;
    put(written, "${r}/README.md", readme(i, "react"))?;
    put(written, "${r}/LICENSE", fs.read_file("${root}/LICENSE")?)?;
    put(written, "${r}/NOTICE", fs.read_file("${root}/NOTICE")?)?;

    // --- vue
    let v = "${base}/vue";
    fresh(v)?;
    put(written, "${v}/create.js", fs.read_file("${root}/src/integrations/vue/create.js")?)?;
    for (rel, content) in wrappers.vue_modules(cs) {
        put(written, "${v}/${rel}", content)?;
    }
    put(written, "${v}/index.d.ts", wrappers.vue_dts(cs, none, t))?;
    put(
        written,
        "${v}/package.json",
        wrapper_package(
            i,
            "vue",
            "Vue 3 wrappers (with v-model) of the ray-elements web components",
            "\"vue\": \">=3.3\""
        )
    )?;
    put(written, "${v}/README.md", readme(i, "vue"))?;
    put(written, "${v}/LICENSE", fs.read_file("${root}/LICENSE")?)?;
    put(written, "${v}/NOTICE", fs.read_file("${root}/NOTICE")?)?;
    Result.Ok(written)
}

fn fresh(dir: string) -> Result<int, string> {
    if (fs.exists(dir)) {
        fs.remove_all(dir)?;
    }
    fs.mkdir(dir)
}

fn put(written: [string], path: string, content: string) -> Result<int, string> {
    fs.mkdir(path.substring(0, path.last_index_of("/").unwrap_or(0)))?;
    fs.write_file(path, content)?;
    written.push(path);
    Result.Ok(0)
}

fn copy_tree(root: string, from_dir: string, to: string, ext: string) -> Result<int, string> {
    fs.mkdir(to)?;
    for f in sort(fs.list_dir("${root}/${from_dir}")?) {
        if (f.ends_with(ext)) {
            fs.write_file("${to}/${f}", fs.read_file("${root}/${from_dir}/${f}")?)?;
        }
    }
    Result.Ok(0)
}

// The entries: "." registers everything; "./core" is the API alone; one per
// component ("./button") registers it and what it uses, so a bundler takes
// only those (the components are side effects: importing one defines it).
fn elements_package(i: Info, cs: [Component]) -> string {
    var entries: [string] = [];
    for c in cs {
        entries.push(`    "./${c.dir}": {
      "types": "./ray-elements.d.ts",
      "default": "./components/${c.dir}/${c.files[0]}"
    },`);
    }
    `{
  "name": "${i.scope}/elements",
  "version": "${i.version}",
  "description": "${i.description}",
  "license": "${i.license}",
${source(i, "elements", ["web-components", "custom-elements", "design-system", "ui", "raylang"])}
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./ray-elements.d.ts",
  "exports": {
    ".": {
      "types": "./ray-elements.d.ts",
      "default": "./index.js"
    },
    "./core": {
      "types": "./ray-elements.d.ts",
      "default": "./core.js"
    },
${join(entries, "\n")}
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./base.css": "./base.css",
    "./custom-elements.json": "./custom-elements.json",
    "./vscode.html-custom-data.json": "./vscode.html-custom-data.json",
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt",
    "./core/*": "./core/*",
    "./components/*": "./components/*"
  },
  "customElements": "custom-elements.json",
  "sideEffects": ["./index.js", "./components/**/*.js", "*.css"]
}
`
}

fn wrapper_package(i: Info, kind: string, description: string, peer: string) -> string {
    `{
  "name": "${i.scope}/${kind}",
  "version": "${i.version}",
  "description": "${description}",
  "license": "${i.license}",
${source(i, kind, ["web-components", "design-system", "ui", "raylang", kind])}
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "${i.scope}/elements": "^${i.version}",
    ${peer}
  }
}
`
}

// Where a package comes from (the lines after "license", up to the comma
// before "type"): npm shows them on the package's page, and publishing with
// provenance checks "repository" against the repository that built it.
fn source(i: Info, kind: string, keywords: [string]) -> string {
    let words = join(keywords.map(fn(k: string) -> string { "\"${k}\"" }), ", ");
    `  "keywords": [${words}],
  "homepage": "${i.homepage}",
  "bugs": {
    "url": "${i.repository}/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+${i.repository}.git",
    "directory": "packages/${kind}"
  },
  "publishConfig": {
    "access": "public"
  },`
}

fn readme(i: Info, kind: string) -> string {
    let usage = match (kind) {
        "react" => `import "${i.scope}/elements/tokens.css";
import { RayButton, RayInput } from "${i.scope}/react";

<RayInput label="Name" value={name} onInput={(e) => setName(e.currentTarget.value)} />
<RayButton onClick={save}>Save</RayButton>`,
        "vue" => `import "${i.scope}/elements/tokens.css";
import RayElements from "${i.scope}/vue";
app.use(RayElements);

<RayInput v-model="name" label="Name" />
<RayButton @click="save">Save</RayButton>`,
        _ => `import "${i.scope}/elements/tokens.css";
import "${i.scope}/elements";   // registers every <ray-*> element

<ray-button variant="light">Save</ray-button>`,
    };
    `# ${i.scope}/${kind}

${i.description}.

Generated from [ray-elements](${i.repository}) (its \`packages/${kind}\`
directory): the components, their docs and the issues are there.

\`\`\`
${usage}
\`\`\`
`
}

@test
fn packages_name_their_source() {
    let i = Info {
        scope: "@raylang",
        version: "1.2.3",
        description: "d",
        license: "Apache-2.0",
        repository: "https://github.com/o/r",
        homepage: "https://o.github.io/r/",
    };
    let p = wrapper_package(i, "vue", "v", "\"vue\": \">=3.3\"");
    assert(p.contains("\"url\": \"git+https://github.com/o/r.git\",\n    \"directory\": \"packages/vue\""));
    assert(p.contains("\"keywords\": [\"web-components\", \"design-system\", \"ui\", \"raylang\", \"vue\"]"));
    assert(p.contains("\"homepage\": \"https://o.github.io/r/\""));
    assert(p.contains("\"access\": \"public\""));
    let none: [Component] = [];
    assert(elements_package(i, none).contains("\"directory\": \"packages/elements\""));
    assert(readme(i, "react").contains("[ray-elements](https://github.com/o/r) (its `packages/react`"));
}
