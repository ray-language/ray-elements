// React and Vue wrappers (index.js) and their declarations (index.d.ts), one
// per element, from component.toml — for @ray-ds/react and @ray-ds/vue
// (package_target) or for an app's own components (app_target, `wrap`).

from components/meta import
    Component,
    Element,
    Prop,
    Named,
    all_elements,
    all_props,
    all_attrs,
    all_events,
    base_elements;
from integrations/ts import
    prop_type,
    event_type,
    handler_name,
    doc,
    quote,
    js_list,
    wrapper_props,
    is_dom_prop;

const HEADER: string = "// Generated by ray-ds tools from component.toml files. Do not edit.";

// Where the generated modules get their pieces from.
pub struct Target {
    // Module with createComponent (and createPlugin), per framework.
    react_factory: string,
    vue_factory: string,
    // Imported for its side effect: registers the elements.
    registers: string,
    // Module whose types declare the element classes.
    element_types: string,
    // Name of the Vue plugin.
    plugin: string,
    // Whether to declare (and re-export) the factories themselves.
    own_factories: bool,
}

pub fn package_target() -> Target {
    Target {
        react_factory: "./create.js",
        vue_factory: "./create.js",
        registers: "@ray-ds/elements",
        element_types: "@ray-ds/elements",
        plugin: "RayDs",
        own_factories: true
    }
}

// For an app's components: the factories come from the ray-ds packages,
// the elements and their types from the generated index next to the wrappers.
pub fn app_target() -> Target {
    Target {
        react_factory: "@ray-ds/react",
        vue_factory: "@ray-ds/vue",
        registers: "./index.js",
        element_types: "./index.js",
        plugin: "AppComponents",
        own_factories: false
    }
}

// The elements to resolve inheritance against: the base classes, `extra`
// (ray-ds's components when wrapping an app's) and the generated ones.
fn lookup(cs: [Component], extra: [Component]) -> [Element] {
    base_elements() + all_elements(extra) + all_elements(cs)
}

// --- React --------------------------------------------------------------------

pub fn react_js(cs: [Component], extra: [Component], t: Target) -> string {
    let els = lookup(cs, extra);
    let out: [string] = [
        HEADER,
        "",
        "import ${quote(t.registers)};",
        "import { createComponent } from ${quote(t.react_factory)};",
        ""
    ];
    if (t.own_factories) {
        out.push("// The factory, to wrap your own custom elements the same way.");
        out.push("export { createComponent };");
        out.push("");
    }
    for el in all_elements(cs) {
        let events: [string] = [];
        for n in all_events(els, el) {
            events.push("${handler_name(n.name)}: ${quote(n.name)}");
        }
        out.push(`export const ${el.class_name} = createComponent(${quote(el.tag)}, {
  displayName: ${quote(el.class_name)},
  properties: [${js_list(wrapper_props(els, el))}],
  events: { ${join(events, ", ")} },
});`);
    }
    out.push("");
    join(out, "\n")
}

pub fn react_dts(cs: [Component], extra: [Component], t: Target) -> string {
    let els = lookup(cs, extra);
    let classes = known_names(cs + extra, els);
    let out: [string] = [
        HEADER,
        "",
        "import type * as React from \"react\";",
        "import type * as Ray from ${quote(t.element_types)};",
        ""
    ];
    if (t.own_factories) {
        out.push(
            "/** Wraps any custom element as a React component (props set as DOM properties, events by name). */"
        );
        out.push(
            "export declare function createComponent<E extends HTMLElement = HTMLElement, P = {}>("
        );
        out.push("  tagName: string,");
        out.push(
            "  options?: { properties?: string[]; events?: Record<string, string>; displayName?: string },"
        );
        out.push(
            "): React.ForwardRefExoticComponent<P & Omit<React.HTMLAttributes<E>, keyof P> & { children?: React.ReactNode } & React.RefAttributes<E>>;"
        );
        out.push("");
    }
    for el in all_elements(
        cs
    ) {
        let cls = el.class_name;
        out.push("export interface ${cls}OwnProps {");
        for p in all_props(els, el) {
            if (is_dom_prop(p.name)) {
                continue;
            }
            out.push("${doc(p.description, "  ")}  ${p.name}?: ${qualify(prop_type(p), classes)};");
        }
        for a in all_attrs(els, el) {
            out.push("${doc(a.description, "  ")}  ${a.name}?: string;");
        }
        for n in all_events(
            els,
            el
        ) {
            out.push(
                "${doc(n.description, "  ")}  ${handler_name(n.name)}?: (event: ${qualify(event_type(n), classes)}) => void;"
            );
        }
        out.push("}");
        out.push(
            "export type ${cls}Props = ${cls}OwnProps & Omit<React.HTMLAttributes<Ray.${cls}>, keyof ${cls}OwnProps> & { children?: React.ReactNode };"
        );
        out.push(
            "${doc("<${el.tag}> as a React component.", "")}export declare const ${cls}: React.ForwardRefExoticComponent<${cls}Props & React.RefAttributes<Ray.${cls}>>;"
        );
        out.push("");
    }
    join(out, "\n")
}

// --- Vue ----------------------------------------------------------------------

pub fn vue_js(cs: [Component], extra: [Component], t: Target) -> string {
    let els = lookup(cs, extra);
    let out: [string] = [
        HEADER,
        "",
        "import ${quote(t.registers)};",
        "import { createComponent, createPlugin } from ${quote(t.vue_factory)};",
        ""
    ];
    if (t.own_factories) {
        out.push("// The factories, to wrap your own custom elements the same way.");
        out.push("export { createComponent, createPlugin };");
        out.push("");
    }
    for el in all_elements(
        cs
    ) {
        let model = if (el.model_property == "") {
            ""
        } else {
            ",\n  model: { prop: ${quote(el.model_property)}, events: [${js_list(el.model_events)}] }"
        };
        let booleans: [string] = [];
        for p in all_props(els, el) {
            if (p.kind == "boolean" && !is_dom_prop(p.name)) {
                booleans.push(p.name);
            }
        }
        out.push(
            `export const ${el.class_name} = createComponent(${quote(el.class_name)}, ${quote(el.tag)}, {
  properties: [${js_list(wrapper_props(els, el))}],
  booleans: [${js_list(booleans)}]${model},
});`
        );
    }
    let names: [string] = all_elements(cs).map(fn(e: Element) -> string { e.class_name });
    out.push("");
    out.push("export const components = { ${join(names, ", ")} };");
    out.push("");
    out.push("/** app.use(${t.plugin}) registers every component globally. */");
    out.push("export const ${t.plugin} = createPlugin(components);");
    out.push("export default ${t.plugin};");
    out.push("");
    join(out, "\n")
}

pub fn vue_dts(cs: [Component], extra: [Component], t: Target) -> string {
    let els = lookup(cs, extra);
    let classes = known_names(cs + extra, els);
    let out: [string] = [
        HEADER,
        "",
        "import type { DefineComponent, Plugin } from \"vue\";",
        "import type * as Ray from ${quote(t.element_types)};",
        ""
    ];
    if (t.own_factories) {
        out.push(
            "/** Wraps any custom element as a Vue component (props set as DOM properties, optional v-model). */"
        );
        out.push("export declare function createComponent<P = Record<string, unknown>>(");
        out.push("  name: string,");
        out.push("  tagName: string,");
        out.push(
            "  options?: { properties?: string[]; booleans?: string[]; model?: { prop: string; events: string[] } },"
        );
        out.push("): DefineComponent<P>;");
        out.push("/** A plugin registering components globally. */");
        out.push(
            "export declare function createPlugin(components: Record<string, unknown>): Plugin;"
        );
        out.push("");
    }
    for el in all_elements(
        cs
    ) {
        let cls = el.class_name;
        let props = all_props(els, el);
        out.push("export interface ${cls}Props {");
        for p in props {
            if (is_dom_prop(p.name)) {
                continue;
            }
            out.push("${doc(p.description, "  ")}  ${p.name}?: ${qualify(prop_type(p), classes)};");
        }
        if (el.model_property != "") {
            let model = props.filter(fn(p: Prop) -> bool { p.name == el.model_property });
            let ty = if (model.len() > 0) {
                qualify(prop_type(model[0]), classes)
            } else {
                "unknown"
            };
            out.push(
                "${doc("v-model: the element's `${el.model_property}`.", "  ")}  modelValue?: ${ty};"
            );
            out.push("  \"onUpdate:modelValue\"?: (value: ${ty}) => void;");
        }
        for a in all_attrs(els, el) {
            out.push("${doc(a.description, "  ")}  ${a.name}?: string;");
        }
        for n in all_events(
            els,
            el
        ) {
            out.push(
                "${doc(n.description, "  ")}  ${handler_name(n.name)}?: (event: ${qualify(event_type(n), classes)}) => void;"
            );
        }
        out.push("}");
        out.push(
            "${doc("<${el.tag}> as a Vue component.", "")}export declare const ${cls}: DefineComponent<${cls}Props>;"
        );
        out.push("");
    }
    let names: [string] = all_elements(cs).map(fn(e: Element) -> string { e.class_name });
    out.push("export declare const components: {");
    out.push(join(names.map(fn(n: string) -> string { "  ${n}: typeof ${n};" }), "\n"));
    out.push("};");
    out.push("/** app.use(${t.plugin}) registers every component globally. */");
    out.push("export declare const ${t.plugin}: Plugin;");
    out.push("export default ${t.plugin};");
    out.push("");
    out.push("declare module \"vue\" {");
    out.push("  export interface GlobalComponents {");
    out.push(join(names.map(fn(n: string) -> string { "    ${n}: typeof ${n};" }), "\n"));
    out.push("  }");
    out.push("}");
    out.push("");
    join(out, "\n")
}

// Names the element-types module declares that the wrappers' types may
// mention: element classes and exported types (TableColumn, CommandAction…).
fn known_names(cs: [Component], els: [Element]) -> [string] {
    let out: [string] = els.map(fn(e: Element) -> string { e.class_name });
    for c in cs {
        for t in c.types {
            out.push(t.name);
        }
    }
    out
}

// Element class names in a TypeScript type, qualified with the `Ray.` import:
// in the wrappers' declarations the bare name is the wrapper itself.
pub fn qualify(ts: string, classes: [string]) -> string {
    let out: [string] = [];
    var word: [string] = [];
    let flush = fn(word: [string], out: [string]) {
        if (word.len() > 0) {
            let w = join(word, "");
            out.push(if (classes.contains(w)) { "Ray.${w}" } else { w });
        }
    };
    for ch in ts.chars() {
        let n = char_code(ch);
        let ident = (n >= 48 && n <= 57)
            || (n >= 65 && n <= 90)
            || (n >= 97 && n <= 122)
            || ch == '_'
            || ch == '$';
        if (ident) {
            word.push(to_string(ch));
        } else {
            flush(word, out);
            word = [];
            out.push(to_string(ch));
        }
    }
    flush(word, out);
    join(out, "")
}

@test
fn qualifies_class_names_only() {
    let classes = ["RayMenu", "RayMenuItem"];
    assert_eq(
        qualify("{ value: string; item: RayMenuItem }", classes),
        "{ value: string; item: Ray.RayMenuItem }"
    );
    assert_eq(qualify("RayMenu[]", classes), "Ray.RayMenu[]");
    assert_eq(qualify("\"a\" | \"b\"", classes), "\"a\" | \"b\"");
}
