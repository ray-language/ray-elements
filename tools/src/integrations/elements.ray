// @raylang/elements: index.js (registers every component and re-exports the
// API), core.js (the API alone) and ray-elements.d.ts (core types + one class per element, the tag map,
// event maps, exported functions and types).

from components/meta import
    Component,
    Element,
    Prop,
    Named,
    Decl,
    all_elements,
    all_events,
    base_elements;
from integrations/ts import prop_type, event_type, doc, is_dom_prop;

// core.js: the API without any component (setIcons, definePrimary,
// enableRaylang…), so importing it registers nothing.
pub fn core_js() -> string {
    let out: [string] = [
        "// Generated by ray-elements tools. Do not edit.",
        "// The API of @raylang/elements without the components: importing it registers no element.",
        "",
        "export * from \"./core/core.js\";",
        "export { FormControl, FieldControl, fieldTemplate, fieldStyles, boxStyles } from \"./core/form.js\";",
        "export { Floating, floatingStyles } from \"./core/floating.js\";",
        "export { COLORS, VARIANT_TOKENS, applyColor, spaceValue, sizeStyles, radiusStyles, variantStyles, loaderStyles, srOnlyStyles, overlayStyles, applyOverlayBlur } from \"./core/styles.js\";",
        "export { place, pointRect, autoUpdate } from \"./core/position.js\";",
        "export { scrollerOf, watchScroll } from \"./core/scroll.js\";",
        "export { tabbables, focusFirst } from \"./core/focus.js\";",
        "export { isRtl, inlineKey } from \"./core/direction.js\";",
        "export { duration, motionAllowed, play, playAll, collapseOut, POP_OUT } from \"./core/motion.js\";",
        "export { dismissable } from \"./core/dismiss.js\";",
        "export { matchesHotkey, formatHotkey } from \"./core/hotkey.js\";",
        "export { CHART_SERIES, chartTheme, onChartThemeChange, withAlpha } from \"./core/charts.js\";",
        "export { setHost, getHost, hostCan, onHostChange, HostFile, typeOfName, extensionsOfType, acceptFilters, titlebar, dragRegion, trackEdits } from \"./core/host.js\";",
        "export { enableRaylang, PROTOCOL } from \"./core/raylang.js\";"
    ];
    out.push("");
    join(out, "\n")
}

pub fn index_js(cs: [Component]) -> string {
    let out: [string] = [
        "// Generated by ray-elements tools from src/components/*/component.toml. Do not edit.",
        "// Importing this module registers every <ray-*> element; import",
        "// @raylang/elements/<name> (\"/button\", \"/icon\"…) for only some, and",
        "// @raylang/elements/core for the API alone.",
        "",
        "export * from \"./core.js\";"
    ];
    for c in cs {
        for f in c.files {
            let names: [string] = c.elements.map(fn(el: Element) -> string { el.class_name });
            for d in c.exports {
                names.push(d.name);
            }
            out.push("export { ${join(names, ", ")} } from \"./components/${c.dir}/${f}\";");
        }
    }
    out.push("");
    join(out, "\n")
}

pub fn dts(core: string, cs: [Component]) -> string {
    let els = all_elements(cs);
    let out: [string] = [
        "// Generated by ray-elements tools from src/core/core.d.ts and src/components/*/component.toml. Do not edit.",
        "",
        core.trim(),
        ""
    ];
    for c in cs {
        out.push("// --- ${c.name} (${c.dir})");
        for t in c.types {
            out.push("${doc(t.description, "")}export type ${t.name} = ${t.ts};");
        }
        for d in c.exports {
            out.push("${doc(d.description, "")}export declare ${d.ts};");
        }
        for el in c.elements {
            out.push(element_class(els, el, c, el.extends_name));
        }
        out.push("");
    }
    out.push("declare global {");
    out.push("  interface HTMLElementTagNameMap {");
    for el in els {
        out.push("    \"${el.tag}\": ${el.class_name};");
    }
    out.push("  }");
    out.push("}");
    out.push("");
    join(out, "\n")
}

fn element_class(els: [Element], el: Element, c: Component, parent: string) -> string {
    let summary = if (el.summary != "") { el.summary } else { c.summary };
    let lines: [string] = [];
    lines.push(
        "${doc("<${el.tag}> " + summary, "")}export declare class ${el.class_name} extends ${parent} {"
    );
    for p in el.props {
        if (is_dom_prop(p.name)) {
            continue;
        }
        // An explicit type that already says how it is empty stays as it is.
        let says_empty = p.ts.contains("null") || p.ts.contains("undefined");
        let optional = if (p.default_value == "" && !says_empty) { " | undefined" } else { "" };
        lines.push("${doc(p.description, "  ")}  ${p.name}: ${prop_type(p)}${optional};");
    }
    for m in el.members {
        lines.push("${doc(m.description, "  ")}  ${m.ts};");
    }
    let custom = el.events.filter(fn(n: Named) -> bool { n.name.starts_with("ray-") });
    if (custom.len() > 0) {
        let cls = el.class_name;
        lines.push(
            "  addEventListener<K extends keyof ${cls}EventMap>(type: K, listener: (this: ${cls}, ev: ${cls}EventMap[K]) => unknown, options?: boolean | AddEventListenerOptions): void;"
        );
        lines.push(
            "  addEventListener(type: string, listener: EventListenerOrEventListenerObject, options?: boolean | AddEventListenerOptions): void;"
        );
        lines.push(
            "  removeEventListener<K extends keyof ${cls}EventMap>(type: K, listener: (this: ${cls}, ev: ${cls}EventMap[K]) => unknown, options?: boolean | EventListenerOptions): void;"
        );
        lines.push(
            "  removeEventListener(type: string, listener: EventListenerOrEventListenerObject, options?: boolean | EventListenerOptions): void;"
        );
    }
    lines.push("}");
    if (custom.len() > 0) {
        lines.push("export interface ${el.class_name}EventMap extends HTMLElementEventMap {");
        // Only ray-* events: the DOM-named ones (input, change…) come typed
        // from HTMLElementEventMap, and redeclaring them as Event clashes
        // with its InputEvent & co.
        for n in all_events(els, el) {
            if (n.name.starts_with("ray-")) {
                lines.push("${doc(n.description, "  ")}  \"${n.name}\": ${event_type(n)};");
            }
        }
        lines.push("}");
    }
    join(lines, "\n")
}

// --- an app's own components (`wrap`) -----------------------------------------

// index.js next to the wrappers: registers the app's components (paths
// relative to it) and re-exports ray-elements, so one module has every class.
pub fn app_index_js(cs: [Component], modules: string) -> string {
    let out: [string] = [
        "// Generated by ray-elements tools (wrap) from component.toml files. Do not edit.",
        "",
        "export * from \"@raylang/elements\";"
    ];
    for c in cs {
        for f in c.files {
            let names: [string] = c.elements.map(fn(el: Element) -> string { el.class_name });
            out.push("export { ${join(names, ", ")} } from \"${modules}${c.dir}/${f}\";");
        }
    }
    out.push("");
    join(out, "\n")
}

// index.d.ts: ray-elements's types plus a class per app element, extending ray-elements's.
pub fn app_dts(cs: [Component], rayds: [Component]) -> string {
    let els = base_elements() + all_elements(rayds) + all_elements(cs);
    let local: [string] = all_elements(cs).map(fn(e: Element) -> string { e.class_name });
    let out: [string] = [
        "// Generated by ray-elements tools (wrap) from component.toml files. Do not edit.",
        "",
        "import type * as RayElements from \"@raylang/elements\";",
        "export * from \"@raylang/elements\";",
        ""
    ];
    for c in cs {
        for t in c.types {
            out.push("${doc(t.description, "")}export type ${t.name} = ${t.ts};");
        }
        for d in c.exports {
            out.push("${doc(d.description, "")}export declare ${d.ts};");
        }
        for el in c.elements {
            let parent = if (local.contains(el.extends_name)) {
                el.extends_name
            } else {
                "RayElements.${el.extends_name}"
            };
            out.push(element_class(els, el, c, parent));
        }
        out.push("");
    }
    out.push("declare global {");
    out.push("  interface HTMLElementTagNameMap {");
    for el in all_elements(cs) {
        out.push("    \"${el.tag}\": ${el.class_name};");
    }
    out.push("  }");
    out.push("}");
    out.push("");
    join(out, "\n")
}
