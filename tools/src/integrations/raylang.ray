// The raylang package (ray_ds/, next to the hand-written bridge.ray): the
// generated module ray_ds/assets, which carries the files of
// @ray-ds/elements (the components, the core, tokens.css, base.css) as
// constants and mounts them in the app's ray://app tree:
//
//   import ray_ds/assets;
//   assets.mount("ray-ds")?;   // ray://app/ray-ds/index.js, …/tokens.css, …
//
// A dependency's own [native] embed does not reach the app (finding #139),
// so the files travel inside the code: the same under `ray run`, in a native
// binary and in a bundle, from any working directory.

import std/fs;

// What the package carries from packages/elements.
fn wanted(rel: string) -> bool {
    rel.ends_with(".js") || rel.ends_with(".css")
}

// Writes ray_ds/assets.ray from packages/elements (written first) and keeps
// ray_ds/ray.toml at `version`. Returns the number of files it carries.
pub fn run(root: string, version: string) -> Result<int, string> {
    let base = "${root}/packages/elements";
    let rels = walk(base, "")?;
    var consts: [string] = [];
    var table: [string] = [];
    var i = 0;
    for rel in rels {
        let text = fs.read_file("${base}/${rel}")?;
        consts.push("const F${i}: string = ${literal(text)};");
        table.push("    (\"${rel}\", F${i}, ${fs.file_size("${base}/${rel}")?}),");
        i = i + 1;
    }
    fs.write_file("${root}/ray_ds/assets.ray", module(version, consts, table))?;
    sync_manifest(root, version)?;
    check_bridge_version(root, version)?;
    Result.Ok(rels.len())
}

fn walk(base: string, rel: string) -> Result<[string], string> {
    let dir = if (rel == "") { base } else { "${base}/${rel}" };
    var out: [string] = [];
    for name in sort(fs.list_dir(dir)?) {
        let child = if (rel == "") { name } else { "${rel}/${name}" };
        if (fs.is_dir("${base}/${child}")) {
            out = out + walk(base, child)?;
        } else if (wanted(child)) {
            out.push(child);
        }
    }
    Result.Ok(out)
}

// A raylang string literal with exactly `text`.
pub fn literal(text: string) -> string {
    let s = text
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
        .replace("\${", "\\\${");
    "\"${s}\""
}

fn module(version: string, consts: [string], table: [string]) -> string {
    `// Generated by ray-ds tools (build) from packages/elements. Do not edit.
//
// The files of @ray-ds/elements ${version}, served from the program:
//
//   import ray_ds/assets;
//   assets.mount("ray-ds")?;   // then the page loads ray-ds/index.js, ray-ds/tokens.css…

import std/ui;

pub const VERSION: string = "${version}";

// (path, content, size in bytes): the size checks the content in the tests.
fn table() -> [(string, string, int)] {
    [
${join(table, "\n")}
    ]
}

// The paths of the files, relative to the mount point.
pub fn files() -> [string] {
    table().map(fn(f: (string, string, int)) -> string { f.0 })
}

// The text of a file ("core/core.js", "tokens.css"…).
pub fn read(path: string) -> Option<string> {
    for (p, text, size) in table() {
        if (p == path) {
            return Option.Some(text);
        }
    }
    Option.None
}

// Mounts every file at ray://app/<prefix>/<path> (prefix "" = the root).
// Returns how many.
pub fn mount(prefix: string) -> Result<int, string> {
    let at = if (prefix == "" || prefix.ends_with("/")) { prefix } else { prefix + "/" };
    for (p, text, size) in table() {
        ui.mount_bytes(at + p, text.to_bytes())?;
    }
    Result.Ok(table().len())
}

@test
fn carries_every_file_exactly() {
    for (p, text, size) in table() {
        assert_eq_msg(text.to_bytes().len(), size, p);
    }
    assert(files().contains("index.js") && files().contains("tokens.css") && files().contains("core/raylang.js"));
}

${join(consts, "\n")}
`
}

// ray_ds/ray.toml follows ray-ds.toml's version.
fn sync_manifest(root: string, version: string) -> Result<int, string> {
    let path = "${root}/ray_ds/ray.toml";
    let lines = fs.read_file(path)?.split("\n");
    var out: [string] = [];
    for l in lines {
        out.push(if (l.starts_with("version = ")) { "version = \"${version}\"" } else { l });
    }
    fs.write_file(path, join(out, "\n"))
}

// bridge.ray is hand-written: its VERSION must say the same.
fn check_bridge_version(root: string, version: string) -> Result<int, string> {
    let want = "pub const VERSION: string = \"${version}\";";
    if (!fs.read_file("${root}/ray_ds/bridge.ray")?.contains(want)) {
        return Result.Err("ray_ds/bridge.ray: VERSION must be \"${version}\" (ray-ds.toml)");
    }
    Result.Ok(0)
}

// --- the package's own repository ----------------------------------------------

// What `export` owns in a checkout of the package's repository: it replaces
// these and leaves anything else (.git, a workflow of that repository).
fn owned(name: string) -> bool {
    name.ends_with(".ray") || ["ray.toml", "README.md", "LICENSE", "NOTICE"].contains(name)
}

// Writes the package as its repository holds it (github.com/ray-language/ray_ds:
// the modules at the root, because a git dependency is the repository's root,
// finding #140) into `out`, with the license and a README. `commit` is the
// ray-ds commit it comes from. Returns the files written.
pub fn export(root: string, out: string, version: string, commit: string) -> Result<[string], string> {
    fs.mkdir(out)?;
    for name in fs.list_dir(out)? {
        if (owned(name) && !fs.is_dir("${out}/${name}")) {
            fs.remove_all("${out}/${name}")?;
        }
    }
    var written: [string] = [];
    for name in sort(fs.list_dir("${root}/ray_ds")?) {
        if (owned(name)) {
            fs.write_file("${out}/${name}", fs.read_file("${root}/ray_ds/${name}")?)?;
            written.push(name);
        }
    }
    for name in ["LICENSE", "NOTICE"] {
        fs.write_file("${out}/${name}", fs.read_file("${root}/${name}")?)?;
        written.push(name);
    }
    fs.write_file("${out}/README.md", readme(version, commit))?;
    written.push("README.md");
    Result.Ok(written)
}

fn readme(version: string, commit: string) -> string {
    let from = if (commit == "") { "" } else { " (ray-ds commit `${commit}`)" };
    `# ray_ds

[ray-ds](https://github.com/ray-language/ray-ds) for raylang apps: the design
system's web components served from the program, with no npm and no copied
files, and the native bridge that gives them the system's dialogs, menus and
window in a \`std/ui\` window.

Version ${version}${from}. This repository is generated from
[ray-language/ray-ds](https://github.com/ray-language/ray-ds) (its \`ray_ds/\`
directory): open issues and pull requests there.

## Install

\`\`\`toml
[dependencies]
ray_ds = "git+https://github.com/ray-language/ray_ds@v${version}"
\`\`\`

## Use

\`\`\`ray
import std/ui;
import ray_ds/assets;
import ray_ds/bridge;

fn main() -> int {
    assets.mount("ray-ds").unwrap();          // ray://app/ray-ds/index.js, tokens.css, base.css…
    ui.mount_embed_at("", "assets").unwrap(); // the app's own page ([native] embed)
    let h = ui.open("App", "ray://app/index.html", 960, 640).unwrap();
    for e in ui.events() {
        if (bridge.handle(e)) {
            continue;                         // a ray-ds request, answered
        }
        if (e.kind == "closed") {
            break;
        }
        // the app's own events
    }
    0
}
\`\`\`

\`\`\`html
<link rel="stylesheet" href="ray-ds/tokens.css">
<link rel="stylesheet" href="ray-ds/base.css">
<script type="module" src="ray-ds/index.js"></script>
<script type="module">
  import { enableRaylang } from "./ray-ds/index.js";
  await enableRaylang();   // the system dialogs, menus and window for the components
</script>
\`\`\`

- \`ray_ds/assets\`: every component, the core, \`tokens.css\` and \`base.css\`;
  \`assets.mount(prefix)\`, \`assets.files()\`, \`assets.read(path)\`,
  \`assets.VERSION\`.
- \`ray_ds/bridge\`: \`bridge.handle(e)\`, or \`bridge.system()\` +
  \`bridge.route(n, e)\` and \`bridge.menu(n, …)\` for the menu bar in the
  command palette.

The components, their pages and the bridge's protocol are documented in
[ray-ds](https://github.com/ray-language/ray-ds): see its \`RAYLANG.md\` and the
"In a raylang app" sections of the component pages.

## License

Apache License 2.0: see [LICENSE](LICENSE) and [NOTICE](NOTICE).
`
}

@test
fn readme_names_the_version() {
    let r = readme("1.2.3", "abc1234");
    assert(r.contains("Version 1.2.3 (ray-ds commit `abc1234`)"));
    assert(r.contains("ray_ds = \"git+https://github.com/ray-language/ray_ds@v1.2.3\""));
    assert(r.contains("```ray\nimport std/ui;"));
}

@test
fn literals_keep_the_text() {
    assert_eq(literal("a\"b\\c\nd\t\${x}$y"), "\"a\\\"b\\\\c\\nd\\t\\\${x}$y\"");
}
