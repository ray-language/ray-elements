// The raylang package, ray_ds/: the hand-written bridge.ray and README.md
// next to what this writes there:
//
//   assets.ray    the files of @ray-ds/elements (the components, the core,
//                 tokens.css, base.css) as constants, mounted in the app's
//                 ray://app tree:
//                   import ray_ds/assets;
//                   assets.mount("ray-ds")?;   // ray://app/ray-ds/index.js, …
//   version.ray   VERSION, ray-ds.toml's version (the bridge's hello says it)
//   ray.toml      its version line; README.md its install line
//   LICENSE, NOTICE  copies of the repository's
//
// ray_ds/ is the whole package: its own repository
// (github.com/ray-language/ray_ds) is `git subtree split --prefix ray_ds`.
//
// A dependency's own [native] embed does not reach the app (finding #139),
// so the files travel inside the code: the same under `ray run`, in a native
// binary and in a bundle, from any working directory.

import std/fs;

// What the package carries from packages/elements.
fn wanted(rel: string) -> bool {
    rel.ends_with(".js") || rel.ends_with(".css")
}

// Writes ray_ds/ from packages/elements (written first) at `version`.
// Returns the number of files assets.ray carries.
pub fn run(root: string, version: string) -> Result<int, string> {
    let base = "${root}/packages/elements";
    let rels = walk(base, "")?;
    var consts: [string] = [];
    var table: [string] = [];
    var i = 0;
    for rel in rels {
        let text = fs.read_file("${base}/${rel}")?;
        consts.push("const F${i}: string = ${literal(text)};");
        table.push("    (\"${rel}\", F${i}, ${fs.file_size("${base}/${rel}")?}),");
        i = i + 1;
    }
    fs.write_file("${root}/ray_ds/assets.ray", module(version, consts, table))?;
    fs.write_file("${root}/ray_ds/version.ray", version_module(version))?;
    sync(root, "ray.toml", fn(l: string) -> string {
        if (l.starts_with("version = ")) { "version = \"${version}\"" } else { l }
    })?;
    sync(root, "README.md", fn(l: string) -> string { install_line(l, version) })?;
    for name in ["LICENSE", "NOTICE"] {
        fs.write_file("${root}/ray_ds/${name}", fs.read_file("${root}/${name}")?)?;
    }
    Result.Ok(rels.len())
}

fn walk(base: string, rel: string) -> Result<[string], string> {
    let dir = if (rel == "") { base } else { "${base}/${rel}" };
    var out: [string] = [];
    for name in sort(fs.list_dir(dir)?) {
        let child = if (rel == "") { name } else { "${rel}/${name}" };
        if (fs.is_dir("${base}/${child}")) {
            out = out + walk(base, child)?;
        } else if (wanted(child)) {
            out.push(child);
        }
    }
    Result.Ok(out)
}

// A raylang string literal with exactly `text`.
pub fn literal(text: string) -> string {
    let s = text
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
        .replace("\${", "\\\${");
    "\"${s}\""
}

fn module(version: string, consts: [string], table: [string]) -> string {
    `// Generated by ray-ds tools (build) from packages/elements. Do not edit.
//
// The files of @ray-ds/elements ${version}, served from the program:
//
//   import ray_ds/assets;
//   assets.mount("ray-ds")?;   // then the page loads ray-ds/index.js, ray-ds/tokens.css…

import std/ui;

// (path, content, size in bytes): the size checks the content in the tests.
fn table() -> [(string, string, int)] {
    [
${join(table, "\n")}
    ]
}

// The paths of the files, relative to the mount point.
pub fn files() -> [string] {
    table().map(fn(f: (string, string, int)) -> string { f.0 })
}

// The text of a file ("core/core.js", "tokens.css"…).
pub fn read(path: string) -> Option<string> {
    for (p, text, size) in table() {
        if (p == path) {
            return Option.Some(text);
        }
    }
    Option.None
}

// Mounts every file at ray://app/<prefix>/<path> (prefix "" = the root).
// Returns how many.
pub fn mount(prefix: string) -> Result<int, string> {
    let at = if (prefix == "" || prefix.ends_with("/")) { prefix } else { prefix + "/" };
    for (p, text, size) in table() {
        ui.mount_bytes(at + p, text.to_bytes())?;
    }
    Result.Ok(table().len())
}

@test
fn carries_every_file_exactly() {
    for (p, text, size) in table() {
        assert_eq_msg(text.to_bytes().len(), size, p);
    }
    assert(files().contains("index.js") && files().contains("tokens.css") && files().contains("core/raylang.js"));
}

${join(consts, "\n")}
`
}

fn version_module(version: string) -> string {
    `// Generated by ray-ds tools (build) from ray-ds.toml. Do not edit.

// The version of ray-ds this package is.
pub const VERSION: string = "${version}";
`
}

// Rewrites ray_ds/<name> line by line.
fn sync(root: string, name: string, f: fn(string) -> string) -> Result<int, string> {
    let path = "${root}/ray_ds/${name}";
    fs.write_file(path, join(fs.read_file(path)?.split("\n").map(f), "\n"))
}

// The README's `ray_ds = "git+…@vX.Y.Z"` names the version.
fn install_line(l: string, version: string) -> string {
    let at = l.last_index_of("@v");
    if (!l.starts_with("ray_ds = \"git+") || at.is_none()) {
        return l;
    }
    l.substring(0, at.unwrap()) + "@v${version}\""
}

@test
fn literals_keep_the_text() {
    assert_eq(literal("a\"b\\c\nd\t\${x}$y"), "\"a\\\"b\\\\c\\nd\\t\\\${x}$y\"");
}

@test
fn the_install_line_follows_the_version() {
    let l = "ray_ds = \"git+https://github.com/ray-language/ray_ds@v0.3.0\"";
    assert_eq(install_line(l, "1.2.3"), "ray_ds = \"git+https://github.com/ray-language/ray_ds@v1.2.3\"");
    assert_eq(install_line("version = \"0.3.0\"", "1.2.3"), "version = \"0.3.0\"");
    assert(version_module("1.2.3").contains("pub const VERSION: string = \"1.2.3\";"));
}
