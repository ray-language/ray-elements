// custom-elements.json (Custom Elements Manifest 2.1: IDEs, Storybook, linters)
// and vscode.html-custom-data.json (VS Code HTML completion).

import std/json;
from std/json import Obj, Arr;
from components/meta import Component, Element, Prop, Named, parse, base_elements, all_elements, all_props, all_attrs, all_events;
from integrations/ts import prop_type, event_type, is_dom_prop;

// `prefix`: the path of the components' directory from the manifest
// ("components/" in @raylang/elements).
pub fn custom_elements(cs: [Component], prefix: string) -> Result<string, string> {
    let els = base_elements() + all_elements(cs);
    var modules = json.arr();
    for c in cs {
        for f in c.files {
            let path = "${prefix}${c.dir}/${f}";
            var decls = json.arr();
            var exports = json.arr();
            for el in c.elements {
                decls = decls.item(declaration(els, el, c));
                exports = exports
                    .item(json.obj()
                    .field("kind", "js")
                    .field("name", el.class_name)
                    .field("declaration", ref(el.class_name, path)))
                    .item(json.obj()
                    .field("kind", "custom-element-definition")
                    .field("name", el.tag)
                    .field("declaration", ref(el.class_name, path)));
            }
            for d in c.exports {
                decls = decls.item(json.obj()
                    .field("kind", "function")
                    .field("name", d.name)
                    .field("description", d.description));
                exports = exports.item(json.obj()
                    .field("kind", "js")
                    .field("name", d.name)
                    .field("declaration", ref(d.name, path)));
            }
            modules = modules.item(json.obj()
                .field("kind", "javascript-module")
                .field("path", path)
                .field("declarations", decls)
                .field("exports", exports));
        }
    }
    let doc = json.obj()
        .field("schemaVersion", "2.1.0")
        .field("readme", "README.md")
        .field("modules", modules);
    pretty(doc)
}

fn ref(name: string, module: string) -> Obj {
    json.obj().field("name", name).field("module", module)
}

fn declaration(els: [Element], el: Element, c: Component) -> Obj {
    var attributes = json.arr();
    var members = json.arr();
    for p in all_props(els, el) {
        let t = json.obj().field("text", prop_type(p));
        if (p.attribute != "") {
            var a = json.obj()
                .field("name", p.attribute)
                .field("type", t)
                .field("description", p.description)
                .field("fieldName", p.name);
            if (p.default_value != "") {
                a = a.field("default", p.default_value);
            }
            attributes = attributes.item(a);
        } else if (p.initial != "") {
            attributes = attributes.item(json.obj()
                .field("name", p.initial)
                .field("type", t)
                .field("description", "The initial value of ${p.name}. ${p.description}"));
        }
        if (!is_dom_prop(p.name)) {
            var m = json.obj()
                .field("kind", "field")
                .field("name", p.name)
                .field("type", t)
                .field("description", p.description);
            if (p.attribute != "") {
                m = m.field("attribute", p.attribute).field("reflects", p.reflect);
            }
            if (p.default_value != "") {
                m = m.field("default", p.default_value);
            }
            members = members.item(m);
        }
    }
    for a in el.attrs {
        attributes = attributes.item(json.obj()
            .field("name", a.name)
            .field("type", json.obj().field("text", "string"))
            .field("description", a.description));
    }
    for d in el.members {
        let kind = if (d.ts.contains("(")) { "method" } else { "field" };
        members = members.item(json.obj()
            .field("kind", kind)
            .field("name", d.name)
            .field("description", d.description));
    }
    var events = json.arr();
    for n in all_events(els, el) {
        events = events.item(json.obj()
            .field("name", n.name)
            .field("type", json.obj().field("text", event_type(n)))
            .field("description", n.description));
    }
    var slots = json.arr();
    for s in el.slots {
        let name = if (s.name == "default") { "" } else { s.name };
        slots = slots.item(json.obj().field("name", name).field("description", s.description));
    }
    var parts = json.arr();
    for p in el.parts {
        parts = parts.item(json.obj().field("name", p.name).field("description", p.description));
    }
    let summary = if (el.summary != "") { el.summary } else { c.summary };
    json.obj()
        .field("kind", "class")
        .field("name", el.class_name)
        .field("tagName", el.tag)
        .field("customElement", true)
        .field("description", summary)
        .field("superclass", json.obj().field("name", el.extends_name))
        .field("attributes", attributes)
        .field("members", members)
        .field("events", events)
        .field("slots", slots)
        .field("cssParts", parts)
}

// The string literals of a TypeScript type (a declared type by its name).
fn literals(ts: string, cs: [Component]) -> [string] {
    var text = ts;
    for c in cs {
        for t in c.types {
            if (t.name == ts) {
                text = t.ts;
            }
        }
    }
    let out: [string] = [];
    for part in text.split("|") {
        let v = part.trim();
        if (v.len() >= 2 && v.starts_with("\"") && v.ends_with("\"")) {
            out.push(v.substring(1, v.len() - 1));
        }
    }
    out
}

pub fn vscode_data(cs: [Component]) -> Result<string, string> {
    let els = base_elements() + all_elements(cs);
    var tags = json.arr();
    for c in cs {
        for el in c.elements {
            var attrs = json.arr();
            for p in all_props(els, el) {
                let name = if (p.attribute != "") { p.attribute } else { p.initial };
                if (name == "") {
                    continue;
                }
                var a = json.obj().field("name", name).field("description", p.description);
                // values, or the literals of an open union (size: "xs" | … | (string & {}),
                // IconName): editors suggest them and still accept anything.
                let values = if (p.values.len() > 0) { p.values } else { literals(p.ts, cs) };
                if (values.len() > 0) {
                    var vs = json.arr();
                    for v in values {
                        vs = vs.item(json.obj().field("name", v));
                    }
                    a = a.field("values", vs);
                } else if (p.kind == "boolean") {
                    a = a.field("valueSet", "v");
                }
                attrs = attrs.item(a);
            }
            for a in all_attrs(els, el) {
                attrs = attrs.item(json.obj()
                    .field("name", a.name)
                    .field("description", a.description));
            }
            let summary = if (el.summary != "") { el.summary } else { c.summary };
            tags = tags.item(json.obj()
                .field("name", el.tag)
                .field("description", summary)
                .field("attributes", attrs));
        }
    }
    pretty(json.obj().field("version", 1.1).field("tags", tags))
}

// Indented, keeping the authored key order.
fn pretty(o: Obj) -> Result<string, string> {
    Result.Ok(json.render_pretty(o, 2) + "\n")
}

@test
fn lists_inherited_and_initial_attributes() {
    let src = `[component]
name = "Thing"
category = "Inputs"
summary = "A thing."
files = ["thing.js"]
requires = []
tags = ["ray-thing"]

[ray-thing]
class = "RayThing"
extends = "FieldControl"

[ray-thing.properties.checked]
attribute = false
initial = true
type = "boolean"

[ray-thing.properties.data]
attribute = false
type = "array"
`;
    let cs = [parse("thing", src).unwrap()];
    let cem = custom_elements(cs, "components/").unwrap();
    assert(cem.contains("\"name\": \"label\""));
    assert(cem.contains("\"name\": \"description-position\""));
    assert(cem.contains("\"name\": \"checked\""));
    let vs = vscode_data(cs).unwrap();
    assert(vs.contains("\"name\": \"label\""));
    assert(vs.contains("\"name\": \"checked\""));
    assert(!vs.contains("\"name\": \"data\""));
}

@test
fn suggests_the_literals_of_open_unions() {
    let src = `[component]
name = "Thing"
category = "Inputs"
summary = "A thing."
files = ["thing.js"]
requires = []
tags = ["ray-thing"]

[component.types.Glyph]
ts = '"star" | "bell" | (string & {})'

[ray-thing]
class = "RayThing"
extends = "RayElement"

[ray-thing.properties.icon]
type = "string"
ts = "Glyph"

[ray-thing.properties.size]
type = "string"
ts = '"sm" | "lg" | (string & {})'
`;
    let vs = vscode_data([parse("thing", src).unwrap()]).unwrap();
    assert(vs.contains("\"name\": \"star\""));
    assert(vs.contains("\"name\": \"bell\""));
    assert(vs.contains("\"name\": \"lg\""));
}
