// docs/components.html (live examples + API tables from component.toml) and
// the import list of every component (src/index.js, or an `add` target's index.js).

from components/meta import Component, Element, Prop, Named, CATEGORIES, all_elements, base_elements, pascal;
import site/frameworks;
from site/model import Page, Group, Link, page, link;
from site/highlight import escape;
import site/thumbs;
import site/highlight;
import site/guides;

// `import` lines for the given components, relative to the index file.
pub fn index_js(cs: [Component], prefix: string) -> string {
    let out: [string] = [
        "// Generated by ray-elements tools. Do not edit: it lists the components present.",
        ""
    ];
    for c in cs {
        for f in c.files {
            out.push("import \"${prefix}${c.dir}/${f}\";");
        }
    }
    out.push("");
    join(out, "\n")
}

fn label_of(c: Component) -> string {
    if (c.aliases.len() > 0) { "${c.name} (${join(c.aliases, ", ")})" } else { c.name }
}

// Components in category order.
fn ordered(cs: [Component]) -> [Component] {
    let out: [Component] = [];
    for cat in CATEGORIES {
        for c in cs {
            if (c.category == cat) {
                out.push(c);
            }
        }
    }
    out
}

// The sidebar: a group per category, each link `prefix + dir + suffix`.
fn sidebar(cs: [Component], prefix: string, suffix: string) -> [Group] {
    let groups: [Group] = [];
    for cat in CATEGORIES {
        let links: [Link] = [];
        for c in cs {
            if (c.category == cat) {
                links.push(link(label_of(c), "${prefix}${c.dir}${suffix}"));
            }
        }
        if (links.len() > 0) {
            groups.push(Group { title: cat, links: links });
        }
    }
    groups
}

// An example placed one directory down (docs/components/): its module
// imports climb one more level, and links to another component's section
// (#button) go to its page when `to_pages`.
fn relocate(html: string, cs: [Component], to_pages: bool) -> string {
    var out = html.replace("\"../src/", "\"../../src/").replace("'../src/", "'../../src/").replace("href=\"code/", "href=\"../code/");
    if (to_pages) {
        for c in cs {
            out = out.replace("href=\"#${c.dir}\"", "href=\"${c.dir}.html\"");
        }
    }
    out
}

// docs/components.html: the catalog — a card per component, by category.
pub fn index(cs: [Component]) -> Page {
    let cats = CATEGORIES.filter(fn(cat: string) -> bool { cs.filter(fn(c: Component) -> bool { c.category == cat }).len() > 0 });
    let jumps = cats.map(fn(cat: string) -> string {
        let n = cs.filter(fn(c: Component) -> bool { c.category == cat }).len();
        "<a href=\"#${slug_of(cat)}\">${escape(cat)}<span>${n}</span></a>"
    });
    let body: [string] = [
        `<header class="catalog-hero">
<p class="catalog-eyebrow">ray·elements · components</p>
<h1 class="page-title">Components</h1>
<p class="page-intro">${cs.len()} web components for any app: a live example, its code in HTML, React and Vue, and its API generated from its <code>component.toml</code>.</p>
<ul class="catalog-facts"><li><b>${cs.len()}</b> components</li><li><b>${cats.len()}</b> categories</li><li><b>3</b> ways to write them: HTML, React, Vue</li><li><a href="components/all.html">All on one page</a></li><li><a href="llms.txt">llms.txt</a> for AI agents</li></ul>
<nav class="catalog-jump" aria-label="Categories">${join(jumps, "")}</nav>
</header>`
    ];
    for cat in cats {
        let in_cat = cs.filter(fn(c: Component) -> bool { c.category == cat });
        body.push("<section class=\"catalog-group\" aria-labelledby=\"${slug_of(cat)}\"><div class=\"catalog-head\"><h2 class=\"catalog-title\" id=\"${slug_of(cat)}\">${escape(cat)}</h2><span class=\"catalog-count\">${in_cat.len()}</span><p>${escape(category_blurb(cat))}</p></div>");
        body.push("<div class=\"catalog\">");
        for c in in_cat {
            let tags = join(c.elements.map(fn(e: Element) -> string { "&lt;${e.tag}&gt;" }), " ");
            body.push("<a class=\"catalog-card\" href=\"components/${c.dir}.html\">${thumbs.thumb(c.dir)}<span class=\"catalog-text\"><strong>${escape(label_of(c))}</strong><span>${escape(first_sentence(c.summary))}</span><code>${tags}</code></span></a>");
        }
        body.push("</div></section>");
    }
    // Links to the old single page (components.html#button) still land.
    let dirs = join(cs.map(fn(c: Component) -> string { "\"${c.dir}\"" }), ",");
    body.push("<script>(() => { const id = location.hash.slice(1); if ([${dirs}].includes(id)) location.replace(\"components/\" + id + \".html\"); })();</script>");
    page(
        "components.html",
        "components",
        "Components",
        "Every ray·elements component: a live example, its code and its API.",
        sidebar(ordered(cs), "components/", ".html"),
        join(body, "\n"),
        "components-index"
    )
}

// docs/components/<dir>.html: one component.
pub fn pages(cs: [Component]) -> [Page] {
    let els = base_elements() + all_elements(cs);
    let list = ordered(cs);
    let out: [Page] = [];
    for i in 0..list.len() {
        let c = list[i];
        let prev = if (i > 0) { "<a class=\"pager-prev\" href=\"${list[i - 1].dir}.html\"><small>Previous</small>${escape(list[i - 1].name)}</a>" } else { "<span></span>" };
        let next = if (i + 1 < list.len()) { "<a class=\"pager-next\" href=\"${list[i + 1].dir}.html\"><small>Next</small>${escape(list[i + 1].name)}</a>" } else { "<span></span>" };
        let body = `<nav class="crumbs" aria-label="Breadcrumb"><a href="../components.html">Components</a><span aria-hidden="true">/</span><a href="../components.html#${slug_of(c.category)}">${escape(c.category)}</a></nav>
${relocate(component(c, els, true), cs, true)}
<nav class="pager" aria-label="Components">${prev}${next}</nav>`;
        let p = page(
            "components/${c.dir}.html",
            "components",
            c.name,
            c.summary,
            sidebar(list, "", ".html"),
            body,
            "components-page"
        );
        p.markdown = "${c.dir}.md";
        out.push(p);
    }
    out
}

// docs/components/all.html: every component on one page (and the page the
// browser tests run in).
pub fn all(cs: [Component]) -> Page {
    let els = base_elements() + all_elements(cs);
    let body: [string] = [
        "<h1 class=\"page-title\">All components</h1>",
        "<p class=\"page-intro\">Every component on one page. Each also has <a href=\"../components.html\">its own page</a>.</p>"
    ];
    for c in ordered(cs) {
        body.push(relocate(component(c, els, false), cs, false));
    }
    page(
        "components/all.html",
        "components",
        "All components",
        "Every ray·elements component on one page.",
        sidebar(ordered(cs), "#", ""),
        join(body, "\n"),
        "components-page"
    )
}

// One line under each category of the catalog.
fn category_blurb(cat: string) -> string {
    for (k, v) in [
        ("Buttons", "Actions, on their own or grouped, with an icon or a pressed state."),
        ("Inputs", "Form fields that take part in a <form>: name, value, validation."),
        ("Navigation", "Moving around an app: links, tabs, pages, the side bar."),
        ("Overlays", "Above the page: modals, drawers, menus, popovers, the command palette."),
        ("Data display", "Content and data: tables, stats, code, media, badges."),
        ("Feedback", "What the app says back: alerts, notifications, progress, loading."),
        ("Layout", "The frame of an app and of its content: the shell and its bars, stacks, groups, grids, cards, scrolling."),
        ("Theme", "Light, dark or the system's choice.")
    ] {
        if (k == cat) {
            return v;
        }
    }
    ""
}

fn slug_of(s: string) -> string {
    s.to_lower().replace(" ", "-")
}

fn first_sentence(s: string) -> string {
    match (s.index_of(". ")) {
        Option.Some(i) => s.substring(0, i + 1),
        Option.None => s,
    }
}

fn component(c: Component, els: [Element], own_page: bool) -> string {
    let api: [string] = [];
    for el in c.elements {
        api.push(element(el, c.elements.len() > 1));
    }
    // The example's code (HTML, React, Vue) is most of the page's weight and
    // rarely opened: it lives in docs/code/<dir>.html (code_file) and
    // site.js fetches it when the details opens.
    let example = if (c.example == "") {
        ""
    } else {
        `<div class="example">${c.example}</div>
<details class="source" data-code-src="code/${c.dir}.html"><summary>Code</summary>
<div class="source-switch"><ray-segmented-control size="xs" aria-label="Language" value="html" data-source-switch><option value="html">HTML</option><option value="react">React</option><option value="vue">Vue</option></ray-segmented-control></div>
<div class="source-body"><p class="source-status"><a href="code/${c.dir}.html">Open the code</a></p></div></details>`
    };
    // On its own page the name is the page's heading.
    let head = if (own_page) {
        `<h1 class="page-title">${escape(c.name)}${aka(c)}</h1>
<p class="page-intro">${escape(c.summary)}</p>`
    } else {
        `<h2>${escape(c.name)}${aka(c)}</h2>
<p class="summary">${escape(c.summary)}</p>`
    };
    // On its own page the API gets its own heading (h1 → h2 → h3).
    let api_head = if (own_page) {
        "<h2 class=\"api-title\">API</h2>\n<p class=\"api-markdown\">For AI agents: <a href=\"${c.dir}.md\">this API as Markdown</a>, or every component in <a href=\"../llms-full.txt\">llms-full.txt</a>.</p>\n"
    } else {
        ""
    };
    let raylang = if (c.raylang == "") {
        ""
    } else {
        let h = if (own_page) { "h2" } else { "h3" };
        "<${h} class=\"api-title\" id=\"${c.dir}-raylang\">In a raylang app</${h}>\n<div class=\"prose raylang-note\">${guides.fragment(c.raylang, "../")}</div>\n"
    };
    `<section id="${c.dir}" class="component">
${head}
${example}
${raylang}${api_head}${join(api, "\n")}
</section>`
}

fn element(el: Element, heading: bool) -> string {
    let out: [string] = [];
    if (heading) {
        out.push("<h3><code>&lt;${el.tag}&gt;</code></h3>");
    } else {
        out.push(
            "<p class=\"tag\"><code>&lt;${el.tag}&gt;</code> &middot; <code>${el.class_name}</code></p>"
        );
    }
    if (el.summary != "") {
        out.push("<p class=\"note\">${escape(el.summary)}</p>");
    }
    if (el.props.len() > 0) {
        let rows: [string] = [];
        for p in el.props {
            rows.push(prop_row(p));
        }
        out.push(table(["Property", "Attribute", "Type", "Default", "Description"], rows));
    }
    out.push(named_table("Attribute", el.attrs));
    out.push(named_table("Event", el.events));
    out.push(named_table("Slot", el.slots));
    out.push(named_table("Part", el.parts));
    join(out, "\n")
}

fn prop_row(p: Prop) -> string {
    let kind = if (p.values.len() > 0) {
        join(p.values.map(fn(v: string) -> string { "<code>${escape(v)}</code>" }), " | ")
    } else {
        p.kind
    };
    let attr = if (p.attribute == "") { "&mdash;" } else { "<code>${p.attribute}</code>" };
    let def = if (p.default_value == "") { "" } else { "<code>${escape(p.default_value)}</code>" };
    let reflect = if (p.reflect) { " <span class=\"reflects\">reflects</span>" } else { "" };
    "<tr><td><code>${p.name}</code></td><td>${attr}${reflect}</td><td>${kind}</td><td>${def}</td><td>${escape(p.description)}</td></tr>"
}

fn named_table(title: string, items: [Named]) -> string {
    if (items.len() == 0) {
        return "";
    }
    let rows: [string] = [];
    for n in items {
        let name = if (title == "Slot" && n.name == "default") {
            "(default)"
        } else {
            "<code>${n.name}</code>"
        };
        rows.push("<tr><td>${name}</td><td>${escape(n.description)}</td></tr>");
    }
    table([title, "Description"], rows)
}

fn table(head: [string], rows: [string]) -> string {
    let th = join(head.map(fn(h: string) -> string { "<th>${h}</th>" }), "");
    "<div class=\"api\"><table><thead><tr>${th}</tr></thead><tbody>${join(rows, "")}</tbody></table></div>"
}

// "Also: Modal" next to the heading of a component with aliases.
fn aka(c: Component) -> string {
    if (c.aliases.len() == 0) {
        return "";
    }
    " <span class=\"aka\">also ${escape(join(c.aliases, ", "))}</span>"
}

// docs/code/<dir>.html: an example's code in HTML, React and Vue, the
// fragment the components page loads when its "Code" opens.
pub fn code_file(c: Component, els: [Element]) -> string {
    let react = frameworks.react(c.example, els, "${pascal(c.dir)}Example");
    let vue = frameworks.vue(c.example, els);
    `<pre class="code" data-source="html"><code>${highlight.code(c.example.trim(), "html")}</code></pre>
<pre class="code" data-source="react" hidden><code>${highlight.code(react, "tsx")}</code></pre>
<pre class="code" data-source="vue" hidden><code>${highlight.code(vue, "vue")}</code></pre>
`
}
