  --ray-control-height-xl: 3.75rem;\n\n    /* shadow */\n    --ray-shadow-xs: 0 1px 3px color-mix(in srgb, var(--ray-black) 5%, transparent), 0 1px 2px color-mix(in srgb, var(--ray-black) 10%, transparent);\n    --ray-shadow-sm: 0 1px 3px color-mix(in srgb, var(--ray-black) 5%, transparent), 0 10px 15px -5px color-mix(in srgb, var(--ray-black) 5%, transparent), 0 7px 7px -5px color-mix(in srgb, var(--ray-black) 4%, transparent);\n    --ray-shadow-md: 0 1px 3px color-mix(in srgb, var(--ray-black) 5%, transparent), 0 20px 25px -5px color-mix(in srgb, var(--ray-black) 5%, transparent), 0 10px 10px -5px color-mix(in srgb, var(--ray-black) 4%, transparent);\n    --ray-shadow-lg: 0 1px 3px color-mix(in srgb, var(--ray-black) 5%, transparent), 0 28px 23px -7px color-mix(in srgb, var(--ray-black) 5%, transparent), 0 12px 12px -7px color-mix(in srgb, var(--ray-black) 4%, transparent);\n    --ray-shadow-xl: 0 1px 3px color-mix(in srgb, var(--ray-black) 5%, transparent), 0 36px 28px -7px color-mix(in srgb, var(--ray-black) 5%, transparent), 0 17px 17px -7px color-mix(in srgb, var(--ray-black) 4%, transparent);\n\n    /* gradient */\n    --ray-gradient-from: var(--ray-indigo-8);\n    --ray-gradient-to: var(--ray-violet-8);\n    --ray-gradient-deg: 45deg;\n\n    /* overlay */\n    --ray-overlay-blur: 4px;\n\n    /* focus */\n    --ray-focus-ring-width: 2px;\n    --ray-focus-ring-offset: 2px;\n\n    /* duration */\n    --ray-duration-fast: 120ms;\n    --ray-duration-base: 200ms;\n    --ray-duration-slow: 300ms;\n\n    /* easing */\n    --ray-easing-standard: cubic-bezier(0.2, 0, 0, 1);\n    --ray-easing-in: cubic-bezier(0.3, 0, 1, 1);\n    --ray-easing-out: cubic-bezier(0, 0, 0, 1);\n\n    /* z */\n    --ray-z-base: 0;\n    --ray-z-sticky: 200;\n    --ray-z-dropdown: 300;\n    --ray-z-overlay: 400;\n    --ray-z-modal: 500;\n    --ray-z-popover: 600;\n    --ray-z-toast: 700;\n    --ray-z-tooltip: 800;\n  }\n\n  [data-theme=\"light\"] { color-scheme: light; }\n  [data-theme=\"dark\