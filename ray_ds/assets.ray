);\n    --ray-cyan-light-hover: light-dark(color-mix(in srgb, var(--ray-cyan-6) 16%, transparent), color-mix(in srgb, var(--ray-cyan-6) 22%, transparent));\n    --ray-cyan-light-color: light-dark(color-mix(in srgb, var(--ray-cyan-9) 90%, var(--ray-black)), var(--ray-cyan-3));\n    --ray-cyan-outline: light-dark(var(--ray-cyan-light-color), var(--ray-cyan-4));\n    --ray-cyan-outline-hover: light-dark(color-mix(in srgb, var(--ray-cyan-6) 8%, transparent), color-mix(in srgb, var(--ray-cyan-4) 8%, transparent));\n    --ray-cyan-contrast: var(--ray-white);\n    --ray-teal-filled: var(--ray-teal-9);\n    --ray-teal-filled-hover: color-mix(in srgb, var(--ray-teal-9) 85%, var(--ray-black));\n    --ray-teal-light: light-dark(color-mix(in srgb, var(--ray-teal-6) 10%, transparent), color-mix(in srgb, var(--ray-teal-6) 15%, transparent));\n    --ray-teal-light-hover: light-dark(color-mix(in srgb, var(--ray-teal-6) 16%, transparent), color-mix(in srgb, var(--ray-teal-6) 22%, transparent));\n    --ray-teal-light-color: light-dark(color-mix(in srgb, var(--ray-teal-9) 90%, var(--ray-black)), var(--ray-teal-3));\n    --ray-teal-outline: light-dark(var(--ray-teal-light-color), var(--ray-teal-4));\n    --ray-teal-outline-hover: light-dark(color-mix(in srgb, var(--ray-teal-6) 8%, transparent), color-mix(in srgb, var(--ray-teal-4) 8%, transparent));\n    --ray-teal-contrast: var(--ray-white);\n    --ray-green-filled: color-mix(in srgb, var(--ray-green-9) 90%, var(--ray-black));\n    --ray-green-filled-hover: color-mix(in srgb, var(--ray-green-9) 80%, var(--ray-black));\n    --ray-green-light: light-dark(color-mix(in srgb, var(--ray-green-6) 10%, transparent), color-mix(in srgb, var(--ray-green-6) 15%, transparent));\n    --ray-green-light-hover: light-dark(color-mix(in srgb, var(--ray-green-6) 16%, transparent), color-mix(in srgb, var(--ray-green-6) 22%, transparent));\n    --ray-green-light-color: light-dark(color-mix(in srgb, var(--ray-green-9) 80%, var(--ray-black)), var(--ray-green-3));\n    --ray-green-outline: light-dark(var(--ray-green-light-color), var(--ray-green-4));\n    --ray-green-outline-hover: light-dark(color-mix(in srgb, var(--ray-green-6) 8%, transparent), color-mix(in srgb, var(--ray-green-4) 8%, transparent));\n    --ray-green-contrast: var(--ray-white);\n    --ray-yellow-filled: var(--ray-yellow-5);\n    --ray-yellow-filled-hover: var(--ray-yellow-6);\n    --ray-yellow-light: light-dark(color-mix(in srgb, var(--ray-yellow-6) 10%, transparent), color-mix(in srgb, var(--ray-yellow-6) 15%, transparent));\n    --ray-yellow-light-hover: light-dark(color-mix(in srgb, var(--ray-yellow-6) 16%, transparent), color-mix(in srgb, var(--ray-yellow-6) 22%, transparent));\n    --ray-yellow-light-color: light-dark(color-mix(in srgb, var(--ray-yellow-9) 62%, var(--ray-black)), var(--ray-yellow-3));\n    --ray-yellow-outline: light-dark(var(--ray-yellow-light-color), var(--ray-yellow-4));\n    --ray-yellow-outline-hover: light-dark(color-mix(in srgb, var(--ray-yellow-6) 8%, transparent), color-mix(in srgb, var(--ray-yellow-4) 8%, transparent));\n    --ray-yellow-contrast: var(--ray-black);\n    --ray-orange-filled: color-mix(in srgb, var(--ray-orange-9) 90%, var(--ray-black));\n    --ray-orange-filled-hover: color-mix(in srgb, var(--ray-orange-9) 80%, var(--ray-black));\n    --ray-orange-light: light-dark(color-mix(in srgb, var(--ray-orange-6) 10%, transparent), color-mix(in srgb, var(--ray-orange-6) 15%, transparent));\n    --ray-orange-light-hover: light-dark(color-mix(in srgb, var(--ray-orange-6) 16%, transparent), color-mix(in srgb, var(--ray-orange-6) 22%, transparent));\n    --ray-orange-light-color: light-dark(color-mix(in srgb, var(--ray-orange-9) 78%, var(--ray-black)), var(--ray-orange-3));\n    --ray-orange-outline: light-dark(var(--ray-orange-light-color), var(--ray-orange-4));\n    --ray-orange-outline-hover: light-dark(color-mix(in srgb, var(--ray-orange-6) 8%, transparent), color-mix(in srgb, var(--ray-orange-4) 8%, transparent));\n    --ray-orange-contrast: var(--ray-white);\n    --ray-custom-filled: var(--ray-custom-src-filled, var(--ray-custom-8));\n    --ray-custom-filled-hover: var(--ray-custom-src-filled-hover, var(--ray-custom-9));\n    --ray-custom-light: light-dark(color-mix(in srgb, var(--ray-custom-6) 10%, transparent), color-mix(in srgb, var(--ray-custom-6) 15%, transparent));\n    --ray-custom-light-hover: light-dark(color-mix(in srgb, var(--ray-custom-6) 16%, transparent), color-mix(in srgb, var(--ray-custom-6) 22%, transparent));\n    --ray-custom-light-color: light-dark(var(--ray-custom-9), var(--ray-custom-3));\n    --ray-custom-outline: light-dark(var(--ray-custom-8), var(--ray-custom-4));\n    --ray-custom-outline-hover: light-dark(color-mix(in srgb, var(--ray-custom-6) 8%, transparent), color-mix(in srgb, var(--ray-custom-4) 8%, transparent));\n    --ray-custom-contrast: var(--ray-custom-src-contrast, var(--ray-white));\n\n    /* primary */\n    --ray-primary-0: var(--ray-blue-0);\n    --ray-primary-1: var(--ray-blue-1);\n    --ray-primary-2: var(--ray-blue-2);\n    --ray-primary-3: var(--ray-blue-3);\n    --ray-primary-4: var(--ray-blue-4);\n    --ray-primary-5: var(--ray-blue-5);\n    --ray-primary-6: var(--ray-blue-6);\n    --ray-primary-7: var(--ray-blue-7);\n    --ray-primary-8: var(--ray-blue-8);\n    --ray-primary-9: var(--ray-blue-9);\n    --ray-primary-filled: var(--ray-blue-filled);\n    --ray-primary-filled-hover: var(--ray-blue-filled-hover);\n    --ray-primary-light: var(--ray-blue-light);\n    --ray-primary-light-hover: var(--ray-blue-light-hover);\n    --ray-primary-light-color: var(--ray-blue-light-color);\n    --ray-primary-outline: var(--ray-blue-outline);\n    --ray-primary-outline-hover: var(--ray-blue-outline-hover);\n    --ray-primary-contrast: var(--ray-blue-contrast);\n\n    /* semantic */\n    --ray-background: light-dark(var(--ray-white), var(--ray-dark-9));\n    --ray-foreground: light-dark(var(--ray-gray-9), var(--ray-gray-1));\n    --ray-card: light-dark(var(--ray-white), var(--ray-dark-8));\n    --ray-card-foreground: light-dark(var(--ray-gray-9), var(--ray-gray-1));\n    --ray-popover: light-dark(var(--ray-white), var(--ray-dark-8));\n    --ray-popover-foreground: light-dark(var(--ray-gray-9), var(--ray-gray-1));\n    --ray-primary: var(--ray-primary-filled);\n    --ray-primary-hover: var(--ray-primary-filled-hover);\n    --ray-primary-foreground: var(--ray-primary-contrast);\n    --ray-secondary: light-dark(var(--ray-gray-1), var(--ray-dark-6));\n    --ray-secondary-hover: light-dark(var(--ray-gray-2), var(--ray-dark-5));\n    --ray-secondary-foreground: light-dark(var(--ray-gray-9), var(--ray-gray-1));\n    --ray-default: light-dark(var(--ray-white), color-mix(in srgb, var(--ray-white) 3%, transparent));\n    --ray-default-hover: light-dark(var(--ray-gray-1), color-mix(in srgb, var(--ray-white) 7%, transparent));\n    --ray-raised: light-dark(var(--ray-white), var(--ray-dark-4));\n    --ray-muted: light-dark(var(--ray-gray-0), var(--ray-dark-6));\n    --ray-muted-foreground: light-dark(color-mix(in srgb, var(--ray-gray-7) 50%, var(--ray-gray-6)), color-mix(in srgb, var(--ray-dark-1) 75%, var(--ray-dark-2)));\n    --ray-accent: light-dark(var(--ray-gray-1), var(--ray-dark-6));\n    --ray-accent-foreground: light-dark(var(--ray-gray-9), var(--ray-gray-1));\n    --ray-destructive: var(--ray-red-filled);\n    --ray-destructive-hover: var(--ray-red-filled-hover);\n    --ray-destructive-foreground: var(--ray-white);\n    --ray-success: light-dark(var(--ray-green-light-color), var(--ray-green-5));\n    --ray-warning: light-dark(var(--ray-yellow-light-color), var(--ray-yellow-5));\n    --ray-info: light-dark(var(--ray-cyan-light-color), var(--ray-cyan-4));\n    --ray-border: light-dark(var(--ray-gray-3), var(--ray-dark-6));\n    --ray-input: light-dark(var(--ray-gray-4), var(--ray-dark-5));\n    --ray-ring: light-dark(color-mix(in srgb, var(--ray-primary-6) 55%, transparent), color-mix(in srgb, var(--ray-primary-4) 60%, transparent));\n    --ray-overlay: light-dark(color-mix(in srgb, var(--ray-black) 10%, transparent), color-mix(in srgb, var(--ray-black) 50%, transparent));\n    --ray-overlay-border: light-dark(color-mix(in srgb, var(--ray-black) 16%, transparent), color-mix(in srgb, var(--ray-white) 14%, transparent));\n    --ray-selection: light-dark(color-mix(in srgb, var(--ray-primary-6) 22%, transparent), color-mix(in srgb, var(--ray-primary-4) 30%, transparent));\n\n    /* chart */\n    --ray-chart-1: light-dark(var(--ray-blue-6), var(--ray-blue-5));\n    --ray-chart-2: light-dark(var(--ray-orange-8), var(--ray-orange-6));\n    --ray-chart-3: light-dark(var(--ray-teal-8), var(--ray-teal-5));\n    --ray-chart-4: light-dark(var(--ray-violet-6), var(--ray-violet-5));\n    --ray-chart-5: light-dark(var(--ray-pink-6), var(--ray-pink-5));\n    --ray-chart-6: light-dark(color-mix(in srgb, var(--ray-yellow-9) 70%, var(--ray-green-9)), var(--ray-yellow-5));\n    --ray-chart-7: light-dark(var(--ray-cyan-9), var(--ray-cyan-5));\n    --ray-chart-8: var(--ray-gray-6);\n    --ray-chart-grid: light-dark(var(--ray-gray-2), var(--ray-dark-6));\n    --ray-chart-axis: var(--ray-muted-foreground);\n    --ray-chart-text: var(--ray-foreground);\n    --ray-chart-tooltip: var(--ray-popover);\n    --ray-chart-tooltip-text: var(--ray-popover-foreground);\n    --ray-chart-tooltip-border: var(--ray-border);\n\n    /* code */\n    --ray-code-background: light-dark(var(--ray-gray-0), #19191a);\n    --ray-code-text: var(--ray-foreground);\n    --ray-code-tag: var(--ray-green-light-color);\n    --ray-code-attr: var(--ray-violet-light-color);\n    --ray-code-string: var(--ray-blue-light-color);\n    --ray-code-keyword: var(--ray-pink-light-color);\n    --ray-code-number: var(--ray-orange-light-color);\n    --ray-code-comment: var(--ray-muted-foreground);\n    --ray-code-punctuation: var(--ray-muted-foreground);\n    --ray-code-function: var(--ray-indigo-light-color);\n    --ray-code-type: var(