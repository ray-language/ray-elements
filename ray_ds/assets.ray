const F50: string = "// <ray-separator>: a horizontal or vertical rule, optionally with a label\n// (Mantine's Divider).\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst styles = css`\n  :host {\n    display: block;\n    --_color: var(--ray-border);\n    --_w: 1px;\n    --_style: solid;\n  }\n  :host([size=\"sm\"]) { --_w: 2px; }\n  :host([size=\"md\"]) { --_w: 3px; }\n  :host([size=\"lg\"]) { --_w: 4px; }\n  :host([size=\"xl\"]) { --_w: 5px; }\n  :host([variant=\"dashed\"]) { --_style: dashed; }\n  :host([variant=\"dotted\"]) { --_style: dotted; }\n  :host([orientation=\"vertical\"]) { display: inline-block; align-self: stretch; height: auto; min-height: 1em; vertical-align: middle; }\n  .line { border-top: var(--_w) var(--_style) var(--_color); }\n  :host([orientation=\"vertical\"]) .line { height: 100%; border-top: 0; border-left: var(--_w) var(--_style) var(--_color); }\n  .labeled {\n    display: flex;\n    align-items: center;\n    gap: var(--ray-space-2);\n    font-size: var(--ray-font-size-xs);\n    color: var(--ray-muted-foreground);\n  }\n  .labeled::before, .labeled::after { content: \"\"; flex: 1; border-top: var(--_w) var(--_style) var(--_color); }\n  :host([label-position=\"left\"]) .labeled::before { flex: 0 0 var(--ray-space-3); }\n  :host([label-position=\"right\"]) .labeled::after { flex: 0 0 var(--ray-space-3); }\n  [hidden] { display: none !important; }\n`;\n\nexport class RaySeparator extends RayElement {\n  static properties = {\n    orientation: { type: String, reflect: true, default: \"horizontal\" },\n    label: { type: String, reflect: true },\n    labelPosition: { type: String, reflect: true, default: \"center\" },\n    size: { type: String, reflect: true, default: \"xs\" },\n    variant: { type: String, reflect: true, default: \"solid\" },\n  };\n  static styles = [styles];\n  static template = `<div class=\"line\" part=\"line\"></div><div class=\"labeled\" part=\"label\" hidden></div>`;\n\n  update() {\n    const vertical = this.orientation === \"vertical\";\n    this.setAttribute(\"role\", \"separator\");\n    this.setAttribute(\"aria-orientation\", vertical ? \"vertical\" : \"horizontal\");\n    const labeled = this.$(\".labeled\");\n    const showLabel = Boolean(this.label) && !vertical;\n    labeled.hidden = !showLabel;\n    labeled.textContent = this.label ?? \"\";\n    this.$(\".line\").hidden = showLabel;\n  }\n}\n\ndefine(\"ray-separator\", RaySeparator);\n";
const F51: string = "// <ray-sidebar>: the side navigation of an app shell (shadcn's Sidebar).\n// Header, content and footer slots; on wide screens a panel that can\n// collapse to an icon rail (`collapsed`); below `breakpoint` an off-canvas\n// drawer (`open`): a modal <dialog> sliding in from its side, with focus\n// trapped, Escape and backdrop click closing it.\n//\n// toggle() does the right thing for the screen: collapse/expand on wide\n// screens, open/close the drawer on narrow ones — wire it to a menu button.\n//\n// <ray-sidebar-group label=\"Projects\">: a titled section of nav links; the\n// title hides when the sidebar collapses.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { overlayStyles } from \"../../core/styles.js\";\nimport { play, playAll } from \"../../core/motion.js\";\n\nconst styles = css`\n  :host {\n    --_w: 16rem;\n    --_rail: 3.5rem;\n    display: block;\n    flex: none;\n    width: var(--_w);\n    height: 100%;\n    min-height: 0;\n    transition: width var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  :host([collapsed]:not([data-mobile])) { width: var(--_rail); }\n  :host([data-mobile]) { width: 0; }\n  .panel {\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    color: var(--ray-foreground);\n    background: var(--ray-sidebar, color-mix(in srgb, var(--ray-muted) 70%, var(--ray-background)));\n    border-inline-end: 1px solid var(--ray-border);\n  }\n  :host([side=\"right\"]) .panel { border-inline-end: 0; border-inline-start: 1px solid var(--ray-border); }\n  :host([variant=\"floating\"]:not([data-mobile])) { padding: var(--ray-space-2); box-sizing: border-box; }\n  :host([variant=\"floating\"]) .panel { border: 1px solid var(--ray-border); border-radius: var(--ray-radius-lg); box-shadow: var(--ray-shadow-sm); }\n  .header, .footer { flex: none; padding: var(--ray-space-2); }\n  .header:not([data-filled]), .footer:not([data-filled]) { display: none; }\n  .content { flex: 1; min-height: 0; overflow-x: hidden; overflow-y: auto; padding: var(--ray-space-2); }\n\n  /* Narrow screens: the panel lives in a modal dialog at the edge. */\n  dialog {\n    --_from: -100%;\n    position: fixed;\n    inset: 0 auto 0 0;\n    box-sizing: border-box;\n    width: min(var(--_w), calc(100vw - 3rem));\n    max-width: none;\n    height: 100dvh;\n    max-height: none;\n    margin: 0;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    overflow: visible;\n  }\n  :host([side=\"right\"]) dialog { inset: 0 0 0 auto; }\n  dialog[open] { display: block; animation: ray-sidebar-in var(--ray-duration-slow) var(--ray-easing-out); }\n  dialog .panel { box-shadow: var(--ray-shadow-xl); background: var(--ray-card); }\n  @keyframes ray-sidebar-in { from { transform: translateX(var(--_from)); } }\n  :host([side=\"right\"]) dialog { --_from: 100%; }\n  dialog::backdrop { animation: ray-fade-in var(--ray-duration-base) var(--ray-easing-out); }\n  @keyframes ray-fade-in { from { opacity: 0; } }\n`;\n\nexport class RaySidebar extends RayElement {\n  static properties = {\n    collapsed: { type: Boolean, reflect: true },\n    open: { type: Boolean, reflect: true },\n    side: { type: String, reflect: true, default: \"left\" },\n    variant: { type: String, reflect: true, default: \"sidebar\" },\n    width: { type: String },\n    collapsedWidth: { type: String },\n    breakpoint: { type: String, default: \"48em\" },\n    label: { type: String, default: \"Sidebar\" },\n  };\n  static styles = [overlayStyles, styles];\n  static template = `\n    <div class=\"panel\" part=\"panel\">\n      <div class=\"header\" part=\"header\"><slot name=\"header\"></slot></div>\n      <nav class=\"content\" part=\"content\"><slot></slot></nav>\n      <div class=\"footer\" part=\"footer\"><slot name=\"footer\"></slot></div>\n    </div>\n    <dialog part=\"drawer\"></dialog>`;\n\n  #mq = null;\n  #exit = null;\n\n  constructor() {\n    super();\n    this.panel = this.$(\".panel\");\n    this.dialog = this.$(\"dialog\");\n    for (const name of [\"header\", \"footer\"]) {\n      const slot = this.$(`slot[name=\"\${name}\"]`);\n      slot.addEventListener(\"slotchange\", () => slot.parentElement.toggleAttribute(\"data-filled\", slot.assignedNodes().length > 0));\n    }\n    this.dialog.addEventListener(\"cancel\", (e) => {\n      e.preventDefault();\n      this.open = false;\n    });\n    this.dialog.addEventListener(\"close\", () => {\n      if (this.open) this.commitProperty(\"open\", false);\n    });\n    // A click on the backdrop (outside the panel) closes the drawer.\n    this.dialog.addEventListener(\"click\", (e) => {\n      if (e.target === this.dialog) this.open = false;\n    });\n    // Following a link closes the drawer.\n    this.addEventListener(\"click\", (e) => {\n      if (!this.mobile || !this.open) return;\n      const link = e.composedPath().find((n) => n.localName === \"a\" && n.href);\n      if (link) this.open = false;\n    });\n    // New nav links and groups pick up the collapsed state.\n    this.$(\".content slot\").addEventListener(\"slotchange\", () => this._syncCollapsed());\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    this._watch();\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    this.#mq?.removeEventListener(\"change\", this._onMedia);\n    this.#mq = null;\n    if (this.dialog.open) this.dialog.close();\n  }\n\n  /** Whether the sidebar is in its narrow-screen (drawer) mode. */\n  get mobile() {\n    return this.hasAttribute(\"data-mobile\");\n  }\n\n  /** Collapses/expands on wide screens; opens/closes the drawer on narrow ones. */\n  toggle() {\n    if (this.mobile) this.open = !this.open;\n    else this.collapsed = !this.collapsed;\n    this.emit(\"ray-toggle\", { collapsed: Boolean(this.collapsed), open: Boolean(this.open), mobile: this.mobile });\n  }\n\n  _watch() {\n    this.#mq?.removeEventListener(\"change\", this._onMedia);\n    this.#mq = matchMedia(`(max-width: \${this.breakpoint || \"48em\"})`);\n    this._onMedia = () => this._setMobile(this.#mq.matches);\n    this.#mq.addEventListener(\"change\", this._onMedia);\n    this._setMobile(this.#mq.matches);\n  }\n\n  _setMobile(on) {\n    this.toggleAttribute(\"data-mobile\", on);\n    if (on) {\n      if (this.panel.parentNode !== this.dialog) this.dialog.append(this.panel);\n      if (this.open && !this.dialog.open) this._show();\n    } else {\n      if (this.dialog.open) this.dialog.close();\n      if (this.panel.parentNode !== this.shadowRoot) this.shadowRoot.prepend(this.panel);\n      if (this.open) this.commitProperty(\"open\", false);\n    }\n    this._syncCollapsed();\n  }\n\n  update(changed) {\n    if (this.width) this.style.setProperty(\"--_w\", this.width);\n    else this.style.removeProperty(\"--_w\");\n    if (this.collapsedWidth) this.style.setProperty(\"--_rail\", this.collapsedWidth);\n    else this.style.removeProperty(\"--_rail\");\n    this.$(\".content\").setAttribute(\"aria-label\", this.label ?? \"Sidebar\");\n    if (changed.has(\"breakpoint\") && this.isConnected) this._watch();\n    if (changed.has(\"collapsed\")) this._syncCollapsed();\n    if (changed.has(\"open\") && this.mobile) {\n      if (this.open && this.#exit) {\n        this.#exit.cancel();\n        this.#exit = null;\n      } else if (this.open && !this.dialog.open) {\n        this._show();\n      } else if (!this.open && this.dialog.open && !this.#exit) {\n        this._leave();\n      }\n    }\n  }\n\n  _show() {\n    this.dialog.showModal();\n    this.emit(\"ray-open\");\n  }\n\n  async _leave() {\n    const to = this.side === \"right\" ? \"translateX(100%)\" : \"translateX(-100%)\";\n    const exit = playAll([\n      play(this.dialog, [{ transform: \"none\" }, { transform: to }]),\n      play(this.dialog, [{ opacity: 1 }, { opacity: 0 }], { pseudoElement: \"::backdrop\" }),\n    ]);\n    this.#exit = exit;\n    await exit.finished;\n    if (this.#exit !== exit) return;\n    this.#exit = null;\n    if (!this.open && this.dialog.open) this.dialog.close();\n    exit.cancel();\n    this.emit(\"ray-close\");\n  }\n\n  // The rail shows icons only: nav links and group titles follow.\n  _syncCollapsed() {\n    const rail = Boolean(this.collapsed) && !this.mobile;\n    for (const el of this.querySelectorAll(\"ray-nav-link\")) el.iconOnly = rail;\n    for (const el of this.querySelectorAll(\"ray-sidebar-group\")) el.toggleAttribute(\"collapsed\", rail);\n  }\n}\n\nconst groupStyles = css`\n  :host { display: block; }\n  :host(:not(:first-child)) { margin-top: var(--ray-space-3); }\n  .label {\n    display: block;\n    height: 1.75rem;\n    padding: 0 var(--ray-space-3);\n    font-size: var(--ray-font-size-xs);\n    font-weight: var(--ray-font-weight-medium);\n    line-height: 1.75rem;\n    color: var(--ray-muted-foreground);\n    white-space: nowrap;\n    overflow: hidden;\n    transition: opacity var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  .label:empty { display: none; }\n  /* Collapsed: the title fades but keeps its height, so icons do not jump. */\n  :host([collapsed]) .label { opacity: 0; }\n  .items { display: grid; gap: 2px; }\n`;\n\nexport class RaySidebarGroup extends RayElement {\n  static properties = {\n    label: { type: String },\n  };\n  static styles = [groupStyles];\n  static template = `<div class=\"label\" part=\"label\" id=\"label\"></div><div class=\"items\" part=\"items\" role=\"group\" aria-labelledby=\"label\"><slot></slot></div>`;\n\n  update() {\n    this.$(\".label\").textContent = this.label ?? \"\";\n  }\n}\n\ndefine(\"ray-sidebar\", RaySidebar);\ndefine(\"ray-sidebar-group\", RaySidebarGroup);\n";
const F52: string = "// <ray-skeleton>: a placeholder shown while content loads (Mantine's\n// Skeleton). A shimmering block, a circle, or a few text lines; with the\n// `loaded` attribute it shows its slotted content instead.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst RADII = [\"xs\", \"sm\", \"md\", \"lg\", \"xl\", \"full\"];\n\nconst styles = css`\n  :host {\n    display: block;\n    --_w: 100%;\n    --_h: 1rem;\n    --_r: var(--ray-radius-sm);\n    /* Visible on the page and on cards in both schemes; the sweep moves\n       toward the background color. */\n    --_base: color-mix(in srgb, var(--ray-muted) 45%, var(--ray-border));\n    --_shine: color-mix(in srgb, var(--_base) 45%, var(--ray-background));\n  }\n  :host([hidden]) { display: none; }\n  :host([circle]) { --_r: 50%; --_w: 2.5rem; }\n  :host([circle]) { width: max-content; }\n  .bones { display: grid; gap: var(--ray-space-2); width: var(--_w); }\n  .bone {\n    height: var(--_h);\n    border-radius: var(--_r);\n    background: var(--_base);\n  }\n  :host([circle]) .bones { width: var(--_w); }\n  :host([circle]) .bone { width: var(--_w); height: var(--_w); }\n  :host([lines]) .bone:last-child:not(:first-child) { width: 70%; }\n  /* animation: shimmer (default) | pulse | none. Not \"animate\": that would\n     shadow Element.prototype.animate(). */\n  :host(:not([animation])) .bone, :host([animation=\"shimmer\"]) .bone {\n    background: linear-gradient(90deg, var(--_base) 25%, var(--_shine) 50%, var(--_base) 75%) 0 0 / 300% 100%;\n    animation: ray-skeleton-shine 1.6s var(--ray-easing-standard) infinite;\n  }\n  :host([animation=\"pulse\"]) .bone { animation: ray-skeleton-pulse 1.6s var(--ray-easing-standard) infinite; }\n  @keyframes ray-skeleton-shine { from { background-position: 100% 0; } to { background-position: 0 0; } }\n  @keyframes ray-skeleton-pulse { 50% { opacity: 0.45; } }\n  @media (prefers-reduced-motion: reduce) {\n    .bone { animation: none !important; background: var(--_base) !important; }\n  }\n  .content { display: none; }\n  :host([loaded]) .bones { display: none; }\n  :host([loaded]) .content { display: contents; }\n`;\n\nconst length = (v) => (/^-?\\d+(\\.\\d+)?$/.test(String(v)) ? `\${v}px` : String(v));\n\nexport class RaySkeleton extends RayElement {\n  static properties = {\n    width: { type: String },\n    height: { type: String },\n    radius: { type: String, reflect: true },\n    circle: { type: Boolean, reflect: true },\n    lines: { type: Number, reflect: true },\n    animation: { type: String, reflect: true },\n    loaded: { type: Boolean, reflect: true },\n  };\n  static styles = [styles];\n  static template = `<div class=\"bones\" part=\"skeleton\" aria-hidden=\"true\"></div><div class=\"content\"><slot></slot></div>`;\n\n  update() {\n    const s = this.style;\n    // A circle's diameter: width, else height.\n    const w = this.width || (this.circle ? this.height : \"\");\n    if (w) s.setProperty(\"--_w\", length(w));\n    else s.removeProperty(\"--_w\");\n    if (this.height) s.setProperty(\"--_h\", length(this.height));\n    else s.removeProperty(\"--_h\");\n    if (this.radius && !this.circle) s.setProperty(\"--_r\", RADII.includes(this.radius) ? `var(--ray-radius-\${this.radius})` : length(this.radius));\n    else s.removeProperty(\"--_r\");\n    const n = this.circle ? 1 : Math.max(1, Math.floor(this.lines || 1));\n    const bones = this.$(\".bones\");\n    if (bones.children.length !== n) {\n      bones.replaceChildren(...Array.from({ length: n }, () => {\n        const b = document.createElement(\"div\");\n        b.className = \"bone\";\n        b.setAttribute(\"part\", \"bone\");\n        return b;\n      }));\n    }\n    // Screen readers: busy while the placeholder stands in for the content.\n    if (this.loaded) this.removeAttribute(\"aria-busy\");\n    else this.setAttribute(\"aria-busy\", \"true\");\n  }\n}\n\ndefine(\"ray-skeleton\", RaySkeleton);\n";
const F53: string = "// <ray-slider>: a range input (native, so keyboard, touch and screen readers\n// work as usual) with label, description, value display and marks.\n// Form-associated.\n\nimport { css, define } from \"../../core/core.js\";\nimport { applyColor, sizeStyles } from \"../../core/styles.js\";\nimport { FieldControl, fieldStyles } from \"../../core/form.js\";\n\nconst styles = css`\n  :host {\n    --_track: 0.375rem;\n    --_thumb: 1.125rem;\n  }\n  :host([size=\"xs\"]) { --_track: 0.25rem; --_thumb: 0.875rem; }\n  :host([size=\"md\"]) { --_track: 0.5rem; --_thumb: 1.375rem; }\n  :host([size=\"lg\"]) { --_track: 0.625rem; --_thumb: 1.625rem; }\n  :host([size=\"xl\"]) { --_track: 0.75rem; --_thumb: 1.875rem; }\n  .head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--ray-space-2); }\n  .value { font-size: calc(var(--_fs) - 0.0625rem); font-variant-numeric: tabular-nums; color: var(--ray-muted-foreground); }\n  .value[hidden] { display: none; }\n  .root { position: relative; padding: calc((var(--_thumb) - var(--_track)) / 2) 0; }\n  input {\n    display: block;\n    width: 100%;\n    height: var(--_thumb);\n    margin: calc((var(--_track) - var(--_thumb)) / 2) 0;\n    background: transparent;\n    -webkit-appearance: none;\n    appearance: none;\n    cursor: pointer;\n  }\n  input:disabled { cursor: not-allowed; }\n  input::-webkit-slider-runnable-track {\n    height: var(--_track);\n    border-radius: var(--ray-radius-full);\n    background: linear-gradient(to right, var(--_filled) var(--_pct), var(--ray-muted) var(--_pct));\n    box-shadow: inset 0 0 0 1px var(--ray-border);\n  }\n  input::-moz-range-track { height: var(--_track); border-radius: var(--ray-radius-full); background: var(--ray-muted); }\n  input::-moz-range-progress { height: var(--_track); border-radius: var(--ray-radius-full); background: var(--_filled); }\n  input::-webkit-slider-thumb {\n    -webkit-appearance: none;\n    width: var(--_thumb);\n    height: var(--_thumb);\n    margin-top: calc((var(--_track) - var(--_thumb)) / 2);\n    background: var(--ray-white);\n    border: 3px solid var(--_filled);\n    border-radius: 50%;\n    box-shadow: var(--ray-shadow-xs);\n  }\n  input::-moz-range-thumb {\n    width: var(--_thumb);\n    height: var(--_thumb);\n    background: var(--ray-white);\n    border: 3px solid var(--_filled);\n    border-radius: 50%;\n  }\n  input:focus-visible { outline: none; }\n  input:focus-visible::-webkit-slider-thumb { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: 2px; }\n  input:focus-visible::-moz-range-thumb { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: 2px; }\n  input:disabled { --_filled: var(--ray-border); }\n  .marks { position: relative; height: 1.25rem; margin: var(--ray-space-1) calc(var(--_thumb) / 2) 0; font-size: var(--ray-font-size-xs); color: var(--ray-muted-foreground); }\n  .marks:empty { display: none; }\n  .mark { position: absolute; transform: translateX(-50%); white-space: nowrap; }\n  .mark::before { content: \"\"; display: block; width: 1px; height: 0.25rem; margin: 0 auto 0.125rem; background: var(--ray-border); }\n`;\n\nexport class RaySlider extends FieldControl {\n  static properties = {\n    ...FieldControl.fieldProperties,\n    value: { type: Number },\n    min: { type: Number, default: 0 },\n    max: { type: Number, default: 100 },\n    step: { type: Number, default: 1 },\n    color: { type: String, reflect: true },\n    showValue: { type: Boolean, reflect: true },\n    unit: { type: String },\n    marks: { attribute: false },\n  };\n  static styles = [sizeStyles, fieldStyles, styles];\n  static template = `\n    <div class=\"head\">\n      <label class=\"label\" part=\"label\" for=\"control\" hidden><span class=\"label-text\"></span><span class=\"required\" aria-hidden=\"true\" hidden> *</span></label>\n      <span class=\"value\" part=\"value\" aria-hidden=\"true\" hidden></span>\n    </div>\n    <div class=\"description\" part=\"description\" id=\"description\" hidden></div>\n    <div class=\"root\" part=\"root\"><input id=\"control\" type=\"range\" part=\"input\"></div>\n    <div class=\"marks\" part=\"marks\"></div>\n    <div class=\"error\" part=\"error\" id=\"error\" hidden></div>`;\n\n  wire() {\n    this._default = this.getAttribute(\"value\");\n    this.control.addEventListener(\"input\", () => {\n      this.commitProperty(\"value\", Number(this.control.value));\n      this._commit();\n    });\n    this.control.addEventListener(\"change\", (e) => this.forward(e));\n  }\n\n  update(changed) {\n    const c = this.control;\n    c.min = String(this.min ?? 0);\n    c.max = String(this.max ?? 100);\n    c.step = String(this.step ?? 1);\n    if (this.value === undefined) this.commitProperty(\"value\", Number(c.value));\n    if (Number(c.value) !== this.value) c.value = String(this.value);\n    applyColor(this.$(\".root\"), this.color);\n    this.syncField();\n    if (changed.has(\"marks\") || changed.has(\"min\") || changed.has(\"max\") || !this._marked) this._renderMarks();\n    this._commit();\n  }\n\n  _commit() {\n    const c = this.control;\n    const min = Number(c.min);\n    const max = Number(c.max);\n    const pct = max > min ? ((Number(c.value) - min) / (max - min)) * 100 : 0;\n    c.style.setProperty(\"--_pct\", `\${pct}%`);\n    const text = `\${c.value}\${this.unit ?? \"\"}`;\n    const value = this.$(\".value\");\n    value.hidden = !this.showValue;\n    value.textContent = text;\n    if (this.unit) c.setAttribute(\"aria-valuetext\", text);\n    else c.removeAttribute(\"aria-valuetext\");\n    this.internals.setFormValue(c.value);\n    this.syncValidity();\n  }\n\n  _renderMarks() {\n    this._marked = true;\n    const box = this.$(\".marks\");\n    box.replaceChildren();\n    if (!Array.isArray(this.marks)) return;\n    const min = this.min ?? 0;\n    const max = this.max ?? 100;\n    for (const m of this.marks) {\n      const v = typeof m === \"number\" ? m : m.value;\n      const span = document.createElement(\"span\");\n      span.className = \"mark\";\n      span.style.left = `\${((v - min) / (max - min || 1)) * 100}%`;\n      span.textContent = typeof m === \"number\" ? String(m) : (m.label ?? String(m.value));\n      box.append(span);\n    }\n  }\n\n  formResetCallback() {\n    this.value = this._default === null ? undefined : Number(this._default);\n  }\n\n  formStateRestoreCallback(state) {\n    this.value = Number(state);\n  }\n}\n\ndefine(\"ray-slider\", RaySlider);\n";
const F54: string = "// <ray-spinner>: an indeterminate loading indicator (Mantine's Loader).\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor, loaderStyles, srOnlyStyles } from \"../../core/styles.js\";\n\nconst styles = css`\n  :host {\n    display: inline-flex;\n    vertical-align: middle;\n    --_loader: 2.25rem;\n  }\n  :host([size=\"xs\"]) { --_loader: 1.125rem; }\n  :host([size=\"sm\"]) { --_loader: 1.375rem; }\n  :host([size=\"lg\"]) { --_loader: 2.75rem; }\n  :host([size=\"xl\"]) { --_loader: 3.625rem; }\n  .loader { color: var(--_filled); }\n`;\n\nexport class RaySpinner extends RayElement {\n  static properties = {\n    color: { type: String, reflect: true },\n    size: { type: String, reflect: true, default: \"md\" },\n    label: { type: String, default: \"Loading\" },\n  };\n  static styles = [loaderStyles, srOnlyStyles, styles];\n  static template = `<span class=\"loader\" part=\"spinner\"></span><span class=\"sr-only\"></span>`;\n\n  connectedCallback() {\n    super.connectedCallback();\n    if (!this.hasAttribute(\"role\")) this.setAttribute(\"role\", \"status\");\n  }\n\n  update() {\n    applyColor(this.$(\".loader\"), this.color);\n    this.$(\".sr-only\").textContent = this.label;\n  }\n}\n\ndefine(\"ray-spinner\", RaySpinner);\n";
const F55: string = "// <ray-split>: two panes (slot=\"start\", slot=\"end\") with a draggable divider\n// (ray-sublime's sidebar and docks). The start pane has the size; the end\n// pane takes the rest.\n//\n// The divider is a focusable separator (WAI-ARIA window splitter): arrows\n// move it (Shift: faster), Home/End go to min/max, Enter collapses the start\n// pane. With `autosave=\"key\"` the size survives reloads (localStorage).\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst styles = css`\n  :host {\n    display: grid;\n    grid-template-columns: var(--_size) 0.375rem minmax(0, 1fr);\n    min-width: 0;\n    min-height: 0;\n    --_size: 50%;\n  }\n  :host([orientation=\"vertical\"]) { grid-template-columns: none; grid-template-rows: var(--_size) 0.375rem minmax(0, 1fr); }\n  .pane { min-width: 0; min-height: 0; overflow: auto; }\n  :host([collapsed]) .start { visibility: hidden; }\n  .divider {\n    position: relative;\n    z-index: 1;\n    margin: 0 -0.25rem;\n    cursor: col-resize;\n    touch-action: none;\n    outline: none;\n  }\n  :host([orientation=\"vertical\"]) .divider { margin: -0.25rem 0; cursor: row-resize; }\n  :host([disabled]) .divider { cursor: default; }\n  .divider::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    left: 50%;\n    width: 1px;\n    background: var(--ray-border);\n    transform: translateX(-50%);\n    transition: background-color var(--ray-duration-fast) var(--ray-easing-standard), width var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  :host([orientation=\"vertical\"]) .divider::before { top: 50%; bottom: auto; left: 0; right: 0; width: auto; height: 1px; transform: translateY(-50%); }\n  :host(:not([disabled])) .divider:hover::before,\n  .divider:focus-visible::before,\n  :host([data-dragging]) .divider::before { width: 3px; background: var(--ray-primary); }\n  :host([orientation=\"vertical\"]:not([disabled])) .divider:hover::before,\n  :host([orientation=\"vertical\"]) .divider:focus-visible::before,\n  :host([orientation=\"vertical\"][data-dragging]) .divider::before { width: auto; height: 3px; }\n  :host([data-dragging]) { user-select: none; cursor: col-resize; }\n  :host([data-dragging][orientation=\"vertical\"]) { cursor: row-resize; }\n`;\n\nconst STEP = 10;\nconst BIG_STEP = 50;\n\nexport class RaySplit extends RayElement {\n  static properties = {\n    orientation: { type: String, reflect: true, default: \"horizontal\" },\n    position: { type: String, default: \"50%\" },\n    min: { type: Number, default: 0 },\n    max: { type: Number },\n    collapsed: { type: Boolean, reflect: true },\n    disabled: { type: Boolean, reflect: true },\n    autosave: { type: String },\n  };\n  static styles = [styles];\n  static template = `\n    <div class=\"pane start\" part=\"start\" id=\"start\"><slot name=\"start\"></slot></div>\n    <div class=\"divider\" part=\"divider\" role=\"separator\" tabindex=\"0\" aria-controls=\"start\"></div>\n    <div class=\"pane end\" part=\"end\"><slot name=\"end\"></slot></div>`;\n\n  constructor() {\n    super();\n    this._px = null;\n    this.divider = this.$(\".divider\");\n    this.divider.addEventListener(\"pointerdown\", (e) => this._down(e));\n    this.divider.addEventListener(\"keydown\", (e) => this._key(e));\n    this.divider.addEventListener(\"dblclick\", () => this.toggle());\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    if (this._restored) return;\n    this._restored = true;\n    if (this.autosave) {\n      try {\n        const saved = Number(localStorage.getItem(`ray-split:\${this.autosave}`));\n        if (saved > 0) this._px = saved;\n      } catch {\n        // No storage: the default position is fine.\n      }\n    }\n  }\n\n  /** The start pane's current size in px. */\n  get size() {\n    return this.$(\".start\").getBoundingClientRect()[this._vertical() ? \"height\" : \"width\"];\n  }\n\n  /** Collapses or restores the start pane. */\n  toggle() {\n    this.collapsed = !this.collapsed;\n    this.emit(\"ray-resize\", { size: this.collapsed ? 0 : this.size, collapsed: this.collapsed });\n  }\n\n  update(changed) {\n    // A later change of `position` wins over a dragged/restored size; the\n    // first update (position from the markup) does not.\n    if (changed.has(\"position\") && this._updated) this._px = null;\n    this._updated = true;\n    const min = Math.max(0, this.min ?? 0);\n    const max = this.max ?? null;\n    let value;\n    if (this._px !== null) {\n      value = `\${this._clamp(this._px)}px`;\n    } else {\n      // A bare number is px; anything else (30%, 20rem) is CSS, clamped by min/max in CSS.\n      const pos = /^\\d+(\\.\\d+)?$/.test(this.position ?? \"\") ? `\${this.position}px` : (this.position || \"50%\");\n      value = `clamp(\${min}px, \${pos}, \${max === null ? \"100%\" : `\${max}px`})`;\n    }\n    // Inline on the host (it beats any :host rule): collapsed is decided here too.\n    this.style.setProperty(\"--_size\", this.collapsed ? \"0px\" : value);\n    const vertical = this._vertical();\n    // The separator line is perpendicular to the split direction.\n    this.divider.setAttribute(\"aria-orientation\", vertical ? \"horizontal\" : \"vertical\");\n    this.divider.setAttribute(\"aria-label\", this.getAttribute(\"aria-label\") ?? \"Resize\");\n    this.divider.tabIndex = this.disabled ? -1 : 0;\n    if (this.disabled) this.divider.setAttribute(\"aria-disabled\", \"true\");\n    else this.divider.removeAttribute(\"aria-disabled\");\n    queueMicrotask(() => this._aria());\n  }\n\n  _vertical() {\n    return this.orientation === \"vertical\";\n  }\n\n  _total() {\n    const r = this.getBoundingClientRect();\n    return this._vertical() ? r.height : r.width;\n  }\n\n  _clamp(px) {\n    const total = this._total();\n    const max = Math.min(this.max ?? Infinity, total > 0 ? total : Infinity);\n    return Math.round(Math.max(this.min ?? 0, Math.min(px, max)));\n  }\n\n  _aria() {\n    const total = this._total();\n    const now = total > 0 ? Math.round((this.collapsed ? 0 : this.size) / total * 100) : 0;\n    this.divider.setAttribute(\"aria-valuemin\", \"0\");\n    this.divider.setAttribute(\"aria-valuemax\", \"100\");\n    this.divider.setAttribute(\"aria-valuenow\", String(now));\n  }\n\n  _resizeTo(px, commit) {\n    this._px = this._clamp(px);\n    if (this.collapsed) this.collapsed = false;\n    this.requestUpdate();\n    if (commit) {\n      if (this.autosave) {\n        try {\n          localStorage.setItem(`ray-split:\${this.autosave}`, String(this._px));\n        } catch {\n          // Not persisted: fine.\n        }\n      }\n      this.emit(\"ray-resize\", { size: this._px, collapsed: false });\n    }\n  }\n\n  _down(e) {\n    if (this.disabled || e.button !== 0) return;\n    e.preventDefault();\n    this.divider.focus();\n    try {\n      this.divider.setPointerCapture(e.pointerId);\n    } catch {\n      // The pointer is already gone (e.g. a canceled touch): drag without capture.\n    }\n    this.setAttribute(\"data-dragging\", \"\");\n    const rect = this.getBoundingClientRect();\n    const vertical = this._vertical();\n    const move = (ev) => this._resizeTo(vertical ? ev.clientY - rect.top : ev.clientX - rect.left, false);\n    const up = (ev) => {\n      this.divider.removeEventListener(\"pointermove\", move);\n      this.divider.removeEventListener(\"pointerup\", up);\n      this.divider.removeEventListener(\"pointercancel\", up);\n      this.removeAttribute(\"data-dragging\");\n      this._resizeTo(vertical ? ev.clientY - rect.top : ev.clientX - rect.left, true);\n    };\n    this.divider.addEventListener(\"pointermove\", move);\n    this.divider.addEventListener(\"pointerup\", up);\n    this.divider.addEventListener(\"pointercancel\", up);\n  }\n\n  _key(e) {\n    if (this.disabled) return;\n    const vertical = this._vertical();\n    const step = e.shiftKey ? BIG_STEP : STEP;\n    const current = this.collapsed ? 0 : this.size;\n    const less = vertical ? \"ArrowUp\" : \"ArrowLeft\";\n    const more = vertical ? \"ArrowDown\" : \"ArrowRight\";\n    let next = null;\n    if (e.key === less) next = current - step;\n    else if (e.key === more) next = current + step;\n    else if (e.key === \"Home\") next = this.min ?? 0;\n    else if (e.key === \"End\") next = this.max ?? this._total();\n    else if (e.key === \"Enter\") {\n      e.preventDefault();\n      this.toggle();\n      return;\n    }\n    if (next === null) return;\n    e.preventDefault();\n    this._resizeTo(next, true);\n  }\n}\n\ndefine(\"ray-split\", RaySplit);\n";
const F56: string = "// <ray-stack>: its children in a column, spaced by the space scale\n// (Mantine's Stack). <ray-group>: the same in a row.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { spaceValue } from \"../../core/styles.js\";\n\nconst ALIGN = { start: \"flex-start\", center: \"center\", end: \"flex-end\", stretch: \"stretch\", baseline: \"baseline\" };\nconst JUSTIFY = { start: \"flex-start\", center: \"center\", end: \"flex-end\", \"space-between\": \"space-between\", \"space-around\": \"space-around\", \"space-evenly\": \"space-evenly\" };\n\nconst styles = css`\n  :host {\n    --_gap: var(--ray-space-md);\n    display: flex;\n    flex-direction: column;\n    gap: var(--_gap);\n    align-items: var(--_align, stretch);\n    justify-content: var(--_justify, flex-start);\n    min-width: 0;\n  }\n  :host([hidden]) { display: none; }\n`;\n\n/** Gap, align and justify onto the host's custom properties. */\nexport function applyFlex(el, { gap, align, justify }, alignDefault) {\n  const g = spaceValue(gap);\n  if (g) el.style.setProperty(\"--_gap\", g);\n  else el.style.removeProperty(\"--_gap\");\n  el.style.setProperty(\"--_align\", ALIGN[align] ?? alignDefault);\n  el.style.setProperty(\"--_justify\", JUSTIFY[justify] ?? \"flex-start\");\n}\n\nexport class RayStack extends RayElement {\n  static properties = {\n    gap: { type: String, reflect: true, default: \"md\" },\n    align: { type: String, reflect: true, default: \"stretch\" },\n    justify: { type: String, reflect: true, default: \"start\" },\n  };\n  static styles = [styles];\n  static template = `<slot></slot>`;\n\n  update() {\n    applyFlex(this, this, \"stretch\");\n  }\n}\n\ndefine(\"ray-stack\", RayStack);\n";
const F57: string = "// <ray-stat>: a metric tile — label, big value, change against a previous\n// period and a note (the tiles of rayauth's dashboard).\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst styles = css`\n  :host { display: block; }\n  .root {\n    display: grid;\n    gap: var(--ray-space-1);\n    padding: var(--ray-space-md);\n    color: var(--ray-card-foreground);\n    background: var(--ray-card);\n    border: 1px solid var(--ray-border);\n    border-radius: var(--ray-radius-default);\n  }\n  :host([plain]) .root { padding: 0; border: 0; background: transparent; }\n  .head { display: flex; align-items: center; justify-content: space-between; gap: var(--ray-space-2); }\n  .label { font-size: var(--ray-font-size-xs); font-weight: var(--ray-font-weight-semibold); text-transform: uppercase; letter-spacing: 0.04em; color: var(--ray-muted-foreground); }\n  .icon { display: inline-flex; color: var(--ray-muted-foreground); }\n  ::slotted(svg) { width: 1.25rem; height: 1.25rem; }\n  .line { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--ray-space-2); }\n  .value { font-size: var(--ray-font-size-2xl); font-weight: var(--ray-font-weight-bold); line-height: var(--ray-line-height-tight); font-variant-numeric: tabular-nums; }\n  .diff { display: inline-flex; align-items: center; gap: 0.125rem; font-size: var(--ray-font-size-sm); font-weight: var(--ray-font-weight-semibold); }\n  .diff[data-trend=\"up\"] { color: var(--ray-success); }\n  .diff[data-trend=\"down\"] { color: var(--ray-destructive); }\n  .diff[data-trend=\"flat\"] { color: var(--ray-muted-foreground); }\n  :host([inverse]) .diff[data-trend=\"up\"] { color: var(--ray-destructive); }\n  :host([inverse]) .diff[data-trend=\"down\"] { color: var(--ray-success); }\n  .diff { --ray-icon-stroke: 2.5; }\n  .diff svg { width: 0.875rem; height: 0.875rem; }\n  .note { font-size: var(--ray-font-size-xs); color: var(--ray-muted-foreground); }\n  [hidden] { display: none !important; }\n`;\n\n// Icon of each trend (from the icon registry).\nconst ARROWS = { up: \"arrow-up-right\", down: \"arrow-down-right\", flat: \"minus\" };\n\nexport class RayStat extends RayElement {\n  static properties = {\n    label: { type: String },\n    value: { type: String },\n    diff: { type: Number },\n    diffUnit: { type: String, default: \"%\" },\n    note: { type: String },\n    inverse: { type: Boolean, reflect: true },\n    plain: { type: Boolean, reflect: true },\n  };\n  static styles = [styles];\n  static template = `\n    <div class=\"root\" part=\"root\">\n      <div class=\"head\"><span class=\"label\" part=\"label\"></span><span class=\"icon\" part=\"icon\"><slot name=\"icon\"></slot></span></div>\n      <div class=\"line\"><span class=\"value\" part=\"value\"></span><span class=\"diff\" part=\"diff\" hidden></span></div>\n      <div class=\"note\" part=\"note\" hidden></div>\n      <slot></slot>\n    </div>`;\n\n  update() {\n    this.$(\".label\").textContent = this.label ?? \"\";\n    this.$(\".value\").textContent = this.value ?? \"\";\n    const diff = this.$(\".diff\");\n    const has = typeof this.diff === \"number\" && !Number.isNaN(this.diff);\n    diff.hidden = !has;\n    if (has) {\n      const trend = this.diff > 0 ? \"up\" : this.diff < 0 ? \"down\" : \"flat\";\n      diff.dataset.trend = trend;\n      const sign = this.diff > 0 ? \"+\" : \"\";\n      diff.innerHTML = `<span data-ray-icon=\"\${ARROWS[trend]}\" aria-hidden=\"true\"></span>`;\n      this.paintIcons(diff);\n      diff.append(`\${sign}\${this.diff}\${this.diffUnit ?? \"\"}`);\n      diff.setAttribute(\"aria-label\", `\${trend === \"up\" ? \"Up\" : trend === \"down\" ? \"Down\" : \"No change\"} \${Math.abs(this.diff)}\${this.diffUnit ?? \"\"}`);\n    }\n    const note = this.$(\".note\");\n    note.hidden = !this.note;\n    note.textContent = this.note ?? \"\";\n  }\n}\n\ndefine(\"ray-stat\", RayStat);\n";
const F58: string = "// <ray-statusbar> + <ray-statusbar-item>: the bar at the bottom of an editor\n// window (ray-sublime): items on the left, items on the right (slot=\"right\").\n// An item with `action` is a button; the others are plain text.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor } from \"../../core/styles.js\";\n\nconst barStyles = css`\n  :host {\n    display: flex;\n    align-items: stretch;\n    justify-content: space-between;\n    gap: var(--ray-space-4);\n    min-height: 1.5rem;\n    padding: 0 var(--ray-space-2);\n    font-size: var(--ray-font-size-xs);\n    color: var(--ray-muted-foreground);\n    background: var(--ray-muted);\n    border-top: 1px solid var(--ray-border);\n    user-select: none;\n  }\n  :host([variant=\"accent\"]) {\n    color: var(--ray-primary-foreground);\n    background: var(--ray-primary);\n    border-top-color: transparent;\n    /* Inherited by the items (no :host-context() in WebKit/Firefox). */\n    --_item-hover: rgb(255 255 255 / 0.15);\n    --_item-hover-color: var(--ray-primary-foreground);\n  }\n  .side { display: flex; align-items: stretch; gap: 0.125rem; min-width: 0; }\n`;\n\nexport class RayStatusbar extends RayElement {\n  static properties = {\n    variant: { type: String, reflect: true, default: \"default\" },\n  };\n  static styles = [barStyles];\n  static template = `<div class=\"side\" part=\"left\"><slot></slot></div><div class=\"side\" part=\"right\"><slot name=\"right\"></slot></div>`;\n\n  constructor() {\n    super();\n    this.attachInternals().role = \"group\";\n  }\n\n  update() {\n    if (!this.hasAttribute(\"aria-label\")) this.setAttribute(\"aria-label\", \"Status bar\");\n  }\n}\n\nconst itemStyles = css`\n  :host { display: inline-flex; min-width: 0; }\n  .item {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--ray-space-1);\n    min-width: 0;\n    padding: 0 var(--ray-space-2);\n    font: inherit;\n    color: inherit;\n    white-space: nowrap;\n    background: transparent;\n    border: 0;\n    border-radius: var(--ray-radius-sm);\n  }\n  .label { overflow: hidden; text-overflow: ellipsis; }\n  button.item { cursor: pointer; }\n  button.item:hover { color: var(--_item-hover-color, var(--ray-foreground)); background: var(--_item-hover, var(--ray-accent)); }\n  :host([color]) .item { color: var(--_light-color); }\n  .icon { display: inline-flex; }\n  .icon:not([data-filled]) { display: none; }\n  ::slotted(svg) { width: 0.875rem; height: 0.875rem; }\n`;\n\nexport class RayStatusbarItem extends RayElement {\n  static delegatesFocus = true;\n  static properties = {\n    action: { type: Boolean, reflect: true },\n    color: { type: String, reflect: true },\n    label: { type: String },\n  };\n  static styles = [itemStyles];\n\n  update() {\n    const tag = this.action ? \"button\" : \"span\";\n    if (!this._el || this._el.localName !== tag) {\n      this._el?.remove();\n      const el = document.createElement(tag);\n      el.className = \"item focus-ring\";\n      el.setAttribute(\"part\", \"item\");\n      if (tag === \"button\") el.type = \"button\";\n      el.innerHTML = `<span class=\"icon\"><slot name=\"icon\"></slot></span><span class=\"label\"><slot></slot></span>`;\n      const slot = el.querySelector('slot[name=\"icon\"]');\n      slot.addEventListener(\"slotchange\", () => slot.parentElement.toggleAttribute(\"data-filled\", slot.assignedNodes().length > 0));\n      this.shadowRoot.append(el);\n      this._el = el;\n    }\n    if (this.color) applyColor(this, this.color);\n    // The label names a button whose content is only an icon or a short count.\n    if (this.label) {\n      this._el.setAttribute(\"aria-label\", this.label);\n      this._el.title = this.label;\n    } else {\n      this._el.removeAttribute(\"aria-label\");\n      this._el.removeAttribute(\"title\");\n    }\n  }\n}\n\ndefine(\"ray-statusbar\", RayStatusbar);\ndefine(\"ray-statusbar-item\", RayStatusbarItem);\n";
const F59: string = "// <ray-stepper> + <ray-step>: a task in steps (Mantine's Stepper): a\n// wizard, a checkout, an onboarding. The stepper draws the steps (number\n// or icon, label, description, connector) and shows the content of the\n// active one; past the last step, the `completed` slot.\n//\n// `active` is the index; next() and prev() move it. With\n// allow-step-select the user can go back to a completed step (and forward\n// to any with `linear` off): change fires. A step can be loading, in error\n// or skippable (an optional label).\n\nimport { RayElement, css, define, uid } from \"../../core/core.js\";\nimport { applyColor } from \"../../core/styles.js\";\n\nconst stepperStyles = css`\n  :host { display: block; --_icon: 2.25rem; }\n  :host([hidden]) { display: none; }\n  :host([size=\"sm\"]) { --_icon: 1.75rem; }\n  :host([size=\"lg\"]) { --_icon: 2.75rem; }\n  .steps { display: flex; align-items: flex-start; gap: var(--ray-space-2); margin: 0; padding: 0; list-style: none; }\n  :host([orientation=\"vertical\"]) { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--ray-space-6); }\n  :host([orientation=\"vertical\"]) .steps { flex-direction: column; gap: 0; }\n  .step { display: flex; flex: 1 1 0; align-items: center; gap: var(--ray-space-2); min-width: 0; }\n  .step:last-child { flex: 0 0 auto; }\n  :host([orientation=\"vertical\"]) .step { flex-direction: column; align-items: stretch; flex: none; }\n  .head {\n    display: flex;\n    align-items: center;\n    gap: var(--ray-space-3);\n    min-width: 0;\n    padding: 0;\n    font: inherit;\n    color: inherit;\n    text-align: left;\n    background: none;\n    border: 0;\n    border-radius: var(--ray-radius-md);\n  }\n  button.head { cursor: pointer; }\n  button.head:focus-visible { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: 3px; }\n  .indicator {\n    flex: none;\n    box-sizing: border-box;\n    display: grid;\n    place-items: center;\n    width: var(--_icon);\n    height: var(--_icon);\n    font-size: calc(var(--_icon) * 0.4);\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n    color: var(--ray-muted-foreground);\n    background: var(--ray-muted);\n    border: 2px solid var(--ray-muted);\n    border-radius: 50%;\n    transition: background-color var(--ray-duration-base), border-color var(--ray-duration-base), color var(--ray-duration-base);\n    --ray-icon-size: calc(var(--_icon) * 0.5);\n    --ray-icon-stroke: 2.5;\n  }\n  .step[data-state=\"active\"] .indicator { color: var(--_light-color); background: var(--ray-background); border-color: var(--_filled); }\n  .step[data-state=\"done\"] .indicator { color: var(--_contrast); background: var(--_filled); border-color: var(--_filled); }\n  .step[data-error] .indicator { color: #fff; background: var(--ray-red-filled); border-color: var(--ray-red-filled); }\n  .spinner { width: 50%; height: 50%; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: ray-step-spin 0.8s linear infinite; }\n  @keyframes ray-step-spin { to { rotate: 1turn; } }\n  .text { display: grid; min-width: 0; }\n  .label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--ray-font-size-sm); font-weight: var(--ray-font-weight-medium); }\n  .step[data-state=\"todo\"] .label { color: var(--ray-muted-foreground); }\n  .description { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--ray-font-size-xs); color: var(--ray-muted-foreground); }\n  .step[data-error] .description { color: var(--ray-destructive); }\n  .description:empty { display: none; }\n  .connector { flex: 1; min-width: var(--ray-space-4); height: 2px; border-radius: 1px; background: var(--ray-border); transition: background-color var(--ray-duration-base); }\n  .step[data-state=\"done\"] .connector { background: var(--_filled); }\n  .step:last-child .connector { display: none; }\n  :host([orientation=\"vertical\"]) .connector { flex: none; width: 2px; min-width: 0; height: auto; min-height: var(--ray-space-6); margin: var(--ray-space-1) 0 var(--ray-space-1) calc(var(--_icon) / 2 - 1px); }\n  /* Narrow (labels-below or a narrow stepper): the labels under the numbers. */\n  :host([icon-position=\"top\"]) .step { align-items: flex-start; }\n  :host([icon-position=\"top\"]) .head { flex-direction: column; align-items: center; text-align: center; gap: var(--ray-space-1); }\n  :host([icon-position=\"top\"]) .connector { margin-top: calc(var(--_icon) / 2 - 1px); }\n  .content { padding-top: var(--ray-space-5); min-width: 0; }\n  :host([orientation=\"vertical\"]) .content { padding-top: 0; }\n  ::slotted(ray-step:not([data-active])) { display: none; }\n  .completed:not([data-show]) { display: none; }\n  @media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 2s; } }\n`;\n\nconst glyph = (name) => {\n  const span = document.createElement(\"span\");\n  span.setAttribute(\"data-ray-icon\", name);\n  return span;\n};\n\nexport class RayStepper extends RayElement {\n  static properties = {\n    active: { type: Number, reflect: true, default: 0 },\n    orientation: { type: String, reflect: true, default: \"horizontal\" },\n    iconPosition: { type: String, reflect: true, attribute: \"icon-position\", default: \"left\" },\n    allowStepSelect: { type: Boolean, reflect: true, attribute: \"allow-step-select\" },\n    linear: { type: Boolean, default: true },\n    size: { type: String, reflect: true, default: \"md\" },\n    color: { type: String, reflect: true },\n    label: { type: String, default: \"Progress\" },\n  };\n  static styles = [stepperStyles];\n  static template = `<ol class=\"steps\" part=\"steps\"></ol><div class=\"content\" part=\"content\"><slot></slot><div class=\"completed\" part=\"completed\"><slot name=\"completed\"></slot></div></div>`;\n\n  #id = uid(\"stepper\");\n\n  constructor() {\n    super();\n    this.$(\"slot:not([name])\").addEventListener(\"slotchange\", () => this.requestUpdate());\n    this.$(\".steps\").addEventListener(\"click\", (e) => {\n      const head = e.target.closest?.(\"button.head\");\n      if (head) this._select(Number(head.dataset.index));\n    });\n  }\n\n  /** The steps, in order. */\n  get steps() {\n    return [...this.children].filter((el) => el.localName === \"ray-step\");\n  }\n\n  /** Moves to the next step (past the last: the completed slot). */\n  next() {\n    this._go(Math.min((this.active ?? 0) + 1, this.steps.length));\n  }\n\n  /** Moves to the previous step. */\n  prev() {\n    this._go(Math.max((this.active ?? 0) - 1, 0));\n  }\n\n  _go(i) {\n    if (i === this.active) return;\n    this.active = i;\n    this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n  }\n\n  _selectable(i) {\n    const steps = this.steps;\n    const active = this.active ?? 0;\n    if (!this.allowStepSelect || i === active || i >= steps.length || steps[i].disabled) return false;\n    return i < active || this.linear === false;\n  }\n\n  _select(i) {\n    if (this._selectable(i)) this._go(i);\n  }\n\n  update() {\n    applyColor(this, this.color);\n    const steps = this.steps;\n    const active = Math.max(0, Math.min(this.active ?? 0, steps.length));\n    const list = this.$(\".steps\");\n    list.setAttribute(\"aria-label\", this.label || \"Progress\");\n    // The steps are redrawn: keep the focus on the same step.\n    const focused = this.shadowRoot.activeElement?.closest?.(\".head\")?.dataset.index;\n    list.replaceChildren();\n    steps.forEach((step, i) => {\n      const state = i < active ? \"done\" : i === active ? \"active\" : \"todo\";\n      const li = document.createElement(\"li\");\n      li.className = \"step\";\n      li.dataset.state = state;\n      li.toggleAttribute(\"data-error\", Boolean(step.error));\n      li.setAttribute(\"part\", `step step-\${state}`);\n      const selectable = this._selectable(i);\n      const head = document.createElement(selectable ? \"button\" : \"div\");\n      head.className = \"head\";\n      if (selectable) head.type = \"button\";\n      head.dataset.index = String(i);\n      if (state === \"active\") head.setAttribute(\"aria-current\", \"step\");\n      const indicator = document.createElement(\"span\");\n      indicator.className = \"indicator\";\n      indicator.setAttribute(\"part\", \"indicator\");\n      indicator.setAttribute(\"aria-hidden\", \"true\");\n      if (step.loading) indicator.innerHTML = `<span class=\"spinner\"></span>`;\n      else if (step.error) indicator.append(glyph(\"close\"));\n      else if (state === \"done\") indicator.append(glyph(step.completedIcon || \"check\"));\n      else if (step.icon) indicator.append(glyph(step.icon));\n      else indicator.textContent = String(i + 1);\n      const text = document.createElement(\"span\");\n      text.className = \"text\";\n      const label = document.createElement(\"span\");\n      label.className = \"label\";\n      label.setAttribute(\"part\", \"label\");\n      label.textContent = step.label ?? `Step \${i + 1}`;\n      const desc = document.createElement(\"span\");\n      desc.className = \"description\";\n      desc.setAttribute(\"part\", \"description\");\n      desc.textContent = step.error || step.description || \"\";\n      // Read as \"Step 2 of 4: Shipping, completed\".\n      const sr = document.createElement(\"span\");\n      sr.className = \"sr\";\n      sr.style.cssText = \"position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap\";\n      sr.textContent = `Step \${i + 1} of \${steps.length}: `;\n      const status = document.createElement(\"span\");\n      status.style.cssText = sr.style.cssText;\n      status.textContent = step.error ? \", error\" : state === \"done\" ? \", completed\" : state === \"active\" ? \", current\" : \"\";\n      label.prepend(sr);\n      label.append(status);\n      text.append(label, desc);\n      head.append(indicator, text);\n      const connector = document.createElement(\"span\");\n      connector.className = \"connector\";\n      connector.setAttribute(\"part\", \"connector\");\n      connector.setAttribute(\"aria-hidden\", \"true\");\n      li.append(head, connector);\n      list.append(li);\n      step.toggleAttribute(\"data-active\", i === active);\n      step.id ||= `\${this.#id}-\${i}`;\n    });\n    this.paintIcons(list);\n    if (focused !== undefined) {\n      const again = list.querySelector(`button.head[data-index=\"\${focused}\"]`) ?? list.querySelector('[aria-current=\"step\"]')?.closest(\"li\")?.querySelector(\"button.head\");\n      again?.focus();\n    }\n    this.$(\".completed\").toggleAttribute(\"data-show\", active >= steps.length && steps.length > 0);\n  }\n}\n\nexport class RayStep extends RayElement {\n  static properties = {\n    label: { type: String },\n    description: { type: String },\n    icon: { type: String },\n    completedIcon: { type: String, attribute: \"completed-icon\" },\n    loading: { type: Boolean, reflect: true },\n    error: { type: String },\n    disabled: { type: Boolean, reflect: true },\n  };\n  static styles = [css`:host { display: block; } :host([hidden]) { display: none; }`];\n  static template = `<slot></slot>`;\n\n  update() {\n    // The stepper draws the steps: tell it.\n    const stepper = this.parentElement;\n    if (stepper?.localName === \"ray-stepper\") stepper.requestUpdate();\n  }\n}\n\ndefine(\"ray-step\", RayStep);\ndefine(\"ray-stepper\", RayStepper);\n";
const F60: string = "// <ray-switch>: an on/off toggle. Same API as <ray-checkbox> (checked,\n// value, name, label…); announced as a switch.\n\nimport { css, define } from \"../../core/core.js\";\nimport { RayCheckbox, checkTemplate } from \"../checkbox/checkbox.js\";\n\nconst styles = css`\n  :host {\n    --_r: var(--ray-radius-full);\n    --_iw: calc(var(--_s) * 1.9);\n  }\n  .indicator {\n    position: relative;\n    justify-content: flex-start;\n    background: var(--ray-muted);\n    border-color: var(--ray-input);\n  }\n  .thumb {\n    position: absolute;\n    top: 50%;\n    left: 2px;\n    width: calc(var(--_s) - 6px);\n    height: calc(var(--_s) - 6px);\n    background: var(--ray-white);\n    border: 1px solid var(--ray-border);\n    border-radius: var(--_r);\n    box-shadow: var(--ray-shadow-xs);\n    transform: translateY(-50%);\n    transition: left var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  .control:checked + .indicator { background: var(--_filled); border-color: var(--_filled); }\n  /* The thumb takes the text color of the filled shade: white on dark fills,\n     black on light ones (yellow, or \"dark\" in the dark scheme). */\n  .control:checked + .indicator .thumb { left: calc(100% - var(--_s) + 4px); border-color: transparent; background: var(--_contrast); }\n  /* Disabled: a muted track (gray when on, like a disabled checkbox) and a\n     plain thumb that stays visible on it, on its side. */\n  .control:disabled + .indicator .thumb { background: var(--ray-background); border-color: var(--ray-border); box-shadow: none; }\n`;\n\nexport class RaySwitch extends RayCheckbox {\n  static styles = [...RayCheckbox.styles, styles];\n  static template = checkTemplate(`<span class=\"indicator\" part=\"track\" aria-hidden=\"true\"><span class=\"thumb\" part=\"thumb\"></span></span>`, `role=\"switch\"`);\n}\n\ndefine(\"ray-switch\", RaySwitch);\n";
const F61: string = "// <ray-table>: a data table rendered from `columns` and `data`.\n//\n//   table.columns = [\n//     { key: \"name\", label: \"Name\", sortable: true },\n//     { key: \"size\", label: \"Size\", align: \"right\", render: (row) => `\${row.size} KB` },\n//   ];\n//   table.data = [{ id: 1, name: \"main.ray\", size: 4 }, …];\n//\n// Cells are text (render() may also return a DOM node; strings are never\n// parsed as HTML). Sorting cycles asc -> desc -> none per column and is done\n// here unless `manual-sort` (then listen to ray-sort and pass sorted data).\n// With `selectable`, rows get checkboxes and `selection` holds their keys.\n// For plain server-rendered tables there is the .ray-table class in base.css.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst styles = css`\n  :host {\n    display: block;\n    --_py: var(--ray-space-2);\n    --_px: var(--ray-space-3);\n    font-size: var(--ray-font-size-sm);\n  }\n  :host([density=\"xs\"]) { --_py: 0.25rem; --_px: var(--ray-space-2); }\n  :host([density=\"md\"]) { --_py: var(--ray-space-3); }\n  :host([density=\"lg\"]) { --_py: var(--ray-space-4); --_px: var(--ray-space-4); }\n  .scroll { max-height: var(--ray-table-max-height, none); overflow: auto; }\n  :host([with-border]) .scroll { border: 1px solid var(--ray-border); border-radius: var(--ray-radius-default); }\n  table { width: 100%; border-collapse: separate; border-spacing: 0; font-variant-numeric: tabular-nums; }\n  caption { padding: var(--_py) var(--_px); text-align: left; font-weight: var(--ray-font-weight-semibold); }\n  th, td { padding: var(--_py) var(--_px); text-align: left; vertical-align: middle; border-bottom: 1px solid var(--ray-border); }\n  :host([with-column-borders]) th + th, :host([with-column-borders]) td + td { border-left: 1px solid var(--ray-border); }\n  tbody tr:last-child td { border-bottom: 0; }\n  :host(:not([with-border])) tbody tr:last-child td { border-bottom: 1px solid var(--ray-border); }\n  th { font-size: var(--ray-font-size-xs); font-weight: var(--ray-font-weight-semibold); color: var(--ray-muted-foreground); white-space: nowrap; background: var(--ray-background); }\n  :host([sticky-header]) thead th { position: sticky; top: 0; z-index: 1; box-shadow: 0 1px 0 var(--ray-border); }\n  [data-align=\"right\"] { text-align: right; }\n  [data-align=\"center\"] { text-align: center; }\n  :host([striped]) tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--ray-muted) 60%, transparent); }\n  tbody tr:hover td { background: var(--ray-default-hover); }\n  :host([no-hover]) tbody tr:hover td { background: inherit; }\n  tbody tr[aria-selected=\"true\"] td { background: var(--ray-primary-light); }\n  tbody tr[data-clickable] { cursor: pointer; }\n  tbody tr:focus-visible { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: -2px; }\n  .sort {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.25rem;\n    margin: -0.25rem -0.375rem;\n    padding: 0.25rem 0.375rem;\n    font: inherit;\n    color: inherit;\n    background: transparent;\n    border: 0;\n    border-radius: var(--ray-radius-sm);\n    cursor: pointer;\n  }\n  .sort:hover { color: var(--ray-foreground); background: var(--ray-accent); }\n  .sort { --ray-icon-stroke: 2.5; }\n  .sort svg { width: 0.75rem; height: 0.75rem; opacity: 0.35; }\n  th[aria-sort=\"ascending\"] .sort, th[aria-sort=\"descending\"] .sort { color: var(--ray-foreground); }\n  th[aria-sort=\"ascending\"] .sort svg, th[aria-sort=\"descending\"] .sort svg { opacity: 1; }\n  th[aria-sort=\"descending\"] .sort svg { transform: rotate(180deg); }\n  .check { width: 1%; padding-right: 0; }\n  .check input { width: 1rem; height: 1rem; margin: 0; accent-color: var(--ray-primary); cursor: pointer; vertical-align: middle; }\n  .empty td { padding: var(--ray-space-8) var(--_px); text-align: center; color: var(--ray-muted-foreground); }\n  .empty:hover td { background: inherit; }\n`;\n\nconst SORT_ICON = `<span data-ray-icon=\"chevron-up\" aria-hidden=\"true\"></span>`;\n\nexport class RayTable extends RayElement {\n  static properties = {\n    columns: { attribute: false },\n    data: { attribute: false },\n    rowKey: { type: String, default: \"id\" },\n    selectable: { type: Boolean, reflect: true },\n    selection: { attribute: false },\n    sort: { attribute: false },\n    manualSort: { type: Boolean },\n    clickableRows: { type: Boolean, reflect: true },\n    striped: { type: Boolean, reflect: true },\n    withBorder: { type: Boolean, reflect: true },\n    withColumnBorders: { type: Boolean, reflect: true },\n    stickyHeader: { type: Boolean, reflect: true },\n    noHover: { type: Boolean, reflect: true },\n    density: { type: String, reflect: true, default: \"sm\" },\n    label: { type: String },\n    emptyLabel: { type: String, default: \"No data\" },\n  };\n  static styles = [styles];\n  static template = `<div class=\"scroll\" part=\"scroll\"><table part=\"table\"><caption hidden></caption><thead part=\"head\"></thead><tbody part=\"body\"></tbody></table></div><slot name=\"empty\" hidden></slot>`;\n\n  constructor() {\n    super();\n    this.$(\"thead\").addEventListener(\"click\", (e) => this._headClick(e));\n    this.$(\"thead\").addEventListener(\"change\", (e) => this._headChange(e));\n    this.$(\"tbody\").addEventListener(\"change\", (e) => this._rowCheck(e));\n    this.$(\"tbody\").addEventListener(\"click\", (e) => this._rowClick(e));\n    this.$(\"tbody\").addEventListener(\"keydown\", (e) => this._rowKey(e));\n  }\n\n  /** The rows in display order (sorted unless manual-sort). */\n  get rows() {\n    const data = Array.isArray(this.data) ? this.data : [];\n    const s = this.sort;\n    if (!s || !s.key || !s.direction || this.manualSort) return data;\n    const col = (this.columns ?? []).find((c) => c.key === s.key);\n    const cmp = col?.sort ?? ((a, b) => compare(a[s.key], b[s.key]));\n    const sorted = [...data].sort(cmp);\n 