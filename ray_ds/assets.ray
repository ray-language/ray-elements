const F85: string = "/* Generated by ray-ds tools from tokens.toml. Do not edit. */\n\n@layer ray.tokens, ray.base;\n\n@layer ray.tokens {\n  :root {\n    color-scheme: light dark;\n\n    /* base */\n    --ray-white: #ffffff;\n    --ray-black: #000000;\n\n    /* palette */\n    --ray-dark-0: #c9c9c9;\n    --ray-dark-1: #b8b8b8;\n    --ray-dark-2: #828282;\n    --ray-dark-3: #696969;\n    --ray-dark-4: #424242;\n    --ray-dark-5: #3b3b3b;\n    --ray-dark-6: #2e2e2e;\n    --ray-dark-7: #242424;\n    --ray-dark-8: #1f1f1f;\n    --ray-dark-9: #141414;\n    --ray-gray-0: #f8f9fa;\n    --ray-gray-1: #f1f3f5;\n    --ray-gray-2: #e9ecef;\n    --ray-gray-3: #dee2e6;\n    --ray-gray-4: #ced4da;\n    --ray-gray-5: #adb5bd;\n    --ray-gray-6: #868e96;\n    --ray-gray-7: #495057;\n    --ray-gray-8: #343a40;\n    --ray-gray-9: #212529;\n    --ray-red-0: #fff5f5;\n    --ray-red-1: #ffe3e3;\n    --ray-red-2: #ffc9c9;\n    --ray-red-3: #ffa8a8;\n    --ray-red-4: #ff8787;\n    --ray-red-5: #ff6b6b;\n    --ray-red-6: #fa5252;\n    --ray-red-7: #f03e3e;\n    --ray-red-8: #e03131;\n    --ray-red-9: #c92a2a;\n    --ray-pink-0: #fff0f6;\n    --ray-pink-1: #ffdeeb;\n    --ray-pink-2: #fcc2d7;\n    --ray-pink-3: #faa2c1;\n    --ray-pink-4: #f783ac;\n    --ray-pink-5: #f06595;\n    --ray-pink-6: #e64980;\n    --ray-pink-7: #d6336c;\n    --ray-pink-8: #c2255c;\n    --ray-pink-9: #a61e4d;\n    --ray-violet-0: #f3f0ff;\n    --ray-violet-1: #e5dbff;\n    --ray-violet-2: #d0bfff;\n    --ray-violet-3: #b197fc;\n    --ray-violet-4: #9775fa;\n    --ray-violet-5: #845ef7;\n    --ray-violet-6: #7950f2;\n    --ray-violet-7: #7048e8;\n    --ray-violet-8: #6741d9;\n    --ray-violet-9: #5f3dc4;\n    --ray-indigo-0: #edf2ff;\n    --ray-indigo-1: #dbe4ff;\n    --ray-indigo-2: #bac8ff;\n    --ray-indigo-3: #91a7ff;\n    --ray-indigo-4: #748ffc;\n    --ray-indigo-5: #5c7cfa;\n    --ray-indigo-6: #4c6ef5;\n    --ray-indigo-7: #4263eb;\n    --ray-indigo-8: #3b5bdb;\n    --ray-indigo-9: #364fc7;\n    --ray-blue-