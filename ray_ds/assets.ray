const F62: string = "// <ray-tabs> + <ray-tab> + <ray-tab-panel> (WAI-ARIA tabs pattern).\n//\n// Tabs and panels are light-DOM children, so their roles, ids,\n// aria-controls and aria-labelledby work as plain attributes. A tab and its\n// panel share a `value`.\n\nimport { RayElement, css, define, uid } from \"../../core/core.js\";\nimport { applyColor } from \"../../core/styles.js\";\n\nconst tabsStyles = css`\n  :host { display: block; }\n  :host([orientation=\"vertical\"]) { display: flex; gap: var(--ray-space-4); }\n  /* Too many tabs for the width: the list scrolls sideways instead of\n     wrapping (a wrapped underline reads as two separate tab bars). The\n     baseline is an inset shadow, so a tab's own bottom border paints over\n     it without a negative margin that the scroller would clip. */\n  .list {\n    --_line: 2px;\n    display: flex;\n    gap: 0;\n    overflow-x: auto;\n    scrollbar-width: none;\n    box-shadow: inset 0 calc(-1 * var(--_line)) 0 var(--ray-border);\n  }\n  .list::-webkit-scrollbar { display: none; }\n  .list ::slotted(ray-tab) { flex: none; }\n  :host([orientation=\"vertical\"]) .list { flex-direction: column; overflow-x: visible; box-shadow: none; border-right: 2px solid var(--ray-border); }\n  :host([variant=\"outline\"]) .list { --_line: 1px; }\n  :host([variant=\"outline\"][orientation=\"vertical\"]) .list { border-right-width: 1px; }\n  :host([variant=\"pills\"]) .list { gap: var(--ray-space-1); border: 0; box-shadow: none; }\n  :host([grow]) .list ::slotted(ray-tab) { flex: 1 0 auto; }\n  .panels { flex: 1; min-width: 0; padding-top: var(--ray-space-3); }\n  :host([orientation=\"vertical\"]) .panels { padding-top: 0; }\n`;\n\nexport class RayTabs extends RayElement {\n  static properties = {\n    value: { type: String },\n    orientation: { type: String, reflect: true, default: \"horizontal\" },\n    variant: { type: String, reflect: true, default: \"default\" },\n    color: { type: String, reflect: true },\n    activation: { type: String, default: \"auto\" },\n    grow: { type: Boolean, reflect: true },\n  };\n  static styles = [tabsStyles];\n  static template = `<div class=\"list\" part=\"list\" role=\"tablist\"><slot name=\"tab\"></slot></div><div class=\"panels\" part=\"panels\"><slot></slot></div>`;\n\n  constructor() {\n    super();\n    this.addEventListener(\"click\", (e) => {\n      const tab = e.target.closest?.(\"ray-tab\");\n      if (tab && this.tabs.includes(tab) && !tab.disabled) this._select(tab, true);\n    });\n    this.addEventListener(\"keydown\", (e) => this._key(e));\n    for (const slot of this.shadowRoot.querySelectorAll(\"slot\")) {\n      slot.addEventListener(\"slotchange\", () => this.requestUpdate());\n    }\n  }\n\n  get tabs() {\n    return [...this.querySelectorAll(\"ray-tab\")].filter((t) => t.closest(\"ray-tabs\") === this);\n  }\n\n  get panels() {\n    return [...this.querySelectorAll(\"ray-tab-panel\")].filter((p) => p.closest(\"ray-tabs\") === this);\n  }\n\n  update() {\n    const tabs = this.tabs;\n    const panels = this.panels;\n    if (this.value === undefined || !tabs.some((t) => t.value === this.value && !t.disabled)) {\n      const first = tabs.find((t) => !t.disabled);\n      if (first) this.commitProperty(\"value\", first.value);\n    }\n    const vertical = this.orientation === \"vertical\";\n    this.$(\".list\").setAttribute(\"aria-orientation\", vertical ? \"vertical\" : \"horizontal\");\n    applyColor(this, this.color);\n    for (const tab of tabs) {\n      const panel = panels.find((p) => p.value === tab.value);\n      const active = tab.value === this.value;\n      tab.id ||= uid(\"tab\");\n      tab.setAttribute(\"role\", \"tab\");\n      tab.setAttribute(\"aria-selected\", String(active));\n      tab.tabIndex = active ? 0 : -1;\n      tab.toggleAttribute(\"data-active\", active);\n      tab.dataset.variant = this.variant || \"default\";\n      tab.toggleAttribute(\"data-vertical\", vertical);\n      if (tab.disabled) tab.setAttribute(\"aria-disabled\", \"true\");\n      else tab.removeAttribute(\"aria-disabled\");\n      if (panel) {\n        panel.id ||= uid(\"tabpanel\");\n        tab.setAttribute(\"aria-controls\", panel.id);\n        panel.setAttribute(\"aria-labelledby\", tab.id);\n      }\n    }\n    for (const panel of panels) {\n      panel.setAttribute(\"role\", \"tabpanel\");\n      panel.tabIndex = 0;\n      panel.hidden = panel.value !== this.value;\n    }\n  }\n\n  _select(tab, user) {\n    const changed = tab.value !== this.value;\n    this.value = tab.value;\n    if (user && changed) this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n  }\n\n  _key(e) {\n    const tab = e.target.closest?.(\"ray-tab\");\n    const tabs = this.tabs.filter((t) => !t.disabled);\n    const i = tabs.indexOf(tab);\n    if (i < 0) return;\n    const vertical = this.orientation === \"vertical\";\n    const next = vertical ? \"ArrowDown\" : \"ArrowRight\";\n    const prev = vertical ? \"ArrowUp\" : \"ArrowLeft\";\n    let target = null;\n    if (e.key === next) target = tabs[(i + 1) % tabs.length];\n    else if (e.key === prev) target = tabs[(i - 1 + tabs.length) % tabs.length];\n    else if (e.key === \"Home\") target = tabs[0];\n    else if (e.key === \"End\") target = tabs[tabs.length - 1];\n    else if ((e.key === \"Enter\" || e.key === \" \") && this.activation === \"manual\") {\n      e.preventDefault();\n      this._select(tab, true);\n      return;\n    }\n    if (!target) return;\n    e.preventDefault();\n    target.focus();\n    if (this.activation !== \"manual\") this._select(target, true);\n  }\n}\n\nconst tabStyles = css`\n  :host {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: var(--ray-space-2);\n    min-height: var(--ray-control-height-sm);\n    padding: 0 var(--ray-space-4);\n    font-size: var(--ray-font-size-sm);\n    font-weight: var(--ray-font-weight-medium);\n    color: var(--ray-muted-foreground);\n    white-space: nowrap;\n    cursor: pointer;\n    user-select: none;\n    outline: none;\n    transition: color var(--ray-duration-fast) var(--ray-easing-standard), background-color var(--ray-duration-fast) var(--ray-easing-standard), border-color var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  :host(:focus-visible) { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: -2px; border-radius: var(--ray-radius-sm); }\n  :host(:hover) { color: var(--ray-foreground); }\n  :host([data-active]) { color: var(--ray-foreground); }\n  :host([disabled]) { opacity: 0.5; cursor: not-allowed; }\n\n  /* default: underline */\n  :host([data-variant=\"default\"]) { border-bottom: 2px solid transparent; }\n  :host([data-variant=\"default\"]:hover:not([data-active])) { border-bottom-color: var(--ray-border); background: var(--ray-muted); }\n  :host([data-variant=\"default\"][data-active]) { border-bottom-color: var(--_filled, var(--ray-primary)); }\n  :host([data-variant=\"default\"][data-vertical]) { margin: 0 -2px 0 0; justify-content: flex-start; border-bottom: 0; border-right: 2px solid transparent; }\n  :host([data-variant=\"default\"][data-vertical][data-active]) { border-right-color: var(--_filled, var(--ray-primary)); }\n\n  /* outline */\n  :host([data-variant=\"outline\"]) { border: 1px solid transparent; border-radius: var(--ray-radius-default) var(--ray-radius-default) 0 0; }\n  :host([data-variant=\"outline\"][data-active]) { border-color: var(--ray-border); border-bottom-color: var(--ray-background); background: var(--ray-background); }\n  :host([data-variant=\"outline\"][data-vertical]) { margin: 0 -1px 0 0; justify-content: flex-start; border-radius: var(--ray-radius-default) 0 0 var(--ray-radius-default); }\n  :host([data-variant=\"outline\"][data-vertical][data-active]) { border-bottom-color: var(--ray-border); border-right-color: var(--ray-background); }\n\n  /* pills */\n  :host([data-variant=\"pills\"]) { border-radius: var(--ray-radius-default); }\n  :host([data-variant=\"pills\"]:hover:not([data-active])) { background: var(--ray-accent); }\n  :host([data-variant=\"pills\"][data-active]) { color: var(--_contrast, var(--ray-primary-foreground)); background: var(--_filled, var(--ray-primary)); }\n\n  .section { display: inline-flex; }\n  .section:not([data-filled]) { display: none; }\n  ::slotted(svg) { width: 1rem; height: 1rem; }\n`;\n\nexport class RayTab extends RayElement {\n  static properties = {\n    value: { type: String, reflect: true },\n    disabled: { type: Boolean, reflect: true },\n  };\n  static styles = [tabStyles];\n  static template = `<span class=\"section\" part=\"left-section\"><slot name=\"left\"></slot></span><slot></slot><span class=\"section\" part=\"right-section\"><slot name=\"right\"></slot></span>`;\n\n  constructor() {\n    super();\n    for (const slot of this.shadowRoot.querySelectorAll(\"slot[name]\")) {\n      slot.addEventListener(\"slotchange\", () => slot.parentElement.toggleAttribute(\"data-filled\", slot.assignedNodes().length > 0));\n    }\n  }\n\n  connectedCallback() {\n    // Tabs render in the tablist of <ray-tabs>.\n    if (this.slot !== \"tab\") this.slot = \"tab\";\n    super.connectedCallback();\n  }\n\n  update(changed) {\n    if (changed.has(\"value\") || changed.has(\"disabled\")) this.closest(\"ray-tabs\")?.requestUpdate();\n  }\n}\n\nconst panelStyles = css`\n  :host { display: block; outline: none; }\n  :host([hidden]) { display: none; }\n  /* The newly selected panel fades in (display none → block restarts it). */\n  :host(:not([hidden])) { animation: ray-panel-in var(--ray-duration-base) var(--ray-easing-out); }\n  @keyframes ray-panel-in { from { opacity: 0; transform: translateY(2px); } }\n  :host(:focus-visible) { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: 2px; border-radius: var(--ray-radius-sm); }\n`;\n\nexport class RayTabPanel extends RayElement {\n  static properties = {\n    value: { type: String, reflect: true },\n  };\n  static styles = [panelStyles];\n  static template = `<slot></slot>`;\n}\n\ndefine(\"ray-tabs\", RayTabs);\ndefine(\"ray-tab\", RayTab);\ndefine(\"ray-tab-panel\", RayTabPanel);\n";
const F63: string = "// <ray-textarea>: a multi-line text field, optionally growing with its content.\n\nimport { css, define } from \"../../core/core.js\";\nimport { sizeStyles, radiusStyles } from \"../../core/styles.js\";\nimport { FieldControl, fieldStyles, boxStyles, fieldTemplate } from \"../../core/form.js\";\n\nconst styles = css`\n  .box { align-items: stretch; }\n  .control {\n    padding-block: calc(var(--_px) * 0.4);\n    line-height: var(--ray-line-height-md);\n    resize: vertical;\n  }\n  :host([autosize]) .control { resize: none; overflow: hidden; }\n  :host([resize=\"none\"]) .control { resize: none; }\n  :host([resize=\"both\"]) .control { resize: both; }\n`;\n\nconst PASSTHROUGH = [\"placeholder\", \"autocomplete\", \"minlength\", \"maxlength\", \"spellcheck\", \"wrap\"];\n\nexport class RayTextarea extends FieldControl {\n  static properties = {\n    ...FieldControl.fieldProperties,\n    value: { type: String },\n    rows: { type: Number, default: 3 },\n    autosize: { type: Boolean, reflect: true },\n    maxRows: { type: Number },\n    readonly: { type: Boolean, reflect: true },\n  };\n  static styles = [sizeStyles, radiusStyles, fieldStyles, boxStyles, styles];\n  static template = fieldTemplate(`<textarea id=\"control\" class=\"control\" part=\"textarea\"></textarea>`, { sections: false });\n\n  static get observedAttributes() {\n    return [...super.observedAttributes, ...PASSTHROUGH];\n  }\n\n  attributeChangedCallback(attr, old, value) {\n    if (PASSTHROUGH.includes(attr)) {\n      if (value === null) this.control?.removeAttribute(attr);\n      else this.control?.setAttribute(attr, value);\n      return;\n    }\n    super.attributeChangedCallback(attr, old, value);\n  }\n\n  wire() {\n    for (const attr of PASSTHROUGH) {\n      const v = this.getAttribute(attr);\n      if (v !== null) this.control.setAttribute(attr, v);\n    }\n    // Initial value: the attribute, else the element's text (like <textarea>).\n    this._default = this.getAttribute(\"value\") ?? this.textContent ?? \"\";\n    if (this.value === undefined) this.commitProperty(\"value\", this._default);\n    this.control.addEventListener(\"input\", () => {\n      this.commitProperty(\"value\", this.control.value);\n      this._commit();\n      this._fit();\n    });\n    this.control.addEventListener(\"change\", (e) => this.forward(e));\n  }\n\n  update() {\n    const c = this.control;\n    const v = this.value ?? \"\";\n    if (c.value !== v) c.value = v;\n    c.rows = this.rows || 3;\n    c.readOnly = Boolean(this.readonly);\n    this.syncField();\n    this._commit();\n    this._fit();\n  }\n\n  _commit() {\n    this.internals.setFormValue(this.value ?? \"\");\n    this.syncValidity();\n  }\n\n  // Autosize: grow to the content, up to maxRows.\n  _fit() {\n    const c = this.control;\n    if (!this.autosize) {\n      c.style.removeProperty(\"height\");\n      return;\n    }\n    c.style.height = \"auto\";\n    let h = c.scrollHeight;\n    if (this.maxRows) {\n      const line = parseFloat(getComputedStyle(c).lineHeight) || 20;\n      const pad = c.offsetHeight - c.clientHeight + parseFloat(getComputedStyle(c).paddingTop) * 2;\n      h = Math.min(h, line * this.maxRows + pad);\n      c.style.overflowY = c.scrollHeight > h ? \"auto\" : \"hidden\";\n    }\n    c.style.height = `\${h}px`;\n  }\n\n  formResetCallback() {\n    this.value = this._default;\n  }\n\n  formStateRestoreCallback(state) {\n    this.value = String(state ?? \"\");\n  }\n}\n\ndefine(\"ray-textarea\", RayTextarea);\n";
const F64: string = "// <ray-theme-toggle>: cycles the document theme system -> light -> dark.\n\nimport { RayElement, css, define, getTheme, setTheme, onThemeChange } from \"../../core/core.js\";\n\nconst ORDER = [\"system\", \"light\", \"dark\"];\nconst LABEL = { system: \"System theme\", light: \"Light theme\", dark: \"Dark theme\" };\n\n// Icon of each theme (from the icon registry).\nconst ICONS = { system: \"monitor\", light: \"sun\", dark: \"moon\" };\n\nconst styles = css`\n  :host {\n    display: inline-flex;\n    --_size: var(--ray-control-height-sm);\n  }\n  :host([size=\"xs\"]) { --_size: var(--ray-control-height-xs); }\n  :host([size=\"md\"]) { --_size: var(--ray-control-height-md); }\n  :host([size=\"lg\"]) { --_size: var(--ray-control-height-lg); }\n  :host([size=\"xl\"]) { --_size: var(--ray-control-height-xl); }\n  button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--_size);\n    height: var(--_size);\n    padding: 0;\n    color: var(--ray-foreground);\n    background: transparent;\n    border: 1px solid var(--ray-border);\n    border-radius: var(--ray-radius-default);\n    cursor: pointer;\n    transition: background var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  button:hover { background: var(--ray-accent); }\n  .icon svg { width: calc(var(--_size) * 0.55); height: calc(var(--_size) * 0.55); }\n`;\n\nexport class RayThemeToggle extends RayElement {\n  static properties = {\n    size: { type: String, reflect: true, default: \"sm\" },\n  };\n  static styles = [styles];\n  static delegatesFocus = true;\n  static template = `<button part=\"button\" class=\"focus-ring\" type=\"button\"><span class=\"icon\" data-ray-icon=\"monitor\" aria-hidden=\"true\"></span></button>`;\n\n  connectedCallback() {\n    super.connectedCallback();\n    this._button = this.$(\"button\");\n    this._onClick = () => {\n      const next = ORDER[(ORDER.indexOf(getTheme()) + 1) % ORDER.length];\n      setTheme(next);\n    };\n    this._button.addEventListener(\"click\", this._onClick);\n    this._stop = onThemeChange(() => this.requestUpdate());\n    this._paint();\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    this._button.removeEventListener(\"click\", this._onClick);\n    this._stop?.();\n  }\n\n  update() {\n    this._paint();\n  }\n\n  _paint() {\n    const theme = getTheme();\n    const next = ORDER[(ORDER.indexOf(theme) + 1) % ORDER.length];\n    this.$(\".icon\").setAttribute(\"data-ray-icon\", ICONS[theme]);\n    this.paintIcons(this._button);\n    this._button.setAttribute(\"aria-label\", `\${LABEL[theme]} (switch to \${next})`);\n    this._button.title = LABEL[theme];\n  }\n}\n\ndefine(\"ray-theme-toggle\", RayThemeToggle);\n";
const F65: string = "// <ray-timeline> + <ray-timeline-item>: events in order along a line\n// (Mantine's Timeline): activity, history, a deploy's stages. Items up to\n// `active` are reached: a filled bullet and a colored line. A bullet is a\n// dot, an icon, or anything in the bullet slot (an avatar).\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor } from \"../../core/styles.js\";\n\nconst timelineStyles = css`\n  :host { display: block; --_bullet: 1.25rem; --_line: 2px; }\n  :host([hidden]) { display: none; }\n  .list { display: flex; flex-direction: column; }\n`;\n\nconst itemStyles = css`\n  :host {\n    position: relative;\n    display: grid;\n    grid-template-columns: var(--_bullet) minmax(0, 1fr);\n    column-gap: var(--ray-space-3);\n    padding-bottom: var(--ray-space-6);\n  }\n  :host([hidden]) { display: none; }\n  :host([data-last]) { padding-bottom: 0; }\n  :host([data-align=\"right\"]) { grid-template-columns: minmax(0, 1fr) var(--_bullet); text-align: right; }\n  :host([data-align=\"right\"]) .bullet-col { grid-column: 2; grid-row: 1; }\n  :host([data-align=\"right\"]) .body { grid-column: 1; grid-row: 1; }\n  .bullet-col { position: relative; display: flex; justify-content: center; }\n  .bullet {\n    position: relative;\n    z-index: 1;\n    box-sizing: border-box;\n    display: grid;\n    place-items: center;\n    width: var(--_bullet);\n    height: var(--_bullet);\n    color: var(--ray-muted-foreground);\n    background: var(--ray-background);\n    border: var(--_line) solid var(--ray-border);\n    border-radius: 50%;\n    --ray-icon-size: calc(var(--_bullet) * 0.6);\n    --ray-icon-stroke: 2.25;\n  }\n  :host([data-reached]) .bullet { color: var(--_contrast); background: var(--_filled); border-color: var(--_filled); }\n  :host([data-has-bullet]) .bullet { border: 0; background: none; overflow: visible; }\n  .line {\n    position: absolute;\n    top: var(--_bullet);\n    bottom: calc(-1 * var(--ray-space-6));\n    left: calc(50% - var(--_line) / 2);\n    width: 0;\n    border-left: var(--_line) var(--_line-style, solid) var(--ray-border);\n  }\n  :host([data-last]) .line { display: none; }\n  :host([data-line-reached]) .line { border-left-color: var(--_filled); }\n  :host([line-variant=\"dashed\"]) .line { --_line-style: dashed; }\n  :host([line-variant=\"dotted\"]) .line { --_line-style: dotted; }\n  .body { min-width: 0; padding-top: calc((var(--_bullet) - 1.4em) / 2); }\n  .title { display: block; font-weight: var(--ray-font-weight-medium); line-height: 1.4; }\n  .title:empty { display: none; }\n  .content { font-size: var(--ray-font-size-sm); color: var(--ray-muted-foreground); }\n  .content ::slotted(*) { margin-block: var(--ray-space-1) 0; }\n  .time { display: block; margin-top: var(--ray-space-1); font-size: var(--ray-font-size-xs); color: var(--ray-muted-foreground); opacity: 0.85; }\n  .time:empty { display: none; }\n`;\n\nexport class RayTimeline extends RayElement {\n  static properties = {\n    active: { type: Number, reflect: true, default: -1 },\n    align: { type: String, reflect: true, default: \"left\" },\n    bulletSize: { type: String, attribute: \"bullet-size\" },\n    lineWidth: { type: Number, attribute: \"line-width\" },\n    color: { type: String, reflect: true },\n    reverseActive: { type: Boolean, reflect: true, attribute: \"reverse-active\" },\n  };\n  static styles = [timelineStyles];\n  static template = `<div class=\"list\" part=\"list\"><slot></slot></div>`;\n\n  constructor() {\n    super();\n    this.$(\"slot\").addEventListener(\"slotchange\", () => this.requestUpdate());\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    if (!this.hasAttribute(\"role\")) this.setAttribute(\"role\", \"list\");\n  }\n\n  /** The items, in order. */\n  get items() {\n    return [...this.children].filter((el) => el.localName === \"ray-timeline-item\");\n  }\n\n  update() {\n    const items = this.items;\n    const n = items.length;\n    const active = this.active ?? -1;\n    if (this.bulletSize) this.style.setProperty(\"--_bullet\", /^\\d+(\\.\\d+)?$/.test(this.bulletSize) ? `\${this.bulletSize}px` : this.bulletSize);\n    else this.style.removeProperty(\"--_bullet\");\n    if (this.lineWidth) this.style.setProperty(\"--_line\", `\${this.lineWidth}px`);\n    else this.style.removeProperty(\"--_line\");\n    applyColor(this, this.color);\n    items.forEach((item, i) => {\n      // reverse-active: reached from the end (the latest event at the top).\n      const k = this.reverseActive ? n - 1 - i : i;\n      item.toggleAttribute(\"data-reached\", active >= 0 && k <= active);\n      item.toggleAttribute(\"data-line-reached\", active >= 0 && (this.reverseActive ? k <= active && k > 0 : k < active));\n      item.toggleAttribute(\"data-last\", i === n - 1);\n      item.setAttribute(\"data-align\", this.align === \"right\" ? \"right\" : \"left\");\n    });\n  }\n}\n\nexport class RayTimelineItem extends RayElement {\n  static properties = {\n    label: { type: String },\n    time: { type: String },\n    icon: { type: String },\n    color: { type: String, reflect: true },\n    lineVariant: { type: String, reflect: true, attribute: \"line-variant\", default: \"solid\" },\n  };\n  static styles = [itemStyles];\n  static template = `\n    <div class=\"bullet-col\"><span class=\"bullet\" part=\"bullet\"><span class=\"icon\" data-ray-icon=\"\"></span><slot name=\"bullet\"></slot></span><span class=\"line\" part=\"line\"></span></div>\n    <div class=\"body\" part=\"body\"><span class=\"title\" part=\"title\"></span><div class=\"content\"><slot></slot></div><span class=\"time\" part=\"time\"></span></div>`;\n\n  constructor() {\n    super();\n    const slot = this.$('slot[name=\"bullet\"]');\n    slot.addEventListener(\"slotchange\", () => this.toggleAttribute(\"data-has-bullet\", slot.assignedElements().length > 0));\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    this.setAttribute(\"role\", \"listitem\");\n  }\n\n  update() {\n    this.$(\".title\").textContent = this.label ?? \"\";\n    this.$(\".time\").textContent = this.time ?? \"\";\n    this.$(\".icon\").setAttribute(\"data-ray-icon\", this.icon ?? \"\");\n    this.paintIcons();\n    // Its own color, else the timeline's (inherited custom properties).\n    if (this.color) applyColor(this, this.color);\n    else for (const p of [...this.style]) if (p.startsWith(\"--_\")) this.style.removeProperty(p);\n  }\n}\n\ndefine(\"ray-timeline-item\", RayTimelineItem);\ndefine(\"ray-timeline\", RayTimeline);\n";
const F66: string = "// <ray-toggle>: a two-state button (aria-pressed), like shadcn's Toggle — bold\n// in a toolbar, \"mute\", \"favorite\". A RayButton, so sizes, radius, color,\n// icons in the left/right slots and ray-button-group all work.\n//\n// The variant describes how \"on\" looks; \"off\" is always neutral, so the two\n// states differ by more than color (WCAG 1.4.1):\n//   subtle  — off: transparent; on: tinted fill (default)\n//   outline — off: neutral border; on: colored border + tint\n//   light   — off: muted fill; on: colored tint\n//   filled  — off: neutral surface with border; on: solid color\n//   raised  — off: a neutral key standing up; on: latched down and lit\n// Button variants left out: default (no \"on\" look of its own), transparent\n// (would change only the text color) and gradient (a second filled).\n\nimport { css, define } from \"../../core/core.js\";\nimport { RayButton } from \"../button/button.js\";\n\nconst styles = css`\n  :host([square]) .button { width: var(--_h); padding: 0; }\n  :host([square]) .label { font-size: calc(var(--_fs) * 1.15); }\n  ::slotted(svg) { width: 1.15em; height: 1.15em; }\n\n  /* Base of the drawn variants, at the specificity of one class so each\n     variant's own off look below wins. */\n  .button:where([data-toggle]:not([data-toggle=\"raised\"])) { color: var(--ray-foreground); background: transparent; }\n  .button[data-toggle] ::slotted(ray-icon), .button[data-toggle] ::slotted(svg) { opacity: 0.85; }\n  .button[data-toggle][aria-pressed=\"true\"] ::slotted(*) { opacity: 1; }\n\n  /* subtle */\n  .button[data-toggle=\"subtle\"]:not([data-disabled]):hover { background: var(--ray-default-hover); }\n  .button[data-toggle=\"subtle\"][aria-pressed=\"true\"] { background: var(--_light); color: var(--_light-color); }\n  .button[data-toggle=\"subtle\"][aria-pressed=\"true\"]:not([data-disabled]):hover { background: var(--_light-hover); }\n\n  /* outline */\n  .button[data-toggle=\"outline\"] { border-color: var(--ray-border); }\n  .button[data-toggle=\"outline\"]:not([data-disabled]):hover { background: var(--ray-default-hover); }\n  .button[data-toggle=\"outline\"][aria-pressed=\"true\"] { border-color: color-mix(in srgb, var(--_outline) 65%, var(--ray-border)); background: var(--_light); color: var(--_light-color); }\n  .button[data-toggle=\"outline\"][aria-pressed=\"true\"]:not([data-disabled]):hover { background: var(--_light-hover); }\n\n  /* light */\n  .button[data-toggle=\"light\"] { background: var(--ray-muted); }\n  .button[data-toggle=\"light\"]:not([data-disabled]):hover { background: var(--ray-default-hover); }\n  .button[data-toggle=\"light\"][aria-pressed=\"true\"] { background: var(--_light); color: var(--_light-color); }\n  .button[data-toggle=\"light\"][aria-pressed=\"true\"]:not([data-disabled]):hover { background: var(--_light-hover); }\n\n  /* filled */\n  .button[data-toggle=\"filled\"] { background: var(--ray-default); border-color: var(--ray-border); }\n  .button[data-toggle=\"filled\"]:not([data-disabled]):hover { background: var(--ray-default-hover); }\n  .button[data-toggle=\"filled\"][aria-pressed=\"true\"] { background: var(--_filled); color: var(--_contrast); border-color: transparent; }\n  .button[data-toggle=\"filled\"][aria-pressed=\"true\"]:not([data-disabled]):hover { background: var(--_filled-hover); }\n\n  /* Disabled keeps showing its state, dimmed. */\n  .button[data-toggle][data-disabled]:not([data-toggle=\"raised\"]) { opacity: 0.5; }\n\n  /* raised: off is an unlit neutral key (ray-kbd's colors) ... */\n  .button[data-toggle=\"raised\"]:not([aria-pressed=\"true\"]) {\n    --_face: var(--ray-raised);\n    --_face-text: var(--ray-foreground);\n    --_rim: light-dark(color-mix(in srgb, var(--_face), black 12%), color-mix(in srgb, var(--_face) 82%, var(--ray-background)));\n    --_edge: light-dark(color-mix(in srgb, var(--_face), black 24%), color-mix(in srgb, var(--_face) 62%, var(--ray-background)));\n    /* ray-kbd's top highlight: a strong one reads as an edge on top in dark. */\n    box-shadow:\n      0 var(--_depth) 0 var(--_edge),\n      0 calc(var(--_depth) + 1px) 6px -1px rgb(0 0 0 / 0.28),\n      inset 0 1px 0 light-dark(rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.07));\n  }\n  /* ... and on stays down, lit in its color, like a latching switch. */\n  .button[data-toggle=\"raised\"][aria-pressed=\"true\"]:not([data-disabled]) {\n    transform: translateY(var(--_depth));\n    /* Sunk: shaded under the top rim. In dark a touch deeper (a light\n       shadow does not show on the color there); light keeps the original. */\n    box-shadow:\n      0 0 0 var(--_edge),\n      inset 0 1px 3px light-dark(rgb(0 0 0 / 0.28), rgb(0 0 0 / 0.4));\n    border-top-color: light-dark(var(--_rim), color-mix(in srgb, var(--_face), black 24%));\n  }\n`;\n\nconst VARIANTS = [\"subtle\", \"outline\", \"light\", \"filled\", \"raised\"];\n\nexport class RayToggle extends RayButton {\n  static properties = {\n    ...RayButton.properties,\n    variant: { type: String, reflect: true, default: \"subtle\" },\n    pressed: { type: Boolean, reflect: true },\n    square: { type: Boolean, reflect: true },\n    label: { type: String, reflect: true },\n  };\n  static styles = [...RayButton.styles, styles];\n\n  #initial = null;\n\n  constructor() {\n    super();\n    // Clicks reach the host after the inner button's own handler, which stops\n    // them while disabled or loading.\n    this.addEventListener(\"click\", () => {\n      if (this.disabled || this.loading || this._fieldsetDisabled) return;\n      this.pressed = !this.pressed;\n      this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    });\n  }\n\n  connectedCallback() {\n    this.#initial ??= this.hasAttribute(\"pressed\");\n    super.connectedCallback();\n  }\n\n  formResetCallback() {\n    this.pressed = this.#initial ?? false;\n  }\n\n  update() {\n    super.update();\n    const el = this._el;\n    const variant = VARIANTS.includes(this.variant) ? this.variant : \"subtle\";\n    // raised reuses ray-button's key; the others are drawn here.\n    el.dataset.variant = variant === \"raised\" ? \"raised\" : \"toggle\";\n    el.dataset.toggle = variant;\n    el.setAttribute(\"aria-pressed\", String(Boolean(this.pressed)));\n    if (this.label) {\n      el.setAttribute(\"aria-label\", this.label);\n      el.title = this.label;\n    }\n    // Submitted like a checkbox: value (default \"on\") under name while pressed.\n    this.internals.setFormValue(this.pressed && this.name ? (this.value ?? \"on\") : null);\n  }\n}\n\ndefine(\"ray-toggle\", RayToggle);\n";
const F67: string = "// <ray-toggle-group>: a set of <ray-toggle> with one shared value (shadcn's\n// ToggleGroup). type=\"single\": at most one on (text alignment, a view mode);\n// type=\"multiple\": any number (bold / italic / underline).\n//\n// A ray-button-group, so the toggles are joined (corners squared, borders\n// overlapped); `spaced` keeps them apart. variant, color, size and square on\n// the group reach every toggle that does not set its own. Arrow keys move\n// between toggles (one tab stop, the selected one); Space/Enter flips the\n// focused one. Each toggle's `value` (else its text) is its key.\n//\n//   <ray-toggle-group type=\"single\" value=\"left\" label=\"Alignment\">\n//     <ray-toggle value=\"left\">Left</ray-toggle> …\n//   </ray-toggle-group>\n\nimport { css, define } from \"../../core/core.js\";\nimport { RayButtonGroup } from \"../button-group/button-group.js\";\nimport \"../toggle/toggle.js\";\n\nconst styles = css`\n  /* spaced: apart, each toggle with its own corners. */\n  :host([spaced]) { gap: var(--ray-space-1); flex-wrap: wrap; }\n  /* !important: the joined rules of ray-button-group are more specific. */\n  :host([spaced]) ::slotted(*) {\n    margin: 0 !important;\n    --ray-group-radius-ss: initial !important;\n    --ray-group-radius-se: initial !important;\n    --ray-group-radius-es: initial !important;\n    --ray-group-radius-ee: initial !important;\n  }\n`;\n\n// Group properties handed down to toggles that do not set their own.\nconst INHERITED = [\"variant\", \"color\", \"size\", \"square\", \"radius\"];\n\nexport class RayToggleGroup extends RayButtonGroup {\n  static formAssociated = true;\n  static properties = {\n    ...RayButtonGroup.properties,\n    type: { type: String, reflect: true, default: \"single\" },\n    value: { type: String },\n    name: { type: String, reflect: true },\n    required: { type: Boolean, reflect: true },\n    disabled: { type: Boolean, reflect: true },\n    spaced: { type: Boolean, reflect: true },\n    variant: { type: String, reflect: true },\n    color: { type: String, reflect: true },\n    size: { type: String, reflect: true },\n    radius: { type: String, reflect: true },\n    square: { type: Boolean, reflect: true },\n  };\n  static styles = [...RayButtonGroup.styles, styles];\n\n  /** What the group set on each toggle (so the toggle's own attributes win). */\n  #handed = new WeakMap();\n  #initial = null;\n  #fieldsetDisabled = false;\n\n  constructor() {\n    super();\n    this.internals = this.attachInternals();\n    this.$(\"slot\").addEventListener(\"slotchange\", () => this.requestUpdate());\n    // A toggle flipped itself: apply the group's rule, then announce the\n    // group's value. The toggles' own change events stop here.\n    this.addEventListener(\"change\", (e) => {\n      const t = e.target;\n      if (t === this) return;\n      e.stopPropagation();\n      if (t.localName === \"ray-toggle\" && t.closest(\"ray-toggle-group\") === this) this.#flipped(t);\n    });\n    this.addEventListener(\"keydown\", (e) => this.#key(e));\n    this.addEventListener(\"focusin\", (e) => {\n      const t = e.composedPath().find((n) => n.localName === \"ray-toggle\");\n      if (t && this.toggles.includes(t)) this.#rove(t);\n    });\n  }\n\n  connectedCallback() {\n    this.#initial ??= this.getAttribute(\"value\");\n    super.connectedCallback();\n  }\n\n  formDisabledCallback(disabled) {\n    this.#fieldsetDisabled = disabled;\n    this.requestUpdate();\n  }\n\n  formResetCallback() {\n    this.value = this.#initial ?? undefined;\n  }\n\n  /** The toggles of this group (not of a nested one). */\n  get toggles() {\n    return [...this.querySelectorAll(\"ray-toggle\")].filter((t) => t.closest(\"ray-toggle-group\") === this);\n  }\n\n  get #multiple() {\n    return this.type === \"multiple\";\n  }\n\n  /** The selected values as a list (single: zero or one). */\n  get values() {\n    const v = this.value;\n    if (Array.isArray(v)) return [...v];\n    if (v === null || v === undefined || v === \"\") return [];\n    return this.#multiple ? String(v).split(\",\").map((s) => s.trim()).filter(Boolean) : [String(v)];\n  }\n\n  set values(list) {\n    this.value = this.#multiple ? [...(list ?? [])] : (list?.[0] ?? undefined);\n  }\n\n  #key(e) {\n    const vertical = this.orientation === \"vertical\";\n    const next = vertical ? \"ArrowDown\" : \"ArrowRight\";\n    const prev = vertical ? \"ArrowUp\" : \"ArrowLeft\";\n    if (![next, prev, \"Home\", \"End\"].includes(e.key)) return;\n    const items = this.toggles.filter((t) => !t.disabled);\n    if (items.length === 0) return;\n    const current = items.findIndex((t) => t.matches(\":focus-within\"));\n    let i = current;\n    if (e.key === \"Home\") i = 0;\n    else if (e.key === \"End\") i = items.length - 1;\n    else if (e.key === next) i = (current + 1) % items.length;\n    else i = (current - 1 + items.length) % items.length;\n    e.preventDefault();\n    this.#rove(items[i]);\n    items[i].focus();\n  }\n\n  // One tab stop: the given toggle gets tabindex 0, the others -1 (a host\n  // with a negative tabindex takes its shadow button out of the tab order).\n  #rove(target) {\n    for (const t of this.toggles) t.tabIndex = t === target ? 0 : -1;\n  }\n\n  #keyOf(t) {\n    return t.value ?? t.textContent.trim();\n  }\n\n  #flipped(t) {\n    const key = this.#keyOf(t);\n    const before = this.values;\n    let next;\n    if (this.#multiple) {\n      next = t.pressed ? [...before.filter((v) => v !== key), key] : before.filter((v) => v !== key);\n      // Keep the order of the toggles, not of the clicks.\n      const order = this.toggles.map((x) => this.#keyOf(x));\n      next.sort((a, b) => order.indexOf(a) - order.indexOf(b));\n    } else if (t.pressed) {\n      next = [key];\n    } else {\n      // Single and required: the selected toggle cannot be turned off.\n      next = this.required ? [key] : [];\n    }\n    this.values = next;\n    this.#sync();\n    if (next.join(\"\\n\") !== before.join(\"\\n\")) {\n      this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    }\n  }\n\n  // Pressed states, handed-down properties and tab stops from the value.\n  #sync() {\n    const selected = this.values;\n    const toggles = this.toggles;\n    const disabled = Boolean(this.disabled) || this.#fieldsetDisabled;\n    for (const t of toggles) {\n      t.pressed = selected.includes(this.#keyOf(t));\n      let handed = this.#handed.get(t);\n      if (!handed) this.#handed.set(t, (handed = new Set()));\n      for (const prop of [...INHERITED, \"disabled\"]) {\n        const groupValue = prop === \"disabled\" ? (disabled || undefined) : this[prop];\n        const attr = prop;\n        if (t.hasAttribute(attr) && !handed.has(prop)) continue;\n        if (groupValue === undefined || groupValue === null || groupValue === false) {\n          if (handed.has(prop)) {\n            t[prop] = prop === \"square\" || prop === \"disabled\" ? false : undefined;\n            handed.delete(prop);\n          }\n        } else {\n          t[prop] = groupValue;\n          handed.add(prop);\n        }\n      }\n    }\n    const stop = toggles.find((t) => t.pressed && !t.disabled) ?? toggles.find((t) => !t.disabled);\n    if (!toggles.some((t) => t.matches(\":focus-within\"))) this.#rove(stop);\n  }\n\n  update(changed) {\n    super.update(changed);\n    // A single group never keeps more than one value.\n    if (!this.#multiple && this.values.length > 1) this.commitProperty(\"value\", this.values[0]);\n    this.#sync();\n    const values = this.values;\n    if (this.name && values.length) {\n      if (this.#multiple) {\n        const data = new FormData();\n        for (const v of values) data.append(this.name, v);\n        this.internals.setFormValue(data);\n      } else {\n        this.internals.setFormValue(values[0]);\n      }\n    } else {\n      this.internals.setFormValue(null);\n    }\n    const first = this.toggles[0];\n    if (this.required && values.length === 0) {\n      this.internals.setValidity({ valueMissing: true }, \"Select an option.\", first?._el ?? undefined);\n    } else {\n      this.internals.setValidity({});\n    }\n  }\n}\n\ndefine(\"ray-toggle-group\", RayToggleGroup);\n";
const F68: string = "// <ray-tooltip label=\"…\">: a short hint shown on hover and focus of its\n// child. The label also becomes the child's accessible description.\n\nimport { css, define, uid } from \"../../core/core.js\";\nimport { Floating, floatingStyles } from \"../../core/floating.js\";\nimport { applyColor } from \"../../core/styles.js\";\n\nconst styles = css`\n  :host { display: inline-flex; }\n  .panel {\n    max-width: 20rem;\n    padding: var(--ray-space-1) var(--ray-space-2);\n    font-size: var(--ray-font-size-xs);\n    line-height: var(--ray-line-height-sm);\n    color: var(--ray-background);\n    background: var(--ray-foreground);\n    border: 0;\n    border-radius: var(--ray-radius-sm);\n    box-shadow: var(--ray-shadow-sm);\n    pointer-events: none;\n    white-space: normal;\n    overflow: visible;\n  }\n  .panel[data-colored] { color: var(--_contrast); background: var(--_filled); }\n`;\n\nexport class RayTooltip extends Floating {\n  static properties = {\n    ...Floating.properties,\n    label: { type: String },\n    placement: { type: String, reflect: true, default: \"top\" },\n    offset: { type: Number, default: 6 },\n    openDelay: { type: Number, default: 300 },\n    closeDelay: { type: Number, default: 0 },\n    color: { type: String, reflect: true },\n    disabled: { type: Boolean, reflect: true },\n  };\n  static styles = [floatingStyles, styles];\n  static popoverMode = \"manual\";\n  static lightDismiss = false;\n  static haspopup = null;\n  static triggerSlot = \"slot:not([name])\";\n  static template = `<slot></slot><div class=\"panel\" part=\"tooltip\" role=\"tooltip\"></div>`;\n\n  constructor() {\n    super();\n    this._open = () => this._schedule(true);\n    this._close = () => this._schedule(false);\n    this._esc = (e) => { if (e.key === \"Escape\") this._schedule(false, 0); };\n  }\n\n  wireTrigger(t) {\n    // The description lives in the light DOM (an unassigned, unrendered child)\n    // so the trigger can reference it by id.\n    if (!this._desc) {\n      this._desc = document.createElement(\"span\");\n      this._desc.slot = \"description\";\n      this._desc.id = uid(\"tooltip\");\n      this._desc.hidden = true;\n      this.append(this._desc);\n    }\n    const ids = new Set((t.getAttribute(\"aria-describedby\") ?? \"\").split(/\\s+/).filter(Boolean));\n    ids.add(this._desc.id);\n    t.setAttribute(\"aria-describedby\", [...ids].join(\" \"));\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    this.addEventListener(\"pointerenter\", this._open);\n    this.addEventListener(\"pointerleave\", this._close);\n    this.addEventListener(\"focusin\", this._open);\n    this.addEventListener(\"focusout\", this._close);\n    this.addEventListener(\"pointerdown\", this._close);\n    document.addEventListener(\"keydown\", this._esc);\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    document.removeEventListener(\"keydown\", this._esc);\n    clearTimeout(this._timer);\n  }\n\n  update(changed) {\n    this.panel.textContent = this.label ?? \"\";\n    if (this._desc) this._desc.textContent = this.label ?? \"\";\n    this.panel.toggleAttribute(\"data-colored\", Boolean(this.color));\n    if (this.color) applyColor(this.panel, this.color);\n    if ((this.disabled || !this.label) && this.open) this.commitProperty(\"open\", false);\n    super.update(changed);\n  }\n\n  _schedule(open, delay = open ? this.openDelay : this.closeDelay) {\n    clearTimeout(this._timer);\n    if (open && (this.disabled || !this.label)) return;\n    const apply = () => { this.open = open; };\n    if (delay > 0) this._timer = setTimeout(apply, delay);\n    else apply();\n  }\n}\n\ndefine(\"ray-tooltip\", RayTooltip);\n";
const F69: string = "// Chart theming: ray-ds draws no charts; this hands the chart tokens\n// (--ray-chart-*, tokens.toml) to a chart library.\n//\n// SVG/HTML charts can use the CSS variables directly (fill: var(--ray-chart-1))\n// and follow the theme by themselves. Canvas libraries (Chart.js, uPlot,\n// ECharts…) need concrete colors: chartTheme() resolves them for the\n// current theme of an element, and onChartThemeChange() tells when to redraw.\n\nimport { onThemeChange, resolvedTheme } from \"./core.js\";\n\n/** Number of series colors (--ray-chart-1 … --ray-chart-8). */\nexport const CHART_SERIES = 8;\n\nlet ctx = null;\n\n/**\n * A computed CSS color as \"#rrggbb\" (opaque) or \"rgba(r, g, b, a)\" — what every\n * canvas accepts. Computed values come as rgb()/rgba() or, for color-mix() and\n * friends, as color(srgb r g b / a), which WebKit's canvas does not take:\n * parsed here rather than trusted to the canvas.\n */\nfunction normalize(color) {\n  const c = String(color).trim();\n  let rgba = null;\n  const srgb = c.match(/^color\\(srgb\\s+([^)]+)\\)$/i);\n  const fn = c.match(/^rgba?\\(([^)]+)\\)$/i);\n  if (srgb) {\n    const [chan, alpha] = srgb[1].split(\"/\");\n    const [r, g, b] = chan.trim().split(/\\s+/).map((x) => Number(x) * 255);\n    rgba = [r, g, b, alpha === undefined ? 1 : Number(alpha)];\n  } else if (fn) {\n    const parts = fn[1].replace(\"/\", \" \").split(/[\\s,]+/).filter(Boolean).map(Number);\n    rgba = [parts[0], parts[1], parts[2], parts.length > 3 ? parts[3] : 1];\n  }\n  if (!rgba || rgba.some((x) => Number.isNaN(x))) {\n    // Anything else (a named color, hex): let the canvas serialize it.\n    ctx ??= document.createElement(\"canvas\").getContext(\"2d\");\n    ctx.fillStyle = \"#000000\";\n    ctx.fillStyle = c;\n    return ctx.fillStyle;\n  }\n  const [r, g, b, a] = rgba.map((x, i) => (i < 3 ? Math.round(Math.min(255, Math.max(0, x))) : x));\n  if (a >= 1) return `#\${[r, g, b].map((x) => x.toString(16).padStart(2, \"0\")).join(\"\")}`;\n  return `rgba(\${r}, \${g}, \${b}, \${a})`;\n}\n\n/**\n * A color with an alpha, for area fills and highlights: withAlpha(\"#1c7ed6\", 0.2).\n * @returns {string} rgba(...)\n */\nexport function withAlpha(color, alpha) {\n  const c = normalize(color);\n  const hex = c.startsWith(\"#\") ? c : null;\n  let r, g, b;\n  if (hex) {\n    const n = parseInt(hex.slice(1), 16);\n    [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];\n  } else {\n    [r, g, b] = c.match(/[\\d.]+/g).map(Number);\n  }\n  return `rgba(\${r}, \${g}, \${b}, \${alpha})`;\n}\n\n/**\n * The chart tokens resolved for the theme of `el` (default: the document):\n * its color scheme, data-primary and any token overrides apply.\n * @param {Element} [el]\n */\nexport function chartTheme(el = document.documentElement) {\n  const host = el === document.documentElement ? document.body ?? el : el;\n  const probe = document.createElement(\"span\");\n  probe.style.cssText = \"position:absolute;visibility:hidden;pointer-events:none;width:0;height:0;overflow:hidden\";\n  host.append(probe);\n  const color = (name) => {\n    probe.style.color = `var(--ray-\${name})`;\n    return normalize(getComputedStyle(probe).color);\n  };\n  try {\n    const series = [];\n    for (let i = 1; i <= CHART_SERIES; i++) series.push(color(`chart-\${i}`));\n    probe.style.fontFamily = \"var(--ray-font-sans)\";\n    probe.style.fontSize = \"var(--ray-font-size-xs)\";\n    const cs = getComputedStyle(probe);\n    return {\n      scheme: resolvedTheme(el),\n      series,\n      background: color(\"background\"),\n      grid: color(\"chart-grid\"),\n      axis: color(\"chart-axis\"),\n      text: color(\"chart-text\"),\n      tooltip: { background: color(\"chart-tooltip\"), text: color(\"chart-tooltip-text\"), border: color(\"chart-tooltip-border\") },\n      font: { family: cs.fontFamily, size: parseFloat(cs.fontSize) },\n    };\n  } finally {\n    probe.remove();\n  }\n}\n\n/**\n * Calls `cb(chartTheme(el))` whenever the theme changes (setTheme,\n * setPrimary, definePrimary, the system scheme). Returns a function that stops.\n * @param {(theme: ReturnType<typeof chartTheme>) => void} cb\n */\nexport function onChartThemeChange(cb, el = document.documentElement) {\n  // After the change has applied (attributes and styles are set synchronously).\n  return onThemeChange(() => queueMicrotask(() => cb(chartTheme(el))));\n}\n";
const F70: string = "// Color math for definePrimary(): parse any CSS color, build a ten-shade\n// scale in OKLCH (perceptually even lightness, same hue), and measure WCAG\n// contrast. OKLab from Björn Ottosson (https://bottosson.github.io/posts/oklab/).\n\n/** Target lightness (OKLab L) of shades 0…9, like the open-color scales. */\nconst LIGHTNESS = [0.97, 0.93, 0.87, 0.8, 0.73, 0.67, 0.61, 0.55, 0.49, 0.43];\n/** Chroma of each shade relative to the base color's (pale ends are less saturated). */\nconst CHROMA = [0.12, 0.25, 0.45, 0.65, 0.8, 0.92, 1, 1, 0.95, 0.88];\n\nlet ctx = null;\n\n/**\n * Any CSS color the browser understands (\"#7c3aed\", \"rebeccapurple\",\n * \"oklch(60% 0.2 280)\") as sRGB channels 0…1, or null if it is not a color.\n */\nexport function parseColor(input) {\n  if (typeof input !== \"string\" || !input.trim()) return null;\n  ctx ??= document.createElement(\"canvas\").getContext(\"2d\");\n  // A sentinel tells an invalid color (fillStyle keeps the previous value) apart.\n  for (const sentinel of [\"#010203\", \"#040506\"]) {\n    ctx.fillStyle = sentinel;\n    ctx.fillStyle = input.trim();\n    const v = ctx.fillStyle;\n    if (v !== sentinel) return fromCanvas(v);\n  }\n  // Both sentinels survived: the input is one of them, or invalid.\n  const t = input.trim().toLowerCase();\n  return t === \"#010203\" || t === \"#040506\" ? fromCanvas(t) : null;\n}\n\nfunction fromCanvas(v) {\n  if (v.startsWith(\"#\")) {\n    const n = parseInt(v.slice(1), 16);\n    return { r: ((n >> 16) & 255) / 255, g: ((n >> 8) & 255) / 255, b: (n & 255) / 255 };\n  }\n  const m = v.match(/rgba?\\(([^)]+)\\)/);\n  if (!m) return null;\n  const [r, g, b] = m[1].split(\",\").map((x) => Number(x.trim()) / 255);\n  return { r, g, b };\n}\n\nexport function toHex({ r, g, b }) {\n  const h = (x) => Math.round(Math.min(1, Math.max(0, x)) * 255).toString(16).padStart(2, \"0\");\n  return `#\${h(r)}\${h(g)}\${h(b)}`;\n}\n\nconst toLinear = (c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);\nconst fromLinear = (c) => (c <= 0.0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - 0.055);\n\nexport function toOklch({ r, g, b }) {\n  const [lr, lg, lb] = [toLinear(r), toLinear(g), toLinear(b)];\n  const l = Math.cbrt(0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb);\n  const m = Math.cbrt(0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb);\n  const s = Math.cbrt(0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb);\n  const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;\n  const A = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;\n  const B = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;\n  return { l: L, c: Math.hypot(A, B), h: Math.atan2(B, A) };\n}\n\nexport function fromOklch({ l: L, c, h }) {\n  const A = c * Math.cos(h);\n  const B = c * Math.sin(h);\n  const l = (L + 0.3963377774 * A + 0.2158037573 * B) ** 3;\n  const m = (L - 0.1055613458 * A - 0.0638541728 * B) ** 3;\n  const s = (L - 0.0894841775 * A - 1.291485548 * B) ** 3;\n  return {\n    r: fromLinear(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s),\n    g: fromLinear(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s),\n    b: fromLinear(-0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s),\n  };\n}\n\nconst inGamut = ({ r, g, b }) => [r, g, b].every((x) => x >= -0.0005 && x <= 1.0005);\n\n/** The color with chroma reduced until it fits in sRGB. */\nfunction fit(lch) {\n  let c = lch.c;\n  let rgb = fromOklch({ ...lch, c });\n  for (let i = 0; i < 60 && !inGamut(rgb); i++) {\n    c *= 0.95;\n    rgb = fromOklch({ ...lch, c });\n  }\n  return rgb;\n}\n\n/**\n * Ten shades (0 = lightest) around `rgb`: the base color itself sits at the\n * shade whose lightness is closest to its own; the others keep its hue.\n * @returns {string[]} hex colors\n */\nexport function shades(rgb) {\n  const base = toOklch(rgb);\n  let closest = 0;\n  LIGHTNESS.forEach((l, i) => {\n    if (Math.abs(l - base.l) < Math.abs(LIGHTNESS[closest] - base.l)) closest = i;\n  });\n  return LIGHTNESS.map((l, i) => (i === closest ? toHex(rgb) : toHex(fit({ l, c: base.c * CHROMA[i], h: base.h }))));\n}\n\nfunction luminance(hex) {\n  const { r, g, b } = fromCanvas(hex);\n  return 0.2126 * toLinear(r) + 0.7152 * toLinear(g) + 0.0722 * toLinear(b);\n}\n\n/** WCAG contrast ratio of two hex colors (1…21). */\nexport function contrastRatio(a, b) {\n  const [x, y] = [luminance(a), luminance(b)].sort((p, q) => q - p);\n  return (x + 0.05) / (y + 0.05);\n}\n";
const F71: string = "// ray-ds core runtime: the base class of every component, shared styles and\n// the theme API. No dependencies; loads as a plain ES module (also from\n// ray://app in a std/ui window).\n\nimport { getIcon, onIconsChange } from \"./icons.js\";\nimport { parseColor, shades, contrastRatio, toHex, toOklch } from \"./color.js\";\n\nexport { setIcons, getIcon, iconNames } from \"./icons.js\";\n\nexport const PREFIX = \"ray\";\n\n// ---------------------------------------------------------------------------\n// Styles\n// ---------------------------------------------------------------------------\n\nconst sheets = new Map();\n\n/**\n * A constructable stylesheet from CSS text, shared by every instance (and every\n * component) that asks for the same text.\n * @param {TemplateStringsArray | string} strings\n * @param {...unknown} values\n * @returns {CSSStyleSheet}\n */\nexport function css(strings, ...values) {\n  const text = typeof strings === \"string\"\n    ? strings\n    : strings.reduce((acc, s, i) => acc + s + (i < values.length ? String(values[i]) : \"\"), \"\");\n  let sheet = sheets.get(text);\n  if (!sheet) {\n    sheet = new CSSStyleSheet();\n    sheet.replaceSync(text);\n    sheets.set(text, sheet);\n  }\n  return sheet;\n}\n\n/**\n * Applied until a component's first update has been painted: it does not\n * transition into its initial state. Its styles depend on what update()\n * sets (data-variant, color variables); if the browser computed its style\n * before that (a layout read by another component while the page loads),\n * the variant would animate in from no style at all: black text and a\n * border fading out.\n */\nconst settlingStyles = css`*, *::before, *::after { transition: none !important; }`;\n\n/** Applied to every component before its own styles. */\nexport const hostStyles = css`\n  :host { box-sizing: border-box; }\n  :host([hidden]) { display: none !important; }\n  /* hidden always hides, whatever display a component's own rule gives. */\n  [hidden] { display: none !important; }\n  *, *::before, *::after { box-sizing: inherit; }\n  /* Icons of the registry (paintIcons). Zero specificity: components size them. */\n  :where([data-ray-icon]) { display: inline-flex; align-items: center; justify-content: center; flex: none; }\n  :where([data-ray-icon]) > svg {\n    width: var(--ray-icon-size, 1em);\n    height: var(--ray-icon-size, 1em);\n    stroke-width: var(--ray-icon-stroke, 2);\n  }\n  .focus-ring:focus-visible {\n    outline: var(--ray-focus-ring-width) solid var(--ray-ring);\n    outline-offset: var(--ray-focus-ring-offset);\n  }\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; }\n  }\n`;\n\n// ---------------------------------------------------------------------------\n// Base element\n// ---------------------------------------------------------------------------\n\n/**\n * @typedef {object} PropertyOptions\n * @property {StringConstructor | NumberConstructor | BooleanConstructor} [type]\n * @property {boolean} [reflect]   write the property back to its attribute\n * @property {string | false} [attribute]  attribute name (kebab-case of the property by default); false = property only\n * @property {unknown} [default]\n */\n\n// Per-class data kept outside the classes, so subclasses cannot clash with it.\nconst templates = new WeakMap();\nconst attrMaps = new WeakMap();\nconst extraStyles = new WeakMap();\n/** Connected ray-ds elements (restyled by extendStyles, repainted by setIcons). */\nconst live = new Set();\n/** Tag -> { property: value }, from configure({ defaults }). */\nconst componentDefaults = new Map();\n\n/**\n * Base class of ray-ds components.\n *\n * Subclasses declare `static properties`, `static styles` and `static template`,\n * and implement `update(changed)`, called once per microtask after any change\n * (and once on first connection).\n *\n * Extension contract: the public and protected members below are stable;\n * every other member of a ray-ds class whose name starts with `_` or `#` is\n * internal and may change. Do not name your own members with a leading `_`.\n */\nexport class RayElement extends HTMLElement {\n  /** @type {Record<string, PropertyOptions>} */\n  static properties = {};\n  /** @type {CSSStyleSheet[]} */\n  static styles = [];\n  /** Shadow DOM markup, cloned per instance. */\n  static template = \"\";\n  /** Forward focus into the first focusable element of the shadow root. */\n  static delegatesFocus = false;\n\n  static get observedAttributes() {\n    return [...RayElement.#attributes(this).keys()];\n  }\n\n  /** attribute -> property map of a class, built (with its accessors) once. */\n  static #attributes(cls) {\n    let map = attrMaps.get(cls);\n    if (map) return map;\n    map = new Map();\n    attrMaps.set(cls, map);\n    for (const [name, opts] of Object.entries(cls.properties)) {\n      const attr = opts.attribute === false ? null : (opts.attribute ?? kebab(name));\n      if (attr) map.set(attr, name);\n      Object.defineProperty(cls.prototype, name, {\n        configurable: true,\n        enumerable: true,\n        get() { return this.#get(name); },\n        set(v) { this.#set(name, v); },\n      });\n    }\n    return map;\n  }\n\n  /**\n   * Adds stylesheets to this component (and its subclasses), also to the\n   * instances already on the page: custom variants, app-wide tweaks.\n   *   RayButton.extendStyles(css`[data-variant=\"brand\"] { … }`)\n   */\n  static extendStyles(...sheets) {\n    extraStyles.set(this, [...(extraStyles.get(this) ?? []), ...sheets]);\n    for (const el of live) {\n      if (el instanceof this) el.#adoptStyles();\n    }\n  }\n\n  #values = new Map();\n  #changed = new Map();\n  #pending = false;\n  #reflecting = false;\n  #settled = false;\n\n  constructor() {\n    super();\n    const ctor = /** @type {typeof RayElement} */ (this.constructor);\n    RayElement.