lor); }\n  :host([color]:hover), :host([color]:focus) { background: var(--_light); color: var(--_light-color); }\n  :host([disabled]) { color: var(--ray-muted-foreground); background: transparent; cursor: not-allowed; opacity: 0.6; }\n  .label { flex: 1; white-space: nowrap; }\n  .section { display: inline-flex; align-items: center; color: var(--ray-muted-foreground); }\n  :host([color]) .section { color: inherit; }\n  .section:not([data-filled]) { display: none; }\n  .right { margin-left: var(--ray-space-6); font-size: var(--ray-font-size-xs); }\n  ::slotted(svg) { width: 1rem; height: 1rem; }\n`;\n\nexport class RayMenuItem extends RayElement {\n  static properties = {\n    value: { type: String, reflect: true },\n    disabled: { type: Boolean, reflect: true },\n    color: { type: String, reflect: true },\n  };\n  static styles = [itemStyles];\n  static template = `<span class=\"section left\" part=\"left-section\"><slot name=\"left\"></slot></span><span class=\"label\" part=\"label\"><slot></slot></span><span class=\"section right\" part=\"right-section\"><slot name=\"right\"></slot></span>`;\n\n  constructor() {\n    super();\n    this.internals = this.attachInternals();\n    this.internals.role = \"menuitem\";\n    for (const slot of this.shadowRoot.querySelectorAll(\"slot[name]\")) {\n      slot.addEventListener(\"slotchange\", () => slot.parentElement.toggleAttribute(\"data-filled\", slot.assignedNodes().length > 0));\n    }\n  }\n\n  update() {\n    this.tabIndex = -1;\n    this.internals.ariaDisabled = this.disabled ? \"true\" : \"false\";\n    if (this.color) applyColor(this, this.color);\n  }\n}\n\nconst labelStyles = css`\n  :host {\n    display: block;\n    padding: var(--ray-space-2) var(--ray-space-2) var(--ray-space-1);\n    font-size: var(--ray-font-size-xs);\n    font-weight: var(--ray-font-weight-medium);\n    color: var(--ray-muted-foreground);\n  }\n`;\n\nexport class RayMenuLabel extends RayElement {\n  static styles = [labelStyles];\n  static template = `<slot></slot>`;\n  constructor() {\n    super();\n    this.attachInternals().role = \"presentation\";\n  }\n}\n\nconst dividerStyles = css`\n  :host { display: block; height: 1px; margin: var(--ray-space-1) calc(var(--ray-space-1) * -1); background: var(--ray-border); }\n`;\n\nexport class RayMenuDivider extends RayElement {\n  static styles = [dividerStyles];\n  constructor() {\n    super();\n    this.attachInternals().role = \"separator\";\n  }\n}\n\ndefine(\"ray-menu\", RayMenu);\ndefine(\"ray-menu-item\", RayMenuItem);\ndefine(\"ray-menu-label\", RayMenuLabel);\ndefine(\"ray-menu-divider\", RayMenuDivider);\n";
const F37: string = "// <ray-nav-link>: an item of a sidebar or navigation (Mantine's NavLink): icon,\n// label, description, a badge on the right, active state, and nested\n// ray-nav-links that collapse under it.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor } from \"../../core/styles.js\";\n\nconst styles = css`\n  :host { display: block; }\n  .link {\n    display: flex;\n    align-items: center;\n    gap: var(--ray-space-3);\n    width: 100%;\n    min-height: 2.25rem;\n    padding: var(--ray-space-1) var(--ray-space-3);\n    font: inherit;\n    font-size: var(--ray-font-size-sm);\n    color: var(--ray-foreground);\n    text-align: left;\n    text-decoration: none;\n    background: transparent;\n    border: 0;\n    border-radius: var(--ray-radius-sm);\n    cursor: pointer;\n  }\n  .link:hover { background: var(--ray-accent); }\n  .link[data-active] { color: var(--_light-color); background: var(--_light); font-weight: var(--ray-font-weight-medium); }\n  .link[data-active]:hover { background: var(--_light-hover); }\n  :host([variant=\"filled\"]) .link[data-active] { color: var(--_contrast); background: var(--_filled); }\n  :host([variant=\"filled\"]) .link[data-active]:hover { background: var(--_filled-hover); }\n  :host([variant=\"subtle\"]) .link[data-active] { background: transparent; }\n  :host([disabled]) .link { color: var(--ray-muted-foreground); cursor: not-allowed; background: transparent; opacity: 0.6; }\n  .body { display: flex; flex: 1; flex-direction: column; min-width: 0; }\n  .label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .description { font-size: var(--ray-font-size-xs); color: var(--ray-muted-foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .link[data-active] .description { color: inherit; opacity: 0.8; }\n  .description:empty { display: none; }\n  .section { display: inline-flex; flex: none; align-items: center; }\n  .section:not([data-filled]) { display: none; }\n  ::slotted(svg) { width: 1rem; height: 1rem; }\n  .chevron { display: none; flex: none; color: var(--ray-muted-foreground); transition: transform var(--ray-duration-base) var(--ray-easing-standard); }\n  .chevron svg { width: 0.875rem; height: 0.875rem; }\n  :host([data-parent]) .chevron { display: inline-flex; }\n  :host([opened]) .chevron { transform: rotate(90deg); }\n  /* Children expand and collapse: a 0fr → 1fr grid row animates the height\n     in both directions without measuring it (like the accordion). */\n  .children {\n    display: grid;\n    grid-template-rows: 0fr;\n    opacity: 0;\n    transition: grid-template-rows var(--ray-duration-base) var(--ray-easing-standard), opacity var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  :host([data-parent][opened]) .children { grid-template-rows: 1fr; opacity: 1; }\n  /* icon-only (a collapsed ray-sidebar): just the left section, centered;\n     the label stays as the accessible name and the tooltip. */\n  :host([icon-only]) .link { justify-content: center; gap: 0; padding-inline: 0; }\n  :host([icon-only]) .body, :host([icon-only]) .chevron, :host([icon-only]) .section.right { display: none; }\n  :host([icon-only]) .children { display: none; }\n  /* 2px of room so the focus ring of a child is not clipped. */\n  .children-inner { min-height: 0; overflow: hidden; margin: -2px 0; padding: 2px 0 2px var(--ray-space-5); }\n`;\n\nconst INNER = `\n  <span class=\"section\" part=\"left-section\"><slot name=\"left\"></slot></span>\n  <span class=\"body\"><span class=\"label\" part=\"label\"></span><span class=\"description\" part=\"description\"></span></span>\n  <span class=\"section right\" part=\"right-section\"><slot name=\"right\"></slot></span>\n  <span class=\"chevron\" aria-hidden=\"true\" data-ray-icon=\"chevron-right\"></span>`;\n\nexport class RayNavLink extends RayElement {\n  static delegatesFocus = true;\n  static properties = {\n    label: { type: String },\n    description: { type: String },\n    href: { type: String, reflect: true },\n    active: { type: Boolean, reflect: true },\n    disabled: { type: Boolean, reflect: true },\n    opened: { type: Boolean, reflect: true },\n    variant: { type: String, reflect: true, default: \"light\" },\n    color: { type: String, reflect: true },\n    iconOnly: { type: Boolean, reflect: true },\n  };\n  static styles = [styles];\n  static template = `<div class=\"children\" part=\"children\" role=\"group\"><div class=\"children-inner\"><slot></slot></div></div>`;\n\n  constructor() {\n    super();\n    this._children = this.$(\".children slot\");\n    this._children.addEventListener(\"slotchange\", () => this.requestUpdate());\n  }\n\n  /** Nested ray-nav-links. */\n  get links() {\n    return this._children.assignedElements().filter((el) => el.localName === \"ray-nav-link\");\n  }\n\n  update() {\n    const parent = this.links.length > 0;\n    this.toggleAttribute(\"data-parent\", parent);\n    // A parent toggles its children; a leaf with href is a link.\n    // A disabled link is a disabled button: an <a> without href is not a link.\n    const tag = this.href && !parent && !this.disabled ? \"a\" : \"button\";\n    if (!this._el || this._el.localName !== tag) this._render(tag);\n    const el = this._el;\n    el.querySelector(\".label\").textContent = this.label ?? \"\";\n    el.querySelector(\".description\").textContent = this.description ?? \"\";\n    el.toggleAttribute(\"data-active\", Boolean(this.active));\n    applyColor(el, this.color);\n    if (tag === \"a\") {\n      if (this.disabled) el.removeAttribute(\"href\");\n      else el.href = this.href;\n    } else {\n      el.disabled = Boolean(this.disabled);\n    }\n    if (this.active && !parent) el.setAttribute(\"aria-current\", \"page\");\n    else el.removeAttribute(\"aria-current\");\n    if (parent) el.setAttribute(\"aria-expanded\", String(Boolean(this.opened)));\n    else el.removeAttribute(\"aria-expanded\");\n    // Collapsed children: not focusable nor read (they are only 0px tall).\n    this.$(\".children\").inert = parent && !this.opened;\n    if (this.disabled) el.setAttribute(\"aria-disabled\", \"true\");\n    else el.removeAttribute(\"aria-disabled\");\n    // Icon only: the label (hidden) still names the link, and shows on hover.\n    if (this.iconOnly && this.label) {\n      el.setAttribute(\"aria-label\", this.label);\n      el.title = this.label;\n    } else {\n      el.removeAttribute(\"aria-label\");\n      el.removeAttribute(\"title\");\n    }\n  }\n\n  _render(tag) {\n    this._el?.remove();\n    const el = document.createElement(tag);\n    el.className = \"link focus-ring\";\n    el.setAttribute(\"part\", \"link\");\n    if (tag === \"button\") el.type = \"button\";\n    el.innerHTML = INNER;\n    for (const slot of el.querySelectorAll(\"slot[name]\")) {\n      const sync = () => slot.parentElement.toggleAttribute(\"data-filled\", slot.assignedNodes().length > 0);\n      slot.addEventListener(\"slotchange\", sync);\n    }\n    el.addEventListener(\"click\", (e) => {\n      if (this.disabled) {\n        e.preventDefault();\n        return;\n      }\n      if (this.links.length > 0) {\n        this.opened = !this.opened;\n        this.emit(\"ray-toggle\", { opened: this.opened });\n      }\n    });\n    this.shadowRoot.prepend(el);\n    this._el = el;\n  }\n}\n\ndefine(\"ray-nav-link\", RayNavLink);\n";
const F38: string = "// <ray-notification>: a message card (title, text, status icon, loader, close).\n// <ray-toaster>: the stack notify() shows them in — a polite live region in\n// the top layer (Popover API), so toasts stay visible above dialogs.\n//\n// API (Mantine's notifications):\n//   const id = notify({ title, message, color, icon, loading, autoClose, closable, action: { label, onClick }, id })\n//   updateNotification(id, { … })   hideNotification(id)   clearNotifications()\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { motionAllowed, play } from \"../../core/motion.js\";\nimport { applyColor } from \"../../core/styles.js\";\n\nconst notificationStyles = css`\n  :host { display: block; }\n  .card {\n    position: relative;\n    display: flex;\n    align-items: flex-start;\n    gap: var(--ray-space-3);\n    padding: var(--ray-space-3) var(--ray-space-3) var(--ray-space-3) var(--ray-space-4);\n    overflow: hidden;\n    color: var(--ray-popover-foreground);\n    background: var(--ray-popover);\n    border: 1px solid transparent;\n    border-radius: var(--ray-radius-lg);\n    box-shadow: var(--ray-shadow-lg);\n  }\n  :host([with-border]) .card { border-color: var(--ray-border); }\n  /* Behind the front toast of a collapsed stack: only its edge shows. */\n  .card > * { transition: opacity var(--ray-duration-base) var(--ray-easing-standard); }\n  :host([data-behind]) .card > * { opacity: 0; }\n  .card[data-icon], .card[data-loading], .card[data-glyph] { padding-left: var(--ray-space-3); }\n  .icon {\n    display: none;\n    flex: none;\n    align-items: center;\n    justify-content: center;\n    width: 1.75rem;\n    height: 1.75rem;\n    color: var(--_contrast);\n    background: var(--_filled);\n    border-radius: 50%;\n  }\n  .card[data-icon] .icon { display: inline-flex; }\n  /* The loader: an SVG ring drawn like the status icons' circle (r 9 of the\n     same 24 grid, same stroke), so it is not larger or heavier than a check\n     or a cross. A CSS border could not match: browsers round its width. */\n  .loader {\n    display: none;\n    flex: none;\n    color: var(--_light-color);\n    --ray-icon-size: var(--ray-notification-icon-size, 1.5rem);\n    --ray-icon-stroke: var(--ray-notification-icon-stroke, 1.5);\n  }\n  .loader svg {\n    width: var(--ray-icon-size);\n    height: var(--ray-icon-size);\n    fill: none;\n    stroke: currentColor;\n    stroke-width: var(--ray-icon-stroke);\n    stroke-linecap: round;\n    animation: ray-spin 0.75s linear infinite;\n  }\n  @keyframes ray-spin { to { transform: rotate(360deg); } }\n  @media (prefers-reduced-motion: reduce) {\n    .loader svg { animation-duration: 1.5s; }\n  }\n  /* A colored notification's status icon, where the loader goes. The\n     light-color shade: legible on the card in both schemes (yellow too).\n     Larger and thinner than inline icons; tuned with --ray-notification-icon-size\n     and --ray-notification-icon-stroke. */\n  .glyph {\n    display: none;\n    flex: none;\n    color: var(--_light-color);\n    --ray-icon-size: var(--ray-notification-icon-size, 1.5rem);\n    --ray-icon-stroke: var(--ray-notification-icon-stroke, 1.5);\n  }\n  .card[data-glyph] .glyph { display: inline-flex; }\n  .card[data-loading] .glyph, .card[data-icon] .glyph { display: none !important; }\n  .card[data-loading] .loader { display: inline-flex; }\n  .card[data-loading] .icon { display: none; }\n  ::slotted(svg) { width: 1rem; height: 1rem; }\n  .body { flex: 1; min-width: 0; }\n  .title { margin: 0 0 0.125rem; font-size: var(--ray-font-size-sm); font-weight: var(--ray-font-weight-semibold); }\n  .title:empty { display: none; }\n  .message { font-size: var(--ray-font-size-sm); color: var(--ray-muted-foreground); overflow-wrap: anywhere; }\n  .title:empty + .message { color: var(--ray-popover-foreground); }\n  .close {\n    flex: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 1.75rem;\n    height: 1.75rem;\n    padding: 0;\n    color: var(--ray-muted-foreground);\n    background: transparent;\n    border: 0;\n    border-radius: var(--ray-radius-sm);\n    cursor: pointer;\n  }\n  .close:hover { background: var(--ray-accent); color: var(--ray-foreground); }\n  .action {\n    flex: none;\n    align-self: center;\n    height: 1.75rem;\n    padding: 0 var(--ray-space-3);\n    font: inherit;\n    font-size: var(--ray-font-size-xs);\n    font-weight: var(--ray-font-weight-medium);\n    color: var(--ray-foreground);\n    background: var(--ray-default);\n    border: 1px solid var(--ray-border);\n    border-radius: var(--ray-radius-default);\n    cursor: pointer;\n  }\n  .action:hover { background: var(--ray-default-hover); }\n  .card:has(.action:not([hidden])) .close { align-self: center; }\n  .close svg { width: 1rem; height: 1rem; }\n  [hidden] { display: none !important; }\n`;\n\n/** The status icon of a color: success, error, warning, else info. */\nexport function statusIcon(color) {\n  if (color === \"green\" || color === \"teal\") return \"circle-check\";\n  if (color === \"red\" || color === \"pink\") return \"circle-x\";\n  if (color === \"yellow\" || color === \"orange\") return \"alert-triangle\";\n  return \"info\";\n}\n\nexport class RayNotification extends RayElement {\n  static properties = {\n    label: { type: String },\n    color: { type: String, reflect: true },\n    loading: { type: Boolean, reflect: true },\n    hideClose: { type: Boolean, reflect: true },\n    withBorder: { type: Boolean, reflect: true },\n    actionLabel: { type: String },\n    icon: { type: String },\n  };\n  static styles = [notificationStyles];\n  static template = `\n    <div class=\"card\" part=\"card\">\n      <span class=\"icon\" part=\"icon\"><slot name=\"icon\"></slot></span>\n      <span class=\"loader\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\" stroke-dasharray=\"42.4 14.1\"/></svg></span>\n      <span class=\"glyph\" part=\"status-icon\" aria-hidden=\"true\"></span>\n      <div class=\"body\">\n        <p class=\"title\" part=\"title\"></p>\n        <div class=\"message\" part=\"message\"><slot></slot></div>\n      </div>\n      <button class=\"action focus-ring\" part=\"action\" type=\"button\" hidden></button>\n      <button class=\"close focus-ring\" part=\"close\" type=\"button\" aria-label=\"Close notification\"><span data-ray-icon=\"close\" aria-hidden=\"true\"></span></button>\n    </div>`;\n\n  constructor() {\n    super();\n    this.$(\".close\").addEventListener(\"click\", () => this.emit(\"ray-close\"));\n    this.$(\".action\").addEventListener(\"click\", () => this.emit(\"ray-action\"));\n    const icon = this.$('slot[name=\"icon\"]');\n    icon.addEventListener(\"slotchange\", () => this.$(\".card\").toggleAttribute(\"data-icon\", icon.assignedNodes().length > 0));\n  }\n\n  update() {\n    const card = this.$(\".card\");\n    applyColor(card, this.color);\n    card.toggleAttribute(\"data-loading\", Boolean(this.loading));\n    // Status icon: the `icon` given, else one that fits the color.\n    const glyph = this.icon === \"none\" ? \"\" : (this.icon || (this.color ? statusIcon(this.color) : \"\"));\n    card.toggleAttribute(\"data-glyph\", Boolean(glyph));\n    const g = this.$(\".glyph\");\n    if (glyph && g.getAttribute(\"data-ray-icon\") !== glyph) {\n      g.setAttribute(\"data-ray-icon\", glyph);\n      this.paintIcons(card);\n    }\n    this.$(\".title\").textContent = this.label ?? \"\";\n    this.$(\".close\").hidden = Boolean(this.hideClose);\n    const action = this.$(\".action\");\n    action.hidden = !this.actionLabel;\n    action.textContent = this.actionLabel ?? \"\";\n  }\n}\n\nconst toasterStyles = css`\n  :host {\n    position: fixed;\n    inset: auto;\n    z-index: var(--ray-z-toast);\n    box-sizing: content-box;\n    display: block;\n    width: min(24rem, calc(100vw - 2rem));\n    margin: 0;\n    padding: var(--ray-space-4);\n    overflow: visible;\n    color: inherit;\n    background: transparent;\n    border: 0;\n    pointer-events: none;\n    transition: height var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  :host(:not(:popover-open)) { display: none; }\n  :host([position^=\"top\"]) { top: 0; }\n  :host([position^=\"bottom\"]), :host(:not([position])) { bottom: 0; }\n  :host([position$=\"right\"]), :host(:not([position])) { right: 0; }\n  :host([position$=\"left\"]) { left: 0; }\n  :host([position$=\"center\"]) { left: 50%; transform: translateX(-50%); }\n  /* Toasts are placed by layout(): absolute, stacked from the edge. */\n  ::slotted(*) {\n    position: absolute;\n    left: var(--ray-space-4);\n    right: var(--ray-space-4);\n    pointer-events: auto;\n    touch-action: pan-y;\n    transform-origin: 50% 100%;\n    transition:\n      transform var(--ray-duration-base) var(--ray-easing-standard),\n      opacity var(--ray-duration-base) var(--ray-easing-standard),\n      height var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  :host([position^=\"bottom\"]) ::slotted(*), :host(:not([position])) ::slotted(*) { bottom: var(--ray-space-4); }\n  :host([position^=\"top\"]) ::slotted(*) { top: var(--ray-space-4); transform-origin: 50% 0; }\n  ::slotted([data-swiping]) { transition: none; }\n  /* Phones: full width at the bottom (or top), wherever the desktop position is. */\n  @media (max-width: 40em) {\n    :host { width: auto; left: 0; right: 0; transform: none; padding: var(--ray-space-3); }\n    :host([position^=\"top\"]) { top: 0; bottom: auto; }\n    :host(:not([position^=\"top\"])) { bottom: 0; top: auto; }\n    ::slotted(*) { left: var(--ray-space-3); right: var(--ray-space-3); }\n    :host(:not([position^=\"top\"])) ::slotted(*) { bottom: var(--ray-space-3); }\n    :host([position^=\"top\"]) ::slotted(*) { top: var(--ray-space-3); }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    :host, ::slotted(*) { transition: none; }\n  }\n`;\n\n// A modal <dialog> makes everything outside it inert, toasts included. While\n// modal ray-ds overlays are open, the toaster lives in the topmost one (its\n// \"overlay\" slot renders inside the <dialog>), and goes back to <body> after.\nconst openDialogs = [];\n// Any modal ray-ds overlay with an \"overlay\" slot (dialog, drawer, palette).\nconst hostsToasts = (el) => Boolean(el.shadowRoot?.querySelector('slot[name=\"overlay\"]') && el.dialog?.matches?.(\":modal\"));\ndocument.addEventListener(\"ray-open\", (e) => {\n  if (hostsToasts(e.target) && !openDialogs.includes(e.target)) {\n    openDialogs.push(e.target);\n    rehome();\n  }\n});\ndocument.addEventListener(\"ray-close\", (e) => {\n  const i = openDialogs.indexOf(e.target);\n  if (i >= 0) {\n    openDialogs.splice(i, 1);\n    rehome();\n  }\n});\n\nfunction rehome() {\n  const t = document.querySelector(\"ray-toaster\");\n  if (!t) return;\n  const host = openDialogs.filter((d) => d.isConnected).at(-1) ?? document.body;\n  if (t.parentElement === host) return;\n  if (host === document.body) t.removeAttribute(\"slot\");\n  else t.slot = \"overlay\";\n  host.append(t);\n  t.raise();\n}\n\n// Collapsed stack: how much of each toast behind the front one shows, and\n// how much smaller it gets.\nconst PEEK = 14;\nconst SHRINK = 0.05;\n\nexport class RayToaster extends RayElement {\n  static properties = {\n    position: { type: String, reflect: true, default: \"bottom-right\" },\n    limit: { type: Number, default: 5 },\n    // Toasts visible in the collapsed stack (the rest wait, invisible).\n    visible: { type: Number, default: 3 },\n    // Always expanded: a list instead of a stack.\n    expand: { type: Boolean, reflect: true },\n    gap: { type: Number, default: 12 },\n  };\n  static styles = [toasterStyles];\n  static template = `<slot></slot>`;\n\n  #expanded = false;\n  #ro = null;\n  #swipe = null;\n\n  connectedCallback() {\n    super.connectedCallback();\n    this.setAttribute(\"popover\", \"manual\");\n    this.setAttribute(\"role\", \"region\");\n    this.setAttribute(\"aria-label\", this.getAttribute(\"aria-label\") ?? \"Notifications\");\n    this.setAttribute(\"aria-live\", \"polite\");\n    if (this._wired) return;\n    this._wired = true;\n    // Mouse: expand while hovered. Keyboard: while focus is inside.\n    this.addEventListener(\"pointerenter\", (e) => { if (e.pointerType === \"mouse\") this.expanded = true; });\n    this.addEventListener(\"pointerleave\", (e) => { if (e.pointerType === \"mouse\" && !this.contains(document.activeElement)) this.expanded = false; });\n    this.addEventListener(\"focusin\", () => { this.expanded = true; });\n    this.addEventListener(\"focusout\", (e) => { if (!this.contains(e.relatedTarget) && !this.matches(\":hover\")) this.expanded = false; });\n    // Touch (no hover): a tap on the collapsed stack expands it — the tap is\n    // consumed so it does not press the front toast's buttons —, a tap\n    // outside collapses it. A horizontal swipe dismisses a toast.\n    this.addEventListener(\"pointerdown\", (e) => this._pointerDown(e));\n    this.addEventListener(\"click\", (e) => {\n      if (this._consumeClick) {\n        this._consumeClick = false;\n        e.preventDefault();\n        e.stopPropagation();\n      }\n    }, true);\n    this._outside = (e) => {\n      if (this.#expanded && e.pointerType !== \"mouse\" && !e.composedPath().includes(this)) this.expanded = false;\n    };\n    document.addEventListener(\"pointerdown\", this._outside, true);\n    this.#ro = new ResizeObserver(() => this.layout());\n    this.shadowRoot.querySelector(\"slot\").addEventListener(\"slotchange\", () => {\n      // Observe each card (its natural height): the host's height is set by\n      // layout() for toasts behind, and observing it would loop.\n      for (const el of this.children) {\n        const card = el.shadowRoot?.querySelector(\".card\");\n        if (card) this.#ro.observe(card);\n      }\n      this.layout();\n    });\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    document.removeEventListener(\"pointerdown\", this._outside, true);\n  }\n\n  /** Whether the stack is spread out (hover, focus, tap, or the expand attribute). */\n  get expanded() {\n    return this.#expanded || Boolean(this.expand);\n  }\n\n  set expanded(on) {\n    on = Boolean(on);\n    if (on === this.#expanded) return;\n    this.#expanded = on;\n    this.toggleAttribute(\"data-expanded\", on);\n    pauseAll(this, on);\n    this.layout();\n  }\n\n  update() {\n    this.layout();\n  }\n\n  /** The toasts, newest first. */\n  get toasts() {\n    return [...this.children].filter((el) => el.localName === \"ray-notification\" && !el._leaving).reverse();\n  }\n\n  /** Places every toast: a stack (collapsed) or a list (expanded). */\n  layout() {\n    const toasts = this.toasts;\n    const top = (this.position ?? \"bottom-right\").startsWith(\"top\");\n    const dir = top ? 1 : -1;\n    const heights = toasts.map((el) => el.shadowRoot?.querySelector(\".card\")?.offsetHeight || el.offsetHeight || 0);\n    const front = heights[0] ?? 0;\n    const open = this.expanded;\n    const shown = Math.min(toasts.length, Math.max(1, this.visible ?? 3));\n    let offset = 0;\n    toasts.forEach((el, i) => {\n      el.style.zIndex = String(toasts.length - i);\n      el.toggleAttribute(\"data-behind\", !open && i > 0);\n      el.toggleAttribute(\"data-front\", i === 0);\n      const swiping = el === this.#swipe?.el;\n      const swipe = swiping ? ` translateX(\${this.#swipe.dx}px)` : \"\";\n      if (open) {\n        el.style.transform = `translateY(\${dir * offset}px)\${swipe}`;\n        if (!swiping) el.style.opacity = \"\";\n        offset += heights[i] + (this.gap ?? 12);\n      } else {\n        const scale = 1 - i * SHRINK;\n        // Behind toasts: the front one's height, so the stack edges line up.\n        el.style.transform = `translateY(\${dir * i * PEEK}px) scale(\${scale})\${swipe}`;\n        if (!swiping) el.style.opacity = i < shown ? \"\" : \"0\";\n      }\n      el.style.height = !open && i > 0 && front ? `\${front}px` : \"\";\n      el.style.overflow = !open && i > 0 ? \"hidden\" : \"\";\n      el.inert = !open && i >= shown;\n    });\n    const total = open ? Math.max(0, offset - (this.gap ?? 12)) : front + (shown - 1) * PEEK;\n    this.style.height = `\${Math.max(0, total)}px`;\n  }\n\n  _pointerDown(e) {\n    if (e.pointerType !== \"mouse\" && !this.expanded && this.toasts.length > 1) {\n      this.expanded = true;\n      this._consumeClick = true;\n      return;\n    }\n    const el = e.target.closest?.(\"ray-notification\");\n    if (!el || e.button > 0) return;\n    const start = { x: e.clientX, y: e.clientY };\n    let moving = false;\n    const move = (ev) => {\n      const dx = ev.clientX - start.x;\n      if (!moving) {\n        if (Math.abs(dx) < 8 || Math.abs(dx) < Math.abs(ev.clientY - start.y)) return;\n        moving = true;\n        el.setAttribute(\"data-swiping\", \"\");\n        try {\n          el.setPointerCapture(ev.pointerId);\n        } catch {\n          // Not an active pointer (synthetic events): the window listeners still track it.\n        }\n      }\n      this.#swipe = { el, dx };\n      el.style.opacity = String(Math.max(0.2, 1 - Math.abs(dx) / 240));\n      this.layout();\n    };\n    const up = () => {\n      window.removeEventListener(\"pointermove\", move);\n      window.removeEventListener(\"pointerup\", up);\n      window.removeEventListener(\"pointercancel\", up);\n      el.removeAttribute(\"data-swiping\");\n      const dx = this.#swipe?.el === el ? this.#swipe.dx : 0;\n      this.#swipe = null;\n      if (moving) this._consumeClick = true;\n      if (Math.abs(dx) > 64) {\n        el._swipeOut = Math.sign(dx);\n        hideNotification(el.dataset.notificationId);\n      } else {\n        el.style.opacity = \"\";\n        this.layout();\n      }\n    };\n    window.addEventListener(\"pointermove\", move);\n    window.addEventListener(\"pointerup\", up);\n    window.addEventListener(\"pointercancel\", up);\n  }\n\n  /** Brings the stack above everything else in the top layer (e.g. a dialog opened later). */\n  raise() {\n    if (this.matches(\":popover-open\")) this.hidePopover();\n    if (this.children.length) this.showPopover();\n    this.layout();\n  }\n}\n\ndefine(\"ray-notification\", RayNotification);\ndefine(\"ray-toaster\", RayToaster);\n\n// --- notify() ---------------------------------------------------------------\n\nlet counter = 0;\nconst timers = new Map();\n\nfunction toaster() {\n  let t = document.querySelector(\"ray-toaster\");\n  if (!t) {\n    t = document.createElement(\"ray-toaster\");\n    document.body.append(t);\n    rehome();\n  }\n  return t;\n}\n\nfunction find(id) {\n  return document.querySelector(`ray-notification[data-notification-id=\"\${CSS.escape(id)}\"]`);\n}\n\nfunction apply(el, o) {\n  if (\"action\" in o) {\n    el.actionLabel = o.action?.label ?? \"\";\n    el._onAction = o.action?.onClick;\n  }\n  if (\"title\" in o) el.label = o.title ?? \"\";\n  if (\"message\" in o) el.textContent = o.message ?? \"\";\n  if (\"color\" in o) el.color = o.color || undefined;\n  if (\"icon\" in o) el.icon = o.icon || undefined;\n  if (\"loading\" in o) el.loading = Boolean(o.loading);\n  if (\"closable\" in o) el.hideClose = o.closable === false;\n  if (\"withBorder\" in o) el.withBorder = Boolean(o.withBorder);\n}\n\nfunction schedule(id, ms) {\n  clearTimeout(timers.get(id)?.handle);\n  if (!ms) {\n    timers.delete(id);\n    return;\n  }\n  const entry = { remaining: ms, start: Date.now(), handle: setTimeout(() => hideNotification(id), ms) };\n  timers.set(id, entry);\n}\n\nfunction pauseAll(t, pause) {\n  for (const el of t.querySelectorAll(\"ray-notification[data-notification-id]\")) {\n    const id = el.dataset.notificationId;\n    const entry = timers.get(id);\n    if (!entry) continue;\n    if (pause) {\n      clearTimeout(entry.handle);\n      entry.remaining -= Date.now() - entry.start;\n    } else {\n      schedule(id, Math.max(entry.remaining, 1000));\n    }\n  }\n}\n\n/**\n * Shows a notification. Returns its id.\n * @param {{ id?: string, title?: string, message?: string, color?: string, loading?: boolean,\n *           autoClose?: number | false, closable?: boolean, withBorder?: boolean,\n *           action?: { label: string, onClick?: () => void }, onClose?: () => void }} options\n *   autoClose: ms (default 4000; false = stays). action: a button (e.g. \"Undo\") that runs onClick and closes it.\n */\nexport function notify(options = {}) {\n  const id = options.id ?? `n\${++counter}`;\n  if (find(id)) {\n    updateNotification(id, options);\n    return id;\n  }\n  const t = toaster();\n  const el = document.createElement(\"ray-notification\");\n  el.dataset.notificationId = id;\n  apply(el, { closable: true, withBorder: true, ...options });\n  el.addEventListener(\"ray-close\", () => hideNotification(id));\n  el.addEventListener(\"ray-action\", () => {\n    el._onAction?.();\n    hideNotification(id);\n  });\n  el._onClose = options.onClose;\n  t.append(el);\n  // Enter from the edge: start off-screen, then let layout() transition it in.\n  const top = (t.position ?? \"bottom-right\").startsWith(\"top\");\n  el.style.transition = \"none\";\n  el.style.opacity = \"0\";\n  el.style.transform = `translateY(\${top ? -100 : 100}%)`;\n  el.getBoundingClientRect();\n  el.style.transition = \"\";\n  el.style.opacity = \"\";\n  // Over the limit: drop the oldest.\n  const all = t.querySelectorAll(\"ray-notification[data-notification-id]\");\n  for (let i = 0; i < all.length - (t.limit ?? 5); i++) hideNotification(all[i].dataset.notificationId);\n  t.raise();\n  schedule(id, options.loading ? 0 : (options.autoClose ?? 4000));\n  return id;\n}\n\n/** Changes a shown notification (e.g. loading -> done). Restarts its auto-close. */\nexport function updateNotification(id, options = {}) {\n  const el = find(id);\n  if (!el) return false;\n  apply(el, options);\n  if (\"onClose\" in options) el._onClose = options.onClose;\n  const loading = \"loading\" in options ? options.loading : el.loading;\n  schedule(id, loading ? 0 : (options.autoClose ?? 4000));\n  return true;\n}\n\nexport function hideNotification(id) {\n  const el = find(id);\n  schedule(id, 0);\n  if (!el || el._leaving) return Boolean(el);\n  const t = el.parentElement;\n  const done = () => {\n    el.remove();\n    el._onClose?.();\n    if (t instanceof RayToaster) {\n      if (!t.children.length && t.matches(\":popover-open\")) t.hidePopover();\n      if (t.toasts.length < 2) t.expanded = false;\n      t.layout();\n    }\n  };\n  if (!motionAllowed(el)) {\n    done();\n    return true;\n  }\n  // Leave (sideways after a swipe, else towards the edge) while the others\n  // move into place.\n  el._leaving = true;\n  el.style.pointerEvents = \"none\";\n  if (t instanceof RayToaster) t.layout();\n  const from = el.style.transform || \"none\";\n  const top = t instanceof RayToaster && (t.position ?? \"\").startsWith(\"top\");\n  const to = el._swipeOut ? `\${from} translateX(\${el._swipeOut * 110}%)` : `\${from} translateY(\${top ? -40 : 40}%)`;\n  const exit = play(el, [{ opacity: Number(el.style.opacity || 1), transform: from }, { opacity: 0, transform: to }], { speed: \"fast\" });\n  exit.finished.then(done);\n  return true;\n}\n\nexport function clearNotifications() {\n  for (const el of document.querySelectorAll(\"ray-notification[data-notification-id]\")) hideNotification(el.dataset.notificationId);\n}\n";
const F39: string = "// <ray-number-input>: a number field (Mantine's NumberInput): + and −\n// buttons (hold to repeat), the arrow keys (Shift: ×10), min/max/step,\n// a fixed number of decimals, a prefix and a suffix (\"$\", \" kg\") and a\n// thousands separator in the shown text. The value is a number (or empty);\n// the form gets its plain digits.\n//\n// An ARIA spinbutton: aria-valuenow/min/max/valuetext on the text field.\n\nimport { css, define } from \"../../core/core.js\";\nimport { sizeStyles, radiusStyles } from \"../../core/styles.js\";\nimport { FieldControl, fieldStyles, boxStyles, fieldTemplate } from \"../../core/form.js\";\n\nconst styles = css`\n  .control { font-variant-numeric: tabular-nums; }\n  .steppers {\n    display: flex;\n    flex-direction: column;\n    align-self: stretch;\n    flex: none;\n    width: calc(var(--_h) * 0.75);\n    border-inline-start: 1px solid var(--ray-input);\n  }\n  :host([hide-controls]) .steppers { display: none; }\n  :host([variant=\"filled\"]) .steppers, :host([variant=\"unstyled\"]) .steppers { border-color: transparent; }\n  .step {\n    display: grid;\n    place-items: center;\n    flex: 1;\n    margin: 0;\n    padding: 0;\n    color: var(--ray-muted-foreground);\n    background: transparent;\n    border: 0;\n    cursor: pointer;\n    --ray-icon-size: 0.8em;\n  }\n  .step + .step { border-top: 1px solid var(--ray-input); }\n  :host([variant=\"filled\"]) .step + .step, :host([variant=\"unstyled\"]) .step + .step { border-color: transparent; }\n  .step:hover:not(:disabled) { color: var(--ray-foreground); background: var(--ray-default-hover); }\n  .step:disabled { cursor: not-allowed; opacity: 0.4; }\n  .up { border-start-end-radius: calc(var(--_r) - 1px); }\n  .down { border-end-end-radius: calc(var(--_r) - 1px); }\n`;\n\n/** A number from text with a prefix/suffix and separators; NaN if none. */\nexport function parseNumber(text, { decimal = \".\", thousands = \"\" } = {}) {\n  let s = String(text ?? \"\");\n  if (thousands) s = s.split(thousands).join(\"\");\n  if (decimal !== \".\") s = s.split(decimal).join(\".\");\n  const m = s.match(/-?\\d*\\.?\\d+(?:e[+-]?\\d+)?|-?\\d+\\.?/i);\n  return m ? Number(m[0]) : NaN;\n}\n\n/** A number as text with `decimals`, a thousands separator and a decimal mark. */\nexport function formatNumber(n, { decimals, thousands = \"\", decimal = \".\" } = {}) {\n  if (!Number.isFinite(n)) return \"\";\n  let s = decimals !== undefined && decimals !== null ? n.toFixed(decimals) : String(n);\n  let [int, frac] = s.split(\".\");\n  if (thousands) int = int.replace(/\\B(?=(\\d{3})+(?!\\d))/g, thousands);\n  return frac !== undefined ? `\${int}\${decimal}\${frac}` : int;\n}\n\nexport class RayNumberInput extends FieldControl {\n  static properties = {\n    ...FieldControl.fieldProperties,\n    value: { type: Number },\n    min: { type: Number },\n    max: { type: Number },\n    step: { type: Number, default: 1 },\n    decimals: { type: Number },\n    prefix: { type: String },\n    suffix: { type: String },\n    thousandsSeparator: { type: String, attribute: \"thousands-separator\" },\n    decimalSeparator: { type: String, attribute: \"decimal-separator\", default: \".\" },\n    placeholder: { type: String },\n    hideControls: { type: Boolean, reflect: true, attribute: \"hide-controls\" },\n    clamp: { type: String, default: \"blur\" },\n    readonly: { type: Boolean, reflect: true },\n  };\n  static styles = [sizeStyles, radiusStyles, fieldStyles, boxStyles, styles];\n  static template = fieldTemplate(\n    `<input id=\"control\" class=\"control\" part=\"input\" role=\"spinbutton\" inputmode=\"decimal\" autocomplete=\"off\" spellcheck=\"false\">` +\n      `<span class=\"steppers\" part=\"controls\"><button type=\"button\" class=\"step up\" part=\"increment\" tabindex=\"-1\" aria-label=\"Increment\"><span data-ray-icon=\"chevron-up\"></span></button><button type=\"button\" class=\"step down\" part=\"decrement\" tabindex=\"-1\" aria-label=\"Decrement\"><span data-ray-icon=\"chevron-down\"></span></button></span>`,\n  );\n\n  #typing = false;\n  #repeat = 0;\n\n  wire() {\n    this._default = this.getAttribute(\"value\") !== null ? Number(this.getAttribute(\"value\")) : undefined;\n    const c = this.control;\n    c.addEventListener(\"input\", () => {\n      this.#typing = true;\n      const n = this._parse(c.value);\n      this.commitProperty(\"value\", Number.isFinite(n) ? (this.clamp === \"strict\" ? this._clamp(n) : n) : undefined);\n      this._commit();\n      this._aria();\n    });\n    c.addEventListener(\"blur\", () => {\n      this.#typing = false;\n      if (this.value !== undefined && this.clamp !== \"none\") this._set(this._clamp(this.value), false);\n      this._paint();\n    });\n    c.addEventListener(\"change\", (e) => this.forward(e));\n    c.addEventListener(\"keydown\", (e) => this._key(e));\n    // + and −: a press steps once; held, it repeats faster and faster.\n    for (const [sel, dir] of [[\".up\", 1], [\".down\", -1]]) {\n      const b = this.$(sel);\n      b.addEventListener(\"pointerdown\", (e) => {\n        if (b.disabled || e.button !== 0) return;\n        e.preventDefault();\n        c.focus();\n        this.stepBy(dir);\n        let delay = 400;\n        const again = () => {\n          this.stepBy(dir);\n          delay = Math.max(40, delay * 0.8);\n          this.#repeat = setTimeout(again, delay);\n        };\n        this.#repeat = setTimeout(again, delay);\n      });\n      for (const ev of [\"pointerup\", \"pointerleave\", \"pointercancel\"]) b.addEventListener(ev, () => clearTimeout(this.#repeat));\n    }\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    clearTimeout(this.#repeat);\n  }\n\n  update() {\n    const c = this.control;\n    c.readOnly = Boolean(this.readonly);\n    if (this.placeholder !== undefined) c.placeholder = this.placeholder;\n    if (!this.#typing) this._paint();\n    this.syncField();\n    this._aria();\n    this._commit();\n  }\n\n  /** Adds `dir` steps (negative: down) from the current value, clamped; fires input and change. */\n  stepBy(dir) {\n    if (this.effectivelyDisabled || this.readonly) return;\n    const step = this.step || 1;\n    const base = this.value ?? (dir > 0 ? (this.min ?? 0) - step : (this.max ?? 0) + step);\n    // Round to the step's precision (0.1 + 0.2 stays 0.3).\n    const places = Math.max(this._places(step), this._places(base), this.decimals ?? 0);\n    const next = Number((base + dir * step).toFixed(places));\n    this._set(this._clamp(next), true);\n  }\n\n  _places(n) {\n    const s = String(n);\n    return s.includes(\".\") ? s.split(\".\")[1].length : 0;\n  }\n\n  _clamp(n) {\n    let v = n;\n    if (this.min !== undefined && this.min !== null && v < this.min) v = this.min;\n    if (this.max !== undefined && this.max !== null && v > this.max) v = this.max;\n    return this.decimals !== undefined && this.decimals !== null ? Number(v.toFixed(this.decimals)) : v;\n  }\n\n  _parse(text) {\n    let s = String(text ?? \"\");\n    if (this.prefix) s = s.split(this.prefix).join(\"\");\n    if (this.suffix) s = s.split(this.suffix).join(\"\");\n    return parseNumber(s, { decimal: this.decimalSeparator || \".\", thousands: this.thousandsSeparator || \"\" });\n  }\n\n  _set(n, user) {\n    const changed = n !== this.value;\n    this.commitProperty(\"value\", n);\n    this._paint();\n    this._commit();\n    this._aria();\n    if (user && changed) {\n      this.dispatchEvent(new Event(\"input\", { bubbles: true, composed: true }));\n      this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    }\n  }\n\n  // The shown text: prefix, separators, decimals, suffix.\n  _text() {\n    if (this.value === undefined || this.value === null || !Number.isFinite(this.value)) return \"\";\n    const num = formatNumber(this.value, { decimals: this.decimals, thousands: this.thousandsSeparator || \"\", decimal: this.decimalSeparator || \".\" });\n    return `\${this.prefix ?? \"\"}\${num}\${this.suffix ?? \"\"}`;\n  }\n\n  _paint() {\n    const t = this._text();\n    if (this.control.value !== t) this.control.value = t;\n    const v = this.value;\n    const off = this.effectivelyDisabled || this.readonly;\n    this.$(\".up\").disabled = off || (v !== undefined && this.max !== undefined && v >= this.max);\n    this.$(\".down\").disabled = off || (v !== undefined && this.min !== undefined && v <= this.min);\n  }\n\n  _aria() {\n    const c = this.control;\n    const set = (a, v) => (v === undefined || v === null || Number.isNaN(v) ? c.removeAttribute(a) : c.setAttribute(a, String(v)));\n    set(\"aria-valuenow\", this.value);\n    set(\"aria-valuemin\", this.min);\n    set(\"aria-valuemax\", this.max);\n    if (this.prefix || this.suffix || this.thousandsSeparator) set(\"aria-valuetext\", this._text() || undefined);\n    else c.removeAttribute(\"aria-valuetext\");\n  }\n\n  _key(e) {\n    const big = e.shiftKey ? 10 : 1;\n    if (e.key === \"ArrowUp\") { e.preventDefault(); this.stepBy(big); }\n    else if (e.key === \"ArrowDown\") { e.preventDefault(); this.stepBy(-big); }\n    else if (e.key === \"PageUp\") { e.preventDefault(); this.stepBy(10); }\n    else if (e.key === \"PageDown\") { e.preventDefault(); this.stepBy(-10); }\n    else if (e.key === \"Home\" && this.min !== undefined) { e.preventDefault(); this._set(this.min, true); }\n    else if (e.key === \"End\" && this.max !== undefined) { e.preventDefault(); this._set(this.max, true); }\n  }\n\n  _commit() {\n    this.internals.setFormValue(this.value === undefined || this.value === null || !Number.isFinite(this.value) ? null : String(this.value));\n    const c = this.control;\n    let msg = \"\";\n    if (this.required && (this.value === undefined || this.value === null)) msg = \"Please enter a number.\";\n    else if (this.value !== undefined && this.min !== undefined && this.value < this.min) msg = `The minimum is \${this.min}.`;\n    else if (this.value !== undefined && this.max !== undefined && this.value > this.max) msg = `The maximum is \${this.max}.`;\n    if (msg) this.internals.setValidity(this.value === undefined ? { valueMissing: true } : this.value < (this.min ?? -Infinity) ? { rangeUnderflow: true } : { rangeOverflow: true }, msg, c);\n    else this.internals.setValidity({});\n  }\n\n  formResetCallback() {\n    this.value = this._default;\n  }\n\n  formStateRestoreCallback(state) {\n    const n = Number(state);\n    this.value = state === null || state === \"\" || !Number.isFinite(n) ? undefined : n;\n  }\n}\n\ndefine(\"ray-number-input\", RayNumberInput);\n";
const F40: string = "// <ray-pagination>: page navigation (Mantine's Pagination). Previous/next,\n// optional first/last, page numbers with ellipses. The number of items stays\n// the same while moving through the pages, so the control does not jump.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor, sizeStyles, radiusStyles, variantStyles } from \"../../core/styles.js\";\n\nconst styles = css`\n  :host { display: block; }\n  :host([hidden]) { display: none; }\n  .list {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: var(--ray-space-1);\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  .item {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: var(--_h);\n    height: var(--_h);\n    padding: 0 calc(var(--_px) * 0.35);\n    font: inherit;\n    font-size: var(--_fs);\n    font-weight: var(--ray-font-weight-medium);\n    font-variant-numeric: tabular-nums;\n    line-height: 1;\n    border-radius: var(--_r);\n    cursor: pointer;\n    user-select: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .item:not([data-disabled]):active { transform: translateY(1px); }\n  /* Disabled: the current page keeps its fill, dimmed. */\n  .item[aria-current=\"page\"]:disabled { opacity: 0.6; cursor: not-allowed; }\n  .item svg { width: 1em; height: 1em; }\n  .dots {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: var(--_h);\n    height: var(--_h);\n    color: var(--ray-muted-foreground);\n    font-size: var(--_fs);\n  }\n  .dots svg { width: 1em; height: 1em; }\n`;\n\n/**\n * The items to show: page numbers and \"dots\", Mantine's algorithm. Always\n * siblings * 2 + 3 + boundaries * 2 items when there are more pages than that.\n * @returns {(number | \"dots\")[]}\n */\nexport function paginationRange(total, value, siblings = 1, boundaries = 1) {\n  total = Math.max(0, Math.floor(total || 0));\n  if (total === 0) return [];\n  const active = Math.min(Math.max(1, Math.floor(value || 1)), total);\n  const range = (a, b) => (b < a ? [] : Array.from({ length: b - a + 1 }, (_, i) => a + i));\n  const count = siblings * 2 + 3 + boundaries * 2;\n  if (count >= total) return range(1, total);\n  const left = Math.max(active - siblings, boundaries);\n  const right = Math.min(active + siblings, total - boundaries);\n  const leftDots = left > boundaries + 2;\n  const rightDots = right < total - (boundaries + 1);\n  if (!leftDots && rightDots) {\n    const n = siblings * 2 + boundaries + 2;\n    return [...range(1, n), \"dots\", ...range(total - boundaries + 1, total)];\n  }\n  if (leftDots && !rightDots) {\n    const n = boundaries + 1 + siblings * 2;\n    return [...range(1, boundaries), \"dots\", ...range(total - n, total)];\n  }\n  return [...range(1, boundaries), \"dots\", ...range(left, right), \"dots\", ...range(total - boundaries + 1, total)];\n}\n\nexport class RayPagination extends RayElement {\n  static properties = {\n    total: { type: Number, default: 1 },\n    value: { type: Number, default: 1 },\n    siblings: { type: Number, default: 1 },\n    boundaries: { type: Number, default: 1 },\n    size: { type: String, reflect: true, default: \"sm\" },\n    radius: { type: String, reflect: true },\n    color: { type: String, reflect: true },\n    disabled: { type: Boolean, reflect: true },\n    withEdges: { type: Boolean, reflect: true },\n    hideControls: { type: Boolean, reflect: true },\n    label: { type: String, default: \"Pagination\" },\n  };\n  static styles = [sizeStyles, radiusStyles, variantStyles, styles];\n  static template = `<nav part=\"root\"><ul class=\"list\" part=\"list\"></ul></nav>`;\n\n  constructor() {\n    super();\n    this.$(\".list\").addEventListener(\"click\", (e) => {\n      const b = e.target.closest?.(\"button[data-page]\");\n      if (!b || b.disabled) return;\n      this._go(Number(b.dataset.page));\n    });\n  }\n\n  /** The current page, clamped to 1…total. */\n  get page() {\n    const total = Math.max(1, this.total || 1);\n    return Math.min(Math.max(1, this.value || 1), total);\n  }\n\n  /** Goes to a page (clamped), firing change when it changes. */\n  setPage(page) {\n    this._go(page);\n  }\n\n  next() { this._go(this.page + 1); }\n  previous() { this._go(this.page - 1); }\n  first() { this._go(1); }\n  last() { this._go(Math.max(1, this.total || 1)); }\n\n  _go(page) {\n    const total = Math.max(1, this.total || 1);\n    const p = Math.min(Math.max(1, page), total);\n    if (p === this.page || this.disabled) return;\n    this.commitProperty(\"value\", p);\n    this.requestUpdate();\n    this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    // Keep the focus on the activated page (the list is rebuilt).\n    queueMicrotask(() => this.$(`button[data-page=\"\${p}\"][data-number]`)?.focus());\n  }\n\n  update() {\n    this.$(\"nav\").setAttribute(\"aria-label\", this.label || \"Pagination\");\n    const total = Math.max(0, this.total || 0);\n    const page = this.page;\n    const list = this.$(\".list\");\n    const focused = this.shadowRoot.activeElement?.dataset?.role;\n    const items = [];\n    const control = (role, target, icon, label, off) => ({ kind: \"control\", role, target, icon, label, off });\n    if (!this.hideControls) {\n      if (this.withEdges) items.push(control(\"first\", 1, \"chevrons-left\", \"First page\", page <= 1));\n      items.push(control(\"previous\", page - 1, \"chevron-left\", \"Previous page\", page <= 1));\n    }\n    for (const it of paginationRange(total, page, this.siblings ?? 1, this.boundaries ?? 1)) {\n      items.push(it === \"dots\" ? { kind: \"dots\" } : { kind: \"page\", target: it });\n    }\n    if (!this.hideControls) {\n      items.push(control(\"next\", page + 1, \"chevron-right\", \"Next page\", page >= total));\n      if (this.withEdges) items.push(control(\"last\", total, \"chevrons-right\", \"Last page\", page >= total));\n    }\n    list.replaceChildren(...items.map((it) => this._item(it, page)));\n    this.paintIcons(list);\n    // Prev/next keep the focus across re-renders (e.g. holding Enter).\n    if (focused) this.$(`button[data-role=\"\${focused}\"]`)?.focus();\n  }\n\n  _item(it, page) {\n    const li = document.createElement(\"li\");\n    if (it.kind === \"dots\") {\n      li.innerHTML = `<span class=\"dots\" part=\"dots\" aria-hidden=\"true\">…</span>`;\n      return li;\n    }\n    const b = document.createElement(\"button\");\n    b.type = \"button\";\n    b.className = \"item focus-ring\";\n    b.dataset.page = String(it.target);\n    applyColor(b, this.color);\n    if (it.kind === \"page\") {\n      const active = it.target === page;\n      b.dataset.number = \"\";\n      b.setAttribute(\"part\", active ? \"item active\" : \"item\");\n      b.dataset.variant = active ? \"filled\" : \"default\";\n      b.textContent = String(it.target);\n      b.setAttribute(\"aria-label\", `Page \${it.target}`);\n      if (active) b.setAttribute(\"aria-current\", \"page\");\n      b.disabled = Boolean(this.disabled);\n      if (!(active && b.disabled)) b.setAttribute(\"data-interactive\", \"\");\n    } else {\n      b.dataset.role = it.role;\n      b.setAttribute(\"part\", `item control \${it.role}`);\n      b.dataset.variant = \"default\";\n      b.setAttribute(\"aria-label\", it.label);\n      b.innerHTML = `<span data-ray-icon=\"\${it.icon}\" aria-hidden=\"true\"></span>`;\n      b.disabled = Boolean(this.disabled || it.off);\n      b.setAttribute(\"data-interactive\", \"\");\n    }\n    b.toggleAttribute(\"data-disabled\", b.disabled);\n    li.append(b);\n    return li;\n  }\n}\n\ndefine(\"ray-pagination\", RayPagination);\n";
const F41: string = "// <ray-password-input>: a password field with a button that shows or hides\n// what was typed (Mantine's PasswordInput). A ray-input underneath: label,\n// description, error, sizes, validation and forms work the same.\n//\n// The toggle keeps the caret and the focus in the field, says what it does\n// (aria-label, aria-pressed) and fires ray-visibility-change.\n\nimport { css, define } from \"../../core/core.js\";\nimport { fieldTemplate } from \"../../core/form.js\";\nimport { RayInput } from \"../input/input.js\";\n\nconst styles = css`\n  .toggle {\n    display: inline-flex;\n    flex: none;\n    align-items: center;\n    justify-content: center;\n    width: max(1.5rem, calc(var(--_h) * 0.7));\n    height: max(1.5rem, calc(var(--_h) * 0.7));\n    margin-inline-end: calc(var(--_px) * 0.35);\n    padding: 0;\n    color: var(--ray-muted-foreground);\n    background: transparent;\n    border: 0;\n    border-radius: var(--ray-radius-sm);\n    cursor: pointer;\n  }\n  .toggle:hover { color: var(--ray-foreground); background: var(--ray-default-hover); }\n  .toggle:disabled { cursor: not-allowed; opacity: 0.6; }\n  .toggle svg { width: 1.1em; height: 1.1em; }\n  /* Dots read better a little apart; typed text keeps the normal spacing. */\n  .control[type=\"password\"]:not(:placeholder-shown) { letter-spacing: 0.08em; }\n`;\n\nexport class RayPasswordInput extends RayInput {\n  static properties = {\n    ...RayInput.properties,\n    type: { type: String, reflect: false, default: \"password\" },\n    visible: { type: Boolean, reflect: true },\n    showLabel: { type: String, default: \"Show password\" },\n    hideLabel: { type: String, default: \"Hide password\" },\n  };\n  static styles = [...RayInput.styles, styles];\n  static template = fieldTemplate(\n    `<input id=\"control\" class=\"control\" part=\"input\" type=\"password\" autocomplete=\"current-password\" spellcheck=\"false\" autocapitalize=\"off\">` +\n      `<button type=\"button\" class=\"toggle focus-ring\" part=\"toggle\" aria-pressed=\"false\"><span data-ray-icon=\"eye\" aria-hidden=\"true\"></span></button>`,\n  );\n\n  wire() {\n    super.wire();\n    const toggle = this.$(\".toggle\");\n    // Keep the focus (and the caret) in the field when the pointer toggles.\n    toggle.addEventListener(\"pointerdown\", (e) => e.preventDefault());\n    toggle.addEventListener(\"click\", () => {\n      this.visible = !this.visible;\n      this.emit(\"ray-visibility-change\", { visible: this.visible });\n      if (this.shadowRoot.activeElement !== toggle) this.control.focus();\n    });\n  }\n\n  update(changed) {\n    // The type follows `visible` (a type set from outside is ignored).\n    const want = this.visible ? \"text\" : \"password\";\n    if (this.type !== want) this.commitProperty(\"type\", want);\n    super.update(changed);\n    const toggle = this.$(\".toggle\");\n    toggle.setAttribute(\"aria-pressed\", String(Boolean(this.visible)));\n    toggle.setAttribute(\"aria-label\", this.visible ? this.hideLabel : this.showLabel);\n    toggle.title = toggle.getAttribute(\"aria-label\");\n    toggle.disabled = this.effectivelyDisabled;\n    const icon = toggle.firstElementChild;\n    const name = this.visible ? \"eye-off\" : \"eye\";\n    if (icon.dataset.rayIcon !== name) {\n      icon.dataset.rayIcon = name;\n      this.paintIcons(toggle);\n    }\n  }\n\n  formResetCallback() {\n    super.formResetCallback();\n    this.visible = false;\n  }\n}\n\ndefine(\"ray-password-input\", RayPasswordInput);\n";
const F42: string = "// <ray-path-input>: a field for a path on the user's disk: a file to open, a\n// folder, or where to save. A ray-input underneath: label, description,\n// error, sizes, validation and forms work the same, and the path can always\n// be typed or pasted.\n//\n// With a native host that offers \"pick_path\" (core/host.js; a std/ui window\n// with core/raylang.js), a Browse… button opens the system dialog, starting\n// where the current path points; the choice fills the field and fires input\n// and change. Without one (a browser), it is a plain text field: a page\n// cannot read paths from a browser's file picker.\n\nimport { css, define } from \"../../core/core.js\";\nimport { fieldTemplate } from \"../../core/form.js\";\nimport { getHost, hostCan, onHostChange, acceptFilters } from \"../../core/host.js\";\nimport { RayInput } from \"../input/input.js\";\n\nconst styles = css`\n  .control { font-variant-ligatures: none; }\n  .browse {\n    display: inline-flex;\n    flex: none;\n    align-items: center;\n    gap: 0.35em;\n    height: calc(var(--_h) - 0.5rem);\n    margin-inline-end: 0.25rem;\n    padding: 0 0.6em;\n    font: inherit;\n    font-size: 0.9em;\n    font-weight: 500;\n    color: var(--ray-foreground);\n    white-space: nowrap;\n    background: var(--ray-default-hover);\n    border: 0;\n    border-radius: var(--ray-radius-sm);\n    cursor: pointer;\n  }\n  .browse:hover { background: color-mix(in srgb, var(--ray-foreground) 12%, var(--ray-default-hover)); }\n  .browse:disabled { cursor: not-allowed; opacity: 0.6; }\n  .browse[hidden] { display: none; }\n  .browse svg { width: 1.05em; height: 1.05em; }\n`;\n\nconst ICONS = { open: \"file\", folder: \"folder\", save: \"file\" };\n\n/** The folder part of a path (\"\" when it has none), with / or \\ separators. */\nexport function dirName(path) {\n  const p = String(path ?? \"\");\n  const cut = Math.max(p.lastIndexOf(\"/\"), p.lastIndexOf(\"\\\\\"));\n  return cut <= 0 ? (cut === 0 ? p.slice(0, 1) : \"\") : p.slice(0, cut);\n}\n\n/** The last part of a path. */\nexport function baseName(path) {\n  return String(path ?? \"\").split(/[\\\\/]/).pop();\n}\n\nexport class RayPathInput extends RayInput {\n  static properties = {\n    ...RayInput.properties,\n    mode: { type: String, reflect: true, default: \"open\" },\n    accept: { type: String, reflect: true },\n    browseLabel: { type: String, attribute: \"browse-label\", default: \"Browse…\" },\n    dialogTitle: { type: String, attribute: \"dialog-title\" },\n  };\n  static styles = [...RayInput.styles, styles];\n  static template = fieldTemplate(\n    `<input id=\"control\" class=\"control\" part=\"input\" spellcheck=\"false\" autocapitalize=\"off\" autocomplete=\"off\">` +\n      `<button type=\"button\" class=\"browse focus-ring\" part=\"browse\" hidden><span data-ray-icon=\"file\" aria-hidden=\"true\"></span><span class=\"browse-text\"></span></button>`,\n  );\n\n  #stop = null;\n\n  wire() {\n    super.wire();\n    this.$(\".browse\").addEventListener(\"click\", () => this.browse());\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    this.#stop ??= onHostChange(() => this.requestUpdate());\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    this.#stop?.();\n    this.#stop = null;\n  }\n\n  /** Whether Browse… is available (a native host offers \"pick_path\"). */\n  get canBrowse() {\n    return hostCan(\"pick_path\");\n  }\n\n  /**\n   * Opens the system dialog for `mode`; resolves to the chosen path, or null\n   * when the user cancels or there is no native host.\n   */\n  async browse() {\n    if (this.effectivelyDisabled || this.readonly || !this.canBrowse) return null;\n    const current = this.value ?? \"\";\n    let path;\n    try {\n      path = await getHost().pickPath({\n        mode: this.mode || \"open\",\n        title: this.dialogTitle ?? this.label ?? \"\",\n        directory: this.mode === \"folder\" ? current : dirName(current),\n        suggested: this.mode === \"save\" ? baseName(current) : \"\",\n        filters: this.mode === \"folder\" ? [] : acceptFilters(this.accept),\n      });\n    } catch (e) {\n      this.emit(\"ray-error\", { error: e });\n      return null;\n    }\n    if (path === null || path === undefined) return null;\n    this.value = path;\n    this.dispatchEvent(new Event(\"input\", { bubbles: true, composed: true }));\n    this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    this.control.focus();\n    return path;\n  }\n\n  update(changed) {\n    super.update(changed);\n    const btn = this.$(\".browse\");\n    btn.hidden = !this.canBrowse;\n    btn.disabled = this.effectivelyDisabled || Boolean(this.readonly);\n    this.$(\".browse-text\").textContent = this.browseLabel;\n    const icon = btn.firstElementChild;\n    const name = ICONS[this.mode] ?? \"file\";\n    if (icon.dataset.rayIcon !== name || !icon.firstChild) {\n      icon.dataset.rayIcon = name;\n      this.paintIcons(btn);\n    }\n  }\n}\n\ndefine(\"ray-path-input\", RayPathInput);\n";
const F43: string = "// <ray-popover>: a floating panel anchored to a trigger (slot=\"trigger\"),\n// toggled by clicking it; closes on Escape and outside clicks.\n\nimport { css, define } from \"../../core/core.js\";\nimport { Floating, floatingStyles } from \"../../core/floating.js\";\nimport { focusFirst, tabbables } from \"../../core/focus.js\";\n\nconst styles = css`\n  /* Defaults on the host, so an ancestor's private --_p / --_width do not leak in. */\n  :host { --_p: var(--ray-space-md); --_width: max-content; }\n  .panel { padding: var(--_p); width: var(--_width); }\n  :host([padding=\"0\"]) { --_p: 0; }\n  :host([padding=\"xs\"]) { --_p: var(--ray-space-xs); }\n  :host([padding=\"sm\"]) { --_p: var(--ray-space-sm); }\n  :host([padding=\"lg\"]) { --_p: var(--ray-space-lg); }\n`;\n\nexport class RayPopover extends Floating {\n  static properties = {\n    ...Floating.properties,\n    width: { type: String },\n    padding: { type: String, reflect: true },\n    matchWidth: { type: Boolean, reflect: true },\n    trapFocus: { type: Boolean, reflect: true },\n  };\n  static styles = [floatingStyles, styles];\n  static template = `<slot name=\"trigger\"></slot><div class=\"panel\" part=\"dropdown\" role=\"dialog\"><slot></slot></div>`;\n\n  wireTrigger(t) {\n    t.addEventListener(\"click\", () => {\n      if (!this.open && this.justClosed()) return;\n      this.toggle();\n    });\n  }\n\n  update(changed) {\n    if (this.width) this.style.setProperty(\"--_width\", /^\\d+$/.test(this.width) ? `\${this.width}px` : this.width);\n    else this.style.removeProperty(\"--_width\");\n    const label = this.getAttribute(\"aria-label\");\n    if (label) this.panel.setAttribute(\"aria-label\", label);\n    super.update(changed);\n  }\n\n  placeOptions() {\n    return { matchWidth: Boolean(this.matchWidth) };\n  }\n\n  toggled(open) {\n    if (open) {\n      if (this.trapFocus) focusFirst(this, { lightOnly: true });\n      this._onKey = (e) => this._keydown(e);\n      this.panel.addEventListener(\"keydown\", this._onKey);\n    } else {\n      this.panel.removeEventListener(\"keydown\", this._onKey);\n      // Return focus to the trigger if it was inside the panel.\n      if (this.focusWasInside) this.trigger?.focus();\n    }\n  }\n\n  // With trap-focus, Tab cycles inside the panel.\n  _keydown(e) {\n    if (e.key !== \"Tab\" || !this.trapFocus) return;\n    const items = tabbables(this, { lightOnly: true }).filter((el) => el !== this.trigger && !this.trigger?.contains(el));\n    if (!items.length) return;\n    const active = deepActive();\n    const first = items[0];\n    const last = items[items.length - 1];\n    const at = (el) => el === active || el.shadowRoot?.contains(active) || el.contains(active);\n    if (e.shiftKey && at(first)) {\n      e.preventDefault();\n      last.focus();\n    } else if (!e.shiftKey && at(last)) {\n      e.preventDefault();\n      first.focus();\n    }\n  }\n}\n\nfunction deepActive() {\n  let a = document.activeElement;\n  while (a?.shadowRoot?.activeElement) a = a.shadowRoot.activeElement;\n  return a;\n}\n\ndefine(\"ray-popover\", RayPopover);\n";
const F44: string = "// <ray-progress>: a determinate or indeterminate progress bar.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor, radiusStyles } from \"../../core/styles.js\";\n\nconst styles = css`\n  :host {\n    display: block;\n    --_h: 0.5rem;\n    --_r: var(--ray-radius-full);\n  }\n  :host([size=\"xs\"]) { --_h: 0.1875rem; }\n  :host([size=\"sm\"]) { --_h: 0.3125rem; }\n  :host([size=\"lg\"]) { --_h: 0.75rem; }\n  :host([size=\"xl\"]) { --_h: 1rem; }\n  .row { display: flex; align-items: center; gap: var(--ray-space-2); }\n  .track {\n    flex: 1;\n    position: relative;\n    height: var(--_h);\n    overflow: hidden;\n    background: var(--ray-muted);\n    border-radius: var(--_r);\n    box-shadow: inset 0 0 0 1px var(--ray-border);\n  }\n  .bar {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    height: 100%;\n    width: var(--_pct, 0%);\n    background: var(--_filled);\n    border-radius: var(--_r);\n    color: var(--_contrast);\n    font-size: max(0.625rem, calc(var(--_h) * 0.7));\n    font-weight: var(--ray-font-weight-semibold);\n    line-height: 1;\n    white-space: nowrap;\n    transition: width var(--ray-duration-slow) var(--ray-easing-standard);\n  }\n  /* show-value on small bars: the value beside the track, not squeezed inside it. */\n  .value {\n    flex: none;\n    min-width: 2.75em;\n    text-align: right;\n    font-size: var(--ray-font-size-xs);\n    font-variant-numeric: tabular-nums;\n    color: var(--ray-muted-foreground);\n  }\n  .value:empty { display: none; }\n  :host([striped]) .bar {\n    background-image: linear-gradient(45deg, rgb(255 255 255 / 0.18) 25%, transparent 25%, transparent 50%, rgb(255 255 255 / 0.18) 50%, rgb(255 255 255 / 0.18) 75%, transparent 75%);\n    background-size: 1rem 1rem;\n  }\n  :host([animated]) .bar { animation: ray-stripes 1s linear infinite; }\n  @keyframes ray-stripes { from { background-position: 1rem 0; } to { background-position: 0 0; } }\n  .track[data-indeterminate] .bar {\n    position: absolute;\n    width: 40%;\n    animation: ray-indeterminate 1.4s var(--ray-easing-standard) infinite;\n  }\n  @keyframes ray-indeterminate { from { left: -40%; } to { left: 100%; } }\n`;\n\nexport class RayProgress extends RayElement {\n  static properties = {\n    value: { type: Number },\n    max: { type: Number, default: 100 },\n    color: { type: String, reflect: true },\n    size: { type: String, reflect: true, default: \"md\" },\n    radius: { type: String, reflect: true },\n    striped: { type: Boolean, reflect: true },\n    animated: { type: Boolean, reflect: true },\n    label: { type: String },\n    showValue: { type: Boolean, reflect: true },\n  };\n  static styles = [radiusStyles, styles];\n  static template = `<div class=\"row\"><div class=\"track\" part=\"track\"><div class=\"bar\" part=\"bar\"></div></div><span class=\"value\" part=\"value\" aria-hidden=\"true\"></span></div>`;\n\n  constructor() {\n    super();\n    this.internals = this.attachInternals();\n    this.internals.role = \"progressbar\";\n  }\n\n  update() {\n    const track = this.$(\".track\");\n    const bar = this.$(\".bar\");\n    applyColor(track, this.color);\n    const max = this.max > 0 ? this.max : 100;\n    const indeterminate = this.value === undefined || this.value === null || Number.isNaN(this.value);\n    track.toggleAttribute(\"data-indeterminate\", indeterminate);\n    const pct = indeterminate ? 0 : Math.min(100, Math.max(0, (this.value / max) * 100));\n    track.style.setProperty(\"--_pct\", `\${pct}%`);\n    const text = this.showValue && !indeterminate ? `\${Math.round(pct)}%` : \"\";\n    // Inside the bar only when it is tall enough to hold text (lg, xl).\n    const inside = this.size === \"lg\" || this.size === \"xl\";\n    bar.textContent = inside ? text : \"\";\n    this.$(\".value\").textContent = inside ? \"\" : text;\n    const i = this.internals;\n    i.ariaValueMin = \"0\";\n    i.ariaValueMax = String(max);\n    i.ariaValueNow = indeterminate ? null : String(this.value);\n    i.ariaValueText = indeterminate ? null : `\${Math.round(pct)}%`;\n    i.ariaLabel = this.label || this.getAttribute(\"aria-label\") || \"Progress\";\n  }\n}\n\ndefine(\"ray-progress\", RayProgress);\n";
const F45: string = "// <ray-radio-group> + <ray-radio>: one choice among options.\n//\n// Native radios cannot group across shadow roots, so the group owns the\n// state: it is the form control (value submitted under `name`), keeps one\n// radio checked, and moves focus and selection with the arrow keys (roving\n// tabindex), like native radios.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor, sizeStyles } from \"../../core/styles.js\";\nimport { FormControl, fieldStyles } from \"../../core/form.js\";\n\nconst groupStyles = css`\n  :host { --_rs: 1.25rem; }\n  :host([size=\"xs\"]) { --_rs: 1rem; }\n  :host([size=\"md\"]) { --_rs: 1.5rem; }\n  :host([size=\"lg\"]) { --_rs: 1.875rem; }\n  :host([size=\"xl\"]) { --_rs: 2.25rem; }\n  .items {\n    display: flex;\n    flex-direction: column;\n    gap: var(--ray-space-3);\n    margin-top: var(--ray-space-2);\n  }\n  :host([orientation=\"horizontal\"]) .items { flex-direction: row; flex-wrap: wrap; gap: var(--ray-space-5); }\n  .label { margin-bottom: 0; }\n`;\n\nexport class RayRadioGroup extends FormControl {\n  static delegatesFocus = false;\n  static properties = {\n    name: { type: String, reflect: true },\n    value: { type: String },\n    label: { type: String },\n    description: { type: String },\n    error: { type: String },\n    required: { type: Boolean, reflect: true },\n    disabled: { type: Boolean, reflect: true },\n    orientation: { type: String, reflect: true, default: \"vertical\" },\n    size: { type: String, reflect: true, default: \"sm\" },\n    color: { type: String, reflect: true },\n    variant: { type: String, reflect: true, default: \"filled\" },\n    descriptionPosition: { type: String, reflect: true, default: \"above\" },\n  };\n  static styles = [sizeStyles, fieldStyles, groupStyles];\n  static template = `\n    <div class=\"label\" part=\"label\" id=\"label\" hidden><span class=\"label-text\"></span><span class=\"required\" aria-hidden=\"true\" hidden> *</span></div>\n    <div class=\"description\" part=\"description\" id=\"description\" hidden></div>\n    <div class=\"items\" part=\"items\"><slot></slot></div>\n    <div class=\"error\" part=\"error\" id=\"error\" hidden></div>`;\n\n  constructor() {\n    super();\n    this.internals.role = \"radiogroup\";\n    this.addEventListener(\"keydown\", (e) => this._keydown(e));\n    this.addEventListener(\"click\", (e) => {\n      const radio = e.target.closest?.(\"ray-radio\");\n      if (radio && this.radios.includes(radio)) this._choose(radio, true);\n    });\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    if (!this._wired) {\n      this._wired = true;\n      this.$(\"slot\").addEventListener(\"slotchange\", () => this.requestUpdate());\n      this._default = this.getAttribute(\"value\");\n    }\n  }\n\n  /** The radios of this group (direct or nested, not in a nested group). */\n  get radios() {\n    return [...this.querySelectorAll(\"ray-radio\")].filter((r) => r.closest(\"ray-radio-group\") === this);\n  }\n\n  update() {\n    const radios = this.radios;\n    // A radio marked `checked` in the markup sets the initial value.\n    if (this.value === undefined) {\n      const marked = radios.find((r) => r.hasAttribute(\"checked\"));\n      if (marked) {\n        this.commitProperty(\"value\", marked.value);\n        if (this._default === null) this._default = marked.value;\n      }\n    }\n    const disabled = this.effectivelyDisabled;\n    const current = radios.find((r) => r.value === this.value);\n    const focusable = current && !current.disabled && !disabled ? current : radios.find((r) => !r.disabled);\n    for (const r of radios) {\n      r._setChecked(r === current);\n      r._setGroupDisabled(disabled);\n      r.toggleAttribute(\"data-outline\", (r.variant || this.variant) === \"outline\");\n      r.tabIndex = r === focusable && !disabled ? 0 : -1;\n    }\n\n    this.$(\"#label\").hidden = !this.label;\n    this.$(\".label-text\").textContent = this.label ?? \"\";\n    this.$(\".required\").hidden = !this.required;\n    const desc = this.$(\"#description\");\n    desc.hidden = !this.description;\n    desc.textContent = this.description ?? \"\";\n    const err = this.$(\"#error\");\n    err.hidden = !this.error;\n    err.textContent = this.error ?? \"\";\n    this.internals.ariaLabel = this.label || this.getAttribute(\"aria-label\") || null;\n    this.internals.ariaRequired = this.required ? \"true\" : \"false\";\n    this.internals.ariaDisabled = disabled ? \"true\" : \"false\";\n    this.internals.ariaInvalid = this.error ? \"true\" : \"false\";\n    // Inherited by the radios (custom properties cross into the light DOM children).\n    applyColor(this, this.color);\n\n    this.internals.setFormValue(this.value ?? null);\n    if (this.required && !this.value) {\n      this.internals.setValidity({ valueMissing: true }, \"Please select one of these options.\", radios[0]);\n    } else {\n      this.internals.setValidity({});\n    }\n  }\n\n  _choose(radio, user) {\n    if (radio.disabled || this.effectivelyDisabled) return;\n    const changed = this.value !== radio.value;\n    this.value = radio.value;\n    radio.focus();\n    if (user && changed) {\n      this.dispatchEvent(new Event(\"input\", { bubbles: true, composed: true }));\n      this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n    }\n  }\n\n  _keydown(e) {\n    const radios = this.radios.filter((r) => !r.disabled);\n    const i = radios.indexOf(e.target.closest?.(\"ray-radio\"));\n    if (i < 0) return;\n    let next = null;\n    if (e.key === \"ArrowDown\" || e.key === \"ArrowRight\") next = radios[(i + 1) % radios.length];\n    else if (e.key === \"ArrowUp\" || e.key === \"ArrowLeft\") next = radios[(i - 1 + radios.length) % radios.length];\n    else if (e.key === \" \") next = radios[i];\n    if (!next) return;\n    e.preventDefault();\n    this._choose(next, true);\n  }\n\n  formResetCallback() {\n    this.value = this._default ?? undefined;\n  }\n\n  formStateRestoreCallback(state) {\n    this.value = state ?? undefined;\n  }\n}\n\nconst radioStyles = css`\n  :host {\n    display: block;\n    --_s: var(--_rs, 1.25rem);\n    outline: none;\n  }\n  :host([size=\"xs\"]) { --_s: 1rem; }\n  :host([size=\"sm\"]) { --_s: 1.25rem; }\n  :host([size=\"md\"]) { --_s: 1.5rem; }\n  :host([size=\"lg\"]) { --_s: 1.875rem; }\n  :host([size=\"xl\"]) { --_s: 2.25rem; }\n  .root { display: flex; align-items: flex-start; gap: calc(var(--_s) * 0.6); cursor: pointer; }\n  .indicator {\n    flex: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--_s);\n    height: var(--_s);\n    background: var(--ray-background);\n    border: 1px solid var(--ray-input);\n    border-radius: 50%;\n    transition: background-color var(--ray-duration-fast) var(--ray-easing-standard), border-color var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  .dot { width: 40%; height: 40%; border-radius: 50%; background: var(--_contrast, var(--ray-primary-contrast)); transform: scale(0); transition: transform var(--ray-duration-fast) var(--ray-easing-standard); }\n  :host([data-checked]) .indicator { background: var(--_filled, var(--ray-primary-filled)); border-color: var(--_filled, var(--ray-primary-filled)); }\n  :host([data-checked]) .dot { transform: scale(1); }\n  :host([data-outline][data-checked]) .indicator { background: var(--ray-background); }\n  :host([data-outline]) .dot { background: var(--_filled, var(--ray-primary-filled)); width: 50%; height: 50%; }\n  :host(:focus-visible) .indicator { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: var(--ray-focus-ring-offset); }\n  :host([data-disabled]) .root { cursor: not-allowed; }\n  :host([data-disabled]) .indicator { background: var(--ray-muted); border-color: var(--ray-border); }\n  :host([data-disabled][data-checked]) .indicator { background: var(--ray-border); }\n  :host([data-disabl