connectedCallback() {\n    live.delete(this);\n  }\n\n  attributeChangedCallback(attr, _old, value) {\n    if (this.#reflecting) return;\n    const ctor = /** @type {typeof RayElement} */ (this.constructor);\n    const name = RayElement.#attributes(ctor).get(attr);\n    if (!name) return;\n    this.commitProperty(name, fromAttribute(value, ctor.properties[name].type));\n  }\n\n  /** The stored value, or the declared default when unset (or set to undefined). */\n  #get(name) {\n    const v = this.#values.get(name);\n    if (v !== undefined) return v;\n    return /** @type {typeof RayElement} */ (this.constructor).properties[name].default;\n  }\n\n  #set(name, value) {\n    const ctor = /** @type {typeof RayElement} */ (this.constructor);\n    const opts = ctor.properties[name];\n    if (!this.commitProperty(name, value)) return;\n    if (opts.reflect && opts.attribute !== false) {\n      const attr = opts.attribute ?? kebab(name);\n      this.#reflecting = true;\n      try {\n        if (value === null || value === undefined || value === false) this.removeAttribute(attr);\n        else this.setAttribute(attr, value === true ? \"\" : String(value));\n      } finally {\n        this.#reflecting = false;\n      }\n    }\n  }\n\n  /**\n   * Protected. Sets a declared property without reflecting it to its\n   * attribute and schedules an update — for state the user changed inside\n   * the component (typing, choosing). Returns whether the value changed.\n   */\n  commitProperty(name, value) {\n    const old = this.#get(name);\n    if (Object.is(old, value)) return false;\n    this.#values.set(name, value);\n    if (!this.#changed.has(name)) this.#changed.set(name, old);\n    this.requestUpdate();\n    return true;\n  }\n\n  /** Protected. Whether a declared property has a value of its own (not the default). */\n  hasValue(name) {\n    return this.#values.get(name) !== undefined;\n  }\n\n  /** Schedules `update` for the next microtask (coalesces many changes). */\n  requestUpdate() {\n    if (this.#pending) return;\n    this.#pending = true;\n    queueMicrotask(() => {\n      this.#pending = false;\n      if (!this.isConnected) return;\n      const changed = this.#changed;\n      this.#changed = new Map();\n      this.update(changed);\n      this.#settle();\n    });\n  }\n\n  // After the first update: once a frame has been painted with its initial\n  // state (two frames: the first may run before that state is styled),\n  // transitions are allowed again.\n  #settle() {\n    if (this.#settled || this.#settling) return;\n    this.#settling = true;\n    const done = () => {\n      this.#settled = true;\n      this.#adoptStyles();\n    };\n    // A hidden page paints nothing (and runs no frames): nothing to animate.\n    if (document.visibilityState === \"hidden\") queueMicrotask(done);\n    else requestAnimationFrame(() => requestAnimationFrame(done));\n  }\n  #settling = false;\n\n  /**\n   * Protected. Called after property changes. `changed` maps each changed\n   * property to its previous value (empty on the first call after connecting).\n   * @param {Map<string, unknown>} _changed\n   */\n  update(_changed) {}\n\n  /**\n   * Dispatches a bubbling, composed CustomEvent.\n   * @returns {boolean} false if a listener called preventDefault()\n   */\n  emit(type, detail = undefined, { cancelable = false } = {}) {\n    return this.dispatchEvent(new CustomEvent(type, { detail, bubbles: true, composed: true, cancelable }));\n  }\n\n  /** querySelector inside the shadow root. */\n  $(selector) {\n    return this.shadowRoot.querySelector(selector);\n  }\n\n  /**\n   * Protected. Fills every [data-ray-icon=\"name\"] under `root` (default: the\n   * shadow root) with that icon of the registry (setIcons). Components call\n   * it for markup they create after the template. An empty name or \"none\"\n   * (the value components use to hide an icon) leaves the slot empty.\n   */\n  paintIcons(root = this.shadowRoot) {\n    for (const slot of root.querySelectorAll(\"[data-ray-icon]\")) {\n      const name = slot.getAttribute(\"data-ray-icon\");\n      slot.innerHTML = name && name !== \"none\" ? getIcon(name) : \"\";\n    }\n  }\n}\n\n/**\n * App-wide settings.\n *   configure({ defaults: { \"ray-button\": { variant: \"light\", size: \"md\" } } })\n * Defaults apply to elements connected afterwards, to the properties their\n * markup and code leave unset (an attribute or a property set wins).\n * @param {{ defaults?: Record<string, Record<string, unknown>> }} options\n */\nexport function configure({ defaults } = {}) {\n  if (defaults) {\n    for (const [tag, values] of Object.entries(defaults)) {\n      componentDefaults.set(tag, { ...(componentDefaults.get(tag) ?? {}), ...values });\n    }\n  }\n}\n\n/** The defaults configure() set for a tag. */\nexport function getDefaults(tag) {\n  return { ...(componentDefaults.get(tag) ?? {}) };\n}\n\n// setIcons() repaints every connected element.\nonIconsChange(() => {\n  for (const el of live) el.paintIcons();\n});\n\nfunction kebab(name) {\n  return name.replace(/[A-Z]/g, (c) => \"-\" + c.toLowerCase());\n}\n\nfunction fromAttribute(value, type) {\n  if (type === Boolean) return value !== null;\n  if (value === null) return undefined;\n  if (type === Number) {\n    const n = Number(value);\n    return Number.isNaN(n) ? undefined : n;\n  }\n  return value;\n}\n\n/**\n * Registers a custom element unless the tag is already taken (several copies\n * of a component may be loaded by different parts of an app).\n * @param {string} tag\n * @param {CustomElementConstructor} cls\n */\nexport function define(tag, cls) {\n  if (!customElements.get(tag)) customElements.define(tag, cls);\n}\n\nlet uidCounter = 0;\n/** A document-unique id with the given stem. */\nexport function uid(stem = \"id\") {\n  uidCounter += 1;\n  return `\${PREFIX}-\${stem}-\${uidCounter}`;\n}\n\n// ---------------------------------------------------------------------------\n// Theme\n// ---------------------------------------------------------------------------\n\nconst THEME_KEY = \"ray-ds:theme\";\nconst PRIMARY_KEY = \"ray-ds:primary\";\nconst CUSTOM_KEY = \"ray-ds:primary-color\";\nexport const THEME_EVENT = \"ray-theme-change\";\n\n/** @typedef {\"light\" | \"dark\" | \"system\"} Theme */\n\nfunction store(key, value) {\n  try {\n    if (value === null) localStorage.removeItem(key);\n    else localStorage.setItem(key, value);\n  } catch {\n    // Storage may be unavailable (private mode, some webviews): not persisting is fine.\n  }\n}\n\nfunction load(key) {\n  try {\n    return localStorage.getItem(key);\n  } catch {\n    return null;\n  }\n}\n\n/**\n * The chosen theme of an element (default: the document root).\n * @returns {Theme}\n */\nexport function getTheme(el = document.documentElement) {\n  const t = el.getAttribute(\"data-theme\");\n  return t === \"light\" || t === \"dark\" ? t : \"system\";\n}\n\n/**\n * The theme actually shown: \"light\" or \"dark\".\n * @returns {\"light\" | \"dark\"}\n */\nexport function resolvedTheme(el = document.documentElement) {\n  const holder = el.closest(\"[data-theme]\");\n  const t = holder ? getTheme(holder) : \"system\";\n  if (t !== \"system\") return t;\n  return matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\";\n}\n\n/**\n * Forces a theme on an element (default: the document root) or returns it to\n * the system's. Persisted for the root unless `persist` is false.\n * @param {Theme} theme\n */\nexport function setTheme(theme, { el = document.documentElement, persist = el === document.documentElement } = {}) {\n  if (theme === \"light\" || theme === \"dark\") el.setAttribute(\"data-theme\", theme);\n  else el.removeAttribute(\"data-theme\");\n  if (persist) store(THEME_KEY, theme === \"system\" ? null : theme);\n  notifyTheme(el);\n}\n\n// The color last given to definePrimary(), per element.\nconst customColors = new WeakMap();\n\n/**\n * The color last given to definePrimary() for an element, as \"#rrggbb\" (null\n * if none) — what a color picker for the custom primary should show.\n */\nexport function getCustomPrimary(el = document.documentElement) {\n  return customColors.get(el) ?? null;\n}\n\n/** The primary color of an element (null = the default from tokens.toml). */\nexport function getPrimary(el = document.documentElement) {\n  return el.getAttribute(\"data-primary\");\n}\n\n/**\n * Switches the primary color (any palette color) of an element and its subtree.\n * @param {string | null} color\n */\nexport function setPrimary(color, { el = document.documentElement, persist = el === document.documentElement } = {}) {\n  if (color) el.setAttribute(\"data-primary\", color);\n  else el.removeAttribute(\"data-primary\");\n  if (persist) store(PRIMARY_KEY, color);\n  notifyTheme(el);\n}\n\n/**\n * Makes any CSS color the primary color of an element (default: the\n * document): builds its ten shades (OKLCH, same hue), picks white or black\n * text for its filled shade by contrast, and switches to data-primary=\"custom\".\n * The variants follow the same rules as the palette colors (tokens.toml).\n * Persisted for the document unless `persist` is false.\n * @param {string} color\n * @returns {{ shades: string[], contrast: \"white\" | \"black\", ratio: number, aa: boolean }}\n */\nexport function definePrimary(color, { el = document.documentElement, persist = el === document.documentElement } = {}) {\n  const rgb = parseColor(color);\n  if (!rgb) throw new TypeError(`definePrimary: \"\${color}\" is not a CSS color`);\n  customColors.set(el, toHex(rgb));\n  const scale = shades(rgb);\n  const base = toHex(rgb);\n  // Filled: the color itself when white text on it reaches AA; a bright color\n  // (light, AA with black text) also fills with itself, with black text, like\n  // yellow in the palette; otherwise the closest darker shade that reaches AA\n  // with white. What the user picked is what they see, as far as AA allows.\n  const whiteOk = (hex) => contrastRatio(hex, \"#ffffff\") >= 4.5;\n  const bright = !whiteOk(base) && toOklch(rgb).l >= 0.72 && contrastRatio(base, \"#000000\") >= 4.5;\n  const baseIndex = scale.indexOf(base);\n  let index = baseIndex;\n  if (!whiteOk(base) && !bright) {\n    index = scale.findIndex((hex, i) => i > baseIndex && whiteOk(hex));\n    if (index < 0) index = 9;\n  }\n  const filled = scale[index];\n  const hover = index < 9 ? scale[index + 1] : toHex({ r: rgb.r * 0.85, g: rgb.g * 0.85, b: rgb.b * 0.85 });\n  const white = contrastRatio(filled, \"#ffffff\");\n  const black = contrastRatio(filled, \"#000000\");\n  const contrast = bright || black > white ? \"black\" : \"white\";\n  const ratio = contrast === \"white\" ? white : black;\n  scale.forEach((hex, i) => el.style.setProperty(`--ray-custom-src-\${i}`, hex));\n  el.style.setProperty(\"--ray-custom-src-contrast\", contrast === \"white\" ? \"#ffffff\" : \"#000000\");\n  el.style.setProperty(\"--ray-custom-src-filled\", filled);\n  el.style.setProperty(\"--ray-custom-src-filled-hover\", hover);\n  if (persist) store(CUSTOM_KEY, color);\n  setPrimary(\"custom\", { el, persist });\n  const aa = ratio >= 4.5;\n  if (!aa) console.warn(`ray-ds: definePrimary(\"\${color}\"): text on the filled shade is \${ratio.toFixed(1)}:1, below WCAG AA (4.5:1)`);\n  return { shades: scale, filled, contrast, ratio, aa };\n}\n\nfunction notifyTheme(el) {\n  el.dispatchEvent(new CustomEvent(THEME_EVENT, {\n    bubbles: true,\n    composed: true,\n    detail: { theme: getTheme(el), resolved: resolvedTheme(el), primary: getPrimary(el) },\n  }));\n}\n\n/**\n * Calls `cb` when the theme of the document changes, by setTheme/setPrimary\n * or by the system. Returns a function that stops listening.\n * @param {(detail: {theme: Theme, resolved: \"light\" | \"dark\", primary: string | null}) => void} cb\n */\nexport function onThemeChange(cb) {\n  const onEvent = (e) => cb(e.detail);\n  const mq = matchMedia(\"(prefers-color-scheme: dark)\");\n  const onSystem = () => {\n    const root = document.documentElement;\n    cb({ theme: getTheme(root), resolved: resolvedTheme(root), primary: getPrimary(root) });\n  };\n  document.addEventListener(THEME_EVENT, onEvent);\n  mq.addEventListener(\"change\", onSystem);\n  return () => {\n    document.removeEventListener(THEME_EVENT, onEvent);\n    mq.removeEventListener(\"change\", onSystem);\n  };\n}\n\n// Restore the persisted choice as soon as the runtime loads. An explicit\n// data-theme / data-primary in the markup wins over the stored one.\n{\n  const root = document.documentElement;\n  const theme = load(THEME_KEY);\n  if (!root.hasAttribute(\"data-theme\") && (theme === \"light\" || theme === \"dark\")) {\n    root.setAttribute(\"data-theme\", theme);\n  }\n  const primary = load(PRIMARY_KEY);\n  if (!root.hasAttribute(\"data-primary\") && primary) {\n    // A custom primary needs its shades back, not just the attribute.\n    const custom = primary === \"custom\" ? load(CUSTOM_KEY) : null;\n    if (custom && parseColor(custom)) definePrimary(custom, { persist: false });\n    else if (primary !== \"custom\") root.setAttribute(\"data-primary\", primary);\n  }\n}\n";
const F72: string = "// Light dismiss for floating panels shown as popover=\"manual\": what\n// popover=\"auto\" does (outside click, Escape, one open at a time unless\n// nested), done here so the component decides how to close — and can\n// animate the exit, which an automatic close would not allow.\n//\n//   const stop = dismissable({ panel, owner: this, trigger, close: (reason) => … });\n//   stop();  // when the panel closed\n//\n// Escape closes the topmost panel and is consumed (preventDefault), so a\n// dialog underneath stays open. A pointer press outside a panel (and its\n// owner and trigger) closes it and every panel above it.\n\nconst stack = [];\n\n/** Whether `node` is inside `container`, crossing shadow roots and slots. */\nfunction within(container, node) {\n  for (let n = node; n; n = n.assignedSlot ?? n.parentNode ?? n.host) {\n    if (n === container) return true;\n  }\n  return false;\n}\n\nfunction inside(entry, path) {\n  return path.some((n) => n === entry.panel || n === entry.owner || (entry.trigger && n === entry.trigger));\n}\n\nfunction onPointer(e) {\n  if (!stack.length) return;\n  const path = e.composedPath();\n  let keep = -1;\n  for (let i = stack.length - 1; i >= 0; i--) {\n    if (inside(stack[i], path)) {\n      keep = i;\n      break;\n    }\n  }\n  for (let i = stack.length - 1; i > keep; i--) stack[i].close(\"outside\");\n}\n\nfunction onKey(e) {\n  if (e.key !== \"Escape\" || !stack.length || e.defaultPrevented) return;\n  e.preventDefault();\n  stack[stack.length - 1].close(\"escape\");\n}\n\n/**\n * Registers an open panel. Panels that do not contain the new one's owner\n * close (one open at a time, nested ones excepted).\n * @param {{ panel: Element, owner: Element, trigger?: Element | null, close: (reason: \"outside\" | \"escape\" | \"replaced\") => void }} entry\n * @returns {() => void} unregisters it\n */\nexport function dismissable(entry) {\n  for (let i = stack.length - 1; i >= 0; i--) {\n    if (!within(stack[i].panel, entry.owner)) stack[i].close(\"replaced\");\n  }\n  if (!stack.length) {\n    document.addEventListener(\"pointerdown\", onPointer, true);\n    document.addEventListener(\"keydown\", onKey);\n  }\n  stack.push(entry);\n  return () => {\n    const i = stack.indexOf(entry);\n    if (i >= 0) stack.splice(i, 1);\n    if (!stack.length) {\n      document.removeEventListener(\"pointerdown\", onPointer, true);\n      document.removeEventListener(\"keydown\", onKey);\n    }\n  };\n}\n";
const F73: string = "// Base class of trigger + floating panel components (popover, menu, tooltip).\n//\n// The panel is a [popover] element in the shadow root, so it renders in the\n// top layer (above dialogs, never clipped by overflow). It is a manual\n// popover with light dismiss done in core/dismiss.js (Escape, outside\n// clicks, one open at a time): closing is always ours, so it can animate\n// out. The trigger is the element slotted into slot=\"trigger\".\n\nimport { RayElement, css } from \"./core.js\";\nimport { place, autoUpdate } from \"./position.js\";\nimport { dismissable } from \"./dismiss.js\";\nimport { play, POP_OUT } from \"./motion.js\";\n\nexport const floatingStyles = css`\n  :host { display: inline-block; }\n  .panel {\n    box-sizing: border-box;\n    max-width: calc(100vw - 16px);\n    max-height: calc(100vh - 16px);\n    overflow: auto;\n    padding: 0;\n    margin: 0;\n    color: var(--ray-popover-foreground);\n    background: var(--ray-popover);\n    border: 1px solid var(--ray-border);\n    border-radius: var(--ray-radius-default);\n    box-shadow: var(--ray-shadow-md);\n  }\n  .panel:popover-open { animation: ray-pop-in var(--ray-duration-fast) var(--ray-easing-out); }\n  @keyframes ray-pop-in { from { opacity: 0; transform: scale(0.97); } }\n`;\n\nexport class Floating extends RayElement {\n  static properties = {\n    open: { type: Boolean, reflect: true },\n    placement: { type: String, reflect: true, default: \"bottom\" },\n    offset: { type: Number, default: 8 },\n  };\n  /** popover attribute of the panel (\"manual\": closing is handled here). */\n  static popoverMode = \"manual\";\n  /** Close on Escape and outside clicks (tooltips: false). */\n  static lightDismiss = true;\n  /** aria-haspopup set on the trigger (null = none). */\n  static haspopup = \"dialog\";\n  /** The slot holding the trigger. */\n  static triggerSlot = 'slot[name=\"trigger\"]';\n\n  #wired = false;\n  #synced = false;\n  #trigger = null;\n  #stopTracking = null;\n  #closedAt = undefined;\n  #undismiss = null;\n  #exit = null;\n\n  connectedCallback() {\n    super.connectedCallback();\n    if (this.#wired) return;\n    this.#wired = true;\n    this.panel = this.$(\".panel\");\n    this.panel.setAttribute(\"popover\", /** @type {typeof Floating} */ (this.constructor).popoverMode);\n    this.panel.addEventListener(\"toggle\", (e) => this._onToggle(e));\n    // `toggle` is async: by then focus has already left a hidden panel.\n    this.panel.addEventListener(\"beforetoggle\", (e) => {\n      if (e.newState === \"closed\") this.focusWasInside = this.contains(document.activeElement) && !this.trigger?.contains(document.activeElement);\n    });\n    const slot = this.$(/** @type {typeof Floating} */ (this.constructor).triggerSlot);\n    slot?.addEventListener(\"slotchange\", () => this._wireTrigger());\n    this._wireTrigger();\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    this.#stopTracking?.();\n    this.#undismiss?.();\n    this.#undismiss = null;\n  }\n\n  /** The element slotted as trigger, if any. */\n  get trigger() {\n    return this.$(/** @type {typeof Floating} */ (this.constructor).triggerSlot)?.assignedElements()[0] ?? null;\n  }\n\n  _wireTrigger() {\n    const t = this.trigger;\n    if (t === this.#trigger) return;\n    this.#trigger = t;\n    if (!t) return;\n    const hp = this.popupKind();\n    if (hp) {\n      t.setAttribute(\"aria-haspopup\", hp);\n      t.setAttribute(\"aria-expanded\", String(Boolean(this.open)));\n    }\n    this.wireTrigger(t);\n  }\n\n  /** aria-haspopup of the trigger for this instance (null: not a popup trigger). */\n  popupKind() {\n    return /** @type {typeof Floating} */ (this.constructor).haspopup;\n  }\n\n  /** Subclasses attach their trigger listeners here. */\n  wireTrigger(_trigger) {}\n\n  /** The rectangle the panel is placed against (default: the trigger). */\n  anchorRect() {\n    return (this.trigger ?? this).getBoundingClientRect();\n  }\n\n  show() { this.open = true; }\n  hide() { this.open = false; }\n  toggle() { this.open = !this.open; }\n\n  update(changed) {\n    if (changed.has(\"open\") || !this.#synced) {\n      this.#synced = true;\n      const isOpen = this.panel.matches(\":popover-open\");\n      if (this.open) {\n        // Reopened while animating out: stay open.\n        this.#exit?.cancel();\n        this.#exit = null;\n        this.panel.style.pointerEvents = \"\";\n        if (!isOpen) this.panel.showPopover();\n        this._dismissable();\n      } else if (isOpen && !this.#exit) {\n        this._closePanel();\n      }\n    }\n    if (this.open) this.reposition();\n  }\n\n  _dismissable() {\n    const ctor = /** @type {typeof Floating} */ (this.constructor);\n    if (this.#undismiss || !ctor.lightDismiss || ctor.popoverMode !== \"manual\") return;\n    this.#undismiss = dismissable({ panel: this.panel, owner: this, trigger: this.trigger, close: () => { this.open = false; } });\n  }\n\n  /** The keyframes the panel leaves with (subclasses may change them). */\n  exitKeyframes() {\n    return POP_OUT;\n  }\n\n  // Animate out, then really hide (unless reopened meanwhile).\n  async _closePanel() {\n    this.#undismiss?.();\n    this.#undismiss = null;\n    const exit = play(this.panel, this.exitKeyframes(), { speed: \"fast\" });\n    this.#exit = exit;\n    // Leaving: no more clicks on it (focus stays where it is until hidden).\n    this.panel.style.pointerEvents = \"none\";\n    await exit.finished;\n    this.panel.style.pointerEvents = \"\";\n    if (this.#exit !== exit) return;\n    this.#exit = null;\n    if (!this.open && this.panel.matches(\":popover-open\")) this.panel.hidePopover();\n    exit.cancel();\n  }\n\n  reposition() {\n    if (!this.panel.matches(\":popover-open\")) return;\n    place(this.anchorRect(), this.panel, { placement: this.placement || \"bottom\", offset: this.offset ?? 8, ...this.placeOptions() });\n  }\n\n  /** Extra place() options for subclasses (e.g. matchWidth). */\n  placeOptions() { return {}; }\n\n  _onToggle(e) {\n    const opening = e.newState === \"open\";\n    if (this.popupKind()) this.#trigger?.setAttribute(\"aria-expanded\", String(opening));\n    if (opening) {\n      this.reposition();\n      const anchor = this.trigger ?? this;\n      this.#stopTracking = autoUpdate(anchor, this.panel, () => this.reposition());\n    } else {\n      this.#stopTracking?.();\n      this.#stopTracking = null;\n      this.#closedAt = performance.now();\n    }\n    // Light dismiss and Escape close the panel behind our back: sync `open`.\n    if (Boolean(this.open) !== opening) this.commitProperty(\"open\", opening);\n    this.emit(opening ? \"ray-open\" : \"ray-close\");\n    this.toggled(opening);\n  }\n\n  /** Hook after the panel opened/closed. */\n  toggled(_open) {}\n\n  /**\n   * Whether a click on the trigger should be ignored because the same\n   * pointer gesture just light-dismissed the panel (it would reopen it).\n   */\n  justClosed() {\n    return this.#closedAt !== undefined && performance.now() - this.#closedAt < 250;\n  }\n}\n";
const F74: string = "// Focus helpers that see through shadow roots and slots (the flat tree), so\n// components made of other components can find what is focusable.\n\nconst FOCUSABLE = [\n  \"a[href]\",\n  \"area[href]\",\n  \"button:not([disabled])\",\n  \"input:not([disabled]):not([type=hidden])\",\n  \"select:not([disabled])\",\n  \"textarea:not([disabled])\",\n  \"iframe\",\n  \"audio[controls]\",\n  \"video[controls]\",\n  \"summary\",\n  \"[contenteditable]:not([contenteditable=false])\",\n  \"[tabindex]\",\n].join(\",\");\n\nfunction visible(el) {\n  if (typeof el.checkVisibility === \"function\") return el.checkVisibility({ visibilityProperty: true });\n  return el.getClientRects().length > 0;\n}\n\n/**\n * Tabbable elements under `root` (an element or a shadow root), in tree\n * order, descending into open shadow roots and slotted content.\n * @returns {HTMLElement[]}\n */\nexport function tabbables(root, { lightOnly = false } = {}) {\n  const out = [];\n  const walk = (node) => {\n    for (const child of childrenOf(node)) {\n      if (!(child instanceof HTMLElement)) continue;\n      if (child.matches(FOCUSABLE) && child.tabIndex >= 0 && !child.hasAttribute(\"inert\") && visible(child)) {\n        out.push(child);\n      }\n      if (child.hasAttribute(\"inert\")) continue;\n      walk(child);\n    }\n  };\n  if (lightOnly) {\n    // Only the root's own (slotted) content, not its shadow root.\n    for (const child of root.children) {\n      if (!(child instanceof HTMLElement) || child.hasAttribute(\"inert\")) continue;\n      if (child.matches(FOCUSABLE) && child.tabIndex >= 0 && visible(child)) out.push(child);\n      walk(child);\n    }\n  } else {\n    walk(root);\n  }\n  return out;\n}\n\nfunction childrenOf(node) {\n  if (node instanceof HTMLSlotElement) return node.assignedElements({ flatten: true });\n  if (node instanceof Element && node.shadowRoot) return [...node.shadowRoot.children];\n  return [...node.children];\n}\n\n/**\n * Focuses the first [autofocus] or tabbable element; returns whether\n * something got focus. `lightOnly`: look only at a host's own content.\n */\nexport function focusFirst(root, { lightOnly = false } = {}) {\n  const auto = root.querySelector?.(\"[autofocus]\");\n  const target = auto ?? tabbables(root, { lightOnly })[0];\n  if (!target) return false;\n  target.focus({ preventScroll: true });\n  return true;\n}\n";
const F75: string = "// Form-associated base classes.\n//\n// FormControl: a custom element that takes part in <form> like a native\n// control (value submitted under `name`, constraint validation, reset,\n// disabled by <fieldset>), through ElementInternals.\n//\n// FieldControl: a FormControl around one native control in its shadow root,\n// with Mantine's input wrapper — label, description, error and the required\n// asterisk — wired with ids and ARIA *inside* the shadow root, so the\n// accessible name works (a <label for> outside cannot reach into it).\n\nimport { RayElement, css } from \"./core.js\";\n\nexport class FormControl extends RayElement {\n  static formAssociated = true;\n  static delegatesFocus = true;\n\n  #fieldsetDisabled = false;\n\n  constructor() {\n    super();\n    this.internals = this.attachInternals();\n  }\n\n  /** The <form> this control belongs to. */\n  get form() { return this.internals.form; }\n  get validity() { return this.internals.validity; }\n  get validationMessage() { return this.internals.validationMessage; }\n  get willValidate() { return this.internals.willValidate; }\n  checkValidity() { return this.internals.checkValidity(); }\n  reportValidity() { return this.internals.reportValidity(); }\n\n  /** Disabled by its own attribute or by a disabled <fieldset>. */\n  get effectivelyDisabled() {\n    return Boolean(this.disabled) || this.#fieldsetDisabled === true;\n  }\n\n  formDisabledCallback(disabled) {\n    this.#fieldsetDisabled = disabled;\n    this.requestUpdate();\n  }\n\n  /** Re-dispatches a non-composed event (e.g. `change`) from the host. */\n  forward(event) {\n    this.dispatchEvent(new Event(event.type, { bubbles: true, cancelable: event.cancelable }));\n  }\n}\n\n/** The field wrapper around a control: label, description, box, error. */\nexport const fieldStyles = css`\n  :host {\n    display: flex;\n    flex-direction: column;\n    font-size: var(--_fs);\n  }\n  /* description-position=\"below\": after the control, with the error (the DOM\n     order and aria-describedby stay the same). */\n  :host([description-position=\"below\"]) .description { order: 1; margin: var(--ray-space-1) 0 0; }\n  :host([description-position=\"below\"]) .error { order: 2; }\n  .label {\n    display: inline-block;\n    align-self: flex-start;\n    margin-bottom: var(--ray-space-1);\n    font-size: var(--_fs);\n    font-weight: var(--ray-font-weight-medium);\n    color: var(--ray-foreground);\n    cursor: default;\n  }\n  .required { color: var(--ray-destructive); }\n  .description {\n    margin: calc(var(--ray-space-1) * -0.5) 0 var(--ray-space-1);\n    font-size: calc(var(--_fs) - 0.125rem);\n    line-height: var(--ray-line-height-sm);\n    color: var(--ray-muted-foreground);\n  }\n  .error {\n    margin-top: var(--ray-space-1);\n    font-size: calc(var(--_fs) - 0.125rem);\n    line-height: var(--ray-line-height-sm);\n    color: var(--ray-destructive);\n  }\n  [hidden] { display: none !important; }\n`;\n\n/** A text-like control box: input, textarea, select. */\nexport const boxStyles = css`\n  .box {\n    position: relative;\n    display: flex;\n    align-items: center;\n    min-height: var(--_h);\n    color: var(--ray-foreground);\n    background: var(--ray-background);\n    border: 1px solid var(--ray-input);\n    border-radius: var(--_r);\n    border-start-start-radius: var(--ray-group-radius-ss, var(--_r));\n    border-start-end-radius: var(--ray-group-radius-se, var(--_r));\n    border-end-start-radius: var(--ray-group-radius-es, var(--_r));\n    border-end-end-radius: var(--ray-group-radius-ee, var(--_r));\n    transition: border-color var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  :host([variant=\"filled\"]) .box { background: var(--ray-muted); border-color: transparent; }\n  :host([variant=\"unstyled\"]) .box { background: transparent; border-color: transparent; }\n  .box:focus-within {\n    border-color: var(--ray-primary);\n    outline: var(--ray-focus-ring-width) solid var(--ray-ring);\n    outline-offset: -1px;\n  }\n  :host([variant=\"unstyled\"]) .box:focus-within { outline: none; }\n  .box[data-invalid] { border-color: var(--ray-destructive); }\n  .box[data-invalid]:focus-within { outline-color: color-mix(in srgb, var(--ray-destructive) 45%, transparent); }\n  .box[data-disabled] { background: var(--ray-muted); color: var(--ray-muted-foreground); cursor: not-allowed; opacity: 0.75; }\n  .control {\n    flex: 1;\n    min-width: 0;\n    height: 100%;\n    min-height: calc(var(--_h) - 2px);\n    margin: 0;\n    padding: 0 calc(var(--_px) * 0.66);\n    font: inherit;\n    font-size: var(--_fs);\n    color: inherit;\n    background: transparent;\n    border: 0;\n    outline: none;\n  }\n  .control::placeholder { color: var(--ray-muted-foreground); opacity: 0.8; }\n  .control:disabled { cursor: not-allowed; }\n  .section {\n    display: inline-flex;\n    flex: none;\n    align-items: center;\n    justify-content: center;\n    min-width: var(--_h);\n    height: calc(var(--_h) - 2px);\n    color: var(--ray-muted-foreground);\n  }\n  .section:not([data-filled]) { display: none; }\n  .section[data-filled] + .control, .control:has(+ .section[data-filled]) { padding-inline: 0; }\n`;\n\n/**\n * Markup of a field around `control`, whose element must carry\n * id=\"control\" and class=\"control\". Sections are slots \"left\" and \"right\".\n */\nexport function fieldTemplate(control, { sections = true } = {}) {\n  const left = sections ? `<span class=\"section\" part=\"left-section\"><slot name=\"left\"></slot></span>` : \"\";\n  const right = sections ? `<span class=\"section\" part=\"right-section\"><slot name=\"right\"></slot></span>` : \"\";\n  return `\n    <label class=\"label\" part=\"label\" for=\"control\" hidden><span class=\"label-text\"></span><span class=\"required\" aria-hidden=\"true\" hidden> *</span></label>\n    <div class=\"description\" part=\"description\" id=\"description\" hidden></div>\n    <div class=\"box\" part=\"wrapper\">\${left}\${control}\${right}</div>\n    <div class=\"error\" part=\"error\" id=\"error\" hidden></div>`;\n}\n\n/**\n * A FormControl around one native control (#control in the shadow root).\n * Subclasses declare the field properties with FieldControl.fieldProperties.\n */\nexport class FieldControl extends FormControl {\n  #wired = false;\n\n  static fieldProperties = {\n    name: { type: String, reflect: true },\n    label: { type: String },\n    description: { type: String },\n    error: { type: String },\n    required: { type: Boolean, reflect: true },\n    disabled: { type: Boolean, reflect: true },\n    size: { type: String, reflect: true, default: \"sm\" },\n    radius: { type: String, reflect: true },\n    variant: { type: String, reflect: true, default: \"default\" },\n    descriptionPosition: { type: String, reflect: true, default: \"above\" },\n  };\n\n  constructor() {\n    super();\n    /** The native control in the shadow root. */\n    this.control = this.$(\"#control\");\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    if (!this.#wired) {\n      this.#wired = true;\n      for (const side of [\"left\", \"right\"]) {\n        const slot = this.$(`slot[name=\"\${side}\"]`);\n        slot?.addEventListener(\"slotchange\", () => {\n          slot.parentElement.toggleAttribute(\"data-filled\", slot.assignedNodes().length > 0);\n        });\n      }\n      this.wire?.();\n    }\n  }\n\n  /** Label, description, error, ARIA and validity. Call from update(). */\n  syncField() {\n    const label = this.$(\".label\");\n    label.hidden = !this.label;\n    this.$(\".label-text\").textContent = this.label ?? \"\";\n    this.$(\".required\").hidden = !this.required;\n\n    const desc = this.$(\"#description\");\n    desc.hidden = !this.description;\n    desc.textContent = this.description ?? \"\";\n    const err = this.$(\"#error\");\n    err.hidden = !this.error;\n    err.textContent = this.error ?? \"\";\n\n    const c = this.control;\n    const described = [this.description ? \"description\" : \"\", this.error ? \"error\" : \"\"].filter(Boolean).join(\" \");\n    if (described) c.setAttribute(\"aria-describedby\", described);\n    else c.removeAttribute(\"aria-describedby\");\n    if (this.error) c.setAttribute(\"aria-invalid\", \"true\");\n    else c.removeAttribute(\"aria-invalid\");\n    // Without a visible label, the host's aria-label names the control.\n    const aria = this.getAttribute(\"aria-label\");\n    if (!this.label && aria) c.setAttribute(\"aria-label\", aria);\n    else c.removeAttribute(\"aria-label\");\n\n    c.required = Boolean(this.required);\n    c.disabled = this.effectivelyDisabled;\n    const box = this.$(\".box\");\n    box?.toggleAttribute(\"data-invalid\", Boolean(this.error));\n    box?.toggleAttribute(\"data-disabled\", this.effectivelyDisabled);\n    this.syncValidity();\n  }\n\n  /** Mirrors the native control's validity into the form. */\n  syncValidity() {\n    const c = this.control;\n    if (c.validity.valid) this.internals.setValidity({});\n    else this.internals.setValidity(c.validity, c.validationMessage, c);\n  }\n}\n";
const F76: string = "// The native host: what the program around the page can do that a browser\n// cannot (system file dialogs, native confirmations). Components ask for it\n// and keep their web behavior when there is none, so they stay agnostic of\n// the host: they never import a bridge, a bridge installs a host here.\n// core/raylang.js installs the one of std/ui windows.\n//\n// A host is an object with `name`, `can(op)` and the operations it offers:\n//\n//   pickFiles({ title, multiple, directory, filters: [{ name, extensions }] })\n//     -> Promise<HostFile[]>   ([] when the user cancels)\n//   pickPath({ mode, title, directory, suggested, filters })\n//     -> Promise<string|null>  (mode: \"open\", \"folder\" or \"save\"; null = cancelled)\n//   confirm({ title, message, confirmLabel, cancelLabel, style })\n//     -> Promise<boolean>      (style: \"\", \"info\", \"warning\" or \"error\")\n//   menuItems()\n//     -> Promise<[{ menu, tag, title, shortcut, enabled, checked }]>  (the app's menu bar)\n//   runMenu(tag)\n//     -> Promise<true>         (the program gets the item as if chosen in the menu bar)\n//   popupMenu([{ title, enabled, checked, separator }])\n//     -> Promise<number|null>  (a native context menu at the pointer: the index\n//                               chosen, null when dismissed or replaced)\n//   setEdited(edited)          (the window's \"unsaved changes\" mark)\n//     -> Promise<true>\n//   titlebar                   ({ height, inset } in px when the page runs under a\n//                               transparent title bar, else null: reserve `height`\n//                               at the top, `inset` at the start for the window\n//                               buttons; also --ray-titlebar-height and\n//                               --ray-titlebar-inset on <html>)\n\nlet current = null;\nconst listeners = new Set();\n\n/** Installs the host (null removes it) and tells the listeners. */\nexport function setHost(host) {\n  current = host ?? null;\n  for (const cb of [...listeners]) cb(current);\n}\n\n/** The installed host, or null. */\nexport function getHost() {\n  return current;\n}\n\n/** Whether the installed host offers `op` (\"pick_files\", \"confirm\"…). */\nexport function hostCan(op) {\n  return Boolean(current && typeof current.can === \"function\" && current.can(op));\n}\n\n/** Calls `cb(host)` whenever the host changes; returns the unsubscribe function. */\nexport function onHostChange(cb) {\n  listeners.add(cb);\n  return () => listeners.delete(cb);\n}\n\n/** The title bar the page runs under ({ height, inset } px), or null. */\nexport function titlebar() {\n  const t = current?.titlebar;\n  return t && t.height > 0 ? t : null;\n}\n\n// Interactive elements inside a drag handle stay clickable.\nconst INTERACTIVE = \"button, a[href], input, select, textarea, label, summary, [contenteditable], [role=button], [role=tab], [role=link], [role=menuitem], [tabindex]:not([tabindex='-1']), [data-ray-no-drag]\";\n\n/**\n * Makes `el` drag the window when the page runs under a host's title bar\n * (titlebar() is not null): it gets data-ray-drag, the attribute the std/ui\n * shell reads. The shell looks at the event's target, which a shadow root\n * retargets to its host, so for a pointer down on anything interactive\n * inside `el` (a button in its shadow root too) the attribute steps aside\n * until the pointer is up. Returns the function that undoes it.\n */\nexport function dragRegion(el) {\n  const guard = (e) => {\n    if (!el.hasAttribute(\"data-ray-drag\")) return;\n    const path = e.composedPath();\n    const end = path.indexOf(el);\n    const hit = path.slice(0, end < 0 ? 0 : end).some((n) => n instanceof Element && n.matches(INTERACTIVE));\n    if (!hit) return;\n    el.removeAttribute(\"data-ray-drag\");\n    const back = () => {\n      removeEventListener(\"pointerup\", back, true);\n      removeEventListener(\"pointercancel\", back, true);\n      if (titlebar()) el.setAttribute(\"data-ray-drag\", \"\");\n    };\n    addEventListener(\"pointerup\", back, true);\n    addEventListener(\"pointercancel\", back, true);\n  };\n  const sync = () => el.toggleAttribute(\"data-ray-drag\", Boolean(titlebar()));\n  el.addEventListener(\"pointerdown\", guard, true);\n  const stop = onHostChange(sync);\n  sync();\n  return () => {\n    stop();\n    el.removeEventListener(\"pointerdown\", guard, true);\n    el.removeAttribute(\"data-ray-drag\");\n  };\n}\n\nconst formKey = (data) => JSON.stringify([...data].map(([k, v]) => [k, typeof v === \"string\" ? v : `\${v.name}:\${v.size}:\${v.lastModified}`]));\n\n/**\n * Follows whether `form` has unsaved changes: its FormData differs from the\n * one it had when tracking started (or since clean()). With a host that\n * offers \"set_edited\", the window shows it (the macOS close button's dot).\n * `onChange(dirty)` is called when it flips. Submit and reset make it clean.\n */\nexport function trackEdits(form, { onChange } = {}) {\n  let saved = formKey(new FormData(form));\n  let dirty = false;\n  const set = (next) => {\n    if (next === dirty) return;\n    dirty = next;\n    if (hostCan(\"set_edited\")) current.setEdited(dirty).catch(() => {});\n    onChange?.(dirty);\n  };\n  const compare = () => set(formKey(new FormData(form)) !== saved);\n  // After the controls' own updates (form-associated elements set their\n  // value in a microtask when it is assigned by code).\n  const check = () => queueMicrotask(() => queueMicrotask(compare));\n  const clean = () => {\n    saved = formKey(new FormData(form));\n    set(false);\n  };\n  const onReset = () => setTimeout(clean, 0);\n  form.addEventListener(\"input\", check);\n  form.addEventListener(\"change\", check);\n  form.addEventListener(\"submit\", clean);\n  form.addEventListener(\"reset\", onReset);\n  return {\n    get dirty() { return dirty; },\n    /** Takes the current values as saved (after saving them some other way). */\n    clean,\n    /** Compares now (the events already do it). */\n    check: compare,\n    stop() {\n      form.removeEventListener(\"input\", check);\n      form.removeEventListener(\"change\", check);\n      form.removeEventListener(\"submit\", clean);\n      form.removeEventListener(\"reset\", onReset);\n      set(false);\n    },\n  };\n}\n\nconst TYPES = {\n  png: \"image/png\", jpg: \"image/jpeg\", jpeg: \"image/jpeg\", gif: \"image/gif\", webp: \"image/webp\",\n  avif: \"image/avif\", svg: \"image/svg+xml\", bmp: \"image/bmp\", heic: \"image/heic\", ico: \"image/x-icon\",\n  mp4: \"video/mp4\", mov: \"video/quicktime\", webm: \"video/webm\", mkv: \"video/x-matroska\",\n  mp3: \"audio/mpeg\", wav: \"audio/wav\", ogg: \"audio/ogg\", m4a: \"audio/mp4\", flac: \"audio/flac\",\n  txt: \"text/plain\", md: \"text/markdown\", csv: \"text/csv\", html: \"text/html\", css: \"text/css\",\n  js: \"text/javascript\", xml: \"text/xml\", json: \"application/json\", pdf: \"application/pdf\",\n  zip: \"application/zip\", gz: \"application/gzip\", tar: \"application/x-tar\",\n};\n\n/** The MIME type of a file name, from its extension (\"\" when unknown). */\nexport function typeOfName(name) {\n  const dot = String(name).lastIndexOf(\".\");\n  return dot < 0 ? \"\" : TYPES[String(name).slice(dot + 1).toLowerCase()] ?? \"\";\n}\n\n/** The extensions of a MIME type or pattern (\"image/*\", \"application/pdf\"). */\nexport function extensionsOfType(type) {\n  const t = String(type).toLowerCase();\n  const all = Object.keys(TYPES);\n  if (t.endsWith(\"/*\")) return all.filter((x) => TYPES[x].startsWith(t.slice(0, -1)));\n  return all.filter((x) => TYPES[x] === t);\n}\n\n/**\n * The file dialog filters of an `accept` list (\".png,image/*\", as in\n * <input type=file>): one filter with every extension, called `name` (by\n * default the extensions). [] (any file) when a type has no known\n * extension, so the dialog never hides a file the list accepts.\n */\nexport function acceptFilters(accept, name = \"\") {\n  const exts = [];\n  const list = String(accept ?? \"\").split(\",\").map((s) => s.trim().toLowerCase()).filter(Boolean);\n  for (const a of list) {\n    const more = a.startsWith(\".\") ? [a.slice(1)] : extensionsOfType(a);\n    if (more.length === 0) return [];\n    for (const x of more) if (!exts.includes(x)) exts.push(x);\n  }\n  if (exts.length === 0) return [];\n  return [{ name: name || exts.map((x) => x.toUpperCase()).join(\", \"), extensions: exts }];\n}\n\n/**\n * A file the host chose: a path on the user's disk instead of the bytes of\n * a File. It has the File fields components read (name, size, type,\n * lastModified), so it lists like one; the program reads the file.\n */\nexport class HostFile {\n  constructor({ path, name, size = 0, type, lastModified = 0 }) {\n    this.path = String(path);\n    this.name = name ?? this.path.split(/[\\\\/]/).pop();\n    this.size = size >= 0 ? size : 0;\n    this.type = type ?? typeOfName(this.name);\n    this.lastModified = lastModified;\n  }\n}\n";
const F77: string = "// Keyboard shortcuts written as \"mod+k\", \"shift+alt+p\", \"/\": `mod` is ⌘ on\n// macOS and Ctrl elsewhere. Shared by the command palette and ray-search.\n\nexport const IS_MAC = typeof navigator !== \"undefined\" && /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);\n\nfunction parse(spec) {\n  const parts = String(spec ?? \"\").toLowerCase().trim().split(\"+\").map((s) => s.trim());\n  const key = parts.pop() ?? \"\";\n  const want = { meta: false, ctrl: false, alt: false, shift: false };\n  for (const p of parts) {\n    if (p === \"mod\") want[IS_MAC ? \"meta\" : \"ctrl\"] = true;\n    else if (p === \"cmd\" || p === \"meta\") want.meta = true;\n    else if (p === \"ctrl\" || p === \"control\") want.ctrl = true;\n    else if (p === \"alt\" || p === \"option\") want.alt = true;\n    else if (p === \"shift\") want.shift = true;\n  }\n  return { key, want };\n}\n\n/** Whether a keydown event is the shortcut `spec` (repeats never match). */\nexport function matchesHotkey(e, spec) {\n  const { key, want } = parse(spec);\n  if (!key || e.repeat) return false;\n  return e.key.toLowerCase() === key && e.metaKey === want.meta && e.ctrlKey === want.ctrl && e.altKey === want.alt && e.shiftKey === want.shift;\n}\n\n/** The shortcut as shown to the user: \"⌘K\" on macOS, \"Ctrl K\" elsewhere. */\nexport function formatHotkey(spec) {\n  const { key, want } = parse(spec);\n  if (!key) return \"\";\n  const k = key.length === 1 ? key.toUpperCase() : key[0].toUpperCase() + key.slice(1);\n  if (IS_MAC) return `\${want.ctrl ? \"⌃\" : \"\"}\${want.alt ? \"⌥\" : \"\"}\${want.shift ? \"⇧\" : \"\"}\${want.meta ? \"⌘\" : \"\"}\${k}`;\n  return [want.ctrl && \"Ctrl\", want.alt && \"Alt\", want.shift && \"Shift\", want.meta && \"Meta\", k].filter(Boolean).join(\" \");\n}\n\n/** True when the event comes from a place where typing is expected. */\nexport function isTyping(e) {\n  const t = e.composedPath?.()[0] ?? e.target;\n  return Boolean(t?.isContentEditable || (t?.localName === \"input\" && ![\"checkbox\", \"radio\", \"button\"].includes(t.type)) || t?.localName === \"textarea\" || t?.localName === \"select\");\n}\n";
const F78: string = "// Icon registry: every icon a ray-ds component draws comes from here, so an\n// app can switch the whole set (Lucide, Tabler, its own…) in one call:\n//\n//   import { setIcons } from \"@ray-ds/elements\";\n//   setIcons({ close: '<svg viewBox=\"0 0 24 24\">…</svg>', \"chevron-down\": … });\n//\n// setIcons() also adds new names, for <ray-icon name=\"…\">. Icons are SVG\n// markup (or an SVGElement) drawn with currentColor; components size them.\n// The markup is inserted as HTML: register icons from your own code only,\n// never from user input.\n\nconst svg = (body) =>\n  `<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\${body}</svg>`;\n\n/** The default set (24×24, 2px stroke). */\nconst DEFAULTS = {\n  \"close\": svg(`<path d=\"M6 6l12 12M18 6 6 18\"/>`),\n  \"check\": svg(`<path d=\"M5 12.5l4.5 4.5L19 7.5\"/>`),\n  \"minus\": svg(`<path d=\"M6 12h12\"/>`),\n  \"plus\": svg(`<path d=\"M12 5v14M5 12h14\"/>`),\n  \"chevron-down\": svg(`<path d=\"m6 9 6 6 6-6\"/>`),\n  \"chevron-up\": svg(`<path d=\"m6 15 6-6 6 6\"/>`),\n  \"chevron-right\": svg(`<path d=\"m9 6 6 6-6 6\"/>`),\n  \"chevron-left\": svg(`<path d=\"m15 6-6 6 6 6\"/>`),\n  \"chevrons-left\": svg(`<path d=\"m11 6-6 6 6 6M18 6l-6 6 6 6\"/>`),\n  \"chevrons-right\": svg(`<path d=\"m13 6 6 6-6 6M6 6l6 6-6 6\"/>`),\n  \"search\": svg(`<circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/>`),\n  \"arrow-up-right\": svg(`<path d=\"M7 17 17 7M8 7h9v9\"/>`),\n  \"arrow-down-right\": svg(`<path d=\"M7 7l10 10M17 8v9H8\"/>`),\n  \"sun\": svg(`<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/>`),\n  \"moon\": svg(`<path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z\"/>`),\n  \"monitor\": svg(`<rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M8 20h8M12 16v4\"/>`),\n  \"user\": svg(`<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/>`),\n  \"info\": svg(`<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v5M12 8h.01\"/>`),\n  \"circle-check\": svg(`<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m8.5 12.5 2.5 2.5 4.5-5\"/>`),\n  \"alert-triangle\": svg(`<path d=\"M10.3 4.2 2.6 17.5A2 2 0 0 0 4.3 20.5h15.4a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z\"/><path d=\"M12 9v4M12 17h.01\"/>`),\n  \"circle-x\": svg(`<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m15 9-6 6M9 9l6 6\"/>`),\n  \"menu\": svg(`<path d=\"M4 6h16M4 12h16M4 18h16\"/>`),\n  \"more-horizontal\": svg(`<circle cx=\"5\" cy=\"12\" r=\"1\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/><circle cx=\"19\" cy=\"12\" r=\"1\"/>`),\n  // Common in command palettes, menus and nav links.\n  \"file\": svg(`<path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5\"/>`),\n  \"folder\": svg(`<path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>`),\n  \"pause\": svg(`<rect x=\"6\" y=\"5\" width=\"4\" height=\"14\" rx=\"1\"/><rect x=\"14\" y=\"5\" width=\"4\" height=\"14\" rx=\"1\"/>`),\n  \"play\": svg(`<path d=\"M7 4.5v15a1 1 0 0 0 1.5.86l12-7.5a1 1 0 0 0 0-1.72l-12-7.5A1 1 0 0 0 7 4.5z\"/>`),\n  \"terminal\": svg(`<path d=\"m5 7 5 5-5 5M12 17h7\"/>`),\n  \"calendar\": svg(`<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/>`),\n  \"image\": svg(`<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><circle cx=\"9\" cy=\"10\" r=\"2\"/><path d=\"m21 17-5-5-9 8\"/>`),\n  \"download\": svg(`<path d=\"M12 4v11M7 10l5 5 5-5M5 20h14\"/>`),\n  eye: svg(`<path d=\"M2.1 12.3a1 1 0 0 1 0-.6 10.8 10.8 0 0 1 19.8 0 1 1 0 0 1 0 .6 10.8 10.8 0 0 1-19.8 0\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/>`),\n  \"eye-off\": svg(`<path d=\"M10.7 5.1a10.7 10.7 0 0 1 11.2 6.6 1 1 0 0 1 0 .7 10.8 10.8 0 0 1-1.4 2.5\"/><path d=\"M14.1 14.2a3 3 0 0 1-4.2-4.2\"/><path d=\"M17.5 17.5a10.7 10.7 0 0 1-15.4-5.1 1 1 0 0 1 0-.7 10.8 10.8 0 0 1 4.4-5.2\"/><path d=\"m2 2 20 20\"/>`),\n  bell: svg(`<path d=\"M10.3 21a1.9 1.9 0 0 0 3.4 0\"/><path d=\"M3.3 15.3A1 1 0 0 0 4 17h16a1 1 0 0 0 .7-1.7C19.4 14 18 12.6 18 8A6 6 0 0 0 6 8c0 4.6-1.4 6-2.7 7.3\"/>`),\n  copy: svg(`<rect x=\"9\" y=\"9\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M5 15a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2\"/>`),\n  quote: `<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M10 7.5C10 6 9 5 7.5 5 4.9 5 3 7.4 3 10.8V19h7v-7H6.1c.1-2.2 1.3-3.6 2.4-3.9.9-.3 1.5-.9 1.5-1.6zM21 7.5C21 6 20 5 18.5 5 15.9 5 14 7.4 14 10.8V19h7v-7h-3.9c.1-2.2 1.3-3.6 2.4-3.9.9-.3 1.5-.9 1.5-1.6z\"/></svg>`,\n  pipette: svg(`<path d=\"m2 22 1-1h3l9-9\"/><path d=\"M3 21v-3l9-9\"/><path d=\"m15 6 3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l.4.4a2.1 2.1 0 1 1-3 3l-3.8-3.8a2.1 2.1 0 1 1 3-3l.4.4Z\"/>`),\n  \"star\": svg(`<path d=\"M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z\" stroke-linejoin=\"round\"/>`),\n  \"upload\": svg(`<path d=\"M12 16V5M7 10l5-5 5 5M5 20h14\"/>`),\n  \"paperclip\": svg(`<path d=\"m20 11-8.5 8.5a5 5 0 0 1-7-7L13 4a3.3 3.3 0 0 1 4.7 4.7l-8.6 8.6a1.7 1.7 0 0 1-2.4-2.4L14.5 7\"/>`),\n  \"panel-left\": svg(`<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M9 4v16\"/>`),\n  \"settings\": svg(`<path d=\"M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12\"/><circle cx=\"16\" cy=\"6\" r=\"2\"/><circle cx=\"10\" cy=\"12\" r=\"2\"/><circle cx=\"18\" cy=\"18\" r=\"2\"/>`),\n  \"home\": svg(`<path d=\"M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1z\"/>`),\n  \"arrow-left\": svg(`<path d=\"M19 12H5M11 6l-6 6 6 6\"/>`),\n  \"message-circle\": svg(`<path d=\"M20 11.5a8 8 0 0 1-11.6 7.2L4 20l1.3-4.2A8 8 0 1 1 20 11.5z\"/>`),\n};\n\nconst registry = new Map(Object.entries(DEFAULTS));\nconst listeners = new Set();\nconst warned = new Set();\n\n/**\n * Replaces or adds icons. Values are SVG markup or an SVGElement.\n * @param {Record<string, string | SVGElement>} icons\n */\nexport function setIcons(icons) {\n  for (const [name, value] of Object.entries(icons)) {\n    const markup = typeof value === \"string\" ? value.trim() : value?.outerHTML;\n    if (typeof markup !== \"string\" || !/^<svg[\\s>]/i.test(markup)) {\n      throw new TypeError(`setIcons: \"\${name}\" is not SVG markup or an SVGElement`);\n    }\n    registry.set(name, markup);\n  }\n  for (const cb of listeners) cb();\n}\n\n/** The SVG markup of an icon (\"\" and one warning when it is not registered). */\nexport function getIcon(name) {\n  const markup = registry.get(name);\n  if (markup !== undefined) return markup;\n  if (!warned.has(name)) {\n    warned.add(name);\n    console.warn(`ray-ds: no icon named \"\${name}\" (setIcons to add it)`);\n  }\n  return \"\";\n}\n\n/** The registered icon names. */\nexport function iconNames() {\n  return [...registry.keys()];\n}\n\n/** @internal Called by the core runtime to repaint components after setIcons. */\nexport function onIconsChange(cb) {\n  listeners.add(cb);\n  return () => listeners.delete(cb);\n}\n";
const F79: string = "// Motion helpers: exit animations (the CSS keyframes cover the entries) and\n// height changes, with the Web Animations API so a component can wait for an\n// animation to end before it really hides an element (dialog.close(),\n// hidePopover(), remove()).\n//\n// Durations and easings come from the tokens (--ray-duration-*,\n// --ray-easing-*). No motion — and an immediate result — when the user asks\n// for reduced motion, when the duration token is 0, or when the page is not\n// visible (hidden windows do not run animations).\n\nconst reduced = typeof matchMedia === \"function\" ? matchMedia(\"(prefers-reduced-motion: reduce)\") : null;\n\n/** A duration token of `el` in milliseconds (\"fast\" | \"base\" | \"slow\"). */\nexport function duration(el, name = \"base\") {\n  const v = getComputedStyle(el).getPropertyValue(`--ray-duration-\${name}`).trim();\n  if (!v) return 0;\n  const n = parseFloat(v);\n  return Number.isNaN(n) ? 0 : v.endsWith(\"ms\") ? n : n * 1000;\n}\n\n/** An easing token of `el` (\"standard\" | \"in\" | \"out\"). */\nexport function easing(el, name = \"in\") {\n  return getComputedStyle(el).getPropertyValue(`--ray-easing-\${name}`).trim() || \"ease\";\n}\n\n/** Whether animations should run for `el` now. */\nexport function motionAllowed(el, name = \"base\") {\n  return !reduced?.matches && document.visibilityState === \"visible\" && duration(el, name) > 0 && typeof el.animate === \"function\";\n}\n\n/**\n * Plays `keyframes` on `el` (optionally its ::backdrop) and resolves when it\n * ends — at once when motion is not allowed. The final frame stays applied\n * (fill: forwards) until `cancel()`: call it once the element is hidden.\n * @returns {{ finished: Promise<void>, cancel: () => void }}\n */\nexport function play(el, keyframes, { speed = \"base\", ease = \"in\", pseudoElement } = {}) {\n  if (!motionAllowed(el, speed)) return { finished: Promise.resolve(), cancel() {} };\n  const ms = duration(el, speed);\n  let anim;\n  try {\n    anim = el.animate(keyframes, { duration: ms, easing: easing(el, ease), fill: \"forwards\", ...(pseudoElement ? { pseudoElement } : {}) });\n  } catch {\n    return { finished: Promise.resolve(), cancel() {} };\n  }\n  // A throttled or suspended timeline must not keep the element open forever.\n  const guard = new Promise((r) => setTimeout(r, ms + 150));\n  return {\n    finished: Promise.race([anim.finished.then(() => {}, () => {}), guard]),\n    cancel: () => anim.cancel(),\n  };\n}\n\n/** Plays several animations; resolves when all ended. */\nexport function playAll(list) {\n  return { finished: Promise.all(list.map((a) => a.finished)).then(() => {}), cancel: () => list.forEach((a) => a.cancel()) };\n}\n\n/** Fades and shrinks an element to nothing (height, margins, padding), then resolves. */\nexport function collapseOut(el, { speed = \"base\" } = {}) {\n  const cs = getComputedStyle(el);\n  const h = el.getBoundingClientRect().height;\n  return play(el, [\n    { height: `\${h}px`, opacity: 1, marginTop: cs.marginTop, marginBottom: cs.marginBottom, paddingTop: cs.paddingTop, paddingBottom: cs.paddingBottom, overflow: \"hidden\" },\n    { height: \"0px\", opacity: 0, marginTop: \"0px\", marginBottom: \"0px\", paddingTop: \"0px\", paddingBottom: \"0px\", overflow: \"hidden\" },\n  ], { speed });\n}\n\n/** The exit of a floating panel (menus, popovers, dropdowns, tooltips). */\nexport const POP_OUT = [\n  { opacity: 1, transform: \"none\" },\n  { opacity: 0, transform: \"scale(0.97)\" },\n];\n";
const F80: string = "// Anchored positioning for floating elements (popovers, menus, tooltips).\n//\n// The floating element is position: fixed (it lives in the top layer via the\n// Popover API), placed next to an anchor rectangle, flipped to the opposite\n// side when it does not fit, and shifted to stay inside the viewport.\n// Done in JS rather than CSS anchor positioning, which not every webview\n// ships yet (WebKitGTK, older WKWebView).\n\nconst OPPOSITE = { top: \"bottom\", bottom: \"top\", left: \"right\", right: \"left\" };\n\n/**\n * @typedef {object} PlaceOptions\n * @property {string} [placement]  side[-align]: top|bottom|left|right, -start|-end (default \"bottom\")\n * @property {number} [offset]     gap to the anchor in px (default 8)\n * @property {number} [padding]    minimum distance to the viewport edges (default 8)\n * @property {boolean} [flip]      try the opposite side when it does not fit (default true)\n * @property {boolean} [matchWidth] at least as wide as the anchor\n */\n\n/**\n * Places `floating` next to `anchor` (a DOMRect-like {left, top, right, bottom, width, height}).\n * The floating element must be rendered (open) so it can be measured.\n * @param {PlaceOptions} options\n * @returns {string} the final placement, e.g. \"top-start\"\n */\nexport function place(anchor, floating, { placement = \"bottom\", offset = 8, padding = 8, flip = true, matchWidth = false } = {}) {\n  const vw = document.documentElement.clientWidth;\n  const vh = window.innerHeight;\n  floating.style.position = \"fixed\";\n  floating.style.inset = \"auto\";\n  floating.style.margin = \"0\";\n  if (matchWidth) floating.style.minWidth = `\${anchor.width}px`;\n  const f = floating.getBoundingClientRect();\n  let [side, align = \"center\"] = placement.split(\"-\");\n\n  const fits = (s) => {\n    if (s === \"bottom\") return anchor.bottom + offset + f.height <= vh - padding;\n    if (s === \"top\") return anchor.top - offset - f.height >= padding;\n    if (s === \"right\") return anchor.right + offset + f.width <= vw - padding;\n    return anchor.left - offset - f.width >= padding;\n  };\n  if (flip && !fits(side) && fits(OPPOSITE[side])) side = OPPOSITE[side];\n\n  let x;\n  let y;\n  if (side === \"top\" || side === \"bottom\") {\n    y = side === \"bottom\" ? anchor.bottom + offset : anchor.top - offset - f.height;\n    x = align === \"start\" ? anchor.left\n      : align === \"end\" ? anchor.right - f.width\n      : anchor.left + anchor.width / 2 - f.width / 2;\n  } else {\n    x = side === \"right\" ? anchor.right + offset : anchor.left - offset - f.width;\n    y = align === \"start\" ? anchor.top\n      : align === \"end\" ? anchor.bottom - f.height\n      : anchor.top + anchor.height / 2 - f.height / 2;\n  }\n  // Shift into the viewport.\n  x = Math.max(padding, Math.min(x, vw - f.width - padding));\n  y = Math.max(padding, Math.min(y, vh - f.height - padding));\n  floating.style.left = `\${Math.round(x)}px`;\n  floating.style.top = `\${Math.round(y)}px`;\n  const final = `\${side}-\${align}`;\n  floating.dataset.placement = final;\n  return final;\n}\n\n/** A zero-size rectangle at a point (context menus). */\nexport function pointRect(x, y) {\n  return { left: x, right: x, top: y, bottom: y, width: 0, height: 0, x, y };\n}\n\n/**\n * Calls `update` whenever the layout may have moved the anchor or resized\n * the floating element: scroll (any ancestor), window resize, element resize.\n * @returns {() => void} stops watching\n */\nexport function autoUpdate(anchor, floating, update) {\n  const onChange = () => update();\n  window.addEventListener(\"scroll\", onChange, { capture: true, passive: true });\n  window.addEventListener(\"resize\", onChange);\n  const ro = typeof ResizeObserver === \"function\" ? new ResizeObserver(onChange) : null;\n  if (ro) {\n    if (anchor instanceof Element) ro.observe(anchor);\n    ro.observe(floating);\n  }\n  return () => {\n    window.removeEventListener(\"scroll\", onChange, { capture: true });\n    window.removeEventListener(\"resize\", onChange);\n    ro?.disconnect();\n  };\n}\n";
const F81: string = "// The page's half of the ray-ds native bridge for std/ui windows (raylang);\n// the program's half is the raylang module ray_ds/bridge.\n//\n//   import { enableRaylang } from \"ray-ds/core/raylang.js\";\n//   await enableRaylang();   // the host, or null in a browser\n//\n// It detects window.ray, asks the program what it offers (\"hello\") and\n// installs a host (core/host.js), so the components that use one get the\n// system dialogs. Requests travel through window.ray.request as JSON objects\n// tagged \"ray-ds\", which bridge.handle answers and the app's own protocol\n// never sees. In a browser, or when the program does not answer (its loop\n// does not call bridge.handle), it resolves to null and nothing changes.\n\nimport { setHost, HostFile } from \"./host.js\";\nimport { chartTheme, onChartThemeChange } from \"./charts.js\";\nimport { getTheme } from \"./core.js\";\nimport { parseColor, toHex } from \"./color.js\";\n\n/** The version of the protocol this page speaks. */\nexport const PROTOCOL = 1;\n\nlet enabling = null;\n\n// The width macOS keeps for the window buttons at the start of the title bar.\nconst MAC_BUTTONS = 78;\n\n/**\n * Installs the raylang host once the program answers. `timeout` (ms) is how\n * long to wait for that answer; `ray` replaces window.ray (tests).\n * `windowColors` (default true) keeps the window's background in the\n * theme's background color, so a resize or a reopen never shows the other\n * theme. The title bar is tinted too only when the window has its own bar\n * (not full_content) and the theme is light or dark: with \"system\" it stays\n * the system's, so the page keeps following the system.\n */\nexport function enableRaylang({ timeout = 2000, ray = globalThis.ray, windowColors = true } = {}) {\n  if (ray !== globalThis.ray) return connect(ray, timeout, windowColors);\n  enabling ??= connect(ray, timeout, windowColors);\n  return enabling;\n}\n\nasync function connect(ray, timeout, windowColors) {\n  if (typeof ray?.request !== \"function\") return null;\n  const call = (op, args = {}) => request(ray, op, args);\n  let hello;\n  try {\n    hello = await within(call(\"hello\"), timeout);\n  } catch {\n    return null;\n  }\n  const ops = new Set(hello?.ops ?? []);\n  // Context menus: the choice comes back as a \"ray-ds:menu\" event pushed by\n  // the program ({ id, index }); a dismissed menu sends nothing, so opening\n  // the next one settles the previous with null.\n  let popups = 0;\n  let pending = null;\n  document.addEventListener(\"ray-ds:menu\", (e) => {\n    if (pending && e.detail?.id === pending.id) {\n      pending.resolve(e.detail.index);\n      pending = null;\n    }\n  });\n  const host = {\n    name: \"raylang\",\n    platform: hello.platform ?? \"\",\n    version: hello.version ?? \"\",\n    can: (op) => ops.has(op),\n    async pickFiles({ title = \"\", multiple = false, directory = \"\", filters = [] } = {}) {\n      const picked = await call(\"pick_files\", { title, multiple, directory, filters });\n      return (picked ?? []).map((f) => new HostFile(f));\n    },\n    async pickPath({ mode = \"open\", title = \"\", directory = \"\", suggested = \"\", filters = [] } = {}) {\n      return (await call(\"pick_path\", { mode, title, directory, suggested, filters })) ?? null;\n    },\n    menuItems() {\n      return call(\"menu_items\");\n    },\n    runMenu(tag) {\n      return call(\"run_menu\", { tag });\n    },\n    async popupMenu(items) {\n      pending?.resolve(null);\n      const id = ++popups;\n      const chosen = new Promise((resolve) => { pending = { id, resolve }; });\n      try {\n        await call(\"popup_menu\", { id, items });\n      } catch (e) {\n        if (pending?.id === id) pending = null;\n        throw e;\n      }\n      return chosen;\n    },\n    setEdited(edited) {\n      return call(\"set_edited\", { edited: Boolean(edited) });\n    },\n    setWindowColors({ background = \"\", titlebar } = {}) {\n      return call(\"window_colors\", titlebar === undefined ? { background } : { background, titlebar });\n    },\n    async confirm({ title = \"Are you sure?\", message = \"\", confirmLabel = \"Confirm\", cancelLabel = \"Cancel\", style = \"\" } = {}) {\n      return Boolean(await call(\"confirm\", { title, message, confirmLabel, cancelLabel, style }));\n    },\n  };\n  // Under a transparent title bar (a full_content window): what to reserve.\n  const height = Number(ray.titlebar_height) || 0;\n  host.titlebar = height > 0 ? { height, inset: host.platform === \"macos\" ? MAC_BUTTONS : 0 } : null;\n  const root = document.documentElement;\n  if (host.titlebar) {\n    root.style.setProperty(\"--ray-titlebar-height\", `\${height}px`);\n    root.style.setProperty(\"--ray-titlebar-inset\", `\${host.titlebar.inset}px`);\n    root.setAttribute(\"data-ray-titlebar\", \"\");\n  }\n  setHost(host);\n  root.setAttribute(\"data-ray-host\", \"raylang\");\n  if (windowColors && ops.has(\"window_colors\")) {\n    // A title bar color also sets the window's appearance (macOS picks light\n    // or dark by its luminance), which the page's prefers-color-scheme\n    // follows, and in a full_content window it brings back the opaque bar.\n    // So the bar is tinted only in a window with its own bar and a chosen\n    // theme (light or dark), and given back to the system once after that.\n    let tinted = false;\n    const paint = (theme) => {\n      const background = hex(theme.background);\n      if (!background) return;\n      const colors = { background };\n      if (!host.titlebar) {\n        if (getTheme() !== \"system\") {\n          colors.titlebar = background;\n          tinted = true;\n        } else if (tinted) {\n          colors.titlebar = \"\";\n          tinted = false;\n        }\n      }\n      host.setWindowColors(colors).catch(() => {});\n    };\n    paint(chartTheme());\n    onChartThemeChange(paint);\n  }\n  return host;\n}\n\n// \"#rrggbb\" of a CSS color, \"\" when it cannot be read.\nfunction hex(color) {\n  if (/^#[0-9a-f]{6}$/i.test(color ?? \"\")) return color.toLowerCase();\n  try {\n    const rgb = parseColor(String(color ?? \"\"));\n    return rgb ? toHex(rgb).slice(0, 7).toLowerCase() : \"\";\n  } catch {\n    return \"\";\n  }\n}\n\nasync function request(ray, op, args) {\n  const answer = await ray.request({ \"ray-ds\": PROTOCOL, op, ...args });\n  if (!answer || typeof answer !== \"object\" || !(\"ok\" in answer)) {\n    throw new Error(`ray-ds bridge: unexpected answer to '\${op}'`);\n  }\n  if (!answer.ok) throw new Error(`ray-ds bridge: \${answer.error}`);\n  return answer.value;\n}\n\nfunction within(promise, ms) {\n  return new Promise((resolve, reject) => {\n    const t = setTimeout(() => reject(new Error(\"ray-ds bridge: no answer\")), ms);\n    promise.then((v) => { clearTimeout(t); resolve(v); }, (e) => { clearTimeout(t); reject(e); });\n  });\n}\n";
const F82: string = "// Which element scrolls the page an element sits on, and the direction of\n// its scrolling: for the bars that hide while scrolling down and come back\n// on the way up (ray-app-bar, ray-bottom-nav).\n\n/**\n * The scroller of `el`: `target` (an element or a selector) when given,\n * else the content of the ray-app-shell or ray-scroll-area around it, else\n * the window.\n * @param {Element} el\n * @param {Element | string | null | undefined} target\n * @returns {Element | Window}\n */\nexport function scrollerOf(el, target) {\n  if (target instanceof Element) return target;\n  if (typeof target === \"string\" && target) {\n    const found = document.querySelector(target);\n    if (found) return found.viewport ?? found.scroller ?? found;\n  }\n  for (let n = el; n; n = n.parentElement ?? n.getRootNode()?.host) {\n    if (n.localName === \"ray-app-shell\" && n.scroller) return n.scroller;\n    if (n.localName === \"ray-scroll-area\" && n !== el && n.viewport) return n.viewport;\n  }\n  return window;\n}\n\n/**\n * Calls `cb({ y, direction })` as `scroller` scrolls, once per frame;\n * direction is \"down\" or \"up\" past `tolerance` px, else unchanged.\n * Returns a function that stops listening.\n * @param {Element | Window} scroller\n * @param {(state: { y: number, direction: \"up\" | \"down\" }) => void} cb\n */\nexport function watchScroll(scroller, cb, { tolerance = 8 } = {}) {\n  const top = () => (scroller === window ? window.scrollY : /** @type {Element} */ (scroller).scrollTop);\n  let last = top();\n  let direction = \"up\";\n  let frame = 0;\n  const run = () => {\n    frame = 0;\n    const y = Math.max(0, top());\n    if (Math.abs(y - last) >= tolerance) {\n      direction = y > last ? \"down\" : \"up\";\n      last = y;\n    }\n    if (y <= 0) { direction = \"up\"; last = 0; }\n    cb({ y, direction });\n  };\n  const onScroll = () => {\n    // A hidden page runs no frames: no need to wait for one.\n    if (document.visibilityState === \"hidden\") return run();\n    if (!frame) frame = requestAnimationFrame(run);\n  };\n  scroller.addEventListener(\"scroll\", onScroll, { passive: true });\n  return () => {\n    scroller.removeEventListener(\"scroll\", onScroll);\n    cancelAnimationFrame(frame);\n  };\n}\n";
const F83: string = "// Shared component styles: sizes, radius, color variants and the loader.\n// Components add the sheets they need to their `static styles`.\n\nimport { css } from \"./core.js\";\n\n/** Palette colors of tokens.toml; anything else given as `color` is used as a raw CSS color. */\nexport const COLORS = [\"dark\", \"gray\", \"red\", \"pink\", \"violet\", \"indigo\", \"blue\", \"cyan\", \"teal\", \"green\", \"yellow\", \"orange\", \"custom\"];\n\n/** Named steps of the space scale (--ray-space-*). */\nconst SPACES = [\"xs\", \"sm\", \"md\", \"lg\", \"xl\"];\n\n/**\n * A spacing value as CSS: a named step (\"md\") as its token, a bare number\n * as px (0 included), anything else as a CSS length (\"1.5rem\", \"5%\").\n * @param {string | number | undefined} value\n * @returns {string | null} null when empty\n */\nexport function spaceValue(value) {\n  const s = String(value ?? \"\").trim();\n  if (!s) return null;\n  if (SPACES.includes(s)) return `var(--ray-space-\${s})`;\n  return /^-?\\d+(\\.\\d+)?$/.test(s) ? `\${s}px` : s;\n}\n\n/** Variant tokens generated per color (tokens.toml [variants.*]). */\nexport const VARIANT_TOKENS = [\"filled\", \"filled-hover\", \"light\", \"light-hover\", \"light-color\", \"outline\", \"outline-hover\", \"contrast\"];\n\n/**\n * Points the private --_<variant> custom properties of `el` at a color:\n * a palette name, a raw CSS color, or the primary color when empty.\n * @param {HTMLElement} el\n * @param {string | undefined} color\n */\nexport function applyColor(el, color) {\n  if (!color || COLORS.includes(color) || color === \"primary\") {\n    const base = !color || color === \"primary\" ? \"--ray-primary\" : `--ray-\${color}`;\n    for (const v of VARIANT_TOKENS) el.style.setProperty(`--_\${v}`, `var(\${base}-\${v})`);\n    return;\n  }\n  // A raw CSS color: derive the variants the way the tokens do.\n  const mix = (pct, other = \"transparent\") => `color-mix(in srgb, \${color} \${pct}, \${other})`;\n  const values = {\n    \"filled\": color,\n    \"filled-hover\": mix(\"85%\", \"black\"),\n    \"light\": mix(\"12%\"),\n    \"light-hover\": mix(\"18%\"),\n    \"light-color\": color,\n    \"outline\": color,\n    \"outline-hover\": mix(\"6%\"),\n    \"contrast\": \"white\",\n  };\n  for (const v of VARIANT_TOKENS) el.style.setProperty(`--_\${v}`, values[v]);\n}\n\n/**\n * The gradient of variant=\"gradient\" on `el`, from a \"from to [deg]\" spec:\n * palette colors (their filled shade) or any CSS colors (\"teal blue 90\",\n * \"#7c3aed #db2777\"). Empty: the --ray-gradient-* tokens.\n * @param {HTMLElement} el\n * @param {string | undefined} spec\n */\nexport function applyGradient(el, spec) {\n  const parts = String(spec ?? \"\").trim().split(/\\s+/).filter(Boolean);\n  const color = (c) => (COLORS.includes(c) ? `var(--ray-\${c}-filled)` : c);\n  if (parts[0]) el.style.setProperty(\"--_gradient-from\", color(parts[0]));\n  else el.style.removeProperty(\"--_gradient-from\");\n  if (parts[1]) el.style.setProperty(\"--_gradient-to\", color(parts[1]));\n  else el.style.removeProperty(\"--_gradient-to\");\n  if (parts[2]) el.style.setProperty(\"--_gradient-deg\", /^-?\\d+(\\.\\d+)?$/.test(parts[2]) ? `\${parts[2]}deg` : parts[2]);\n  else el.style.removeProperty(\"--_gradient-deg\");\n}\n\n/**\n * Size scale on the host: --_h (control height), --_fs (font size),\n * --_px (horizontal padding), --_gap. Default `sm`, like Mantine.\n */\nexport const sizeStyles = css`\n  :host {\n    --_h: var(--ray-control-height-sm);\n    --_fs: var(--ray-font-size-sm);\n    --_px: 1.125rem;\n    --_gap: var(--ray-space-2);\n  }\n  :host([size=\"xs\"]) { --_h: var(--ray-control-height-xs); --_fs: var(--ray-font-size-xs); --_px: 0.875rem; --_gap: var(--ray-space-1); }\n  :host([size=\"md\"]) { --_h: var(--ray-control-height-md); --_fs: var(--ray-font-size-md); --_px: 1.375rem; }\n  :host([size=\"lg\"]) { --_h: var(--ray-control-height-lg); --_fs: var(--ray-font-size-lg); --_px: 1.625rem; --_gap: var(--ray-space-3); }\n  :host([size=\"xl\"]) { --_h: var(--ray-control-height-xl); --_fs: var(--ray-font-size-xl); --_px: 2rem; --_gap: var(--ray-space-3); }\n`;\n\n/** Radius on the host: --_r. Default: the system-wide --ray-radius-default. */\nexport const radiusStyles = css`\n  :host { --_r: var(--ray-radius-default); }\n  :host([radius=\"xs\"]) { --_r: var(--ray-radius-xs); }\n  :host([radius=\"sm\"]) { --_r: var(--ray-radius-sm); }\n  :host([radius=\"md\"]) { --_r: var(--ray-radius-md); }\n  :host([radius=\"lg\"]) { --_r: var(--ray-radius-lg); }\n  :host([radius=\"xl\"]) { --_r: var(--ray-radius-xl); }\n  :host([radius=\"full\"]) { --_r: var(--ray-radius-full); }\n`;\n\n/**\n * Color variants for an element carrying data-variant and the --_<variant>\n * properties of applyColor(): filled, light, outline, subtle, default,\n * transparent, and gradient (applyGradient / --ray-gradient-*).\n */\nexport const variantStyles = css`\n  [data-variant] {\n    border: 1px solid transparent;\n    transition:\n      background-color var(--ray-duration-fast) var(--ray-easing-standard),\n      border-color var(--ray-duration-fast) var(--ray-easing-standard),\n      color var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  [data-variant=\"filled\"] { background: var(--_filled); color: var(--_contrast); }\n  [data-variant=\"light\"] { background: var(--_light); color: var(--_light-color); }\n  [data-variant=\"outline\"] { background: transparent; color: var(--_outline); border-color: var(--_outline); }\n  [data-variant=\"subtle\"] { background: transparent; color: var(--_light-color); }\n  [data-variant=\"transparent\"] { background: transparent; color: var(--_light-color); }\n  [data-variant=\"default\"] { background: var(--ray-default); color: var(--ray-foreground); border-color: var(--ray-border); }\n  [data-variant=\"gradient\"] {\n    background: linear-gradient(\n      var(--_gradient-deg, var(--ray-gradient-deg)),\n      var(--_gradient-from, var(--ray-gradient-from)),\n      var(--_gradient-to, var(--ray-gradient-to))\n    );\n    color: var(--ray-white);\n  }\n\n  [data-interactive]:not([data-disabled])[data-variant=\"filled\"]:hover { background: var(--_filled-hover); }\n  [data-interactive]:not([data-disabled])[data-variant=\"light\"]:hover { background: var(--_light-hover); }\n  [data-interactive]:not([data-disabled])[data-variant=\"outline\"]:hover { background: var(--_outline-hover); }\n  [data-interactive]:not([data-disabled])[data-variant=\"subtle\"]:hover { background: var(--_light); }\n  [data-interactive]:not([data-disabled])[data-variant=\"default\"]:hover { background: var(--ray-default-hover); }\n  [data-interactive]:not([data-disabled])[data-variant=\"gradient\"]:hover { filter: brightness(0.92); }\n\n  [data-interactive][data-disabled] {\n    background: var(--ray-muted);\n    color: var(--ray-muted-foreground);\n    border-color: var(--ray-border);\n    cursor: not-allowed;\n  }\n  [data-interactive][data-disabled][data-variant=\"subtle\"],\n  [data-interactive][data-disabled][data-variant=\"transparent\"] {\n    background: transparent;\n    border-color: transparent;\n  }\n`;\n\n/** A ring spinner: <span class=\"loader\"></span>, sized by --_loader (default 1em). */\nexport const loaderStyles = css`\n  .loader {\n    display: inline-block;\n    flex: none;\n    width: var(--_loader, 1em);\n    height: var(--_loader, 1em);\n    border: max(2px, calc(var(--_loader, 1em) / 8)) solid currentColor;\n    border-right-color: transparent;\n    border-radius: 50%;\n    animation: ray-spin 0.75s linear infinite;\n  }\n  @keyframes ray-spin { to { transform: rotate(360deg); } }\n  @media (prefers-reduced-motion: reduce) {\n    .loader { animation-duration: 1.5s !important; }\n  }\n`;\n\n/** Visually hidden but available to assistive technology. */\nexport const srOnlyStyles = css`\n  .sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n    border: 0;\n  }\n`;\n\n/**\n * The backdrop of modal overlays (dialog, drawer, command palette): the\n * --ray-overlay color and, when --ray-overlay-blur is set (tokens default:\n * [overlay] blur), the page behind blurred. ::backdrop inherits from its\n * dialog, so both follow the element, its subtree or :root.\n */\nexport const overlayStyles = css`\n  dialog::backdrop {\n    background: var(--ray-overlay);\n    -webkit-backdrop-filter: blur(var(--ray-overlay-blur, 0px));\n    backdrop-filter: blur(var(--ray-overlay-blur, 0px));\n  }\n  @media (prefers-reduced-transparency: reduce) {\n    dialog::backdrop { -webkit-backdrop-filter: none; backdrop-filter: none; }\n  }\n`;\n\n/**\n * The overlay-blur attribute of an overlay: a number (px), a CSS length, or\n * \"none\"/\"0\" to turn the blur off. Unset: the inherited --ray-overlay-blur.\n */\nexport function applyOverlayBlur(el, value) {\n  if (value === undefined || value === null || value === \"\") {\n    el.style.removeProperty(\"--ray-overlay-blur\");\n    return;\n  }\n  const v = String(value).trim();\n  const css = v === \"none\" ? \"0px\" : /^\\d+(\\.\\d+)?$/.test(v) ? `\${v}px` : v;\n  el.style.setProperty(\"--ray-overlay-blur\", css);\n}\n";
