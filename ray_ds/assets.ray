// The paths of the files, relative to the mount point.
pub fn files() -> [string] {
    table().map(fn(f: (string, string, int)) -> string { f.0 })
}

// The text of a file ("core/core.js", "tokens.css"…).
pub fn read(path: string) -> Option<string> {
    for (p, text, size) in table() {
        if (p == path) {
            return Option.Some(text);
        }
    }
    Option.None
}

// Mounts every file at ray://app/<prefix>/<path> (prefix "" = the root).
// Returns how many.
pub fn mount(prefix: string) -> Result<int, string> {
    let at = if (prefix == "" || prefix.ends_with("/")) { prefix } else { prefix + "/" };
    for (p, text, size) in table() {
        ui.mount_bytes(at + p, text.to_bytes())?;
    }
    Result.Ok(table().len())
}

@test
fn carries_every_file_exactly() {
    for (p, text, size) in table() {
        assert_eq_msg(text.to_bytes().len(), size, p);
    }
    assert(files().contains("index.js") && files().contains("tokens.css") && files().contains("core/raylang.js"));
}

const F0: string = "/* ray-ds base: document defaults on top of tokens.css. Optional — load it\n   for pages built with ray-ds, skip it when embedding components in an app\n   that has its own base styles. Layered, so any unlayered app CSS wins. */\n\n@layer ray.tokens, ray.base;\n\n@layer ray.base {\n  html {\n    font-family: var(--ray-font-sans);\n    font-size: 100%;\n    line-height: var(--ray-line-height-md);\n    color: var(--ray-foreground);\n    background: var(--ray-background);\n    accent-color: var(--ray-primary);\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    -webkit-text-size-adjust: 100%;\n    text-size-adjust: 100%;\n  }\n\n  body {\n    margin: 0;\n    font-size: var(--ray-font-size-md);\n  }\n\n  /* Subtrees with their own data-theme repaint with their own scheme. */\n  [data-theme] {\n    color: var(--ray-foreground);\n    background: var(--ray-background);\n  }\n\n  /* Overlays take no room before their definition loads: their light DOM\n     (a drawer's navigation, a dialog's form) would otherwise lay out in the\n     page for an instant and push it down when it leaves (layout shift). */\n  :where(ray-dialog, ray-drawer, ray-command-palette, ray-toaster):not(:defined) {\n    display: none;\n  }\n  /* A navigation list keeps its rows' height while its links load. */\n  :where(ray-nav-link):not(:defined) {\n    display: block;\n    min-height: 2.25rem;\n  }\n\n  ::selection {\n    background: var(--ray-selection);\n  }\n\n  :focus-visible {\n    outline: var(--ray-focus-ring-width) solid var(--ray-ring);\n    outline-offset: var(--ray-focus-ring-offset);\n  }\n\n  :where(h1, h2, h3, h4, h5, h6) {\n    line-height: var(--ray-line-height-heading);\n    font-weight: var(--ray-font-weight-bold);\n  }\n\n  :where(code, kbd, samp, pre) {\n    font-family: var(--ray-font-mono);\n  }\n\n  :where(a) {\n    color: var(--ray-primary-light-color);\n  }\n\n  :where(hr) {\n    border: 0;\n    border-top: 1px solid var(--ray-border);\n  }\n\n  :where(img, svg, video, canvas) {\n    max-width: 100%;\n  }\n\n  /* Plain HTML tables (server-rendered pages, no JS): <table class=\"ray-table\">.\n     Modifiers: .ray-table-striped, .ray-table-bordered. <ray-table> is the\n     data-driven component with sorting and selection. */\n  :where(table.ray-table) {\n    width: 100%;\n    border-collapse: separate;\n    border-spacing: 0;\n    font-size: var(--ray-font-size-sm);\n    font-variant-numeric: tabular-nums;\n  }\n  :where(.ray-table) :where(th, td) {\n    padding: var(--ray-space-2) var(--ray-space-3);\n    text-align: left;\n    vertical-align: middle;\n    border-bottom: 1px solid var(--ray-border);\n  }\n  :where(.ray-table) :where(th) {\n    font-size: var(--ray-font-size-xs);\n    font-weight: var(--ray-font-weight-semibold);\n    color: var(--ray-muted-foreground);\n    white-space: nowrap;\n  }\n  :where(.ray-table) :where(tbody tr:hover td) {\n    background: var(--ray-default-hover);\n  }\n  :where(.ray-table-striped) :where(tbody tr:nth-child(even) td) {\n    background: color-mix(in srgb, var(--ray-muted) 60%, transparent);\n  }\n  :where(.ray-table-bordered) {\n    border: 1px solid var(--ray-border);\n    border-radius: var(--ray-radius-default);\n    overflow: hidden;\n  }\n  :where(.ray-table-bordered) :where(tbody tr:last-child td) {\n    border-bottom: 0;\n  }\n}\n";
const F1: string = "// <ray-accordion> + <ray-accordion-item>: collapsible sections (WAI-ARIA\n// accordion pattern). One open item at a time, or several with `multiple`.\n//\n// value: the open item's value; with `multiple`, the property is an array and\n// the attribute a comma-separated list.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst accordionStyles = css`\n  :host { display: block; }\n  :host([variant=\"separated\"]) .items { display: grid; gap: var(--ray-space-3); }\n  :host([variant=\"contained\"]) .items { border: 1px solid var(--ray-border); border-radius: var(--ray-radius-default); overflow: hidden; }\n`;\n\nexport class RayAccordion extends RayElement {\n  static properties = {\n    value: { type: String },\n    multiple: { type: Boolean, reflect: true },\n    variant: { type: String, reflect: true, default: \"default\" },\n    chevronPosition: { type: String, reflect: true, default: \"right\" },\n  };\n  static styles = [accordionStyles];\n  static template = `<div class=\"items\" part=\"items\"><slot></slot></div>`;\n\n  constructor() {\n    super();\n    this.addEventListener(\"ray-accordion-toggle\", (e) => {\n      const item = e.target;\n      if (!this.items.includes(item)) return;\n      e.stopPropagation();\n      this._toggle(item.value);\n    });\n    this.addEventListener(\"keydown\", (e) => this._key(e));\n    this.$(\"slot\").addEventListener(\"slotchange\", () => this.requestUpdate());\n  }\n\n  get items() {\n    return [...this.querySelectorAll(\"ray-accordion-item\")].filter((i) => i.closest(\"ray-accordion\") === this);\n  }\n\n  /** The open values as an array, whatever the mode. */\n  get openValues() {\n    const v = this.value;\n    if (Array.isArray(v)) return v;\n    if (v === undefined || v === null || v === \"\") return [];\n    return this.multiple ? String(v).split(\",\").map((s) => s.trim()).filter(Boolean) : [String(v)];\n  }\n\n  update() {\n    const open = this.openValues;\n    const items = this.items;\n    items.forEach((item, i) => {\n      item._setOpen(open.includes(item.value));\n      item.dataset.variant = this.variant || \"default\";\n      item.dataset.chevron = this.chevronPosition || \"right\";\n      item.toggleAttribute(\"data-first\", i === 0);\n      item.toggleAttribute(\"data-last\", i === items.length - 1);\n    });\n  }\n\n  _toggle(value) {\n    const open = this.openValues;\n    let next;\n    if (this.multiple) next = open.includes(value) ? open.filter((v) => v !== value) : [...open, value];\n    else next = open.includes(value) ? undefined : value;\n    this.value = next;\n    this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n  }\n\n  _key(e) {\n    const item = e.composedPath().find((n) => n instanceof RayAccordionItem);\n    const items = this.items.filter((i) => !i.disabled);\n    const i = items.indexOf(item);\n    if (i < 0 || !e.composedPath().some((n) => n.classList?.contains(\"control\"))) return;\n    let target = null;\n    if (e.key === \"ArrowDown\") target = items[(i + 1) % items.length];\n    else if (e.key === \"ArrowUp\") target = items[(i - 1 + items.length) % items.length];\n    else if (e.key === \"Home\") target = items[0];\n    else if (e.key === \"End\") target = items[items.length - 1];\n    if (!target) return;\n    e.preventDefault();\n    target.focus();\n  }\n}\n\nconst itemStyles = css`\n  :host { display: block; border-bottom: 1px solid var(--ray-border); }\n  :host([data-variant=\"contained\"]) { border-bottom: 1px solid var(--ray-border); }\n  :host([data-variant=\"contained\"][data-last]) { border-bottom: 0; }\n  :host([data-variant=\"contained\"][data-open]) { background: var(--ray-muted); }\n  :host([data-variant=\"separated\"]) { border: 1px solid transparent; border-radius: var(--ray-radius-default); background: var(--ray-muted); }\n  :host([data-variant=\"separated\"][data-open]) { border-color: var(--ray-border); background: var(--ray-background); }\n  :host([data-variant=\"filled\"]) { border: 0; border-radius: var(--ray-radius-default); }\n  :host([data-variant=\"filled\"][data-open]) { background: var(--ray-muted); }\n  h3 { margin: 0; font: inherit; }\n  .control {\n    display: flex;\n    align-items: center;\n    gap: var(--ray-space-3);\n    width: 100%;\n    min-height: 3rem;\n    padding: var(--ray-space-2) var(--ray-space-md);\n    font: inherit;\n    font-size: var(--ray-font-size-md);\n    font-weight: var(--ray-font-weight-medium);\n    color: var(--ray-foreground);\n    text-align: left;\n    background: transparent;\n    border: 0;\n    border-radius: inherit;\n    cursor: pointer;\n  }\n  .control:hover:not(:disabled) { background: var(--ray-accent); }\n  :host([data-variant=\"default\"]) .control:hover:not(:disabled) { background: var(--ray-muted); }\n  .control:disabled { color: var(--ray-muted-foreground); cursor: not-allowed; }\n  .label { display: grid; flex: 1; gap: 0.125rem; min-width: 0; }\n  .description { font-size: var(--ray-font-size-sm); font-weight: var(--ray-font-weight-normal, 400); color: var(--ray-muted-foreground); }\n  .description:empty { display: none; }\n  :host([data-chevron=\"left\"]) .chevron { order: -1; }\n  .chevron { display: inline-flex; color: var(--ray-muted-foreground); transition: transform var(--ray-duration-base) var(--ray-easing-standard); }\n  .chevron svg { width: 1rem; height: 1rem; }\n  :host([data-open]) .chevron { transform: rotate(180deg); }\n  .section { display: inline-flex; color: var(--ray-muted-foreground); }\n  .section:not([data-filled]) { display: none; }\n  .panel {\n    display: grid;\n    grid-template-rows: 0fr;\n    transition: grid-template-rows var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  :host([data-open]) .panel { grid-template-rows: 1fr; }\n  .inner { overflow: hidden; }\n  /* Space above too: the header may have a background (hover, filled,\n     contained) and the content must not touch it. */\n  .content { padding: var(--ray-space-3) var(--ray-space-md) var(--ray-space-md); font-size: var(--ray-font-size-sm); }\n`;\n\nexport class RayAccordionItem extends RayElement {\n  static delegatesFocus = true;\n  static properties = {\n    value: { type: String, reflect: true },\n    label: { type: String },\n    description: { type: String },\n    disabled: { type: Boolean, reflect: true },\n    headingLevel: { type: Number, default: 3 },\n  };\n  static styles = [itemStyles];\n  static template = `\n    <h3 part=\"heading\">\n      <button class=\"control focus-ring\" id=\"control\" part=\"control\" type=\"button\" aria-expanded=\"false\" aria-controls=\"panel\">\n        <span class=\"section\" part=\"left-section\"><slot name=\"left\"></slot></span>\n        <span class=\"label\" part=\"label\"><span class=\"label-text\"><slot name=\"label\"></slot></span><span class=\"description\" part=\"description\"></span></span>\n        <span class=\"chevron\" part=\"chevron\" aria-hidden=\"true\" data-ray-icon=\"chevron-down\"></span>\n      </button>\n    </h3>\n    <div class=\"panel\" id=\"panel\" part=\"panel\" role=\"region\" aria-labelledby=\"control\" inert>\n      <div class=\"inner\"><div class=\"content\" part=\"content\"><slot></slot></div></div>\n    </div>`;\n\n  constructor() {\n    super();\n    this._open = false;\n    this.$(\".control\").addEventListener(\"click\", () => {\n      if (!this.disabled) this.emit(\"ray-accordion-toggle\");\n    });\n    const left = this.$('slot[name=\"left\"]');\n    left.addEventListener(\"slotchange\", () => left.parentElement.toggleAttribute(\"data-filled\", left.assignedNodes().length > 0));\n  }\n\n  /** Whether this item is expanded (set the accordion's value to change it). */\n  get open() {\n    return this._open;\n  }\n\n  _setOpen(on) {\n    this._open = on;\n    this.toggleAttribute(\"data-open\", on);\n    this.$(\".control\").setAttribute(\"aria-expanded\", String(on));\n    // Closed content must not take focus nor be read.\n    this.$(\".panel\").inert = !on;\n  }\n\n  update(changed) {\n    // The label text sits before the label slot (rich content).\n    const text = this.$(\".label-text\");\n    if (text.firstChild?.nodeType === Node.TEXT_NODE) text.firstChild.remove();\n    if (this.label) text.prepend(document.createTextNode(this.label));\n    this.$(\".description\").textContent = this.description ?? \"\";\n    this.$(\".control\").disabled = Boolean(this.disabled);\n    const h = this.$(\"h3\");\n    h.setAttribute(\"role\", \"heading\");\n    h.setAttribute(\"aria-level\", String(this.headingLevel || 3));\n    if (changed.has(\"value\")) this.closest(\"ray-accordion\")?.requestUpdate();\n  }\n}\n\ndefine(\"ray-accordion\", RayAccordion);\ndefine(\"ray-accordion-item\", RayAccordionItem);\n";
const F2: string = "// <ray-alert>: an inline message (Mantine's Alert) — title, text, an icon\n// from the registry, the color variants, and an optional close button.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { motionAllowed, collapseOut } from \"../../core/motion.js\";\nimport { applyColor, radiusStyles, variantStyles } from \"../../core/styles.js\";\n\n// The icon a color gets when `icon` is not set (any registered name works).\nconst ICON_BY_COLOR = { blue: \"info\", cyan: \"info\", indigo: \"info\", green: \"circle-check\", teal: \"circle-check\", yellow: \"alert-triangle\", orange: \"alert-triangle\", red: \"circle-x\", pink: \"circle-x\" };\n\nconst styles = css`\n  :host { display: block; }\n  .alert {\n    position: relative;\n    display: flex;\n    gap: var(--ray-space-3);\n    padding: var(--ray-space-3) var(--ray-space-4);\n    font-size: var(--ray-font-size-sm);\n    border-radius: var(--_r);\n  }\n  .icon { flex: none; display: inline-flex; margin-top: 0.0625rem; }\n  .icon svg { width: 1.25rem; height: 1.25rem; }\n  .icon[hidden] { display: none; }\n  .body { flex: 1; min-width: 0; }\n  .title { margin: 0 0 0.125rem; font-weight: var(--ray-font-weight-bold); }\n  .title:empty { display: none; }\n  .text { color: inherit; line-height: var(--ray-line-height-sm); }\n  [data-variant=\"light\"] .text, [data-variant=\"outline\"] .text, [data-variant=\"transparent\"] .text { color: var(--ray-foreground); }\n  [data-variant=\"default\"] .icon { color: var(--_light-color); }\n  .close {\n    flex: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 1.5rem;\n    height: 1.5rem;\n    margin: -0.125rem -0.375rem 0 0;\n    padding: 0;\n    color: inherit;\n    background: transparent;\n    border: 0;\n    border-radius: var(--ray-radius-sm);\n    cursor: pointer;\n    opacity: 0.8;\n  }\n  .close:hover { opacity: 1; background: color-mix(in srgb, currentColor 12%, transparent); }\n  .close svg { width: 1rem; height: 1rem; }\n  .close[hidden] { display: none; }\n`;\n\nexport class RayAlert extends RayElement {\n  static properties = {\n    label: { type: String },\n    color: { type: String, reflect: true },\n    variant: { type: String, reflect: true, default: \"light\" },\n    radius: { type: String, reflect: true },\n    icon: { type: String, reflect: true },\n    closable: { type: Boolean, reflect: true },\n    closeLabel: { type: String, default: \"Dismiss\" },\n  };\n  static styles = [radiusStyles, variantStyles, styles];\n  static template = `\n    <div class=\"alert\" part=\"alert\">\n      <span class=\"icon\" part=\"icon\" aria-hidden=\"true\"><slot name=\"icon\"><span class=\"default-icon\" data-ray-icon=\"\"></span></slot></span>\n      <div class=\"body\">\n        <p class=\"title\" part=\"title\"></p>\n        <div class=\"text\" part=\"text\"><slot></slot></div>\n      </div>\n      <button class=\"close focus-ring\" part=\"close\" type=\"button\" hidden><span data-ray-icon=\"close\" aria-hidden=\"true\"></span></button>\n    </div>`;\n\n  constructor() {\n    super();\n    this.internals = this.attachInternals();\n    this.internals.role = \"alert\";\n    this.$(\".close\").addEventListener(\"click\", () => {\n      if (!this.emit(\"ray-close\", undefined, { cancelable: true })) return;\n      if (!motionAllowed(this)) {\n        this.hidden = true;\n        return;\n      }\n      // Fade and fold away, then hide (content below moves up smoothly).\n      const exit = collapseOut(this);\n      exit.finished.then(() => {\n        this.hidden = true;\n        exit.cancel();\n      });\n    });\n  }\n\n  update() {\n    const box = this.$(\".alert\");\n    box.dataset.variant = this.variant || \"light\";\n    applyColor(box, this.color);\n    this.$(\".title\").textContent = this.label ?? \"\";\n    const name = this.icon ?? ICON_BY_COLOR[this.color] ?? \"info\";\n    const slotted = this.$('slot[name=\"icon\"]').assignedNodes().length > 0;\n    const def = this.$(\".default-icon\");\n    if (def.getAttribute(\"data-ray-icon\") !== name) {\n      def.setAttribute(\"data-ray-icon\", name);\n      this.paintIcons(box);\n    }\n    // icon=\"none\" hides it.\n    this.$(\".icon\").hidden = this.icon === \"none\" && !slotted;\n    const close = this.$(\".close\");\n    close.hidden = !this.closable;\n    close.setAttribute(\"aria-label\", this.closeLabel ?? \"Dismiss\");\n    this.internals.ariaLabel = this.label || null;\n  }\n}\n\ndefine(\"ray-alert\", RayAlert);\n";
const F3: string = "// <ray-app-bar>: the top bar of a phone screen (Material's top app bar, the\n// iOS navigation bar): a back or menu button, the title (and a subtitle),\n// actions, and an optional row under it (tabs, a search field).\n//\n// scroll=\"elevate\" (default) draws its border and shadow once the content\n// scrolls; scroll=\"hide\" also slides it away while scrolling down and back\n// on the way up. It follows the scroller of its ray-app-shell, else\n// `scroll-target`, else the window. Clear of the notch (safe-area inset).\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { scrollerOf, watchScroll } from \"../../core/scroll.js\";\n\nconst styles = css`\n  :host {\n    --_h: 3.5rem;\n    --_bg: var(--ray-background);\n    --_fg: var(--ray-foreground);\n    --_muted: var(--ray-muted-foreground);\n    display: grid;\n    grid-template-rows: 1fr;\n    position: relative;\n    z-index: 2;\n    transition: grid-template-rows var(--ray-duration-base) var(--ray-easing-standard), translate var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  /* Hidden above a scroller (in a shell): its row closes, the content takes\n     the room. Over the window (sticky): it slides up. */\n  :host([data-concealed=\"flow\"]) { grid-template-rows: 0fr; clip-path: inset(0); }\n  :host([data-concealed=\"over\"]) { translate: 0 -100%; }\n  :host([hidden]) { display: none; }\n  :host([sticky]) { position: sticky; top: 0; }\n  :host([variant=\"filled\"]) { --_bg: var(--ray-primary-filled); --_fg: var(--ray-primary-contrast); --_muted: color-mix(in srgb, var(--ray-primary-contrast) 75%, transparent); }\n  :host([variant=\"transparent\"]) { --_bg: transparent; }\n  :host([size=\"sm\"]) { --_h: 3rem; }\n  :host([size=\"lg\"]) { --_h: 4rem; }\n  /* The row that closes (no padding, no border: it can reach 0). */\n  .fold { min-height: 0; }\n  .bar {\n    box-sizing: border-box;\n    padding-top: env(safe-area-inset-top, 0px);\n    color: var(--_fg);\n    background: var(--_bg);\n    border-bottom: 1px solid transparent;\n    transition: border-color var(--ray-duration-fast), box-shadow var(--ray-duration-fast), background-color var(--ray-duration-fast);\n  }\n  :host([data-elevated]) .bar { border-bottom-color: var(--ray-border); box-shadow: var(--ray-shadow-sm); }\n  :host([data-elevated][variant=\"transparent\"]) .bar { background: var(--ray-background); }\n  :host([variant=\"filled\"][data-elevated]) .bar { border-bottom-color: transparent; }\n  .row {\n    display: grid;\n    grid-template-columns: auto minmax(0, 1fr) auto;\n    align-items: center;\n    gap: var(--ray-space-1);\n    min-height: var(--_h);\n    padding-inline: max(var(--ray-space-2), env(safe-area-inset-left, 0px)) max(var(--ray-space-2), env(safe-area-inset-right, 0px));\n  }\n  :host([center]) .row { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }\n  .start, .end { display: flex; align-items: center; gap: var(--ray-space-1); }\n  .end { justify-content: flex-end; }\n  .title { display: grid; min-width: 0; padding-inline: var(--ray-space-2); }\n  :host([center]) .title { text-align: center; }\n  .label {\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n    font-size: var(--ray-font-size-lg);\n    font-weight: var(--ray-font-weight-bold, 700);\n    line-height: 1.25;\n  }\n  :host([size=\"sm\"]) .label { font-size: var(--ray-font-size-md); }\n  .description { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--ray-font-size-xs); color: var(--_muted); }\n  .label:empty, .description:empty { display: none; }\n  .bottom { padding: 0 var(--ray-space-2) var(--ray-space-2); }\n  .bottom:not([data-filled]), .start:not([data-filled]) { display: none; }\n  :host([center]) .start:not([data-filled]) { display: flex; }\n  @media (prefers-reduced-motion: reduce) { :host { transition: none; } }\n`;\n\nexport class RayAppBar extends RayElement {\n  static properties = {\n    label: { type: String },\n    description: { type: String },\n    center: { type: Boolean, reflect: true },\n    variant: { type: String, reflect: true, default: \"default\" },\n    size: { type: String, reflect: true, default: \"md\" },\n    scroll: { type: String, reflect: true, default: \"elevate\" },\n    sticky: { type: Boolean, reflect: true },\n    scrollTarget: { type: String, attribute: \"scroll-target\" },\n  };\n  static styles = [styles];\n  static template = `\n    <div class=\"fold\"><div class=\"bar\" part=\"bar\">\n      <div class=\"row\">\n        <div class=\"start\" part=\"start\"><slot name=\"start\"></slot></div>\n        <div class=\"title\" part=\"title\"><span class=\"label\"></span><span class=\"description\"></span><slot></slot></div>\n        <div class=\"end\" part=\"end\"><slot name=\"end\"></slot></div>\n      </div>\n      <div class=\"bottom\" part=\"bottom\"><slot name=\"bottom\"></slot></div>\n    </div></div>`;\n\n  #stop = null;\n  #lock = 0;\n\n  constructor() {\n    super();\n    for (const name of [\"start\", \"bottom\"]) {\n      const slot = this.$(`slot[name=\"\${name}\"]`);\n      slot.addEventListener(\"slotchange\", () => slot.parentElement.toggleAttribute(\"data-filled\", slot.assignedNodes().length > 0));\n    }\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    for (const name of [\"start\", \"bottom\"]) {\n      const slot = this.$(`slot[name=\"\${name}\"]`);\n      slot.parentElement.toggleAttribute(\"data-filled\", slot.assignedNodes().length > 0);\n    }\n    // The shell (or the target) may upgrade after the bar: watch once settled.\n    queueMicrotask(() => this._watch());\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    this.#stop?.();\n    this.#stop = null;\n  }\n\n  /** Whether scroll=\"hide\" has slid it away. */\n  get concealed() {\n    return this.hasAttribute(\"data-concealed\");\n  }\n\n  update(changed) {\n    this.$(\".label\").textContent = this.label ?? \"\";\n    this.$(\".description\").textContent = this.description ?? \"\";\n    if (changed.has(\"scroll\") || changed.has(\"scrollTarget\")) this._watch();\n  }\n\n  _watch() {\n    this.#stop?.();\n    this.#stop = null;\n    this.removeAttribute(\"data-concealed\");\n    this.toggleAttribute(\"data-elevated\", false);\n    if (!this.isConnected || this.scroll === \"none\") return;\n    const scroller = scrollerOf(this, this.scrollTarget);\n    // In a shell the bar sits above the scroller: hiding gives its room to\n    // the content. Over the window it slides away.\n    const inFlow = scroller !== window;\n    this.#stop = watchScroll(scroller, ({ y, direction }) => {\n      this.toggleAttribute(\"data-elevated\", y > 0);\n      if (this.scroll !== \"hide\") return;\n      if (y <= 0) this.removeAttribute(\"data-concealed\");\n      else this._conceal(direction === \"down\" && y > this.offsetHeight + 8, inFlow);\n    });\n  }\n\n  _conceal(on, inFlow = true) {\n    if (on === this.concealed) return;\n    // Closing its row resizes the scroller, which can move the scroll\n    // position (at the end of the content): ignore that for a moment.\n    if (performance.now() < this.#lock) return;\n    this.#lock = performance.now() + 400;\n    if (on) this.setAttribute(\"data-concealed\", inFlow ? \"flow\" : \"over\");\n    else this.removeAttribute(\"data-concealed\");\n  }\n}\n\ndefine(\"ray-app-bar\", RayAppBar);\n";
const F4: string = "// <ray-app-shell>: the frame of an app (Mantine's AppShell): header,\n// navbar, main, aside, footer, and a bottom bar for phones.\n//\n// Wide: the header across the top (or beside the navbar with\n// layout=\"alt\"), the navbar and the aside on the sides of the main content.\n// Narrow (below `breakpoint`, the shell's own width): one column, header,\n// main, footer and the `bottom` slot (a ray-bottom-nav); the navbar and the\n// aside take no room (a ray-sidebar there still opens as a drawer).\n//\n// The main content scrolls, the bars stay: `scroller` is the element that\n// scrolls (ray-app-bar and ray-bottom-nav find it on their own).\n//\n// Under a transparent title bar (a std/ui full_content window with\n// core/raylang.js; see titlebar() in core/host.js) the header is the title\n// bar: it is at least as tall, leaves room for the window buttons and drags\n// the window. With layout=\"alt\", or without a header, the navbar and the\n// main content start below the title bar instead.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { spaceValue } from \"../../core/styles.js\";\nimport { titlebar, dragRegion, onHostChange } from \"../../core/host.js\";\n\nconst styles = css`\n  :host {\n    display: block;\n    height: 100dvh;\n    min-height: 0;\n    color: var(--ray-foreground);\n    background: var(--ray-background);\n  }\n  :host([hidden]) { display: none; }\n  .shell {\n    display: grid;\n    height: 100%;\n    grid-template-columns: auto minmax(0, 1fr) auto;\n    grid-template-rows: auto minmax(0, 1fr) auto auto;\n    grid-template-areas:\n      \"header header header\"\n      \"navbar main aside\"\n      \"footer footer footer\"\n      \"bottom bottom bottom\";\n  }\n  :host([layout=\"alt\"]) .shell {\n    grid-template-areas:\n      \"navbar header aside\"\n      \"navbar main aside\"\n      \"navbar footer aside\"\n      \"bottom bottom bottom\";\n  }\n  .header { grid-area: header; min-width: 0; }\n  .navbar { grid-area: navbar; display: flex; min-height: 0; }\n  .aside { grid-area: aside; display: flex; min-height: 0; }\n  .footer { grid-area: footer; min-width: 0; }\n  .bottom { grid-area: bottom; min-width: 0; display: none; }\n  .main {\n    grid-area: main;\n    position: relative;\n    min-width: 0;\n    min-height: 0;\n    overflow: auto;\n    overscroll-behavior: contain;\n    padding: var(--_p, 0);\n  }\n  .header:not([data-filled]), .footer:not([data-filled]), .navbar:not([data-filled]), .aside:not([data-filled]) { display: none; }\n\n  /* Narrow: one column; the side panels take no room but stay rendered\n     (a sidebar's drawer is a top-layer dialog inside them). */\n  :host([data-mobile]) .shell {\n    grid-template-columns: minmax(0, 1fr);\n    grid-template-areas: \"header\" \"main\" \"footer\" \"bottom\";\n  }\n  :host([data-mobile]) .navbar, :host([data-mobile]) .aside {\n    position: absolute;\n    width: 0;\n    height: 0;\n    overflow: hidden;\n  }\n  :host([data-mobile]) .bottom[data-filled] { display: block; }\n\n  /* Under a transparent title bar (data-titlebar, from the host). */\n  :host([data-titlebar]) .header { min-height: var(--ray-titlebar-height, 0px); }\n  :host([data-titlebar]:not([layout=\"alt\"])) .header,\n  :host([data-titlebar][data-mobile]) .header { padding-inline-start: var(--ray-titlebar-inset, 0px); }\n  :host([data-titlebar][layout=\"alt\"]:not([data-mobile])) .navbar,\n  :host([data-titlebar][data-no-header]) .navbar,\n  :host([data-titlebar][data-no-header]) .aside { padding-top: var(--ray-titlebar-height, 0px); }\n  :host([data-titlebar][data-no-header]) .main { padding-top: calc(var(--_p, 0px) + var(--ray-titlebar-height, 0px)); }\n`;\n\n/** A CSS length in px, against the element's font size for em/rem. */\nfunction toPx(value, el) {\n  const m = String(value ?? \"\").trim().match(/^(\\d+(?:\\.\\d+)?)(px|em|rem)?$/);\n  if (!m) return 768;\n  const n = Number(m[1]);\n  if (m[2] === \"rem\") return n * parseFloat(getComputedStyle(document.documentElement).fontSize || \"16\");\n  if (m[2] === \"em\") return n * parseFloat(getComputedStyle(el).fontSize || \"16\");\n  return n;\n}\n\nexport class RayAppShell extends RayElement {\n  static properties = {\n    layout: { type: String, reflect: true, default: \"default\" },\n    breakpoint: { type: String, default: \"48em\" },\n    padding: { type: String, reflect: true },\n  };\n  static styles = [styles];\n  static template = `\n    <div class=\"shell\" part=\"shell\">\n      <div class=\"header\" part=\"header\"><slot name=\"header\"></slot></div>\n      <div class=\"navbar\" part=\"navbar\"><slot name=\"navbar\"></slot></div>\n      <div class=\"main\" part=\"main\"><slot></slot></div>\n      <div class=\"aside\" part=\"aside\"><slot name=\"aside\"></slot></div>\n      <div class=\"footer\" part=\"footer\"><slot name=\"footer\"></slot></div>\n      <div class=\"bottom\" part=\"bottom\"><slot name=\"bottom\"></slot></div>\n    </div>`;\n\n  #ro = null;\n  #syncs = [];\n  #stopHost = null;\n  /** @type {Map<Element, () => void>} */\n  #drags = new Map();\n\n  constructor() {\n    super();\n    for (const name of [\"header\", \"navbar\", \"aside\", \"footer\", \"bottom\"]) {\n      const slot = this.$(`slot[name=\"\${name}\"]`);\n      const sync = () => {\n        slot.parentElement.toggleAttribute(\"data-filled\", slot.assignedNodes().length > 0);\n        if (name === \"header\") this.#chrome();\n      };\n      slot.addEventListener(\"slotchange\", sync);\n      this.#syncs.push(sync);\n    }\n  }\n\n  // The title bar: the shell's attributes, and the header elements as drag handles.\n  #chrome() {\n    const bar = this.isConnected && titlebar();\n    this.toggleAttribute(\"data-titlebar\", Boolean(bar));\n    const header = this.$('slot[name=\"header\"]').assignedElements();\n    this.toggleAttribute(\"data-no-header\", header.length === 0);\n    for (const [el, undo] of this.#drags) {\n      if (!bar || !header.includes(el)) {\n        undo();\n        this.#drags.delete(el);\n      }\n    }\n    if (bar) for (const el of header) if (!this.#drags.has(el)) this.#drags.set(el, dragRegion(el));\n  }\n\n  /** The element that scrolls the main content. */\n  get scroller() {\n    return this.$(\".main\");\n  }\n\n  /** Whether the shell is in its narrow (phone) layout. */\n  get mobile() {\n    return this.hasAttribute(\"data-mobile\");\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    for (const sync of this.#syncs) sync();\n    // The layout follows the shell's own width: right in a phone-sized\n    // frame as in a full window. Measured at once too (the observer reports\n    // before the next paint, and never in a page that is not rendered).\n    this.#ro = new ResizeObserver(() => this._measure());\n    this.#ro.observe(this);\n    this._measure();\n    this.#stopHost ??= onHostChange(() => this.#chrome());\n    this.#chrome();\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    this.#ro?.disconnect();\n    this.#ro = null;\n    this.#stopHost?.();\n    this.#stopHost = null;\n    this.#chrome();\n  }\n\n  update(changed) {\n    const p = spaceValue(this.padding);\n    if (p) this.style.setProperty(\"--_p\", p);\n    else this.style.removeProperty(\"--_p\");\n    if (changed.has(\"breakpoint\")) this._measure();\n  }\n\n  _measure() {\n    const mobile = this.getBoundingClientRect().width < toPx(this.breakpoint, this);\n    if (mobile === this.mobile) return;\n    this.toggleAttribute(\"data-mobile\", mobile);\n    this.emit(\"ray-breakpoint\", { mobile });\n  }\n}\n\ndefine(\"ray-app-shell\", RayAppShell);\n";
const F5: string = "// <ray-aspect-ratio>: a box with a fixed width/height ratio; its media\n// (img, video, iframe, any element) fills it.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst RADII = [\"xs\", \"sm\", \"md\", \"lg\", \"xl\", \"full\"];\n\nconst styles = css`\n  /* Defaults set on the host: an ancestor's private --_r (a card's or a\n     button's radius) would otherwise inherit into it. */\n  :host {\n    --_ratio: 16 / 9;\n    --_r: 0;\n    display: block;\n    position: relative;\n    overflow: hidden;\n    aspect-ratio: var(--_ratio);\n    border-radius: var(--_r);\n  }\n  :host([hidden]) { display: none; }\n  ::slotted(*) {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n  :host([fit=\"contain\"]) ::slotted(*) { object-fit: contain; }\n`;\n\n/** \"16/9\", \"16:9\", \"1.5\", 2 -> a CSS aspect-ratio value (\"16 / 9\"); null if invalid. */\nexport function parseRatio(value) {\n  const s = String(value ?? \"\").trim();\n  const m = s.match(/^(\\d+(?:\\.\\d+)?)\\s*[/:]\\s*(\\d+(?:\\.\\d+)?)$/);\n  if (m && Number(m[2]) > 0) return `\${Number(m[1])} / \${Number(m[2])}`;\n  const n = Number(s);\n  return s && Number.isFinite(n) && n > 0 ? String(n) : null;\n}\n\nexport class RayAspectRatio extends RayElement {\n  static properties = {\n    ratio: { type: String, reflect: true, default: \"16/9\" },\n    fit: { type: String, reflect: true, default: \"cover\" },\n    radius: { type: String, reflect: true },\n  };\n  static styles = [styles];\n  static template = `<slot></slot>`;\n\n  update() {\n    const r = parseRatio(this.ratio);\n    if (r) this.style.setProperty(\"--_ratio\", r);\n    else this.style.removeProperty(\"--_ratio\");\n    const rad = this.radius;\n    if (rad) this.style.setProperty(\"--_r\", RADII.includes(rad) ? `var(--ray-radius-\${rad})` : rad);\n    else this.style.removeProperty(\"--_r\");\n  }\n}\n\ndefine(\"ray-aspect-ratio\", RayAspectRatio);\n";
const F6: string = "// <ray-attachment>: a file in a message composer, an upload list or a chat\n// (shadcn's AI attachment, upload items). Thumbnail or type icon, name, size\n// and an extension badge; optional upload progress, error, remove button and\n// download link. <ray-attachments> lays several out in a wrapping row.\n//\n//   el.file = input.files[0];   // fills name, size, type and an image thumbnail\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst styles = css`\n  :host {\n    display: inline-flex;\n    vertical-align: top;\n    max-width: 100%;\n    font-size: var(--ray-font-size-sm);\n    --_thumb: 2.75rem;\n  }\n  :host([hidden]) { display: none; }\n  .item {\n    position: relative;\n    display: flex;\n    align-items: center;\n    gap: var(--ray-space-3);\n    box-sizing: border-box;\n    width: 16rem;\n    max-width: 100%;\n    padding: var(--ray-space-2);\n    padding-right: var(--ray-space-3);\n    color: var(--ray-foreground);\n    background: var(--ray-card);\n    border: 1px solid var(--ray-border);\n    border-radius: var(--ray-radius-default);\n    overflow: hidden;\n  }\n  :host([status=\"error\"]) .item { border-color: var(--ray-destructive); }\n  :host([disabled]) .item { opacity: 0.6; }\n  .thumb {\n    position: relative;\n    flex: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--_thumb);\n    height: var(--_thumb);\n    overflow: hidden;\n    color: var(--ray-muted-foreground);\n    background: var(--ray-muted);\n    border-radius: calc(var(--ray-radius-default) - 2px);\n  }\n  .thumb img { width: 100%; height: 100%; object-fit: cover; }\n  .thumb [data-ray-icon] { --ray-icon-size: 1.25rem; }\n  :host([status=\"error\"]) .thumb { color: var(--ray-destructive); }\n  .badge {\n    position: absolute;\n    bottom: 3px;\n    left: 50%;\n    transform: translateX(-50%);\n    padding: 0 0.25rem;\n    font-size: 0.5625rem;\n    font-weight: var(--ray-font-weight-bold);\n    line-height: 0.875rem;\n    letter-spacing: 0.02em;\n    color: var(--ray-muted-foreground);\n    background: var(--ray-card);\n    border-radius: var(--ray-radius-xs);\n  }\n  .thumb[data-image] .badge { display: none; }\n  .text { display: grid; flex: 1; min-width: 0; gap: 1px; }\n  .name-box { display: block; min-width: 0; }\n  .name {\n    display: block;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n    font-weight: var(--ray-font-weight-medium);\n    color: inherit;\n    text-decoration: none;\n  }\n  a.name:hover { text-decoration: underline; }\n  a.name:focus-visible { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: 2px; border-radius: var(--ray-radius-xs); }\n  .meta { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--ray-font-size-xs); color: var(--ray-muted-foreground); font-variant-numeric: tabular-nums; }\n  :host([status=\"error\"]) .meta { color: var(--ray-destructive); }\n  .bar {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 2px;\n    background: var(--ray-muted);\n  }\n  .bar span {\n    display: block;\n    height: 100%;\n    width: var(--_pct, 0%);\n    background: var(--ray-primary);\n    transition: width var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  .remove {\n    flex: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 1.5rem;\n    height: 1.5rem;\n    padding: 0;\n    color: var(--ray-muted-foreground);\n    background: transparent;\n    border: 0;\n    border-radius: var(--ray-radius-sm);\n    cursor: pointer;\n    opacity: 0.7;\n    transition: opacity var(--ray-duration-fast) var(--ray-easing-standard), background var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  .item:hover .remove, .remove:focus-visible { opacity: 1; }\n  .remove:hover { color: var(--ray-foreground); background: var(--ray-default-hover); }\n  .remove:disabled { cursor: not-allowed; }\n  .remove [data-ray-icon] { --ray-icon-size: 0.875rem; }\n\n  /* variant=\"card\": the thumbnail on top, square-ish. */\n  :host([variant=\"card\"]) .item {\n    flex-direction: column;\n    align-items: stretch;\n    gap: var(--ray-space-2);\n    width: 10rem;\n    padding: var(--ray-space-2);\n  }\n  :host([variant=\"card\"]) .thumb { width: 100%; height: auto; aspect-ratio: 4 / 3; }\n  :host([variant=\"card\"]) .thumb [data-ray-icon] { --ray-icon-size: 1.75rem; }\n  :host([variant=\"card\"]) .badge { bottom: 6px; font-size: 0.625rem; }\n  :host([variant=\"card\"]) .text { padding: 0 var(--ray-space-1) var(--ray-space-1); }\n  :host([variant=\"card\"]) .remove {\n    position: absolute;\n    top: calc(var(--ray-space-2) + 4px);\n    right: calc(var(--ray-space-2) + 4px);\n    background: var(--ray-card);\n    box-shadow: var(--ray-shadow-xs);\n    opacity: 1;\n  }\n  [hidden] { display: none !important; }\n`;\n\nconst IMAGE = /^image\\//;\n\n/** 12 KB, 3.4 MB… (base 1024, like file managers). */\nexport function formatBytes(bytes, locale) {\n  const n = Number(bytes);\n  if (!Number.isFinite(n) || n < 0) return \"\";\n  const units = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\"];\n  let i = 0;\n  let v = n;\n  while (v >= 1024 && i < units.length - 1) {\n    v /= 1024;\n    i++;\n  }\n  const digits = i === 0 || v >= 10 ? 0 : 1;\n  return `\${new Intl.NumberFormat(locale, { maximumFractionDigits: digits }).format(v)} \${units[i]}`;\n}\n\n/** \"report.final.pdf\" -> \"PDF\"; else from the MIME type (\"image/png\" -> \"PNG\"). */\nexport function extension(name, type) {\n  const m = /\\.([a-z0-9]{1,5})$/i.exec(String(name ?? \"\"));\n  if (m) return m[1].toUpperCase();\n  const sub = String(type ?? \"\").split(\"/\")[1];\n  return sub ? sub.split(/[+;.-]/)[0].slice(0, 5).toUpperCase() : \"\";\n}\n\n/** The registry icon for a file: \"image\" for images, \"file\" otherwise. */\nexport function iconFor(type, name) {\n  const t = String(type ?? \"\");\n  if (IMAGE.test(t) || /\\.(png|jpe?g|gif|webp|svg|avif|bmp)$/i.test(String(name ?? \"\"))) return \"image\";\n  return \"file\";\n}\n\nexport class RayAttachment extends RayElement {\n  static properties = {\n    name: { type: String, reflect: true },\n    size: { type: Number },\n    type: { type: String, reflect: true },\n    src: { type: String },\n    href: { type: String, reflect: true },\n    progress: { type: Number },\n    status: { type: String, reflect: true },\n    error: { type: String },\n    removable: { type: Boolean, reflect: true },\n    removeLabel: { type: String },\n    variant: { type: String, reflect: true, default: \"row\" },\n    disabled: { type: Boolean, reflect: true },\n  };\n  static styles = [styles];\n  static template = `\n    <div class=\"item\" part=\"item\" role=\"group\">\n      <span class=\"thumb\" part=\"thumbnail\"><img alt=\"\" hidden><span class=\"icon\" aria-hidden=\"true\"></span><span class=\"badge\" part=\"badge\" aria-hidden=\"true\"></span></span>\n      <span class=\"text\"><span class=\"name-box\"></span><span class=\"meta\" part=\"meta\"></span></span>\n      <button class=\"remove focus-ring\" part=\"remove\" type=\"button\" hidden><span data-ray-icon=\"close\" aria-hidden=\"true\"></span></button>\n      <span class=\"bar\" part=\"progress\" role=\"progressbar\" aria-valuemin=\"0\" aria-valuemax=\"100\" hidden><span></span></span>\n    </div>`;\n\n  #file = null;\n  #objectUrl = null;\n  #failed = null;\n\n  constructor() {\n    super();\n    this.$(\"img\").addEventListener(\"error\", () => {\n      this.#failed = this.$(\"img\").getAttribute(\"src\");\n      this.requestUpdate();\n    });\n    this.$(\".remove\").addEventListener(\"click\", () => {\n      if (this.disabled) return;\n      if (this.emit(\"ray-remove\", { name: this.name ?? \"\", file: this.#file }, { cancelable: true })) this.remove();\n    });\n  }\n\n  /** A File to show: fills name, size, type and, for images, a thumbnail. */\n  get file() {\n    return this.#file;\n  }\n\n  set file(f) {\n    this.#revoke();\n    this.#file = f ?? null;\n    if (f) {\n      this.name = f.name;\n      this.size = f.size;\n      this.type = f.type;\n      // A Blob has bytes to show; a file the host chose (HostFile) is only a path.\n      if (IMAGE.test(f.type) && f instanceof Blob && typeof URL.createObjectURL === \"function\") {\n        this.#objectUrl = URL.createObjectURL(f);\n        this.src = this.#objectUrl;\n      }\n    }\n    this.requestUpdate();\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    this.#revoke();\n  }\n\n  #revoke() {\n    if (this.#objectUrl) {\n      URL.revokeObjectURL(this.#objectUrl);\n      if (this.src === this.#objectUrl) this.src = undefined;\n      this.#objectUrl = null;\n    }\n  }\n\n  /** The effective status: an explicit one, else \"uploading\" while progress is set. */\n  get state() {\n    if (this.status) return this.status;\n    return this.progress === undefined || this.progress === null || Number.isNaN(this.progress) ? \"done\" : \"uploading\";\n  }\n\n  update() {\n    const name = this.name ?? \"\";\n    const size = formatBytes(this.size);\n    const state = this.state;\n\n    // Thumbnail (images with a working src) or the type icon + extension badge.\n    const thumb = this.$(\".thumb\");\n    const img = this.$(\"img\");\n    const showImage = Boolean(this.src) && this.#failed !== this.src && iconFor(this.type, name) === \"image\";\n    img.hidden = !showImage;\n    if (showImage && img.getAttribute(\"src\") !== this.src) img.src = this.src;\n    thumb.toggleAttribute(\"data-image\", showImage);\n    const icon = this.$(\".icon\");\n    icon.hidden = showImage;\n    const iconName = state === \"error\" ? \"alert-triangle\" : iconFor(this.type, name);\n    if (icon.getAttribute(\"data-ray-icon\") !== iconName) {\n      icon.setAttribute(\"data-ray-icon\", iconName);\n      this.paintIcons(thumb);\n    }\n    this.$(\".badge\").textContent = extension(name, this.type);\n\n    // Name: a link with href, plain text otherwise.\n    const box = this.$(\".name-box\");\n    const tag = this.href && !this.disabled ? \"a\" : \"span\";\n    let el = box.firstElementChild;\n    if (!el || el.localName !== tag) {\n      el = document.createElement(tag);\n      el.className = \"name\";\n      el.setAttribute(\"part\", \"name\");\n      box.replaceChildren(el);\n    }\n    el.textContent = name;\n    el.title = name;\n    if (tag === \"a\") {\n      el.href = this.href;\n      el.setAttribute(\"download\", name);\n    }\n\n    // Meta line: size, upload state or error.\n    const pct = Math.max(0, Math.min(100, Math.round(Number(this.progress) || 0)));\n    let meta = size;\n    if (state === \"uploading\") meta = this.progress === undefined || this.progress === null ? \"Uploading…\" : `Uploading… \${pct}%`;\n    else if (state === \"error\") meta = this.error || \"Upload failed\";\n    this.$(\".meta\").textContent = meta;\n\n    const bar = this.$(\".bar\");\n    const uploading = state === \"uploading\" && this.progress !== undefined && this.progress !== null;\n    bar.hidden = !uploading;\n    if (uploading) {\n      bar.style.setProperty(\"--_pct\", `\${pct}%`);\n      bar.setAttribute(\"aria-valuenow\", String(pct));\n      bar.setAttribute(\"aria-label\", `Uploading \${name}`);\n    }\n\n    const remove = this.$(\".remove\");\n    remove.hidden = !this.removable;\n    remove.disabled = Boolean(this.disabled);\n    remove.setAttribute(\"aria-label\", (this.removeLabel || \"Remove {name}\").replace(\"{name}\", name));\n\n    const item = this.$(\".item\");\n    item.setAttribute(\"aria-label\", [name, size].filter(Boolean).join(\", \"));\n    item.toggleAttribute(\"aria-busy\", state === \"uploading\");\n    if (state === \"error\") item.setAttribute(\"aria-invalid\", \"true\");\n    else item.removeAttribute(\"aria-invalid\");\n  }\n}\n\nconst listStyles = css`\n  :host { display: flex; flex-wrap: wrap; gap: var(--ray-space-2); align-items: flex-start; }\n  :host([hidden]) { display: none; }\n`;\n\n/** A wrapping row of attachments (layout only). */\nexport class RayAttachments extends RayElement {\n  static styles = [listStyles];\n  static template = `<slot></slot>`;\n}\n\ndefine(\"ray-attachment\", RayAttachment);\ndefine(\"ray-attachments\", RayAttachments);\n";
const F7: string = "// <ray-avatar>: an image, the initials of `name`, or a placeholder icon.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor, radiusStyles, variantStyles } from \"../../core/styles.js\";\n\nconst styles = css`\n  :host {\n    display: inline-flex;\n    vertical-align: middle;\n    --_size: 2.375rem;\n    --_r: var(--ray-radius-full);\n  }\n  :host([size=\"xs\"]) { --_size: 1rem; }\n  :host([size=\"sm\"]) { --_size: 1.625rem; }\n  :host([size=\"lg\"]) { --_size: 3.5rem; }\n  :host([size=\"xl\"]) { --_size: 5.25rem; }\n  .avatar {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--_size);\n    height: var(--_size);\n    overflow: hidden;\n    font-size: calc(var(--_size) * 0.4);\n    font-weight: var(--ray-font-weight-bold);\n    line-height: 1;\n    user-select: none;\n    border-radius: var(--_r);\n  }\n  img { width: 100%; height: 100%; object-fit: cover; }\n  .initials svg { width: calc(var(--_size) * 0.6); height: calc(var(--_size) * 0.6); }\n  [hidden] { display: none !important; }\n`;\n\nconst PLACEHOLDER = `<span data-ray-icon=\"user\" aria-hidden=\"true\"></span>`;\n\n/** Up to two initials: \"Ada Lovelace\" -> \"AL\", \"ray\" -> \"R\". */\nexport function initials(name) {\n  const words = String(name || \"\").trim().split(/\\s+/).filter(Boolean);\n  if (!words.length) return \"\";\n  const first = [...words[0]][0] ?? \"\";\n  const last = words.length > 1 ? ([...words[words.length - 1]][0] ?? \"\") : \"\";\n  return (first + last).toUpperCase();\n}\n\nexport class RayAvatar extends RayElement {\n  static properties = {\n    src: { type: String, reflect: true },\n    alt: { type: String, reflect: true },\n    name: { type: String, reflect: true },\n    color: { type: String, reflect: true },\n    variant: { type: String, reflect: true, default: \"light\" },\n    size: { type: String, reflect: true, default: \"md\" },\n    radius: { type: String, reflect: true },\n  };\n  static styles = [radiusStyles, variantStyles, styles];\n  static template = `<span class=\"avatar\" part=\"avatar\"><img part=\"image\" alt=\"\" hidden><span class=\"initials\" part=\"initials\"></span><slot></slot></span>`;\n\n  connectedCallback() {\n    super.connectedCallback();\n    if (!this._wired) {\n      this._wired = true;\n      this.$(\"img\").addEventListener(\"error\", () => {\n        this._failed = this.src;\n        this.requestUpdate();\n      });\n    }\n  }\n\n  update() {\n    const box = this.$(\".avatar\");\n    box.dataset.variant = this.variant || \"light\";\n    applyColor(box, this.color);\n    const img = this.$(\"img\");\n    const showImage = Boolean(this.src) && this._failed !== this.src;\n    img.hidden = !showImage;\n    if (showImage && img.getAttribute(\"src\") !== this.src) img.src = this.src;\n    const text = initials(this.name);\n    const span = this.$(\".initials\");\n    span.hidden = showImage;\n    if (!showImage) {\n      if (text) span.textContent = text;\n      else {\n        span.innerHTML = PLACEHOLDER;\n        this.paintIcons(span);\n      }\n    }\n    // The host carries the accessible name.\n    const label = this.alt || this.name;\n    this.setAttribute(\"role\", \"img\");\n    if (label) this.setAttribute(\"aria-label\", label);\n    else this.removeAttribute(\"aria-label\");\n  }\n}\n\ndefine(\"ray-avatar\", RayAvatar);\n";
const F8: string = "// <ray-badge>: a short status label.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor, applyGradient, radiusStyles, variantStyles } from \"../../core/styles.js\";\n\nconst styles = css`\n  :host {\n    display: inline-flex;\n    vertical-align: middle;\n    --_r: var(--ray-radius-full);\n    --_h: 1.25rem;\n    --_fs: 0.6875rem;\n    --_px: 0.5rem;\n  }\n  :host([size=\"xs\"]) { --_h: 1rem; --_fs: 0.5625rem; --_px: 0.375rem; }\n  :host([size=\"md\"]) { --_h: 1.5rem; --_fs: 0.75rem; --_px: 0.625rem; }\n  :host([size=\"lg\"]) { --_h: 1.875rem; --_fs: 0.875rem; --_px: 0.75rem; }\n  :host([size=\"xl\"]) { --_h: 2.25rem; --_fs: 1rem; --_px: 1rem; }\n  .badge {\n    display: inline-flex;\n    align-items: center;\n    gap: calc(var(--_px) / 2);\n    height: var(--_h);\n    padding: 0 var(--_px);\n    font-size: var(--_fs);\n    font-weight: var(--ray-font-weight-bold);\n    letter-spacing: 0.25px;\n    text-transform: uppercase;\n    line-height: 1;\n    white-space: nowrap;\n    border-radius: var(--_r);\n  }\n  :host([normal-case]) .badge { text-transform: none; letter-spacing: 0; }\n  .dot { display: none; width: 0.5em; height: 0.5em; border-radius: 50%; background: var(--_filled); }\n  .badge[data-variant=\"dot\"] {\n    color: var(--ray-foreground);\n    background: transparent;\n    border-color: var(--ray-border);\n  }\n  .badge[data-variant=\"dot\"] .dot { display: inline-block; }\n`;\n\nexport class RayBadge extends RayElement {\n  static properties = {\n    variant: { type: String, reflect: true, default: \"light\" },\n    color: { type: String, reflect: true },\n    gradient: { type: String, reflect: true },\n    size: { type: String, reflect: true, default: \"sm\" },\n    radius: { type: String, reflect: true },\n    normalCase: { type: Boolean, reflect: true },\n  };\n  static styles = [radiusStyles, variantStyles, styles];\n  static template = `<span class=\"badge\" part=\"badge\"><span class=\"dot\" part=\"dot\"></span><slot></slot></span>`;\n\n  update() {\n    const el = this.$(\".badge\");\n    el.dataset.variant = this.variant || \"light\";\n    applyColor(el, this.color);\n    applyGradient(el, this.gradient);\n  }\n}\n\ndefine(\"ray-badge\", RayBadge);\n";
const F9: string = "// <ray-blockquote>: a quotation set apart from the text (Mantine's\n// Blockquote): a colored edge, a quote mark on it and the attribution\n// below. The content goes into a real <blockquote>, so it is announced as\n// one; `href` (the source's URL) becomes its cite attribute.\n//\n//   <ray-blockquote cite=\"— Grace Hopper\" color=\"teal\">\n//     The most dangerous phrase in the language is \"We've always done it this way.\"\n//   </ray-blockquote>\n//\n// Variants: light (tinted, the default), outline (the edge only) and\n// filled (solid color, for a pull quote in a dark band).\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor } from \"../../core/styles.js\";\n\nconst RADII = [\"xs\", \"sm\", \"md\", \"lg\", \"xl\"];\n\nconst styles = css`\n  :host { display: block; --_fs: var(--ray-font-size-md); --_icon: 1.75rem; --_p: var(--ray-space-md); --_edge: 3px; }\n  :host([size=\"sm\"]) { --_fs: var(--ray-font-size-sm); --_icon: 1.5rem; }\n  :host([size=\"lg\"]) { --_fs: var(--ray-font-size-lg); --_icon: 2.25rem; }\n  :host([hide-edge]) { --_edge: 0px; }\n  figure { position: relative; margin: 0; }\n  /* Room for the mark, so it does not cover what is above or beside. */\n  :host([data-icon]) figure { padding: calc(var(--_icon) / 2) 0 0 calc(var(--_icon) / 2); }\n  blockquote {\n    margin: 0;\n    padding: var(--_p) calc(var(--_p) * 1.25);\n    font-size: var(--_fs);\n    line-height: var(--ray-line-height-lg, 1.6);\n    color: var(--ray-foreground);\n    background: var(--_light);\n    border-inline-start: var(--_edge) solid var(--_filled);\n    border-radius: var(--_radius, var(--ray-radius-md));\n  }\n  :host([variant=\"outline\"]) blockquote { background: transparent; border: 1px solid var(--ray-border); border-inline-start: var(--_edge) solid var(--_filled); }\n  :host([variant=\"outline\"][hide-edge]) blockquote { border-inline-start-width: 1px; border-inline-start-color: var(--ray-border); }\n  :host([variant=\"filled\"]) blockquote { color: var(--_contrast); background: var(--_filled); border-inline-start-color: transparent; }\n  ::slotted(p) { margin: 0 0 var(--ray-space-2); }\n  ::slotted(p:last-of-type) { margin-bottom: 0; }\n\n  /* The quote mark: a disc on the box's top-start corner. */\n  .icon {\n    position: absolute;\n    top: 0;\n    left: 0;\n    display: grid;\n    place-items: center;\n    width: var(--_icon);\n    height: var(--_icon);\n    color: var(--_filled);\n    background: var(--ray-background);\n    border-radius: 50%;\n    box-shadow: 0 0 0 1px var(--ray-border);\n    --ray-icon-size: calc(var(--_icon) * 0.5);\n  }\n  .icon[hidden] { display: none; }\n\n  .cite {\n    display: flex;\n    align-items: center;\n    gap: var(--ray-space-3);\n    margin-top: var(--ray-space-2);\n    padding-inline-start: calc(var(--_edge) + var(--_p) * 1.25);\n    font-size: var(--ray-font-size-sm);\n    font-style: normal;\n    color: var(--ray-muted-foreground);\n  }\n  .cite:not([data-filled]) { display: none; }\n`;\n\nexport class RayBlockquote extends RayElement {\n  static properties = {\n    cite: { type: String },\n    href: { type: String },\n    color: { type: String, reflect: true },\n    variant: { type: String, reflect: true, default: \"light\" },\n    icon: { type: String, default: \"quote\" },\n    padding: { type: String, reflect: true },\n    hideEdge: { type: Boolean, reflect: true },\n    size: { type: String, reflect: true, default: \"md\" },\n    radius: { type: String, reflect: true },\n  };\n  static styles = [styles];\n  static template = `\n    <figure part=\"figure\">\n      <span class=\"icon\" part=\"icon\" aria-hidden=\"true\"><slot name=\"icon\"><span data-ray-icon=\"quote\"></span></slot></span>\n      <blockquote part=\"quote\"><slot></slot></blockquote>\n      <figcaption class=\"cite\" part=\"cite\"><slot name=\"cite\"><cite class=\"cite-text\"></cite></slot></figcaption>\n    </figure>`;\n\n  constructor() {\n    super();\n    for (const name of [\"cite\", \"icon\"]) {\n      this.$(`slot[name=\"\${name}\"]`).addEventListener(\"slotchange\", () => this.requestUpdate());\n    }\n  }\n\n  update() {\n    applyColor(this.$(\"figure\"), this.color);\n    const quote = this.$(\"blockquote\");\n    if (this.href) quote.setAttribute(\"cite\", this.href);\n    else quote.removeAttribute(\"cite\");\n    // The quote mark: the icon slot, a registry name, or none.\n    const slotted = this.querySelector(':scope > [slot=\"icon\"]');\n    const name = this.icon === \"none\" ? \"\" : this.icon || \"quote\";\n    const mark = this.$('slot[name=\"icon\"] > span');\n    if (mark.dataset.rayIcon !== name) {\n      mark.dataset.rayIcon = name;\n      this.paintIcons(this.$(\".icon\"));\n    }\n    const shown = Boolean(slotted || name);\n    this.$(\".icon\").hidden = !shown;\n    this.toggleAttribute(\"data-icon\", shown);\n    // The attribution: the cite slot, else the cite text.\n    this.$(\".cite-text\").textContent = this.cite ?? \"\";\n    const hasCite = Boolean(this.querySelector(':scope > [slot=\"cite\"]') || this.cite);\n    this.$(\".cite\").toggleAttribute(\"data-filled\", hasCite);\n    const pad = this.padding;\n    if (pad) this.style.setProperty(\"--_p\", RADII.includes(pad) ? `var(--ray-space-\${pad})` : /^\\d+(\\.\\d+)?$/.test(pad) ? `\${pad}px` : pad);\n    else this.style.removeProperty(\"--_p\");\n    const r = this.radius;\n    if (r) this.style.setProperty(\"--_radius\", RADII.includes(r) ? `var(--ray-radius-\${r})` : r === \"none\" ? \"0\" : r);\n    else this.style.removeProperty(\"--_radius\");\n  }\n}\n\ndefine(\"ray-blockquote\", RayBlockquote);\n";
const F10: string = "// <ray-bottom-nav>: the bottom navigation bar of a phone app (Material's\n// navigation bar, the iOS tab bar): three to five destinations, an icon and\n// a label each, the current one marked by a pill behind its icon.\n//\n// Links (<ray-bottom-nav-item href>) mark the page they lead to\n// (aria-current=\"page\"); without href it is a control: `value` and\n// `change`, like a segmented control. An item with `action` is a button\n// (a prominent \"New\" in the middle): it fires ray-select, it is not a\n// destination.\n//\n// hide-on-scroll slides it away while the content scrolls down (the\n// scroller of its ray-app-shell, `scroll-target` or the window); `fixed`\n// pins it to the bottom of the window. Clear of the home indicator\n// (safe-area inset).\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor } from \"../../core/styles.js\";\nimport { scrollerOf, watchScroll } from \"../../core/scroll.js\";\n\n// An item's value: its own, else its href, else its label.\nconst valueOf = (item) => item.value ?? item.href ?? item.label;\n\nconst navStyles = css`\n  :host {\n    display: grid;\n    grid-template-rows: 1fr;\n    position: relative;\n    z-index: 2;\n    transition: grid-template-rows var(--ray-duration-base) var(--ray-easing-standard), translate var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  :host([hidden]) { display: none; }\n  :host([fixed]) { position: fixed; inset: auto 0 0 0; }\n  /* Its border, padding and raised action would still show: clip them. */\n  :host([data-concealed=\"flow\"]) { grid-template-rows: 0fr; clip-path: inset(0); }\n  :host([data-concealed=\"over\"]) { translate: 0 100%; }\n  .fold { min-height: 0; }\n  nav {\n    box-sizing: border-box;\n    display: grid;\n    grid-auto-columns: minmax(0, 1fr);\n    grid-auto-flow: column;\n    align-items: stretch;\n    padding: var(--ray-space-1) max(var(--ray-space-1), env(safe-area-inset-right, 0px)) max(var(--ray-space-1), env(safe-area-inset-bottom, 0px)) max(var(--ray-space-1), env(safe-area-inset-left, 0px));\n    background: var(--ray-bottom-nav, var(--ray-background));\n    border-top: 1px solid var(--ray-border);\n  }\n  :host([variant=\"floating\"]) { padding: 0 var(--ray-space-3) max(var(--ray-space-3), env(safe-area-inset-bottom, 0px)); }\n  :host([variant=\"floating\"][data-concealed=\"flow\"]) { padding-bottom: 0; }\n  :host([variant=\"floating\"]) nav { padding-bottom: var(--ray-space-1); border: 1px solid var(--ray-border); border-radius: var(--ray-radius-xl); box-shadow: var(--ray-shadow-lg); overflow: visible; }\n  @media (prefers-reduced-motion: reduce) { :host { transition: none; } }\n`;\n\nconst itemStyles = css`\n  :host {\n    display: block;\n    min-width: 0;\n  }\n  :host([hidden]) { display: none; }\n  .slot-host { display: contents; }\n  .item {\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 0.25rem;\n    width: 100%;\n    min-height: 3.5rem;\n    padding: 0.375rem 0.25rem;\n    margin: 0;\n    font: inherit;\n    color: var(--ray-muted-foreground);\n    text-decoration: none;\n    background: none;\n    border: 0;\n    border-radius: var(--ray-radius-md);\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n    transition: color var(--ray-duration-fast);\n  }\n  .item:focus-visible { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: -2px; }\n  .item:hover { color: var(--ray-foreground); }\n  :host([active]) .item { color: var(--_light-color); }\n  :host([disabled]) .item { opacity: 0.45; cursor: not-allowed; }\n  .icon-wrap {\n    position: relative;\n    display: grid;\n    place-items: center;\n    width: 3.5rem;\n    height: 2rem;\n    border-radius: var(--ray-radius-full);\n    --ray-icon-size: 1.375rem;\n    --ray-icon-stroke: 1.75;\n  }\n  .pill {\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    background: var(--_light);\n    opacity: 0;\n    scale: 0.6 1;\n    transition: opacity var(--ray-duration-fast), scale var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  :host([active]) .pill { opacity: 1; scale: 1; }\n  :host([data-indicator=\"none\"]) .pill { display: none; }\n  :host([data-indicator=\"line\"]) .pill { inset: auto 1rem -0.25rem; height: 0.1875rem; background: var(--_filled); }\n  .icon, ::slotted([slot=\"icon\"]) { position: relative; }\n  .icon:empty { display: none; }\n  .badge {\n    position: absolute;\n    top: 0;\n    left: calc(50% + 0.375rem);\n    min-width: 1rem;\n    height: 1rem;\n    padding: 0 0.25rem;\n    box-sizing: border-box;\n    font-size: 0.625rem;\n    font-weight: 700;\n    line-height: 1rem;\n    text-align: center;\n    color: #fff;\n    background: var(--ray-red-filled);\n    border: 2px solid var(--ray-bottom-nav, var(--ray-background));\n    border-radius: var(--ray-radius-full);\n    box-sizing: content-box;\n  }\n  .badge:empty:not([data-dot]) { display: none; }\n  .badge[data-dot] { min-width: 0; width: 0.5rem; height: 0.5rem; padding: 0; top: 0.25rem; left: calc(50% + 0.5rem); }\n  .label {\n    max-width: 100%;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n    font-size: var(--ray-font-size-xs);\n    font-weight: var(--ray-font-weight-medium, 500);\n    line-height: 1.2;\n  }\n  :host([active]) .label { font-weight: 700; }\n  :host([data-labels=\"active\"]:not([active])) .label, :host([data-labels=\"never\"]) .label {\n    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;\n  }\n  /* action: a raised round button in the bar. */\n  :host([action]) .icon-wrap {\n    width: 3.25rem;\n    height: 3.25rem;\n    margin-top: -1.25rem;\n    color: var(--_contrast);\n    background: var(--_filled);\n    box-shadow: var(--ray-shadow-md);\n    transition: scale var(--ray-duration-fast);\n    --ray-icon-size: 1.5rem;\n    --ray-icon-stroke: 2;\n  }\n  :host([action]) .item:active .icon-wrap { scale: 0.94; }\n  :host([action]) .pill { display: none; }\n  :host([action]) .item { color: var(--ray-foreground); }\n  @media (prefers-reduced-motion: reduce) { .pill { transition: none; } }\n`;\n\nexport class RayBottomNavItem extends RayElement {\n  static properties = {\n    value: { type: String, reflect: true },\n    label: { type: String },\n    icon: { type: String },\n    href: { type: String, reflect: true },\n    badge: { type: String },\n    dot: { type: Boolean, reflect: true },\n    active: { type: Boolean, reflect: true },\n    disabled: { type: Boolean, reflect: true },\n    action: { type: Boolean, reflect: true },\n  };\n  static styles = [itemStyles];\n  static delegatesFocus = true;\n  static template = `<span class=\"slot-host\"></span>`;\n\n  #tag = \"\";\n\n  update() {\n    // A link for a destination with href, a button otherwise.\n    const tag = this.href && !this.action ? \"a\" : \"button\";\n    if (tag !== this.#tag) {\n      this.#tag = tag;\n      const host = this.$(\".slot-host\");\n      host.innerHTML = `<\${tag} class=\"item\" part=\"item\"><span class=\"icon-wrap\"><span class=\"pill\" part=\"indicator\"></span><span class=\"icon\" data-ray-icon=\"\"></span><slot name=\"icon\"></slot><span class=\"badge\" part=\"badge\"></span></span><span class=\"label\" part=\"label\"></span></\${tag}>`;\n      if (tag === \"button\") host.firstElementChild.type = \"button\";\n    }\n    const item = this.$(\".item\");\n    if (tag === \"a\") {\n      if (this.disabled) item.removeAttribute(\"href\");\n      else item.setAttribute(\"href\", this.href);\n    } else {\n      item.disabled = Boolean(this.disabled);\n    }\n    if (this.active && !this.action) item.setAttribute(\"aria-current\", \"page\");\n    else item.removeAttribute(\"aria-current\");\n    const icon = this.$(\".icon\");\n    icon.setAttribute(\"data-ray-icon\", this.icon ?? \"\");\n    this.paintIcons();\n    this.$(\".label\").textContent = this.label ?? \"\";\n    const badge = this.$(\".badge\");\n    badge.textContent = this.dot ? \"\" : (this.badge ?? \"\");\n    badge.toggleAttribute(\"data-dot\", Boolean(this.dot));\n    // The badge is read with the label (\"Messages, 3\").\n    if (this.badge && !this.dot) item.setAttribute(\"aria-label\", `\${this.label ?? \"\"}, \${this.badge}`);\n    else if (this.dot) item.setAttribute(\"aria-label\", `\${this.label ?? \"\"}, new`);\n    else item.removeAttribute(\"aria-label\");\n  }\n}\n\nexport class RayBottomNav extends RayElement {\n  static properties = {\n    value: { type: String, reflect: true },\n    label: { type: String, default: \"Main\" },\n    labels: { type: String, reflect: true, default: \"always\" },\n    indicator: { type: String, reflect: true, default: \"pill\" },\n    color: { type: String, reflect: true },\n    variant: { type: String, reflect: true, default: \"default\" },\n    hideOnScroll: { type: Boolean, reflect: true, attribute: \"hide-on-scroll\" },\n    fixed: { type: Boolean, reflect: true },\n    scrollTarget: { type: String, attribute: \"scroll-target\" },\n  };\n  static styles = [navStyles];\n  // The row that closes is .fold (no padding, no border: it can reach 0).\n  static template = `<div class=\"fold\"><nav part=\"nav\"><slot></slot></nav></div>`;\n\n  #stop = null;\n  #lock = 0;\n\n  constructor() {\n    super();\n    this.$(\"slot\").addEventListener(\"slotchange\", () => this._sync());\n    this.addEventListener(\"click\", (e) => {\n      const item = e.target.closest?.(\"ray-bottom-nav-item\");\n      if (!item || item.parentElement !== this || item.disabled) return;\n      if (item.action) {\n        this.emit(\"ray-select\", { value: valueOf(item) ?? \"\" });\n        return;\n      }\n      const value = valueOf(item);\n      if (value !== undefined && value !== this.value) {\n        this.commitProperty(\"value\", value);\n        this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n      }\n    });\n  }\n\n  /** The destinations and actions, in order. */\n  get items() {\n    return [...this.children].filter((el) => el.localName === \"ray-bottom-nav-item\");\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    queueMicrotask(() => this._watch());\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    this.#stop?.();\n    this.#stop = null;\n  }\n\n  update(changed) {\n    this.$(\"nav\").setAttribute(\"aria-label\", this.label || \"Main\");\n    this._sync();\n    if (changed.has(\"hideOnScroll\") || changed.has(\"scrollTarget\") || changed.has(\"fixed\")) this._watch();\n  }\n\n  // Marks the current item. Without a value: the link to this page, or\n  // the first destination of a control.\n  _sync() {\n    const items = this.items;\n    if (this.value === undefined) {\n      const here = items.find((i) => i.href && !i.action && new URL(i.href, document.baseURI).pathname === location.pathname);\n      if (here) this.commitProperty(\"value\", valueOf(here));\n      // A control (no links) starts on its first destination.\n      else if (items.length && !items.some((i) => i.href)) {\n        const first = items.find((i) => !i.action && !i.disabled);\n        if (first) this.commitProperty(\"value\", valueOf(first));\n      }\n    }\n    for (const item of items) {\n      item.active = !item.action && valueOf(item) !== undefined && valueOf(item) === this.value;\n      item.setAttribute(\"data-labels\", this.labels || \"always\");\n      item.setAttribute(\"data-indicator\", this.indicator || \"pill\");\n      applyColor(item, this.color);\n    }\n  }\n\n  _watch() {\n    this.#stop?.();\n    this.#stop = null;\n    this.removeAttribute(\"data-concealed\");\n    if (!this.isConnected || !this.hideOnScroll) return;\n    const scroller = scrollerOf(this, this.scrollTarget);\n    const mode = this.fixed || scroller === window ? \"over\" : \"flow\";\n    this.#stop = watchScroll(scroller, ({ y, direction }) => {\n      const on = direction === \"down\" && y > 24;\n      if (y <= 0) { this.removeAttribute(\"data-concealed\"); return; }\n      if (on === this.hasAttribute(\"data-concealed\") || performance.now() < this.#lock) return;\n      this.#lock = performance.now() + 400;\n      if (on) this.setAttribute(\"data-concealed\", mode);\n      else this.removeAttribute(\"data-concealed\");\n    });\n  }\n}\n\ndefine(\"ray-bottom-nav-item\", RayBottomNavItem);\ndefine(\"ray-bottom-nav\", RayBottomNav);\n";
const F11: string = "// <ray-breadcrumbs> + <ray-breadcrumb>: where a page sits (Mantine's\n// Breadcrumbs, the WAI-ARIA breadcrumb pattern): a labelled nav of links,\n// the last one the current page (aria-current=\"page\").\n//\n// separator: any text (\"/\", \"›\", \"·\") or \"chevron\" (an icon). max-items\n// collapses the middle of a long path into a \"…\" button that expands it.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst trailStyles = css`\n  :host { display: block; min-width: 0; }\n  :host([hidden]) { display: none; }\n  ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0; margin: 0; padding: 0; list-style: none; }\n`;\n\nconst itemStyles = css`\n  :host { display: inline-flex; align-items: center; min-width: 0; font-size: var(--_fs, var(--ray-font-size-sm)); }\n  :host([hidden]), :host([data-collapsed]) { display: none; }\n  .sep {\n    display: inline-flex;\n    align-items: center;\n    padding: 0 var(--ray-space-2);\n    color: var(--ray-muted-foreground);\n    user-select: none;\n  }\n  .sep svg { width: 0.9em; height: 0.9em; }\n  :host([data-first]) .sep.before { display: none; }\n  .more, .after { display: none; }\n  :host([data-after-more]) .more, :host([data-after-more]) .after { display: inline-flex; }\n  .more {\n    align-items: center;\n    justify-content: center;\n    min-width: 1.75rem;\n    height: 1.5rem;\n    padding: 0 0.25rem;\n    font: inherit;\n    letter-spacing: 0.1em;\n    color: var(--ray-muted-foreground);\n    background: transparent;\n    border: 0;\n    border-radius: var(--ray-radius-sm);\n    cursor: pointer;\n  }\n  .more:hover { color: var(--ray-foreground); background: var(--ray-default-hover); }\n  .more:focus-visible, .link:focus-visible { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: 2px; }\n  .link {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--ray-space-1);\n    min-width: 0;\n    max-width: var(--ray-breadcrumb-max, 16rem);\n    color: var(--ray-muted-foreground);\n    text-decoration: none;\n    border-radius: var(--ray-radius-xs);\n    --ray-icon-size: 1em;\n  }\n  .text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  a.link:hover { color: var(--ray-foreground); text-decoration: underline; text-underline-offset: 0.2em; }\n  :host([data-current]) .link { color: var(--ray-foreground); font-weight: var(--ray-font-weight-medium); }\n`;\n\nexport class RayBreadcrumbs extends RayElement {\n  static properties = {\n    separator: { type: String, default: \"/\" },\n    maxItems: { type: Number, attribute: \"max-items\" },\n    label: { type: String, default: \"Breadcrumb\" },\n    size: { type: String, reflect: true, default: \"sm\" },\n  };\n  static styles = [trailStyles];\n  static template = `<nav part=\"nav\"><ol part=\"list\"><slot></slot></ol></nav>`;\n\n  #expanded = false;\n\n  constructor() {\n    super();\n    this.$(\"slot\").addEventListener(\"slotchange\", () => this.requestUpdate());\n    this.addEventListener(\"ray-breadcrumbs-expand\", (e) => {\n      e.stopPropagation();\n      this.expand();\n    });\n  }\n\n  /** The crumbs, in order. */\n  get items() {\n    return [...this.children].filter((el) => el.localName === \"ray-breadcrumb\");\n  }\n\n  /** Shows every crumb of a collapsed path. */\n  expand() {\n    this.#expanded = true;\n    this.requestUpdate();\n    // Focus moves to the first crumb that was hidden.\n    queueMicrotask(() => this.items[1]?.focus());\n  }\n\n  update() {\n    this.$(\"nav\").setAttribute(\"aria-label\", this.label || \"Breadcrumb\");\n    const sizes = { xs: \"var(--ray-font-size-xs)\", sm: \"var(--ray-font-size-sm)\", md: \"var(--ray-font-size-md)\", lg: \"var(--ray-font-size-lg)\" };\n    this.style.setProperty(\"--_fs\", sizes[this.size] ?? sizes.sm);\n    const items = this.items;\n    const explicit = items.some((i) => i.current);\n    const max = this.maxItems ?? 0;\n    // Collapsed: the first crumb, \"…\", then the last (max - 1).\n    const collapse = !this.#expanded && max >= 2 && items.length > max;\n    const hiddenUntil = collapse ? items.length - (max - 1) : 0;\n    items.forEach((item, i) => {\n      item.toggleAttribute(\"data-first\", i === 0);\n      item.toggleAttribute(\"data-current\", explicit ? Boolean(item.current) : i === items.length - 1);\n      item.toggleAttribute(\"data-collapsed\", collapse && i > 0 && i < hiddenUntil);\n      item.toggleAttribute(\"data-after-more\", collapse && i === hiddenUntil);\n      item._setSeparator(this.separator || \"/\");\n    });\n  }\n}\n\nexport class RayBreadcrumb extends RayElement {\n  static properties = {\n    href: { type: String, reflect: true },\n    current: { type: Boolean, reflect: true },\n  };\n  static styles = [itemStyles];\n  static delegatesFocus = true;\n  static template = `<span class=\"sep before\" part=\"separator\" aria-hidden=\"true\"></span><button class=\"more\" type=\"button\" part=\"more\" aria-label=\"Show the whole path\">…</button><span class=\"sep after\" aria-hidden=\"true\"></span><span class=\"slot-host\"></span>`;\n\n  #tag = \"\";\n  #sep = \"\";\n\n  static get observedAttributes() {\n    return [...super.observedAttributes, \"data-current\"];\n  }\n\n  attributeChangedCallback(attr, old, value) {\n    if (attr === \"data-current\") return this.requestUpdate();\n    super.attributeChangedCallback(attr, old, value);\n  }\n\n  constructor() {\n    super();\n    this.setAttribute(\"role\", \"listitem\");\n    this.$(\".more\").addEventListener(\"click\", () => this.dispatchEvent(new CustomEvent(\"ray-breadcrumbs-expand\", { bubbles: true })));\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    this.setAttribute(\"role\", \"listitem\");\n  }\n\n  /** Protected: the separator the trail draws before this crumb. */\n  _setSeparator(sep) {\n    if (sep === this.#sep) return;\n    this.#sep = sep;\n    for (const el of this.shadowRoot.querySelectorAll(\".sep\")) {\n      if (sep === \"chevron\") el.innerHTML = `<span data-ray-icon=\"chevron-right\"></span>`;\n      else el.textContent = sep;\n    }\n    this.paintIcons();\n  }\n\n  update() {\n    const current = this.hasAttribute(\"data-current\");\n    // The current page and a crumb without href are text, the others links.\n    const tag = this.href && !current ? \"a\" : \"span\";\n    if (tag !== this.#tag) {\n      this.#tag = tag;\n      this.$(\".slot-host\").innerHTML = `<\${tag} class=\"link\" part=\"link\"><slot name=\"icon\"></slot><span class=\"text\"><slot></slot></span></\${tag}>`;\n    }\n    const link = this.$(\".link\");\n    if (tag === \"a\") link.setAttribute(\"href\", this.href);\n    if (current) link.setAttribute(\"aria-current\", \"page\");\n    else link.removeAttribute(\"aria-current\");\n  }\n}\n\ndefine(\"ray-breadcrumb\", RayBreadcrumb);\ndefine(\"ray-breadcrumbs\", RayBreadcrumbs);\n";
const F12: string = "// <ray-button>: a button (or a link, with href) in Mantine's variants.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { applyColor, applyGradient, sizeStyles, radiusStyles, variantStyles, loaderStyles } from \"../../core/styles.js\";\n\nconst styles = css`\n  :host {\n    display: inline-flex;\n    vertical-align: middle;\n  }\n  :host([full-width]) { display: flex; width: 100%; }\n  .button {\n    position: relative;\n    display: inline-flex;\n    flex: 1;\n    align-items: center;\n    justify-content: center;\n    gap: var(--_gap);\n    height: var(--_h);\n    padding: 0 var(--_px);\n    font: inherit;\n    font-size: var(--_fs);\n    font-weight: var(--ray-font-weight-semibold);\n    line-height: 1;\n    white-space: nowrap;\n    text-decoration: none;\n    border-radius: var(--_r);\n    /* Corners a ray-button-group can square off (inherited custom properties). */\n    border-start-start-radius: var(--ray-group-radius-ss, var(--_r));\n    border-start-end-radius: var(--ray-group-radius-se, var(--_r));\n    border-end-start-radius: var(--ray-group-radius-es, var(--_r));\n    border-end-end-radius: var(--ray-group-radius-ee, var(--_r));\n    cursor: pointer;\n    user-select: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .button:not([data-disabled]):active { transform: translateY(1px); }\n\n  /* variant=\"raised\": a physical key. The face sits on a darker edge (a hard\n     shadow, like ray-kbd's thick bottom border); pressing sinks the face onto\n     it. The host reserves the edge's height, so the row does not jump. */\n  :host([variant=\"raised\"]) { --_depth: 4px; padding-bottom: var(--_depth); }\n  :host([variant=\"raised\"][size=\"xs\"]), :host([variant=\"raised\"][size=\"sm\"]) { --_depth: 3px; }\n  .button[data-variant=\"raised\"] {\n    /* Face, its text and the edge: overridable (ray-toggle's unlit key). */\n    --_face: var(--_filled);\n    --_face-text: var(--_contrast);\n    --_edge: color-mix(in srgb, var(--_face), black 32%);\n    --_rim: color-mix(in srgb, var(--_face), black 14%);\n    background: var(--_face);\n    color: var(--_face-text);\n    border-color: var(--_rim);\n    box-shadow:\n      0 var(--_depth) 0 var(--_edge),\n      0 calc(var(--_depth) + 1px) 6px -1px rgb(0 0 0 / 0.28),\n      inset 0 1px 0 rgb(255 255 255 / 0.18);\n    transition:\n      transform 110ms var(--ray-easing-out),\n      box-shadow 110ms var(--ray-easing-out),\n      background-color var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  .button[data-variant=\"raised\"][data-interactive]:not([data-disabled]):hover {\n    background: color-mix(in srgb, var(--_face), white 6%);\n  }\n  .button[data-variant=\"raised\"]:not([data-disabled]):is(:active, [data-pressed]) {\n    transform: translateY(var(--_depth));\n    box-shadow: 0 0 0 var(--_edge), 0 1px 2px -1px rgb(0 0 0 / 0.3), inset 0 1px 2px rgb(0 0 0 / 0.12);\n    transition-duration: 50ms;\n  }\n  /* Disabled or loading: pushed in and greyed. */\n  .button[data-variant=\"raised\"][data-disabled] {\n    transform: translateY(var(--_depth));\n    color: var(--ray-muted-foreground);\n    background: var(--ray-muted);\n    border-color: var(--ray-border);\n    box-shadow: none;\n  }\n  .section { display: inline-flex; align-items: center; }\n  .section:not([data-filled]) { display: none; }\n  .label { display: inline-flex; align-items: center; overflow: hidden; text-overflow: ellipsis; }\n  .overlay {\n    position: absolute;\n    inset: 0;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    --_loader: calc(var(--_fs) * 1.15);\n  }\n  :host([loading]) .overlay { display: flex; }\n  /* Hidden by opacity, not visibility: the label stays the button's\n     accessible name while the spinner shows (\"Saving\", busy). */\n  :host([loading]) .content { opacity: 0; }\n  .content { display: contents; }\n  :host([loading]) .button[data-disabled] { cursor: progress; }\n  :host([loading]) .button[data-variant=\"filled\"][data-disabled] {\n    background: var(--_filled);\n    color: var(--_contrast);\n    border-color: transparent;\n    opacity: 0.75;\n  }\n`;\n\nconst INNER = `\n  <span class=\"content\">\n    <span class=\"section\" part=\"left-section\"><slot name=\"left\"></slot></span>\n    <span class=\"label\" part=\"label\"><slot></slot></span>\n    <span class=\"section\" part=\"right-section\"><slot name=\"right\"></slot></span>\n  </span>\n  <span class=\"overlay\" aria-hidden=\"true\"><span class=\"loader\"></span></span>`;\n\nconst PRESS_MS = 110;\n\n// Host attributes copied to the inner <button>/<a>.\nconst MIRRORED_ARIA = [\"aria-label\", \"aria-expanded\", \"aria-haspopup\", \"aria-pressed\", \"aria-current\"];\n\nexport class RayButton extends RayElement {\n  static formAssociated = true;\n  static delegatesFocus = true;\n  static properties = {\n    variant: { type: String, reflect: true, default: \"filled\" },\n    color: { type: String, reflect: true },\n    gradient: { type: String, reflect: true },\n    size: { type: String, reflect: true, default: \"sm\" },\n    radius: { type: String, reflect: true },\n    type: { type: String, reflect: true, default: \"button\" },\n    disabled: { type: Boolean, reflect: true },\n    loading: { type: Boolean, reflect: true },\n    fullWidth: { type: Boolean, reflect: true },\n    href: { type: String, reflect: true },\n    target: { type: String, reflect: true },\n    name: { type: String, reflect: true },\n    value: { type: String, reflect: true },\n  };\n  static styles = [sizeStyles, radiusStyles, variantStyles, loaderStyles, styles];\n\n  static get observedAttributes() {\n    return [...super.observedAttributes, ...MIRRORED_ARIA, \"aria-describedby\"];\n  }\n\n  attributeChangedCallback(attr, old, value) {\n    if (attr.startsWith(\"aria-\")) {\n      this.requestUpdate();\n      return;\n    }\n    super.attributeChangedCallback(attr, old, value);\n  }\n\n  constructor() {\n    super();\n    this.internals = this.attachInternals();\n    this._onClick = (e) => this._click(e);\n  }\n\n  get form() { return this.internals.form; }\n\n  formDisabledCallback(disabled) {\n    this._fieldsetDisabled = disabled;\n    this.requestUpdate();\n  }\n\n  /** Clicks the inner button (host.click() alone would not reach it). */\n  click() {\n    if (this._el) this._el.click();\n    else super.click();\n  }\n\n  update() {\n    // The inner element is a <button>, or an <a> when href is set.\n    const tag = this.href ? \"a\" : \"button\";\n    if (!this._el || this._el.localName !== tag) this._render(tag);\n    const el = this._el;\n    const disabled = Boolean(this.disabled || this.loading || this._fieldsetDisabled);\n\n    el.dataset.variant = this.variant || \"filled\";\n    el.toggleAttribute(\"data-disabled\", disabled);\n    applyColor(el, this.color);\n    applyGradient(el, this.gradient);\n    if (tag === \"button\") {\n      el.disabled = Boolean(this.disabled || this._fieldsetDisabled);\n      el.setAttribute(\"aria-disabled\", String(disabled));\n    } else {\n      el.href = this.href;\n      if (this.target) el.target = this.target;\n      else el.removeAttribute(\"target\");\n      if (disabled) {\n        el.setAttribute(\"aria-disabled\", \"true\");\n        el.removeAttribute(\"href\");\n      } else {\n        el.removeAttribute(\"aria-disabled\");\n      }\n    }\n    el.toggleAttribute(\"aria-busy\", Boolean(this.loading));\n    // ARIA put on the host (by the app, a popover, a menu…) belongs to the inner button.\n    for (const attr of MIRRORED_ARIA) {\n      const v = this.getAttribute(attr);\n      if (v !== null) el.setAttribute(attr, v);\n      else el.removeAttribute(attr);\n    }\n    // aria-describedby ids live in the document: reference the elements\n    // themselves (element reflection may point out of the shadow root).\n    const ids = (this.getAttribute(\"aria-describedby\") ?? \"\").split(/\\s+/).filter(Boolean);\n    if (\"aria