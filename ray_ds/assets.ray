e.key === \"Enter\" || e.key === \" \") up();\n    });\n  }\n\n  _click(e) {\n    if (this.loading || this.disabled) {\n      e.preventDefault();\n      e.stopImmediatePropagation();\n      return;\n    }\n    const form = this.internals.form;\n    if (!form || this.href) return;\n    if (this.type === \"submit\") {\n      // Submit with this button as the submitter-equivalent: name/value travel\n      // as a hidden field for the duration of the submit.\n      let extra = null;\n      if (this.name) {\n        extra = document.createElement(\"input\");\n        extra.type = \"hidden\";\n        extra.name = this.name;\n        extra.value = this.value ?? \"\";\n        form.append(extra);\n      }\n      try {\n        form.requestSubmit();\n      } finally {\n        extra?.remove();\n      }\n    } else if (this.type === \"reset\") {\n      form.reset();\n    }\n  }\n}\n\ndefine(\"ray-button\", RayButton);\n";
const F13: string = "// <ray-button-group>: buttons (and fields, menus…) joined into one control\n// (Mantine's Button.Group, shadcn's ButtonGroup). The group squares off the\n// inner corners of its children through inherited custom properties\n// (--ray-group-radius-*, read by ray-button, ray-icon-button and the field\n// boxes) and overlaps their borders.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst styles = css`\n  :host { display: inline-flex; vertical-align: middle; isolation: isolate; }\n  :host([orientation=\"vertical\"]) { flex-direction: column; }\n  :host([full-width]) { display: flex; }\n  :host([full-width]) ::slotted(*) { flex: 1; }\n  ::slotted(*) { position: relative; }\n  /* The hovered or focused child on top: its whole border shows. */\n  ::slotted(:hover) { z-index: 1; }\n  /* A pressed toggle's colored border must not hide under its neighbors,\n     nor flicker as the pointer moves over them. */\n  ::slotted([pressed]) { z-index: 2; }\n  ::slotted(:focus-within), ::slotted(:focus) { z-index: 3; }\n\n  /* Horizontal: square the inside corners, overlap the 1px borders. */\n  :host(:not([orientation=\"vertical\"])) ::slotted(:not(:first-child)) {\n    margin-inline-start: -1px;\n    --ray-group-radius-ss: 0px;\n    --ray-group-radius-es: 0px;\n  }\n  :host(:not([orientation=\"vertical\"])) ::slotted(:not(:last-child)) {\n    --ray-group-radius-se: 0px;\n    --ray-group-radius-ee: 0px;\n  }\n  /* Vertical: the same on the block axis. */\n  :host([orientation=\"vertical\"]) ::slotted(:not(:first-child)) {\n    margin-block-start: -1px;\n    --ray-group-radius-ss: 0px;\n    --ray-group-radius-se: 0px;\n  }\n  :host([orientation=\"vertical\"]) ::slotted(:not(:last-child)) {\n    --ray-group-radius-es: 0px;\n    --ray-group-radius-ee: 0px;\n  }\n  /* Filled buttons have no border to overlap: a thin divider instead. */\n  :host(:not([orientation=\"vertical\"])) ::slotted(ray-button[variant=\"filled\"]:not(:first-child)),\n  :host(:not([orientation=\"vertical\"])) ::slotted(ray-button:not([variant]):not(:first-child)),\n  :host(:not([orientation=\"vertical\"])) ::slotted(ray-menu:not(:first-child)) {\n    box-shadow: -1px 0 0 0 color-mix(in srgb, var(--ray-background) 35%, transparent);\n  }\n`;\n\nexport class RayButtonGroup extends RayElement {\n  static properties = {\n    orientation: { type: String, reflect: true, default: \"horizontal\" },\n    fullWidth: { type: Boolean, reflect: true },\n    label: { type: String },\n  };\n  static styles = [styles];\n  static template = `<slot></slot>`;\n\n  connectedCallback() {\n    super.connectedCallback();\n    if (!this.hasAttribute(\"role\")) this.setAttribute(\"role\", \"group\");\n  }\n\n  update() {\n    if (this.label) this.setAttribute(\"aria-label\", this.label);\n    // role=group takes no aria-orientation (ARIA allows it on toolbars,\n    // sliders, separators…): the orientation shows, it is not announced.\n    this.removeAttribute(\"aria-orientation\");\n  }\n}\n\ndefine(\"ray-button-group\", RayButtonGroup);\n";
const F14: string = "// <ray-card>: a surface with optional header and footer.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { radiusStyles } from \"../../core/styles.js\";\n\nconst styles = css`\n  :host {\n    display: block;\n    --_p: var(--ray-space-md);\n    --_shadow: none;\n  }\n  :host([padding=\"xs\"]) { --_p: var(--ray-space-xs); }\n  :host([padding=\"sm\"]) { --_p: var(--ray-space-sm); }\n  :host([padding=\"lg\"]) { --_p: var(--ray-space-lg); }\n  :host([padding=\"xl\"]) { --_p: var(--ray-space-xl); }\n  :host([padding=\"0\"]) { --_p: 0; }\n  :host([shadow=\"xs\"]) { --_shadow: var(--ray-shadow-xs); }\n  :host([shadow=\"sm\"]) { --_shadow: var(--ray-shadow-sm); }\n  :host([shadow=\"md\"]) { --_shadow: var(--ray-shadow-md); }\n  :host([shadow=\"lg\"]) { --_shadow: var(--ray-shadow-lg); }\n  :host([shadow=\"xl\"]) { --_shadow: var(--ray-shadow-xl); }\n  .card {\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    overflow: hidden;\n    color: var(--ray-card-foreground);\n    background: var(--ray-card);\n    border: 1px solid transparent;\n    border-radius: var(--_r);\n    box-shadow: var(--_shadow);\n  }\n  :host([with-border]) .card,\n  :host([variant=\"outline\"]) .card { border-color: var(--ray-border); }\n  :host([variant=\"filled\"]) .card { background: var(--ray-muted); }\n  :host([variant=\"outline\"]) .card { background: transparent; }\n  .header, .footer { padding: var(--_p); }\n  .header { padding-bottom: 0; }\n  .footer { padding-top: 0; }\n  .header:not([data-filled]), .footer:not([data-filled]) { display: none; }\n  .body { flex: 1; padding: var(--_p); }\n  ::slotted([slot=\"media\"]) { display: block; width: 100%; }\n`;\n\nexport class RayCard extends RayElement {\n  static properties = {\n    padding: { type: String, reflect: true },\n    radius: { type: String, reflect: true },\n    shadow: { type: String, reflect: true },\n    withBorder: { type: Boolean, reflect: true },\n    variant: { type: String, reflect: true, default: \"default\" },\n  };\n  static styles = [radiusStyles, styles];\n  static template = `\n    <div class=\"card\" part=\"card\">\n      <slot name=\"media\"></slot>\n      <div class=\"header\" part=\"header\"><slot name=\"header\"></slot></div>\n      <div class=\"body\" part=\"body\"><slot></slot></div>\n      <div class=\"footer\" part=\"footer\"><slot name=\"footer\"></slot></div>\n    </div>`;\n\n  connectedCallback() {\n    super.connectedCallback();\n    for (const name of [\"header\", \"footer\"]) {\n      const slot = this.$(`slot[name=\"\${name}\"]`);\n      const sync = () => slot.parentElement.toggleAttribute(\"data-filled\", slot.assignedNodes().length > 0);\n      slot.addEventListener(\"slotchange\", sync);\n      sync();\n    }\n  }\n}\n\ndefine(\"ray-card\", RayCard);\n";
const F15: string = "// <ray-carousel>: slides in a scroll-snap viewport (Mantine's Carousel,\n// shadcn's Carousel). Native scrolling does the moving — touch swipe,\n// trackpads, scroll wheels — and the component adds previous/next controls,\n// indicators, keyboard, loop and autoplay on top.\n//\n// Any child element is a slide. With several slides in view (slide-size\n// \"50%\", \"18rem\"…) the positions are the distinct snap points the viewport\n// can reach: `index`, the indicators and next()/prev() count those.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\nimport { motionAllowed } from \"../../core/motion.js\";\n\nconst styles = css`\n  :host {\n    display: block;\n    position: relative;\n    /* Inside grid/flex parents: never wider than them (the slides scroll). */\n    min-width: 0;\n    --_size: 100%;\n    --_gap: var(--ray-space-4);\n  }\n  :host([orientation=\"vertical\"]) { height: 20rem; }\n  .root { position: relative; display: flex; flex-direction: column; gap: var(--ray-space-3); height: 100%; }\n  .stage { position: relative; flex: 1; min-width: 0; min-height: 0; }\n  .viewport {\n    display: flex;\n    gap: var(--_gap);\n    height: 100%;\n    overflow-x: auto;\n    overflow-y: hidden;\n    scroll-snap-type: x mandatory;\n    overscroll-behavior-x: contain;\n    scrollbar-width: none;\n    border-radius: var(--ray-radius-default);\n    outline: none;\n  }\n  .viewport::-webkit-scrollbar { display: none; }\n  .viewport:focus-visible { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: 2px; }\n  :host([orientation=\"vertical\"]) .viewport {\n    flex-direction: column;\n    overflow-x: hidden;\n    overflow-y: auto;\n    scroll-snap-type: y mandatory;\n    overscroll-behavior-y: contain;\n  }\n  ::slotted(*) {\n    flex: 0 0 var(--_size);\n    min-width: 0;\n    min-height: 0;\n    box-sizing: border-box;\n    scroll-snap-align: start;\n  }\n  :host([align=\"center\"]) ::slotted(*) { scroll-snap-align: center; }\n\n  .control {\n    position: absolute;\n    top: 50%;\n    z-index: 1;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 2rem;\n    height: 2rem;\n    padding: 0;\n    color: var(--ray-popover-foreground);\n    background: var(--ray-popover);\n    border: 1px solid var(--ray-border);\n    border-radius: var(--ray-radius-full);\n    box-shadow: var(--ray-shadow-sm);\n    cursor: pointer;\n    transform: translateY(-50%);\n    transition: opacity var(--ray-duration-fast) var(--ray-easing-standard), background var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  .control:hover:not(:disabled) { background: var(--ray-accent); }\n  .control:disabled { opacity: 0; pointer-events: none; }\n  .control svg { width: 1rem; height: 1rem; }\n  .prev { left: var(--ray-space-2); }\n  .next { right: var(--ray-space-2); }\n  :host([orientation=\"vertical\"]) .control { top: auto; left: 50%; transform: translateX(-50%) rotate(90deg); }\n  :host([orientation=\"vertical\"]) .prev { top: var(--ray-space-2); }\n  :host([orientation=\"vertical\"]) .next { bottom: var(--ray-space-2); }\n  :host([hide-controls]) .control { display: none; }\n\n  .footer { display: flex; align-items: center; justify-content: center; gap: var(--ray-space-2); min-height: 1.5rem; }\n  .footer[hidden] { display: none; }\n  .indicators { display: flex; align-items: center; gap: 0.125rem; }\n  :host([hide-indicators]) .indicators { display: none; }\n  .dot {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    /* 24px: the minimum target (WCAG 2.5.8); the dot drawn inside is smaller. */\n    width: 1.5rem;\n    height: 1.5rem;\n    padding: 0;\n    background: none;\n    border: 0;\n    border-radius: var(--ray-radius-full);\n    cursor: pointer;\n  }\n  .dot::before {\n    content: \"\";\n    width: 0.5rem;\n    height: 0.5rem;\n    border-radius: var(--ray-radius-full);\n    background: color-mix(in srgb, var(--ray-foreground) 25%, transparent);\n    transition: width var(--ray-duration-base) var(--ray-easing-standard), background var(--ray-duration-base) var(--ray-easing-standard);\n  }\n  .dot:hover::before { background: color-mix(in srgb, var(--ray-foreground) 45%, transparent); }\n  .dot[aria-current=\"true\"] { width: 1.75rem; }\n  .dot[aria-current=\"true\"]::before { width: 1.25rem; background: var(--ray-primary); }\n  .dot:focus-visible, .play:focus-visible { outline: var(--ray-focus-ring-width) solid var(--ray-ring); outline-offset: 1px; }\n  .play {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 1.5rem;\n    height: 1.5rem;\n    padding: 0;\n    color: var(--ray-muted-foreground);\n    background: none;\n    border: 0;\n    border-radius: var(--ray-radius-full);\n    cursor: pointer;\n  }\n  .play:hover { color: var(--ray-foreground); background: var(--ray-accent); }\n  .play[hidden] { display: none; }\n  .play svg { width: 0.875rem; height: 0.875rem; }\n`;\n\nconst PAUSE_ICON = `<span data-ray-icon=\"pause\" aria-hidden=\"true\"></span>`;\n\nconst reduced = typeof matchMedia === \"function\" ? matchMedia(\"(prefers-reduced-motion: reduce)\") : null;\n\nexport class RayCarousel extends RayElement {\n  static properties = {\n    index: { type: Number, default: 0 },\n    label: { type: String, default: \"Carousel\" },\n    slideSize: { type: String, attribute: \"slide-size\" },\n    slideGap: { type: String, attribute: \"slide-gap\" },\n    align: { type: String, reflect: true, default: \"start\" },\n    orientation: { type: String, reflect: true, default: \"horizontal\" },\n    loop: { type: Boolean, reflect: true },\n    autoplay: { type: Number, default: 0 },\n    hideControls: { type: Boolean, reflect: true },\n    hideIndicators: { type: Boolean, reflect: true },\n  };\n  static styles = [styles];\n  static template = `\n    <div class=\"root\" part=\"root\" role=\"region\" aria-roledescription=\"carousel\">\n      <div class=\"stage\">\n        <div class=\"viewport\" part=\"viewport\" tabindex=\"0\" aria-live=\"polite\"><slot></slot></div>\n        <button class=\"control prev\" part=\"previous\" type=\"button\" aria-label=\"Previous slide\"><span data-ray-icon=\"chevron-left\" aria-hidden=\"true\"></span></button>\n        <button class=\"control next\" part=\"next\" type=\"button\" aria-label=\"Next slide\"><span data-ray-icon=\"chevron-right\" aria-hidden=\"true\"></span></button>\n      </div>\n      <div class=\"footer\" part=\"footer\">\n        <button class=\"play\" part=\"play\" type=\"button\" hidden></button>\n        <div class=\"indicators\" part=\"indicators\"></div>\n      </div>\n    </div>`;\n\n  #snaps = [0];\n  #scrollTimer = 0;\n  #autoTimer = 0;\n  #hover = false;\n  #focus = false;\n  // Reduced motion: autoplay starts paused (the play button starts it).\n  #userPaused = Boolean(reduced?.matches);\n  #resize = null;\n\n  constructor() {\n    super();\n    this.viewport = this.$(\".viewport\");\n    this._slot = this.$(\"slot\");\n    this._slot.addEventListener(\"slotchange\", () => this._measure());\n    this.viewport.addEventListener(\"scroll\", () => {\n      // No rAF in some hosts: settle the position with a short timeout.\n      clearTimeout(this.#scrollTimer);\n      this.#scrollTimer = setTimeout(() => this._track(), 50);\n    }, { passive: true });\n    this.viewport.addEventListener(\"scrollend\", () => this._track());\n    this.$(\".prev\").addEventListener(\"click\", () => this.prev());\n    this.$(\".next\").addEventListener(\"click\", () => this.next());\n    this.$(\".play\").addEventListener(\"click\", () => {\n      this.#userPaused = !this.#userPaused;\n      this._schedule();\n    });\n    this.$(\".indicators\").addEventListener(\"click\", (e) => {\n      const dot = e.target.closest?.(\".dot\");\n      if (dot) this.goTo(Number(dot.dataset.index));\n    });\n    this.addEventListener(\"keydown\", (e) => this._onKey(e));\n    this.addEventListener(\"pointerenter\", () => { this.#hover = true; this._schedule(); });\n    this.addEventListener(\"pointerleave\", () => { this.#hover = false; this._schedule(); });\n    this.addEventListener(\"focusin\", () => { this.#focus = true; this._schedule(); });\n    this.addEventListener(\"focusout\", (e) => {\n      if (!this.contains(e.relatedTarget) && !this.shadowRoot.contains(e.relatedTarget)) {\n        this.#focus = false;\n        this._schedule();\n      }\n    });\n    this._onVisibility = () => this._schedule();\n  }\n\n  connectedCallback() {\n    super.connectedCallback();\n    document.addEventListener(\"visibilitychange\", this._onVisibility);\n    if (typeof ResizeObserver === \"function\" && !this.#resize) {\n      this.#resize = new ResizeObserver(() => this._measure());\n      this.#resize.observe(this.viewport);\n    }\n    queueMicrotask(() => this._measure());\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback();\n    document.removeEventListener(\"visibilitychange\", this._onVisibility);\n    this.#resize?.disconnect();\n    this.#resize = null;\n    clearTimeout(this.#autoTimer);\n    clearTimeout(this.#scrollTimer);\n  }\n\n  /** The slide elements (the assigned children). */\n  get slides() {\n    return this._slot.assignedElements();\n  }\n\n  /** Number of positions (snap points): one per slide unless several fit in view. */\n  get count() {\n    return this.#snaps.length;\n  }\n\n  update(changed) {\n    const root = this.$(\".root\");\n    root.setAttribute(\"aria-label\", this.label || \"Carousel\");\n    if (this.slideSize) this.style.setProperty(\"--_size\", this.slideSize);\n    else this.style.removeProperty(\"--_size\");\n    if (this.slideGap) this.style.setProperty(\"--_gap\", this.slideGap);\n    else this.style.removeProperty(\"--_gap\");\n    if (changed.has(\"slideSize\") || changed.has(\"slideGap\") || changed.has(\"align\") || changed.has(\"orientation\")) {\n      queueMicrotask(() => this._measure());\n    }\n    if (changed.has(\"index\") && !this._tracking) this._go(this.index, false);\n    if (changed.has(\"autoplay\")) this._schedule();\n    this._paint();\n  }\n\n  /** Goes to the next position (wraps with `loop`). */\n  next() {\n    const i = this._current();\n    if (i < this.count - 1) this.goTo(i + 1);\n    else if (this.loop) this.goTo(0);\n  }\n\n  /** Goes to the previous position (wraps with `loop`). */\n  prev() {\n    const i = this._current();\n    if (i > 0) this.goTo(i - 1);\n    else if (this.loop) this.goTo(this.count - 1);\n  }\n\n  /** Scrolls to position `index` (smoothly unless `instant` or reduced motion). */\n  /** Moves to a position (not scrollTo(): that is Element.prototype.scrollTo). */\n  goTo(index, { instant = false } = {}) {\n    this._go(index, true, instant);\n  }\n\n  // --- internals ------------------------------------------------------------\n\n  _vertical() {\n    return this.orientation === \"vertical\";\n  }\n\n  _current() {\n    return Math.min(Math.max(0, this.index ?? 0), this.count - 1);\n  }\n\n  // The snap points: each slide's aligned position, clamped to what the\n  // viewport can reach, without duplicates.\n  _measure() {\n    const vp = this.viewport;\n    const v = this._vertical();\n    const slides = this.slides;\n    const total = slides.length;\n    slides.forEach((s, i) => {\n      if (!s.hasAttribute(\"role\")) s.setAttribute(\"role\", \"group\");\n      s.setAttribute(\"aria-roledescription\", \"slide\");\n      if (!s.hasAttribute(\"aria-label\") || s.dataset.rayAutoLabel !== undefined) {\n        s.setAttribute(\"aria-label\", `\${i + 1} of \${total}`);\n        s.dataset.rayAutoLabel = \"\";\n      }\n    });\n    const vr = vp.getBoundingClientRect();\n    const size = v ? vp.clientHeight : vp.clientWidth;\n    const max = Math.max(0, v ? vp.scrollHeight - vp.clientHeight : vp.scrollWidth - vp.clientWidth);\n    const scroll = v ? vp.scrollTop : vp.scrollLeft;\n    const snaps = [];\n    for (const s of slides) {\n      const r = s.getBoundingClientRect();\n      const start = (v ? r.top - vr.top : r.left - vr.left) + scroll;\n      const length = v ? r.height : r.width;\n      const pos = this.align === \"center\" ? start - (size - length) / 2 : start;\n      const clamped = Math.round(Math.min(max, Math.max(0, pos)));\n      // A position only a sliver past the previous one (the end clamp, gaps)\n      // is the same stop: keep the later, so the end stays reachable.\n      if (snaps.length && clamped - snaps[snaps.length - 1] < Math.max(2, length / 3)) snaps[snaps.length - 1] = clamped;\n      else snaps.push(clamped);\n    }\n    this.#snaps = snaps.length ? snaps : [0];\n    this._renderDots();\n    this._track();\n  }\n\n  _renderDots() {\n    const box = this.$(\".indicators\");\n    const n = this.count;\n    if (box.children.length !== n) {\n      box.replaceChildren(\n        ...Array.from({ length: n }, (_, i) => {\n          const b = document.createElement(\"button\");\n          b.type = \"button\";\n          b.className = \"dot\";\n          b.setAttribute(\"part\", \"indicator\");\n          b.dataset.index = String(i);\n          b.setAttribute(\"aria-label\", `Go to slide \${i + 1}`);\n          return b;\n        }),\n      );\n    }\n    this.$(\".footer\").hidden = (n < 2 || this.hideIndicators) && !(this.autoplay > 0);\n  }\n\n  // The position closest to the current scroll offset.\n  _track() {\n    const vp = this.viewport;\n    const scroll = this._vertical() ? vp.scrollTop : vp.scrollLeft;\n    let best = 0;\n    for (let i = 1; i < this.#snaps.length; i++) {\n      if (Math.abs(this.#snaps[i] - scroll) < Math.abs(this.#snaps[best] - scroll)) best = i;\n    }\n    this._setIndex(best);\n    this._paint();\n  }\n\n  _setIndex(i) {\n    if (i === (this.index ?? 0)) return;\n    this._tracking = true;\n    this.commitProperty(\"index\", i);\n    queueMicrotask(() => { this._tracking = false; });\n    this.dispatchEvent(new Event(\"change\", { bubbles: true }));\n  }\n\n  _go(index, user, instant = false) {\n    if (!Number.isFinite(index)) return;\n    const i = Math.min(Math.max(0, Math.round(index)), this.count - 1);\n    const pos = this.#snaps[i] ?? 0;\n    const smooth = user && !instant && !reduced?.matches && motionAllowed(this);\n    const opts = { behavior: smooth ? \"smooth\" : \"instant\" };\n    if (this._vertical()) this.viewport.scrollTo({ top: pos, ...opts });\n    else this.viewport.scrollTo({ left: pos, ...opts });\n    this._setIndex(i);\n    this._paint();\n    this._schedule();\n  }\n\n  _paint() {\n    const i = this._current();\n    const n = this.count;\n    this.$(\".prev\").disabled = !this.loop && i <= 0;\n    this.$(\".next\").disabled = !this.loop && i >= n - 1;\n    for (const d of this.$(\".indicators\").children) {\n      if (Number(d.dataset.index) === i) d.setAttribute(\"aria-current\", \"true\");\n      else d.removeAttribute(\"aria-current\");\n    }\n    this._paintPlay();\n    this.$(\".footer\").hidden = (n < 2 || this.hideIndicators) && !(this.autoplay > 0);\n  }\n\n  // Autoplay runs unless paused by the user (or by reduced motion), hovered,\n  // focused, or the page is hidden.\n  _running() {\n    if (!(this.autoplay > 0) || this.count < 2 || this.#userPaused) return false;\n    return !this.#hover && !this.#focus && document.visibilityState !== \"hidden\";\n  }\n\n  _schedule() {\n    clearTimeout(this.#autoTimer);\n    this._paintPlay();\n    if (!this._running()) return;\n    this.#autoTimer = setTimeout(() => {\n      const i = this._current();\n      this.goTo(i < this.count - 1 ? i + 1 : 0);\n    }, this.autoplay);\n  }\n\n  // The pause/play button reflects the user's choice (hover and focus pause\n  // only for a moment); the live region is off while slides move by themselves.\n  _paintPlay() {\n    const play = this.$(\".play\");\n    const auto = this.autoplay > 0;\n    play.hidden = !auto;\n    const paused = this.#userPaused;\n    if (auto && play.dataset.state !== (paused ? \"paused\" : \"playing\")) {\n      play.dataset.state = paused ? \"paused\" : \"playing\";\n      play.innerHTML = paused ? `<span data-ray-icon=\"play\" aria-hidden=\"true\"></span>` : PAUSE_ICON;\n      this.paintIcons(play);\n      play.setAttribute(\"aria-label\", paused ? \"Start autoplay\" : \"Pause autoplay\");\n    }\n    this.viewport.setAttribute(\"aria-live\", auto && this._running() ? \"off\" : \"polite\");\n  }\n\n  _onKey(e) {\n    const t = e.composedPath()[0];\n    if (t && (t.isContentEditable || [\"input\", \"textarea\", \"select\"].includes(t.localName))) return;\n    const v = this._vertical();\n    const back = v ? \"ArrowUp\" : \"ArrowLeft\";\n    const fwd = v ? \"ArrowDown\" : \"ArrowRight\";\n    if (e.key === fwd) {\n      e.preventDefault();\n      this.next();\n    } else if (e.key === back) {\n      e.preventDefault();\n      this.prev();\n    } else if (e.key === \"Home\") {\n      e.preventDefault();\n      this.goTo(0);\n    } else if (e.key === \"End\") {\n      e.preventDefault();\n      this.goTo(this.count - 1);\n    }\n  }\n}\n\ndefine(\"ray-carousel\", RayCarousel);\n";
const F16: string = "// <ray-center>: its content centered on both axes (Mantine's Center). It\n// fills its parent's width; give it a height (or let a flex/grid parent\n// stretch it) to center vertically. `inline` makes it as wide as its content.\n\nimport { RayElement, css, define } from \"../../core/core.js\";\n\nconst styles = css`\n  :host {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 0;\n  }\n  :host([inline]) { display: inline-flex; }\n  :host([hidden]) { display: none; }\n`;\n\nexport class RayCenter extends RayElement {\n  static properties = {\n    inline: { type: Boolean, reflect: true },\n  };\n  static styles = [styles];\n  static template = `<slot></slot>`;\n}\n\ndefine(\"ray-center\", RayCenter);\n";
const F17: string = "// <ray-checkbox>: a checkbox with label (attribute or content), description\n// and error. Submits `value` (default \"on\") under `name` when checked.\n\nimport { css, define } from \"../../core/core.js\";\nimport { applyColor, sizeStyles, radiusStyles } from \"../../core/styles.js\";\nimport { FieldControl, fieldStyles } from \"../../core/form.js\";\n\nexport const checkStyles = css`\n  :host {\n    display: block;\n    --_s: 1.25rem;\n  }\n  :host([size=\"xs\"]) { --_s: 1rem; }\n  :host([size=\"md\"]) { --_s: 1.5rem; }\n  :host([size=\"lg\"]) { --_s: 1.875rem; }\n  :host([size=\"xl\"]) { --_s: 2.25rem; }\n  .root {\n    display: flex;\n    align-items: flex-start;\n    gap: calc(var(--_s) * 0.6);\n  }\n  :host([label-position=\"left\"]) .root { flex-direction: row-reverse; justify-content: flex-end; }\n  .inner {\n    position: relative;\n    flex: none;\n    display: inline-flex;\n    width: var(--_iw, var(--_s));\n    height: var(--_s);\n  }\n  .control {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    width: 100%;\n    height: 100%;\n    margin: 0;\n    opacity: 0;\n    cursor: pointer;\n  }\n  .control:disabled { cursor: not-allowed; }\n  .indicator {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    height: 100%;\n    color: var(--_contrast);\n    background: var(--ray-background);\n    border: 1px solid var(--ray-input);\n    border-radius: var(--_r);\n    transition: background-color var(--ray-duration-fast) var(--ray-easing-standard), border-color var(--ray-duration-fast) var(--ray-easing-standard);\n  }\n  .control:focus-visible + .indicator {\n    outline: var(--ray-focus-ring-width) solid var(--ray-ring);\n    outline-offset: var(--ray-focus-ring-offset);\n  }\n  .control:disabled + .indicator { background: var(--ray-muted); border-color: var(--ray-border); }\n  .root[data-invalid] .indicator { border-color: var(--ray-destructive); }\n  .body { display: flex; flex-direction: column; justify-content: center; min-height: var(--_s); }\n  .label { margin: 0; cursor: pointer; font-weight: var(--ray-font-weight-regular); line-height: var(--ray-line-height-sm); }\n  .description, .error { margin: var(--ray-space-1) 0 0; }\n  :host([disabled]) .label { color: var(--ray-muted-foreground); cursor: not-allowed; }\n`;\n\nconst styles = css`\n  :host { --_r: var(--ray-radius-sm); }\n  .indicator { --ray-icon-stroke: 3; }\n  .check, .dash { display: none; }\n  .check svg, .dash svg { width: calc(var(--_s) * 0.65); height: calc(var(--_s) * 0.65); }\n  .control:checked + .indicator,\n  .control:indeterminate + .indicator { background: var(--_filled); border-color: var(--_filled); }\n  .control:checked:not(:indeterminate) + .indicator .check { display: inline-flex; }\n  .control:indeterminate + .indicator .dash { display: inline-flex; }\n  :host([variant=\"outline\"]) .control:checked + .indicator,\n  :host([variant=\"outline\"]) .control:indeterminate + .indicator { background: var(--ray-background); color: var(--_filled); }\n  .control:disabled:checked + .indicator,\n  .control:disabled:indeterminate + .indicator { background: var(--ray-border); border-color: var(--ray-border); color: var(--ray-muted-foreground); }\n`;\n\nexport function checkTemplate(indicator, inputAttrs = \"\") {\n  return `\n    <div class=\"root\" part=\"root\">\n      <span class=\"inner\">\n        <input type=\"checkbox\" id=\"control\" class=\"control\" part=\"input\" \${inputAttrs}>\n        \${indicator}\n      </span>\n      <span class=\"body\">\n        <label class=\"label\" part=\"label\" for=\"control\" hidden><span class=\"label-text\"></span><slot></slot><span class=\"required\" aria-hidden=\"true\" hidden> *</span></label>\n        <div class=\"description\" part=\"description\" id=\"description\" hidden></div>\n        <div class=\"error\" part=\"error\" id=\"error\" hidden></div>\n      </span>\n    </div>`;\n}\n\nexport class RayCheckbox extends FieldControl {\n  static properties = {\n    ...FieldControl.fieldProperties,\n    checked: { type: Boolean, attribute: false },\n    indeterminate: { type: Boolean, reflect: true },\n    value: { type: String, reflect: true, default: \"on\" },\n    color: { type: String, reflect: true },\n    variant: { type: String, reflect: true, default: \"filled\" },\n    labelPosition: { type: String, reflect: true, default: \"right\" },\n  };\n  static styles = [sizeStyles, radiusStyles, fieldStyles, checkStyles, styles];\n  static template = checkTemplate(`<span class=\"indicator\" part=\"indicator\" aria-hidden=\"true\"><span class=\"check\" data-ray-icon=\"check\"></span><span class=\"dash\" data-ray-icon=\"minus\"></span></span>`);\n\n  wire() {\n    // The `checked` attribute is the default state, like on <input>.\n    this._default = this.hasAttribute(\"checked\");\n    if (!this.hasValue(\"checked\")) this.commitProperty(\"checked\", this._default);\n    this.control.addEventListener(\"change\", (e) => {\n      this.commitProperty(\"checked\", this.control.checked);\n      if (this.indeterminate) this.indeterminate = false;\n      this._commit();\n      this.forward(e);\n    });\n    const slot = this.$(\".label slot\");\n    slot.addEventListener(\"slotchange\", () => this.requestUpdate());\n  }\n\n  update() {\n    const c = this.control;\n    c.checked = Boolean(this.checked);\n    c.indeterminate = Boolean(this.indeterminate);\n    if (this.indeterminate) c.setAttribute(\"aria-checked\", \"mixed\");\n    else c.removeAttribute(\"aria-checked\");\n    applyColor(this.$(\".root\"), this.color);\n    this.syncField();\n    // The label shows for the attribute or for slotted content.\n    const slotted = this.$(\".label slot\").assignedNodes().some((n) => n.nodeType === 1 || n.textContent.trim());\n    this.$(\".label\").hidden = !(this.label || slotted);\n    this.$(\".root\").toggleAttribute(\"data-invalid\", Boolean(this.error));\n    this._commit();\n  }\n\n  _commit(