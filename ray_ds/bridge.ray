// The program's half of the ray-ds native bridge (the page's half is
// core/raylang.js). The page asks with window.ray.request and a JSON object
// tagged "ray-ds"; handle() answers those requests and leaves any other event
// to the app, so the bridge sits in front of the app's own protocol:
//
//   for e in ui.events() {
//       if (bridge.handle(e)) {
//           continue;
//       }
//       // the app's own events
//   }
//
// Every answer is {"ok": true, "value": …} or {"ok": false, "error": "…"}.
// The system dialogs are behind `Native`, so tests answer with fakes.

import std/fs;
import std/json;
import std/ui;

// The version of the protocol: a page asking with a newer one gets an error.
pub const PROTOCOL: int = 1;

pub const VERSION: string = "0.3.0";

// What the requests reach: the system (system()) or fakes in tests.
pub struct Native {
    pick_files: fn(ui.FileDialogOptions) -> Result<[string], string>,
    // mode ("open", "folder" or "save") and the options; None = cancelled.
    pick_path: fn(string, ui.FileDialogOptions) -> Result<Option<string>, string>,
    confirm: fn(string, string, string, string, string) -> Result<bool, string>,
    file_size: fn(string) -> Result<int, string>,
}

// The real dialogs. `confirm` takes title, message, confirm label, cancel
// label and style ("" for the plain question, or "info", "warning", "error").
pub fn system() -> Native {
    Native {
        pick_files: fn(o: ui.FileDialogOptions) -> Result<[string], string> { ui.pick_files(o) },
        pick_path: fn(mode: string, o: ui.FileDialogOptions) -> Result<Option<string>, string> {
            match (mode) {
                "folder" => ui.pick_folder_with(o),
                "save" => ui.save_file_with(o),
                _ => ui.pick_file_with(o),
            }
        },
        confirm: fn(title: string, text: string, ok: string, cancel: string, style: string) -> Result<bool, string> {
            if (style == "") {
                ui.confirm(title, text, ok, cancel)
            } else {
                ui.message_styled(title, text, style, [ok, cancel]).map(fn(i: int) -> bool { i == 0 })
            }
        },
        file_size: fn(path: string) -> Result<int, string> { fs.file_size(path) },
    }
}

// Answers `e` if it is a ray-ds request; false for anything else.
pub fn handle(e: ui.UiEvent) -> bool {
    handle_with(e, system())
}

pub fn handle_with(e: ui.UiEvent, n: Native) -> bool {
    if (e.kind != "message") {
        return false;
    }
    match (ui.as_request(e)) {
        Option.Some((id, body)) => match (answer(n, body)) {
            Option.Some(reply) => {
                // A window that closed meanwhile cannot be answered: nothing to do.
                let _sent = ui.reply_json(e.window, id, reply);
                true
            },
            Option.None => false,
        },
        Option.None => false,
    }
}

// The JSON answer to a request body; None when it is not a ray-ds request.
pub fn answer(n: Native, body: string) -> Option<string> {
    let j = match (json.parse(body)) {
        Result.Ok(j) => j,
        Result.Err(_) => return Option.None,
    };
    let protocol = match (json.get_int(j, "ray-ds")) {
        Option.Some(p) => p,
        Option.None => return Option.None,
    };
    let result = if (protocol > PROTOCOL) {
        Result.Err("ray-ds protocol ${protocol} is newer than the program's (${PROTOCOL}): update ray_ds")
    } else {
        run(n, json.get_string(j, "op").unwrap_or(""), j)
    };
    Option.Some(match (result) {
        Result.Ok(value) => "{\"ok\":true,\"value\":${value}}",
        Result.Err(e) => json.obj().field("ok", false).field("error", e).render(),
    })
}

// The operations; each returns its value as JSON text.
fn run(n: Native, op: string, j: json.Json) -> Result<string, string> {
    match (op) {
        "hello" => Result.Ok(hello()),
        "pick_files" => pick_files(n, j),
        "pick_path" => pick_path(n, j),
        "confirm" => confirm(n, j),
        _ => Result.Err("unknown ray-ds operation '${op}'"),
    }
}

const OPS: [string] = ["hello", "pick_files", "pick_path", "confirm"];

fn hello() -> string {
    json.obj().field("protocol", PROTOCOL).field("version", VERSION).field("platform", platform()).field(
        "ops",
        json.list(OPS)
    ).render()
}

// {title, directory, multiple, filters: [{name, extensions}]} -> [{path, name, size}]
// (size -1 when it cannot be read); [] when the user cancels.
fn pick_files(n: Native, j: json.Json) -> Result<string, string> {
    var o = ui.file_options();
    o.title = json.get_string(j, "title").unwrap_or("");
    o.directory = json.get_string(j, "directory").unwrap_or("");
    o.multiple = json.get_bool(j, "multiple").unwrap_or(false);
    o.filters = filters(j);
    let paths = (n.pick_files)(o)?;
    var out = json.arr();
    for p in paths {
        let size = (n.file_size)(p).unwrap_or(-1);
        out = out.item(json.obj().field("path", p).field("name", base_name(p)).field("size", size));
    }
    Result.Ok(json.render_arr(out))
}

// {mode, title, directory, suggested, filters} -> the path, or null when cancelled.
fn pick_path(n: Native, j: json.Json) -> Result<string, string> {
    let mode = json.get_string(j, "mode").unwrap_or("open");
    if (mode != "open" && mode != "folder" && mode != "save") {
        return Result.Err("pick_path: unknown mode '${mode}' (open, folder or save)");
    }
    var o = ui.file_options();
    o.title = json.get_string(j, "title").unwrap_or("");
    o.directory = json.get_string(j, "directory").unwrap_or("");
    o.suggested = json.get_string(j, "suggested").unwrap_or("");
    o.filters = filters(j);
    match (n.pick_path(mode, o)?) {
        Option.Some(p) => Result.Ok(p.to_json()),
        Option.None => Result.Ok("null"),
    }
}

fn filters(j: json.Json) -> [ui.FileFilter] {
    var out: [ui.FileFilter] = [];
    for f in json.get_array(j, "filters").unwrap_or([]) {
        var exts: [string] = [];
        for x in json.get_array(f, "extensions").unwrap_or([]) {
            match (json.as_string(x)) {
                Option.Some(s) => exts.push(s.strip_prefix(".").unwrap_or(s)),
                Option.None => { },
            }
        }
        if (exts.len() > 0) {
            out.push(ui.filter(json.get_string(f, "name").unwrap_or(""), exts));
        }
    }
    out
}

// {title, message, confirmLabel, cancelLabel, style} -> bool
fn confirm(n: Native, j: json.Json) -> Result<string, string> {
    let style = json.get_string(j, "style").unwrap_or("");
    if (style != "" && style != "info" && style != "warning" && style != "error") {
        return Result.Err("confirm: unknown style '${style}' (info, warning or error)");
    }
    let yes = (n.confirm)(
        json.get_string(j, "title").unwrap_or("Are you sure?"),
        json.get_string(j, "message").unwrap_or(""),
        json.get_string(j, "confirmLabel").unwrap_or("Confirm"),
        json.get_string(j, "cancelLabel").unwrap_or("Cancel"),
        style
    )?;
    Result.Ok(if (yes) { "true" } else { "false" })
}

// The last part of a path, with / or \ separators.
pub fn base_name(path: string) -> string {
    let cut = match (path.replace("\\", "/").last_index_of("/")) {
        Option.Some(i) => i + 1,
        Option.None => 0,
    };
    path.substring(cut, path.len())
}

// --- tests -------------------------------------------------------------------

// Picks the comma-separated paths of the dialog's title; confirms when the
// title starts with "yes"; a file's size is ten times its name's length.
fn fake() -> Native {
    Native {
        pick_files: fn(o: ui.FileDialogOptions) -> Result<[string], string> {
            if (o.title == "fail") {
                return Result.Err("no dialog");
            }
            if (o.title == "") { Result.Ok([]) } else { Result.Ok(o.title.split(",")) }
        },
        pick_path: fn(mode: string, o: ui.FileDialogOptions) -> Result<Option<string>, string> {
            if (o.title == "") {
                return Result.Ok(Option.None);
            }
            Result.Ok(Option.Some("${mode}:${o.directory}|${o.suggested}|${o.filters.len()}"))
        },
        confirm: fn(title: string, text: string, ok: string, cancel: string, style: string) -> Result<bool, string> {
            Result.Ok(title.starts_with("yes"))
        },
        file_size: fn(path: string) -> Result<int, string> {
            if (path.ends_with(".missing")) { Result.Err("gone") } else { Result.Ok(base_name(path).len() * 10) }
        },
    }
}

@test
fn ignores_what_is_not_a_bridge_request() {
    assert(answer(fake(), "hello").is_none());
    assert(answer(fake(), "{\"op\":\"hello\"}").is_none());
    assert(answer(fake(), "[1,2]").is_none());
}

@test
fn says_hello() {
    let a = answer(fake(), "{\"ray-ds\":1,\"op\":\"hello\"}").unwrap();
    assert(a.starts_with("{\"ok\":true,\"value\":{\"protocol\":1,\"version\":\"0.3.0\",\"platform\":\""));
    assert(a.ends_with("\"ops\":[\"hello\",\"pick_files\",\"pick_path\",\"confirm\"]}}"));
}

@test
fn picks_files_with_their_sizes() {
    let a = answer(fake(), "{\"ray-ds\":1,\"op\":\"pick_files\",\"title\":\"/a/b.png,C:\\\\x\\\\y.txt,z.missing\"}");
    assert_eq(
        a.unwrap(),
        "{\"ok\":true,\"value\":[{\"path\":\"/a/b.png\",\"name\":\"b.png\",\"size\":50},{\"path\":\"C:\\\\x\\\\y.txt\",\"name\":\"y.txt\",\"size\":50},{\"path\":\"z.missing\",\"name\":\"z.missing\",\"size\":-1}]}"
    );
    assert_eq(answer(fake(), "{\"ray-ds\":1,\"op\":\"pick_files\"}").unwrap(), "{\"ok\":true,\"value\":[]}");
}

@test
fn picks_a_path() {
    assert_eq(
        answer(
            fake(),
            "{\"ray-ds\":1,\"op\":\"pick_path\",\"mode\":\"save\",\"title\":\"t\",\"directory\":\"/a\",\"suggested\":\"x \\\"1\\\".txt\"}"
        ).unwrap(),
        "{\"ok\":true,\"value\":\"save:/a|x \\\"1\\\".txt|0\"}"
    );
    assert_eq(
        answer(fake(), "{\"ray-ds\":1,\"op\":\"pick_path\",\"mode\":\"folder\"}").unwrap(),
        "{\"ok\":true,\"value\":null}"
    );
    assert(answer(fake(), "{\"ray-ds\":1,\"op\":\"pick_path\",\"mode\":\"x\"}").unwrap().contains("unknown mode 'x'"));
}

@test
fn reads_the_filters() {
    let j = json.parse("{\"filters\":[{\"name\":\"Images\",\"extensions\":[\".png\",\"jpg\"]},{\"name\":\"none\",\"extensions\":[]}]}").unwrap();
    let got = filters(j);
    assert_eq(got.len(), 1);
    assert_eq(got[0].name, "Images");
    assert_eq(got[0].extensions, ["png", "jpg"]);
}

@test
fn confirms() {
    assert_eq(answer(fake(), "{\"ray-ds\":1,\"op\":\"confirm\",\"title\":\"yes?\"}").unwrap(), "{\"ok\":true,\"value\":true}");
    assert_eq(answer(fake(), "{\"ray-ds\":1,\"op\":\"confirm\",\"title\":\"no?\",\"style\":\"warning\"}").unwrap(), "{\"ok\":true,\"value\":false}");
    assert_eq(
        answer(fake(), "{\"ray-ds\":1,\"op\":\"confirm\",\"style\":\"loud\"}").unwrap(),
        "{\"ok\":false,\"error\":\"confirm: unknown style 'loud' (info, warning or error)\"}"
    );
}

@test
fn reports_errors() {
    assert_eq(answer(fake(), "{\"ray-ds\":1,\"op\":\"pick_files\",\"title\":\"fail\"}").unwrap(), "{\"ok\":false,\"error\":\"no dialog\"}");
    assert_eq(answer(fake(), "{\"ray-ds\":1,\"op\":\"fly\"}").unwrap(), "{\"ok\":false,\"error\":\"unknown ray-ds operation 'fly'\"}");
    assert(answer(fake(), "{\"ray-ds\":2,\"op\":\"hello\"}").unwrap().contains("newer than the program's"));
}
